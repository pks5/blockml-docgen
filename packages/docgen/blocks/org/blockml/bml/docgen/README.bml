<!--
  BlockML DocGen Library — README / library reading entry point

  FQN: org.blockml.bml.docgen.README
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:docgen="org.blockml.bml.docgen"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:page="org.blockml.bml.docgen.page"
  xmlns:level="org.blockml.bml.docgen.level"
  xmlns:weight="org.blockml.bml.docgen.weight"
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core">

  <name>README</name>
  <type>docgen:README</type>
  <baseType>core:ReadMe</baseType>
  <is>A documentation-generation library reading entry point</is>

  <documentation>
    README for the BlockML documentation-generation library (org.blockml.bml.docgen). This library
    is a standalone foundation for producing human-readable documentation from BlockML — page
    models under dcore:DocElement → dcore:Page (page:DocPage) and dcore:PageElement (content
    elements including Navigation / NavigationItem), plus definitional metadata such as
    dcore:Audience / dcore:PageType and annotative metadata under dcore:SemanticAnnotation
    (concrete annotations in org.blockml.bml.docgen.semantic) that usually is not direct page
    chrome, and classification axes dcore:DetailLevel (how detailed)
    and dcore:Weight (how important for understanding) — without tying them to one particular
    website. DocSet.pageMapping owns pageKey and path for publishable pages.

    Narrative SSOT remains in bml-core (org.blockml.bml.documentation.* and org.blockml.bml.task.*).
    Site-specific catalogues (for example org.blockml.bml.bmldocs) depend on this library and fill
    concrete documentation structures for their surfaces.

    Start with dcore:DocElement, then dcore:Page / dcore:PageElement / dcore:Audience /
    dcore:SemanticAnnotation / dcore:DetailLevel / dcore:Weight and their specializations.
  </documentation>

  <references>
    <see type="dcore:DocElement" relation="ReadFirst">
      Semantic base for all docgen domain Blocks (except Library / README).
    </see>
    <see type="dcore:DocSet" relation="ReadFirst">
      Cohesive documentation set — container for product/project docs.
    </see>
    <see type="dcore:Page" relation="ReadFirst">
      Abstract documentation-generation page branch root.
    </see>
    <see type="dcore:PageGroup" relation="SeeAlso">
      Nested navigational groups of pages (title, order, landing page).
    </see>
    <see type="page:DocPage" relation="ReadFirst">
      Abstract documentation page marker with content aggregation.
    </see>
    <see type="dcore:PageElement" relation="ReadFirst">
      Abstract content element root (block and inline).
    </see>
    <see type="dcore:Audience" relation="ReadFirst">
      Definitional semantic metadata — Audience, PageType, ContentRole, ….
    </see>
    <see type="dcore:SemanticAnnotation" relation="ReadFirst">
      Annotative semantic metadata branch — children in org.blockml.bml.docgen.semantic
      (ReaderOutcome, Scope, LearningObjective, …).
    </see>
    <see type="dcore:DetailLevel" relation="SeeAlso">
      How detailed an explanation should be (prefer over Depth).
    </see>
    <see type="level:Overview" relation="SeeAlso">
      Shortest concrete DetailLevel — 1–3 sentence orientation.
    </see>
    <see type="level:Exhaustive" relation="SeeAlso">
      Fullest concrete DetailLevel — edge cases and history.
    </see>
    <see type="dcore:Weight" relation="SeeAlso">
      How important an element is for understanding (prefer over Importance).
    </see>
    <see type="weight:Primary" relation="SeeAlso">
      Central page statement — every reader should understand.
    </see>
    <see type="weight:Advanced" relation="SeeAlso">
      Deepening for experienced readers — not required for the page.
    </see>
    <see type="page:Navigation" relation="ReadFirst">
      In-page navigation lists and recursive menu trees.
    </see>
    <see type="docgen:Library" relation="SeeAlso">
      Published catalog of exported documentation-generation blocks.
    </see>
    <see type="blockml:Library" relation="Requires">
      BlockML core library — grammar and documentation SSOT that docgen consumes.
    </see>
  </references>

</block>
