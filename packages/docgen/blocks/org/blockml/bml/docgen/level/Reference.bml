<!--BlockML DocGen — a complete precise reference detail level

  FQN: org.blockml.bml.docgen.level.Reference-->
<level:Reference xmlns="http://blockml.org/bml"
  xmlns:level="org.blockml.bml.docgen.level"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    dcore:DetailLevel
  </baseType>
  <is>
    A complete precise reference detail level
  </is>
  <documentation>
    Complete, precise reference. No simplification for readability — every rule, member, and constraint that belongs in the authoritative surface is stated accurately.
  </documentation>
  <references>
    <see type="dcore:DetailLevel" relation="Extends">
      Detail-level classification axis under DocElement.
    </see>
  </references>
</level:Reference>
