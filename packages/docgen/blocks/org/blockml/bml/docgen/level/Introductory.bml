<!--BlockML DocGen — an introductory detail level for beginners

  FQN: org.blockml.bml.docgen.level.Introductory-->
<level:Introductory xmlns="http://blockml.org/bml"
  xmlns:level="org.blockml.bml.docgen.level"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    dcore:DetailLevel
  </baseType>
  <is>
    An introductory detail level for beginners
  </is>
  <documentation>
    For beginners. Explains the concept without internals or special cases. Introduces vocabulary and mental models; omits design history, edge cases, and advanced configuration.
  </documentation>
  <references>
    <see type="dcore:DetailLevel" relation="Extends">
      Detail-level classification axis under DocElement.
    </see>
  </references>
</level:Introductory>
