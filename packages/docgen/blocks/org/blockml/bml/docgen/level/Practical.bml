<!--BlockML DocGen — a practical application-focused detail level

  FQN: org.blockml.bml.docgen.level.Practical-->
<level:Practical xmlns="http://blockml.org/bml"
  xmlns:level="org.blockml.bml.docgen.level"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    dcore:DetailLevel
  </baseType>
  <is>
    A practical application-focused detail level
  </is>
  <documentation>
    Focus on application and typical usage. Only theory that is necessary to apply the concept correctly. Prefer worked examples and common paths over exhaustive coverage.
  </documentation>
  <references>
    <see type="dcore:DetailLevel" relation="Extends">
      Detail-level classification axis under DocElement.
    </see>
  </references>
</level:Practical>
