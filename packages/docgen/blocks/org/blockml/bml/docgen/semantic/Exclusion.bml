<!--BlockML DocGen — What the documentation deliberately omits

  FQN: org.blockml.bml.docgen.semantic.Exclusion-->
<sem:Exclusion xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    dcore:SemanticAnnotation
  </baseType>
  <is>
    What the documentation deliberately omits
  </is>
  <documentation>
    Marks topics, features, or depth levels that are out of scope — complementary to Scope for clear editorial boundaries.
  </documentation>
  <references>
    <see type="dcore:SemanticAnnotation" relation="Extends">
      Annotative semantic metadata branch.
    </see>
  </references>
  <properties>
    <reason type="org.blockml.bml.type.Text">
      <documentation>
        Why this topic, feature, or depth is deliberately omitted.
      </documentation>
    </reason>
  </properties>
</sem:Exclusion>
