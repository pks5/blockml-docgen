<!--BlockML DocGen — a learning or understanding outcome for the reader

  FQN: org.blockml.bml.docgen.semantic.ReaderOutcome-->
<sem:ReaderOutcome xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    dcore:SemanticAnnotation
  </baseType>
  <is>
    A learning or understanding outcome for the reader
  </is>
  <documentation>
    States what a reader should know, be able to do, or decide after consuming the documentation. Guides page goals and success criteria for generation.
  </documentation>
  <references>
    <see type="dcore:SemanticAnnotation" relation="Extends">
      Annotative semantic metadata branch.
    </see>
  </references>
</sem:ReaderOutcome>
