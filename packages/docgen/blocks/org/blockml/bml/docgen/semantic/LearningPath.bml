<!--BlockML DocGen — a learning path through documentation

  FQN: org.blockml.bml.docgen.semantic.LearningPath-->
<sem:LearningPath xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    dcore:SemanticAnnotation
  </baseType>
  <is>
    A learning path through a documentation set
  </is>
  <documentation>
    Ordered learning sequence through documentation — prerequisites, steps, and next topics for
    progressive disclosure. Owned by Documentation.learningPaths. Distinct from LearningObjective,
    which annotates a single instructional goal on content or page kinds.
  </documentation>
  <references>
    <see type="dcore:SemanticAnnotation" relation="Extends">
      Annotative semantic metadata branch.
    </see>
    <see type="sem:LearningObjective" relation="ContrastsWith">
      Single instructional goal — not a multi-step path catalogue entry.
    </see>
    <see type="dcore:DocSet" relation="SeeAlso">
      DocSet that owns learningPaths aggregations.
    </see>
  </references>
</sem:LearningPath>
