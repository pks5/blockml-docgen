<!--BlockML DocGen — abstract TOC plan template

  FQN: org.blockml.bml.docgen.plan.DocSetPlan-->
<dplan:DocSetPlan xmlns="http://blockml.org/bml"
  xmlns:dplan="org.blockml.bml.docgen.plan"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:stage="org.blockml.bml.docgen.stage"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    dcore:Plan
  </baseType>
  <is>
    An abstract template for a documentation TOC plan
  </is>
  <isNot>
    A concrete DocSetPlan, DocSet, or documentation Page
  </isNot>
  <documentation>
    Abstract template for a documentation table-of-contents plan. Concrete DocSetPlan
    types fill this template; they are not themselves a DocSet.

    A DocSetPlan is the TOC plan: which pages exist, what each page is about, how
    pages nest in groups, and which group is the root.

    - **Pages** — PagePlan.name (relative path; base packages later) and
      PagePlan.scope (intended content, not body text)
    - **Nesting** — PageGroupPlan entries, each with a visible title
    - **Root** — rootPageGroupPlan, the TOC root PageGroupPlan

    Filled in DocSetPlanningStage; consumed by DocSetStructuringStage. Does not hold
    page body, routing keys, or full Block FQNs.
  </documentation>
  <abstract>
    true
  </abstract>
  <references>
    <see type="dcore:Plan" relation="Extends">
      Planning-element base for DocSetPlanningStage.
    </see>
    <see type="dcore:DocSet" relation="ContrastsWith">
      Concrete documentation-set container — not the TOC plan.
    </see>
    <see type="dplan:PageGroupPlan" relation="Requires">
      TOC nesting and titles via rootPageGroupPlan.
    </see>
    <see type="dplan:PagePlan" relation="Requires">
      Planned TOC pages — relative name and scope.
    </see>
    <see type="stage:DocSetPlanningStage" relation="SeeAlso">
      Stage that creates or updates this TOC plan.
    </see>
    <see type="stage:DocSetStructuringStage" relation="SeeAlso">
      Stage that materializes Pages and PageGroups from this plan.
    </see>
  </references>
  <properties>
    <title>
      <documentation>
        The title of the documentation set.
      </documentation>
    </title>
    <summary>
      <documentation>
        The summary of the documentation set.
      </documentation>
    </summary>
    <version>
      <documentation>
        The version of the documentation set.
      </documentation>
    </version>
     <homePage type="type:TypeReference(dcore:Page)">
      <documentation>
        Type reference to the entry / home page of this documentation set.
      </documentation>
    </homePage>
  </properties>
  <aggregations>
    <rootPageGroupPlan type="dplan:PageGroupPlan">
      <documentation>
        TOC root. Nested PageGroupPlan and PagePlan entries under plans define
        grouping, titles, pages, and scope.
      </documentation>
    </rootPageGroupPlan>
  </aggregations>
</dplan:DocSetPlan>
