<!--BlockML DocGen — planned page within a DocSetPlan

  FQN: org.blockml.bml.docgen.plan.PagePlan-->
<dplan:PagePlan xmlns="http://blockml.org/bml"
  xmlns:dplan="org.blockml.bml.docgen.plan"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:page="org.blockml.bml.docgen.page"
  xmlns:constraint="org.blockml.bml.constraint">

  <baseType>
    dplan:StructurePlan
  </baseType>
  <is>
    A planned page for a DocSetPlan
  </is>
  <isNot>
    A concrete documentation Page, PageMapping, or PageGroup
  </isNot>
  <documentation>
    Planned page within a DocSetPlan. Used in DocSetPlanningStage to sketch
    structure before concrete Pages exist. Inherits name from StructurePlan
    (relative Block path; completing base package is defined later).

    Planning fields:

    - **scope** — what the page covers
    - **readerOutcome** — what the reader should take away
    - **learningObjective** — what the page intends to teach
    - **exclusion** — what the page deliberately does not cover
    - **supportingPoint** — what supports the main message

    Structuring maps those fields into the concrete Page’s purpose and
    documentation while reusing existing content where possible.
  </documentation>
  <references>
    <see type="dplan:StructurePlan" relation="Extends">
      Structural planning base — provides relative name (base package defined later).
    </see>
    <see type="dplan:DocSetPlan" relation="SeeAlso">
      Abstract DocSet model that owns planned pages.
    </see>
    <see type="page:DocPage" relation="ContrastsWith">
      Concrete page marker — created later from this plan entry in DocSetStructuringStage.
    </see>
    <see type="dcore:PageMapping" relation="ContrastsWith">
      Concrete pageKey/path mapping — assigned during structuring, not at planning time.
    </see>
  </references>
  <properties>
    <scope type="org.blockml.bml.type.Text">
      <abstract>true</abstract>
      <documentation>
        What the page covers. The topical content extent: which topics, concepts,
        and aspects this page should treat.
      </documentation>
      <constraints>
        <constraint:ValuePresent validation="Error" />
      </constraints>
    </scope>
    <readerOutcome type="org.blockml.bml.type.Text">
      <documentation>
        What the reader should take away. What the reader should understand, know,
        or be able to distinguish after reading the page.
      </documentation>
    </readerOutcome>
    <learningObjective type="org.blockml.bml.type.Text">
      <documentation>
        What the page intends to teach. The didactic goal: which knowledge,
        understanding, or skill the page is meant to convey.
      </documentation>
    </learningObjective>
    <exclusion type="org.blockml.bml.type.Text">
      <documentation>
        What the page deliberately does not cover. Consciously bounds scope against
        related topics, especially where overlap with other pages would otherwise
        arise.
      </documentation>
    </exclusion>
    <supportingPoint type="org.blockml.bml.type.Text">
      <documentation>
        What supports the page's main message. Complementary claims, arguments,
        connections, or facts that help understand the main topic but are not
        themselves the central subject of the page.
      </documentation>
    </supportingPoint>
  </properties>
</dplan:PagePlan>
