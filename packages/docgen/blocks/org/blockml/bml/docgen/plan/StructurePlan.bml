<!--BlockML DocGen — base for structural planning elements

  FQN: org.blockml.bml.docgen.plan.StructurePlan-->
<dplan:StructurePlan xmlns="http://blockml.org/bml"
  xmlns:dplan="org.blockml.bml.docgen.plan"
  xmlns:dcore="org.blockml.bml.docgen.core">

  <baseType>
    dcore:Plan
  </baseType>
  <is>
    A structural documentation-planning element
  </is>
  <isNot>
    A DocSetPlan or a concrete Page / PageGroup
  </isNot>
  <documentation>
    Abstract base for structural planning elements within a DocSetPlan — PagePlan and
    PageGroupPlan. name is the concrete Block local path relative to DocSetPlan.pageBasePackage
    (PagePlan, for example Intro) or DocSetPlan.pageGroupBasePackage (PageGroupPlan, for example
    GettingStartedPageGroup). Full FQN = the matching base package + "." + name.
    Used by DocSetPlanningStage; materialized by DocSetStructuringStage.
  </documentation>
  <abstract>
    true
  </abstract>
  <references>
    <see type="dcore:Plan" relation="Extends">
      Planning-element base for DocSetPlanningStage.
    </see>
    <see type="dplan:DocSetPlan" relation="SeeAlso">
      DocSet-level plan — owns pageBasePackage and pageGroupBasePackage; contrasts with
      structural entries.
    </see>
    <see type="dplan:PagePlan" relation="SeeAlso">
      Planned-page specialization.
    </see>
    <see type="dplan:PageGroupPlan" relation="SeeAlso">
      Planned page-group specialization.
    </see>
  </references>
  <properties>
    <name type="org.blockml.bml.type.Text">
      <documentation>
        Concrete Block name relative to DocSetPlan.pageBasePackage (PagePlan) or
        DocSetPlan.pageGroupBasePackage (PageGroupPlan). Full FQN = the matching base
        package + "." + name.
      </documentation>
    </name>
  </properties>
</dplan:StructurePlan>
