<!--BlockML DocGen — documentation paragraph

  FQN: org.blockml.bml.docgen.page.Paragraph-->
<page:Paragraph xmlns="http://blockml.org/bml"
  xmlns:page="org.blockml.bml.docgen.page">

  <baseType>
    page:ContentElement
  </baseType>
  <is>
    A paragraph of inline documentation content
  </is>
  <documentation>
    Block of inline runs (text). Prefer one idea per paragraph.
  </documentation>
  <references>
    <see type="page:ContentElement" relation="Extends">
      Block-level leaf content under BlockElement.
    </see>
  </references>
  <aggregations>
    <content type="page:InlineElement[]">
      <documentation>
        Ordered inline children that make up this paragraph.
      </documentation>
    </content>
  </aggregations>
</page:Paragraph>
