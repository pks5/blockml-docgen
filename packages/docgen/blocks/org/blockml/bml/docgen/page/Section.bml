<!--BlockML DocGen — documentation section

  FQN: org.blockml.bml.docgen.page.Section-->
<page:Section xmlns="http://blockml.org/bml"
  xmlns:page="org.blockml.bml.docgen.page"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    page:BlockElement
  </baseType>
  <is>
    A documentation section grouping block content
  </is>
  <documentation>
    Ordered container of block-level children. Nesting allows hierarchical page structure
    (sections within sections). When heading is omitted, generate it from this section’s
    purpose and other available semantic context instead of leaving the heading empty.
  </documentation>
  <references>
    <see type="page:BlockElement" relation="Extends">
      Block-level content element branch.
    </see>
  </references>
  <properties>
    <heading type="org.blockml.bml.type.Text">
      <documentation>
        Optional heading of this section. When omitted, generate the heading from
        the provided semantic information (purpose and related page/section context) and
        authoritative sources instead of leaving it empty.
      </documentation>
    </heading>
  </properties>
  <aggregations>
    <content type="page:BlockElement[]">
      <documentation>
        Ordered block-level children of this section.
      </documentation>
    </content>
  </aggregations>
</page:Section>
