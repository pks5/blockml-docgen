<!--BlockML DocGen — documentation image

  FQN: org.blockml.bml.docgen.page.Image-->
<page:Image xmlns="http://blockml.org/bml"
  xmlns:page="org.blockml.bml.docgen.page"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    page:ContentElement
  </baseType>
  <is>
    A block-level image in documentation content
  </is>
  <documentation>
    Block-level image referenced by src. Placed among other ContentElements in Section.content
    or DocPage.content — not as an inline run inside Paragraph.
  </documentation>
  <references>
    <see type="page:ContentElement" relation="Extends">
      Block-level leaf content under BlockElement.
    </see>
  </references>
  <properties>
    <src type="org.blockml.bml.type.Text">
      <documentation>
        Image URL or site-relative path.
      </documentation>
    </src>
  </properties>
</page:Image>
