<!--BlockML DocGen — abstract block-level page content element

  FQN: org.blockml.bml.docgen.page.BlockElement-->
<page:BlockElement xmlns="http://blockml.org/bml"
  xmlns:page="org.blockml.bml.docgen.page"
  xmlns:dcore="org.blockml.bml.docgen.core">

  <baseType>
    dcore:PageElement
  </baseType>
  <is>
    A block-level documentation content element
  </is>
  <documentation>
    Abstract base for vertical/flow content: sections and ContentElements (paragraphs, lists,
    code blocks, images). Aggregated as DocPage.content, Section.content, and ListItem.content.
  </documentation>
  <abstract>
    true
  </abstract>
  <references>
    <see type="dcore:PageElement" relation="Extends">
      Shared page content element root.
    </see>
    <see type="page:ContentElement" relation="SeeAlso">
      Leaf content specializations under this branch.
    </see>
    <see type="page:Section" relation="SeeAlso">
      Structural grouping of BlockElements.
    </see>
    <see type="page:Navigation" relation="SeeAlso">
      In-page navigation list of page links.
    </see>
  </references>
</page:BlockElement>
