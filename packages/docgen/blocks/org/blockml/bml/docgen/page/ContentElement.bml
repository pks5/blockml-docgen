<!--BlockML DocGen — abstract block-level leaf content element

  FQN: org.blockml.bml.docgen.page.ContentElement-->
<page:ContentElement xmlns="http://blockml.org/bml"
  xmlns:page="org.blockml.bml.docgen.page"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    page:BlockElement
  </baseType>
  <is>
    A block-level documentation content element that carries readable content
  </is>
  <documentation>
    Abstract base for block-level elements that hold documentation content themselves —
    paragraphs, lists, code blocks, and images. Distinct from Section, which is structural
    grouping of BlockElements without being leaf content. message states what claim or idea
    this element should convey to the reader; contrast with purpose on PageElement (why the
    element exists for the renderer).
    
    detailLevel and weight are optional TypeReferenceEntity links into the DetailLevel and Weight
    branches. Semantic annotations (SupportingPoint, ReaderOutcome, Scope, Exclusion) are owned
    as direct aggregation instances — not type references. authoritativeSources and audiences are
    TypeReferenceEntity catalogues; role is a TypeReference to a ContentRole.
  </documentation>
  <abstract>
    true
  </abstract>
  <references>
    <see type="page:BlockElement" relation="Extends">
      Block-level content element branch.
    </see>
    <see type="dcore:PageElement" relation="ContrastsWith">
      purpose — why the element exists for the renderer; message — what it should convey.
    </see>
    <see type="page:Section" relation="ContrastsWith">
      Structural container — still a BlockElement, not ContentElement.
    </see>
    <see type="dcore:DetailLevel" relation="Requires">
      Target branch for detailLevel TypeReferenceEntity.
    </see>
    <see type="dcore:Weight" relation="Requires">
      Target branch for weight TypeReferenceEntity.
    </see>
    <see type="sem:SupportingPoint" relation="Requires">
      Owned supporting-point instances on supportingPoints.
    </see>
    <see type="core:Block" relation="Requires">
      Authoritative source Blocks via authoritativeSources TypeReferenceEntity aggregation.
    </see>
    <see type="dcore:ContentRole" relation="Requires">
      Content role via role TypeReference property.
    </see>
    <see type="page:Paragraph" relation="SeeAlso">
      Inline-run paragraph content.
    </see>
    <see type="page:List" relation="SeeAlso">
      List of items.
    </see>
  </references>
  <properties>
    <message type="type:Text">
      <documentation>
        What statement or idea this element should convey to the reader. Distinct
        from purpose on PageElement (why the element exists for the renderer).
      </documentation>
    </message>
    <detailLevel type="type:TypeReference(dcore:DetailLevel)">
      <documentation>
        Optional reference to how detailed this content should be explained
        (concrete levels in org.blockml.bml.docgen.level).
      </documentation>
    </detailLevel>
    <role type="type:TypeReference(dcore:ContentRole)">
      <documentation>
        Type reference to the rhetorical or content role of this element.
      </documentation>
    </role>
    <weight type="type:TypeReference(dcore:Weight)">
      <documentation>
        Optional reference to how important this content is for understanding
        (concrete weights in org.blockml.bml.docgen.weight).
      </documentation>
    </weight>
  </properties>
  <aggregations>
    <rules type="type:TypeReferenceEntity(dcore:Rule)[]">
      <documentation>
        Rules that apply to this element. They apply in addition to the global rules on
        Documentation and the rules on the Page that owns this element.
      </documentation>
    </rules>
    <authoritativeSources type="type:TypeReferenceEntity(core:Block)[]">
      <documentation>
        Authoritative source Blocks this content relates to.
      </documentation>
    </authoritativeSources>
    <audiences type="type:TypeReferenceEntity(dcore:Audience)[]">
      <documentation>
        Type references to audiences this content is intended for.
      </documentation>
    </audiences>
    <supportingPoints type="sem:SupportingPoint[]">
      <documentation>
        Owned supporting points that reinforce this element’s message — direct
        instances, not type references.
      </documentation>
    </supportingPoints>
    <readerOutcomes type="sem:ReaderOutcome[]">
      <documentation>
        Owned reader outcomes this element should produce — direct instances, not
        type references.
      </documentation>
    </readerOutcomes>
    <learningObjectives type="sem:LearningObjective[]">
      <documentation>
        Owned learning objectives this element should produce — direct instances, not
        type references.
      </documentation>
    </learningObjectives>
    <scopes type="sem:Scope[]">
      <documentation>
        Owned in-scope bounds for this element — direct instances, not type
        references.
      </documentation>
    </scopes>
    <exclusions type="sem:Exclusion[]">
      <documentation>
        Owned out-of-scope exclusions for this element — direct instances, not type
        references.
      </documentation>
    </exclusions>
  </aggregations>
</page:ContentElement>
