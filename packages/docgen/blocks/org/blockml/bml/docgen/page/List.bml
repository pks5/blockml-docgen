<!--BlockML DocGen — documentation list

  FQN: org.blockml.bml.docgen.page.List-->
<page:List xmlns="http://blockml.org/bml"
  xmlns:page="org.blockml.bml.docgen.page"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    page:ContentElement
  </baseType>
  <is>
    A list of documentation items
  </is>
  <documentation>
    Ordered collection of ListItem children. Each item may carry a short text label and nested
    block content.
  </documentation>
  <references>
    <see type="page:ContentElement" relation="Extends">
      Block-level leaf content under BlockElement.
    </see>
    <see type="page:ListItem" relation="Requires">
      List item type for items aggregation.
    </see>
  </references>
  <aggregations>
    <items type="page:ListItem[]">
      <documentation>
        Ordered list items.
      </documentation>
    </items>
  </aggregations>
</page:List>
