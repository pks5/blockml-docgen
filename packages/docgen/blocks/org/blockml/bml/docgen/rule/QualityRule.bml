<!--BlockML DocGen — a documentation quality rule

  FQN: org.blockml.bml.docgen.rule.QualityRule-->
<rule:QualityRule xmlns="http://blockml.org/bml"
  xmlns:rule="org.blockml.bml.docgen.rule"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    dcore:Rule
  </baseType>
  <is>
    A documentation quality rule
  </is>
  <documentation>
    Defines overarching quality requirements that evaluate documentation as a whole. Quality Rules govern characteristics such as clarity, completeness, consistency, correctness, maintainability, and audience suitability. Unlike specialized rule types, Quality Rules combine multiple quality aspects and provide criteria for assessing the overall quality of documentation.
    
    Distinction in one sentence: How good is the documentation overall?
  </documentation>
  <references>
    <see type="dcore:Rule" relation="Extends">
      Documentation-generation rule branch under DocElement.
    </see>
  </references>
</rule:QualityRule>
