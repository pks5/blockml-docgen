<!--BlockML DocGen — a documentation learning rule

  FQN: org.blockml.bml.docgen.rule.LearningRule-->
<rule:LearningRule xmlns="http://blockml.org/bml"
  xmlns:rule="org.blockml.bml.docgen.rule"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    dcore:Rule
  </baseType>
  <is>
    A documentation learning rule
  </is>
  <documentation>
    Defines requirements for the educational progression of documentation. Learning Rules govern prerequisite knowledge, concept introduction, learning objectives, and the logical order in which information should be presented to support understanding. They focus on how readers acquire knowledge, rather than on the documentation structure or wording.
    
    Distinction in one sentence: How is knowledge taught?
  </documentation>
  <references>
    <see type="dcore:Rule" relation="Extends">
      Documentation-generation rule branch under DocElement.
    </see>
  </references>
</rule:LearningRule>
