<!--BlockML DocGen — Context content role

  FQN: org.blockml.bml.docgen.role.Context-->
<role:Context xmlns="http://blockml.org/bml"
  xmlns:role="org.blockml.bml.docgen.role"
  xmlns:dcore="org.blockml.bml.docgen.core">

  <baseType>
    dcore:ContentRole
  </baseType>
  <is>
    A content role that situates a topic in a larger frame
  </is>
  <documentation>
    Situates a topic in a larger frame — background, preconditions, or embedding — without
    itself explaining the central concept. Useful when background is needed without turning
    it into the primary claim.
    
    Distinguishes from Lead (opens), and Explanation (explains substantively).
    
    Typical rules: provide embedding or background only; avoid becoming the main technical
    explanation; keep secondary to the page message.
  </documentation>
  <references>
    <see type="dcore:ContentRole" relation="Extends">
      Rhetorical / content-role branch root.
    </see>
    <see type="role:Lead" relation="ContrastsWith">
      Lead opens; Context situates within an ongoing argument.
    </see>
    <see type="role:Explanation" relation="ContrastsWith">
      Explanation explains substantively; Context only frames.
    </see>
  </references>
  <properties>
    <displayName override="true">
      <value>Context</value>
    </displayName>
    <defaultDetailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </defaultDetailLevel>
    <defaultWeight override="true">
      <value>org.blockml.bml.docgen.weight.Supporting</value>
    </defaultWeight>
    <allowsNewConcepts override="true">
      <value>false</value>
    </allowsNewConcepts>
  </properties>
</role:Context>
