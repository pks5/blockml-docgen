<!--BlockML DocGen — Example content role

  FQN: org.blockml.bml.docgen.role.Example-->
<role:Example xmlns="http://blockml.org/bml"
  xmlns:role="org.blockml.bml.docgen.role"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:level="org.blockml.bml.docgen.level"
  xmlns:weight="org.blockml.bml.docgen.weight">

  <baseType>
    dcore:ContentRole
  </baseType>
  <is>
    A content role that illustrates a prior concept with a concrete case
  </is>
  <documentation>
    Illustrates a previously described concept with a concrete case — code, BML snippet,
    configuration, small scenario, or counter-example. Shows rather than introducing new
    theory.
    
    Distinguishes from Instruction (which directs the reader to act), and Reference (which
    supplies complete technical facts).
    
    Typical rules: name clearly what is illustrated; keep small; introduce no extra
    concepts; match the current detail level.
  </documentation>
  <references>
    <see type="dcore:ContentRole" relation="Extends">
      Rhetorical / content-role branch root.
    </see>
    <see type="role:Instruction" relation="ContrastsWith">
      Instruction tells the reader what to do; Example only shows.
    </see>
    <see type="role:Reference" relation="ContrastsWith">
      Reference is complete lookup material; Example is a small illustration.
    </see>
  </references>
  <properties>
    <displayName override="true">
      <value>Example</value>
    </displayName>
    <defaultDetailLevel override="true">
      <value>level:Practical</value>
    </defaultDetailLevel>
    <defaultWeight override="true">
      <value>weight:Supporting</value>
    </defaultWeight>
    <allowsNewConcepts override="true">
      <value>false</value>
    </allowsNewConcepts>
  </properties>
</role:Example>
