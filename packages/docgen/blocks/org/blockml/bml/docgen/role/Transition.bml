<!--BlockML DocGen — Transition content role

  FQN: org.blockml.bml.docgen.role.Transition-->
<role:Transition xmlns="http://blockml.org/bml"
  xmlns:role="org.blockml.bml.docgen.role"
  xmlns:dcore="org.blockml.bml.docgen.core">

  <baseType>
    dcore:ContentRole
  </baseType>
  <is>
    A content role that bridges two sections or thought steps
  </is>
  <documentation>
    Bridges two sections or thought steps. Carries little subject matter of its own; helps
    the reader see why the next topic follows. Example: with the BML/BOM distinction
    established, the next step is to look at the principles BlockML is designed around.
    
    Distinguishes from Lead (opens a unit) — Transition connects within an ongoing
    narrative.
    
    Typical rules: short; no new concepts; clear link between what came before and what
    follows.
  </documentation>
  <references>
    <see type="dcore:ContentRole" relation="Extends">
      Rhetorical / content-role branch root.
    </see>
    <see type="role:Lead" relation="ContrastsWith">
      Lead opens a page or section; Transition connects within the narrative.
    </see>
  </references>
  <properties>
    <displayName override="true">
      <value>Transition</value>
    </displayName>
    <defaultDetailLevel override="true">
      <value>org.blockml.bml.docgen.level.Overview</value>
    </defaultDetailLevel>
    <defaultWeight override="true">
      <value>org.blockml.bml.docgen.weight.Optional</value>
    </defaultWeight>
    <allowsNewConcepts override="true">
      <value>false</value>
    </allowsNewConcepts>
  </properties>
</role:Transition>
