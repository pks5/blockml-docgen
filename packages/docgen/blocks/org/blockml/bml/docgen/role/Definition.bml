<!--BlockML DocGen — Definition content role

  FQN: org.blockml.bml.docgen.role.Definition-->
<role:Definition xmlns="http://blockml.org/bml"
  xmlns:role="org.blockml.bml.docgen.role"
  xmlns:dcore="org.blockml.bml.docgen.core">

  <baseType>
    dcore:ContentRole
  </baseType>
  <is>
    A content role that introduces a term or bounded concept precisely
  </is>
  <documentation>
    Introduces a term or clearly bounded concept with a precise statement. Answers: What is
    X? Prefer a stable, concise conceptual claim. Derive substance from
    authoritativeSources; do not invent a competing definition.
    
    Distinguishes from Explanation (how or why something works) and Context (where something
    fits).
    
    Typical rules: exactly one primary concept; no unnecessary implementation detail; prefer
    canonical terminology; keep short and unambiguous.
  </documentation>
  <references>
    <see type="dcore:ContentRole" relation="Extends">
      Rhetorical / content-role branch root.
    </see>
    <see type="role:Explanation" relation="ContrastsWith">
      Explanation covers how/why; Definition states what X is.
    </see>
    <see type="role:Context" relation="ContrastsWith">
      Context situates; Definition names the concept itself.
    </see>
  </references>
  <properties>
    <displayName override="true">
      <value>Definition</value>
    </displayName>
    <defaultDetailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </defaultDetailLevel>
    <defaultWeight override="true">
      <value>org.blockml.bml.docgen.weight.Primary</value>
    </defaultWeight>
    <allowsNewConcepts override="true">
      <value>true</value>
    </allowsNewConcepts>
  </properties>
</role:Definition>
