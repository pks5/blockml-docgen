<!--BlockML DocGen — Rationale content role

  FQN: org.blockml.bml.docgen.role.Rationale-->
<role:Rationale xmlns="http://blockml.org/bml"
  xmlns:role="org.blockml.bml.docgen.role"
  xmlns:dcore="org.blockml.bml.docgen.core">

  <baseType>
    dcore:ContentRole
  </baseType>
  <is>
    A content role that explains a deliberate design decision
  </is>
  <documentation>
    Explains the deliberate design decision behind a concept. Answers: Why was it done
    exactly this way? Examples include why BOM is lossless, why domain semantics live in the
    renderer, why BlockML uses XML, or why TypeReferenceEntity is preferred over certain
    associations.
    
    Distinguishes from Explanation (how something works) by focusing on why it was
    intentionally designed that way.
  </documentation>
  <references>
    <see type="dcore:ContentRole" relation="Extends">
      Rhetorical / content-role branch root.
    </see>
    <see type="role:Explanation" relation="ContrastsWith">
      Explanation describes behaviour; Rationale justifies the design.
    </see>
  </references>
  <properties>
    <displayName override="true">
      <value>Rationale</value>
    </displayName>
    <defaultDetailLevel override="true">
      <value>org.blockml.bml.docgen.level.Detailed</value>
    </defaultDetailLevel>
    <defaultWeight override="true">
      <value>org.blockml.bml.docgen.weight.Supporting</value>
    </defaultWeight>
    <allowsNewConcepts override="true">
      <value>false</value>
    </allowsNewConcepts>
  </properties>
</role:Rationale>
