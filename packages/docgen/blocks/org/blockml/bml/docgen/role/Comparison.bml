<!--BlockML DocGen — Comparison content role

  FQN: org.blockml.bml.docgen.role.Comparison-->
<role:Comparison xmlns="http://blockml.org/bml"
  xmlns:role="org.blockml.bml.docgen.role"
  xmlns:dcore="org.blockml.bml.docgen.core">

  <baseType>
    dcore:ContentRole
  </baseType>
  <is>
    A content role that systematically contrasts two or more concepts
  </is>
  <documentation>
    Systematically contrasts two or more concepts. Answers: What differs between X and Y?
    When does X apply versus Y? What are the shared and distinct aspects?
    
    Use Comparison when the contrast itself is the core of the element — not merely when an
    Explanation mentions a difference in passing.
    
    Typical rules: at least two subjects; a clear comparison dimension; no unsystematic
    mixing; establish the shared basis first.
  </documentation>
  <references>
    <see type="dcore:ContentRole" relation="Extends">
      Rhetorical / content-role branch root.
    </see>
    <see type="role:Explanation" relation="ContrastsWith">
      Explanation may mention differences; Comparison centres the contrast.
    </see>
  </references>
  <properties>
    <displayName override="true">
      <value>Comparison</value>
    </displayName>
    <defaultDetailLevel override="true">
      <value>org.blockml.bml.docgen.level.Practical</value>
    </defaultDetailLevel>
    <defaultWeight override="true">
      <value>org.blockml.bml.docgen.weight.Primary</value>
    </defaultWeight>
    <allowsNewConcepts override="true">
      <value>false</value>
    </allowsNewConcepts>
  </properties>
</role:Comparison>
