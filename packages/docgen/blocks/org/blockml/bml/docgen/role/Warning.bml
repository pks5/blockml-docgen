<!--BlockML DocGen — Warning content role

  FQN: org.blockml.bml.docgen.role.Warning-->
<role:Warning xmlns="http://blockml.org/bml"
  xmlns:role="org.blockml.bml.docgen.role"
  xmlns:dcore="org.blockml.bml.docgen.core">

  <baseType>
    dcore:ContentRole
  </baseType>
  <is>
    A content role that highlights information whose neglect causes harm
  </is>
  <documentation>
    Highlights information whose neglect can cause misunderstanding, errors, or harmful
    results. Examples: a composition must not be authored standalone; do not use deprecated
    syntax; this configuration cannot be overridden safely.
    
    A merely important statement is not automatically a Warning — there should be a concrete
    negative consequence. For purely informative callouts, a separate Note role may be added
    later; Warning is sufficient for V1.
  </documentation>
  <references>
    <see type="dcore:ContentRole" relation="Extends">
      Rhetorical / content-role branch root.
    </see>
    <see type="role:Explanation" relation="ContrastsWith">
      Explanation informs; Warning signals a concrete negative consequence.
    </see>
  </references>
  <properties>
    <displayName override="true">
      <value>Warning</value>
    </displayName>
    <defaultDetailLevel override="true">
      <value>org.blockml.bml.docgen.level.Practical</value>
    </defaultDetailLevel>
    <defaultWeight override="true">
      <value>org.blockml.bml.docgen.weight.Primary</value>
    </defaultWeight>
    <allowsNewConcepts override="true">
      <value>false</value>
    </allowsNewConcepts>
  </properties>
</role:Warning>
