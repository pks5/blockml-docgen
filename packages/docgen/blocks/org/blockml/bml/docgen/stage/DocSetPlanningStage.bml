<!--
  BlockML DocGen — DocSet planning manifestation stage

  FQN: org.blockml.bml.docgen.stage.DocSetPlanningStage
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:stage="org.blockml.bml.docgen.stage"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:dplan="org.blockml.bml.docgen.plan">

  <name>DocSetPlanningStage</name>
  <type>stage:DocSetPlanningStage</type>
  <baseType>dcore:ManifestationStage</baseType>
  <is>The manifestation stage that creates an abstract DocSetPlan</is>

  <documentation>
    Creates or updates the DocSetPlan as an abstract content-structure sketch.

    This stage builds a nested rootPageGroupPlan tree of PageGroupPlans and PagePlans. Together
    they define the intended topical structure of the documentation set before any concrete Pages
    or PageGroups are created. Each PagePlan carries a Block name relative to pageBasePackage and comma-separated scopes
    that describe page content; routing keys, paths, and concrete Block identities are not
    decided here.

    Responsibilities include:
    - defining the root PageGroupPlan and nested PageGroupPlan / PagePlan structure
    - defining intended Pages via PagePlan entries (name relative to pageBasePackage + scopes)
    - defining the ordering and overall progression of the DocSet
    - defining DocSet-level authoritativeSources (SSOT Blocks for the planned set)
    - updating an existing abstract plan when the topical structure should change

    This stage does not create or modify concrete Pages, PageGroups, or Page mappings.
  </documentation>

  <references>
    <see type="dcore:ManifestationStage" relation="Extends">
      Manifestation-stage classification axis under DocElement.
    </see>
    <see type="dplan:DocSetPlan" relation="Requires">
      Abstract DocSet model created or updated in this stage.
    </see>
    <see type="dplan:PageGroupPlan" relation="Requires">
      Root and nested page-group plans on DocSetPlan.rootPageGroupPlan.
    </see>
    <see type="dplan:PagePlan" relation="Requires">
      Nested abstract planned pages within the rootPageGroupPlan tree.
    </see>
    <see type="stage:DocSetStructuringStage" relation="SeeAlso">
      Next stage — translates the abstract plan into concrete Pages and PageGroups.
    </see>
  </references>

</block>
