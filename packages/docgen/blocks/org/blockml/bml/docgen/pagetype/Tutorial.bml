<!--BlockML DocGen — Tutorial page type

  FQN: org.blockml.bml.docgen.pagetype.Tutorial-->
<ptype:Tutorial xmlns="http://blockml.org/bml"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:role="org.blockml.bml.docgen.role"
  xmlns:level="org.blockml.bml.docgen.level">

  <baseType>
    dcore:PageType
  </baseType>
  <is>
    A page type that teaches through a structured learning experience
  </is>
  <documentation>
    Teaches the reader through a structured learning experience. Guides through a sequence
    of steps while gradually introducing new concepts. Primary goal is learning rather than
    reference.
    
    Typical characteristics: sequential; beginner friendly; hands-on; builds knowledge
    incrementally.
    
    Examples: Build your first Block; Create your first Machine.
    
    Core question: How do I learn this step by step?
  </documentation>
  <references>
    <see type="dcore:PageType" relation="Extends">
      Editorial page-kind branch root.
    </see>
    <see type="ptype:HowTo" relation="ContrastsWith">
      HowTo assumes basics and solves one task; Tutorial teaches incrementally.
    </see>
    <see type="ptype:Introduction" relation="ContrastsWith">
      Introduction orients; Tutorial practices.
    </see>
  </references>
  <properties>
    <displayName override="true">
      <value>Tutorial</value>
    </displayName>
    <defaultDetailLevel override="true">
      <value>level:Practical</value>
    </defaultDetailLevel>
    <maxPrimaryConcepts override="true">
      <value>3</value>
    </maxPrimaryConcepts>
  </properties>
  <aggregations>
    <recommendedRoles override="true">
      <composition>
        <role:Lead />
        <role:Instruction />
        <role:Example />
        <role:Explanation />
        <role:Summary />
      </composition>
    </recommendedRoles>
    <forbiddenRoles override="true">
      <composition>
        <role:Reference />
      </composition>
    </forbiddenRoles>
  </aggregations>
</ptype:Tutorial>
