<!--BlockML DocGen — Reference page type

  FQN: org.blockml.bml.docgen.pagetype.Reference-->
<ptype:Reference xmlns="http://blockml.org/bml"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:role="org.blockml.bml.docgen.role">

  <baseType>
    dcore:PageType
  </baseType>
  <is>
    A page type that provides complete factual reference information
  </is>
  <documentation>
    Provides complete factual reference information — APIs, syntax, properties, members,
    options, mappings, or rules — as precisely and completely as possible. Optimized for
    lookup rather than learning.
    
    Typical characteristics: exhaustive; precise; structured; little narrative.
    
    Examples: Block definition; Aggregation member; Expression language; XML schema.
    
    Core question: Which complete facts apply?
  </documentation>
  <references>
    <see type="dcore:PageType" relation="Extends">
      Editorial page-kind branch root.
    </see>
    <see type="ptype:Introduction" relation="ContrastsWith">
      Introduction orients; Reference is exhaustive lookup.
    </see>
    <see type="ptype:Guide" relation="ContrastsWith">
      Guide narrates architecture and advice; Reference lists facts.
    </see>
    <see type="ptype:Concept" relation="ContrastsWith">
      Concept builds understanding; Reference catalogues facts.
    </see>
  </references>
  <properties>
    <displayName override="true">
      <value>Reference</value>
    </displayName>
    <defaultDetailLevel override="true">
      <value>org.blockml.bml.docgen.level.Reference</value>
    </defaultDetailLevel>
    <maxPrimaryConcepts override="true">
      <value>1</value>
    </maxPrimaryConcepts>
  </properties>
  <aggregations>
    <recommendedRoles override="true">
      <composition>
        <role:Reference />
        <role:Warning />
        <role:Example />
      </composition>
    </recommendedRoles>
    <forbiddenRoles override="true">
      <composition>
        <role:Lead />
      </composition>
    </forbiddenRoles>
  </aggregations>
</ptype:Reference>
