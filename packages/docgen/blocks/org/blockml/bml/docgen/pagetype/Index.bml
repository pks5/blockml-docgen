<!--BlockML DocGen — Index page type

  FQN: org.blockml.bml.docgen.pagetype.Index-->
<ptype:Index xmlns="http://blockml.org/bml"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:role="org.blockml.bml.docgen.role">

  <baseType>
    dcore:PageType
  </baseType>
  <is>
    A page type that provides structured navigation to documentation resources
  </is>
  <documentation>
    Provides structured navigation to documentation resources. Organizes and links content
    without introducing significant new information.
    
    Typical characteristics: navigation; categorized links; overview.
    
    Examples: Documentation Home; Language Index; API Index.
    
    Core question: Where do I find the information?
  </documentation>
  <references>
    <see type="dcore:PageType" relation="Extends">
      Editorial page-kind branch root.
    </see>
    <see type="ptype:Introduction" relation="ContrastsWith">
      Introduction builds a mental model; Index only navigates.
    </see>
    <see type="ptype:Guide" relation="ContrastsWith">
      Guide explains a subject; Index catalogues entry points.
    </see>
  </references>
  <properties>
    <displayName override="true">
      <value>Index</value>
    </displayName>
    <defaultDetailLevel override="true">
      <value>org.blockml.bml.docgen.level.Overview</value>
    </defaultDetailLevel>
    <maxPrimaryConcepts override="true">
      <value>0</value>
    </maxPrimaryConcepts>
  </properties>
  <aggregations>
    <recommendedRoles override="true">
      <composition>
        <role:Lead />
        <role:Summary />
      </composition>
    </recommendedRoles>
    <forbiddenRoles override="true">
      <composition>
        <role:Reference />
        <role:Instruction />
      </composition>
    </forbiddenRoles>
  </aggregations>
</ptype:Index>
