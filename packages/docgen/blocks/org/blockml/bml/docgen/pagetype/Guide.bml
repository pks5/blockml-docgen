<!--BlockML DocGen — Guide page type

  FQN: org.blockml.bml.docgen.pagetype.Guide-->
<ptype:Guide xmlns="http://blockml.org/bml"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:role="org.blockml.bml.docgen.role">

  <baseType>
    dcore:PageType
  </baseType>
  <is>
    A page type that explains a larger topic spanning multiple concepts
  </is>
  <documentation>
    Explains a larger topic by combining multiple concepts into a coherent narrative. Helps
    readers understand a broader subject that spans multiple pages or concepts. Emphasizes
    understanding and decision-making rather than individual definitions.
    
    Typical characteristics: multiple concepts; recommendations; architecture; best
    practices.
    
    Examples: Documentation Architecture; Modeling Strategies; Library Design.
    
    Core question: How do several concepts fit together?
  </documentation>
  <references>
    <see type="dcore:PageType" relation="Extends">
      Editorial page-kind branch root.
    </see>
    <see type="ptype:Concept" relation="ContrastsWith">
      Concept deepens one idea; Guide relates many.
    </see>
    <see type="ptype:Reference" relation="ContrastsWith">
      Reference is lookup; Guide advises and structures.
    </see>
  </references>
  <properties>
    <displayName override="true">
      <value>Guide</value>
    </displayName>
    <defaultDetailLevel override="true">
      <value>org.blockml.bml.docgen.level.Detailed</value>
    </defaultDetailLevel>
    <maxPrimaryConcepts override="true">
      <value>5</value>
    </maxPrimaryConcepts>
  </properties>
  <aggregations>
    <recommendedRoles override="true">
      <composition>
        <role:Explanation />
        <role:Context />
        <role:Comparison />
        <role:Rationale />
        <role:Summary />
      </composition>
    </recommendedRoles>
  </aggregations>
</ptype:Guide>
