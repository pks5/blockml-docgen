<!--BlockML DocGen — Concept page type

  FQN: org.blockml.bml.docgen.pagetype.Concept-->
<ptype:Concept xmlns="http://blockml.org/bml"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:role="org.blockml.bml.docgen.role"
  xmlns:level="org.blockml.bml.docgen.level">

  <baseType>
    dcore:PageType
  </baseType>
  <is>
    A page type that explains a single concept in depth
  </is>
  <documentation>
    Explains a single concept in depth — one idea, principle, or abstraction. Covers what
    the concept is, why it exists, and how it relates to other concepts, without necessarily
    teaching implementation.
    
    Typical characteristics: one central concept; conceptual explanation; relationships;
    rationale; examples.
    
    Examples: Block; Renderer; Capability; Aggregation.
    
    Core question: What is this concept?
  </documentation>
  <references>
    <see type="dcore:PageType" relation="Extends">
      Editorial page-kind branch root.
    </see>
    <see type="ptype:Introduction" relation="ContrastsWith">
      Introduction orients a topic; Concept deepens one idea.
    </see>
    <see type="ptype:Guide" relation="ContrastsWith">
      Guide weaves multiple concepts; Concept centres one.
    </see>
    <see type="ptype:Reference" relation="ContrastsWith">
      Reference lists facts; Concept builds understanding.
    </see>
  </references>
  <properties>
    <displayName override="true">
      <value>Concept</value>
    </displayName>
    <defaultDetailLevel override="true">
      <value>level:Detailed</value>
    </defaultDetailLevel>
    <maxPrimaryConcepts override="true">
      <value>1</value>
    </maxPrimaryConcepts>
  </properties>
  <aggregations>
    <recommendedRoles override="true">
      <composition>
        <role:Definition />
        <role:Explanation />
        <role:Rationale />
        <role:Example />
        <role:Comparison />
      </composition>
    </recommendedRoles>
  </aggregations>
</ptype:Concept>
