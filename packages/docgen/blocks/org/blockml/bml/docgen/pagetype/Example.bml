<!--BlockML DocGen — Example page type

  FQN: org.blockml.bml.docgen.pagetype.Example-->
<ptype:Example xmlns="http://blockml.org/bml"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:role="org.blockml.bml.docgen.role"
  xmlns:level="org.blockml.bml.docgen.level">

  <baseType>
    dcore:PageType
  </baseType>
  <is>
    A page type that demonstrates concepts through concrete examples
  </is>
  <documentation>
    Demonstrates concepts through concrete examples. Primarily illustrates existing concepts
    rather than introducing new ones.
    
    Typical characteristics: practical; concrete; reusable; explanatory.
    
    Examples: Minimal Block; Machine example; Complete Library example.
    
    Core question: What does this look like concretely?
  </documentation>
  <references>
    <see type="dcore:PageType" relation="Extends">
      Editorial page-kind branch root.
    </see>
    <see type="ptype:Tutorial" relation="ContrastsWith">
      Tutorial teaches a path; Example showcases a case.
    </see>
    <see type="ptype:HowTo" relation="ContrastsWith">
      HowTo solves a task; Example demonstrates without prescribing steps.
    </see>
    <see type="ptype:Concept" relation="ContrastsWith">
      Concept defines the idea; Example shows it applied.
    </see>
  </references>
  <properties>
    <displayName override="true">
      <value>Example</value>
    </displayName>
    <defaultDetailLevel override="true">
      <value>level:Practical</value>
    </defaultDetailLevel>
    <maxPrimaryConcepts override="true">
      <value>2</value>
    </maxPrimaryConcepts>
  </properties>
  <aggregations>
    <recommendedRoles override="true">
      <composition>
        <role:Example />
        <role:Explanation />
        <role:Lead />
      </composition>
    </recommendedRoles>
    <forbiddenRoles override="true">
      <composition>
        <role:Reference />
      </composition>
    </forbiddenRoles>
  </aggregations>
</ptype:Example>
