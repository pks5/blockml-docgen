<!--BlockML DocGen — documentation generation rule

  FQN: org.blockml.bml.docgen.core.Rule-->
<dcore:Rule xmlns="http://blockml.org/bml"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:rule="org.blockml.bml.docgen.rule"
  xmlns:type="org.blockml.bml.type"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <baseType>
    workflow:InstructionRule
  </baseType>
  <is>
    A documentation-generation rule
  </is>
  <documentation>
    Named rule that guides how documentation is authored or generated. Extends
    workflow:InstructionRule so instances may be composed into Task.rules and applied
    during Task.run. name identifies the rule; summary states its intent briefly;
    instructions holds the actionable directive for authors and generators. Concrete
    specializations live in org.blockml.bml.docgen.rule (StructureRule, ContentRule,
    SourceRule, TerminologyRule, LearningRule, StyleRule, QualityRule). Assign each
    concrete rule to the Tasks of the manifestation phase where it constrains the work
    (planning, structuring, authoring, or rendering).
  </documentation>
  <abstract>
    true
  </abstract>
  <references>
    <see type="workflow:InstructionRule" relation="Extends">
      Workflow rule branch — apply() follows instructions during Task.run.
    </see>
    <see type="dcore:DocSet" relation="SeeAlso">
      DocSet that may own or apply rules.
    </see>
    <see type="dcore:ManifestationStage" relation="SeeAlso">
      Manifestation phases whose Tasks should compose the rules that apply there.
    </see>
    <see type="rule:StructureRule" relation="SeeAlso">
      Structural organization requirements.
    </see>
    <see type="rule:QualityRule" relation="SeeAlso">
      Overarching quality requirements across dimensions.
    </see>
  </references>
  <properties>
    <name type="type:Text">
      <documentation>
        Stable name of this rule.
      </documentation>
    </name>
    <summary type="type:Text">
      <documentation>
        Short statement of what this rule requires or prefers.
      </documentation>
    </summary>
  </properties>
</dcore:Rule>
