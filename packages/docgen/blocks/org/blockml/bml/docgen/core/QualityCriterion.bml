<!--BlockML DocGen — a documentation quality criterion

  FQN: org.blockml.bml.docgen.core.QualityCriterion-->
<dcore:QualityCriterion xmlns="http://blockml.org/bml"
  xmlns:dcore="org.blockml.bml.docgen.core">

  <baseType>
    dcore:DocElement
  </baseType>
  <is>
    A quality criterion for documentation
  </is>
  <documentation>
    Defines a criterion used to judge documentation quality (clarity, completeness, accuracy,
    consistency, …). Useful for generation checks and editorial standards — not a page layout
    element.
  </documentation>
  <references>
    <see type="dcore:DocElement" relation="Extends">
      Semantic base for all docgen domain Blocks (except Library / README).
    </see>
  </references>
  <properties>
    <displayName type="org.blockml.bml.type.Text">
      <documentation>
        Stable human-readable display name of this definitional semantic element (for
        catalogue identity, linking, and generation).
      </documentation>
    </displayName>
  </properties>
</dcore:QualityCriterion>
