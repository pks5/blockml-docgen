<!--BlockML DocGen — abstract semantic annotation metadata

  FQN: org.blockml.bml.docgen.core.SemanticAnnotation-->
<dcore:SemanticAnnotation xmlns="http://blockml.org/bml"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:type="org.blockml.bml.type"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <baseType>
    dcore:DocElement
  </baseType>
  <is>
    An annotative editorial or knowledge metadata element
  </is>
  <documentation>
    Abstract branch for annotative semantic metadata bound to a page or content argument.
    Concrete specializations live in org.blockml.bml.docgen.semantic — ReaderOutcome,
    SupportingPoint, Scope, Exclusion, LearningObjective, and LearningPath. These mark intent,
    boundaries, learning goals, and paths rather than defining reusable catalogue meanings.
  </documentation>
  <abstract>
    true
  </abstract>
  <references>
    <see type="dcore:DocElement" relation="Extends">
      Semantic base for all docgen domain Blocks (except Library / README).
    </see>
    <see type="dcore:Audience" relation="ContrastsWith">
      Definitional catalogue metadata — not page-bound annotations.
    </see>
    <see type="sem:ReaderOutcome" relation="SeeAlso">
      What the reader should know or be able to do afterward.
    </see>
    <see type="sem:LearningObjective" relation="SeeAlso">
      Explicit learning objective for the documentation.
    </see>
    <see type="workflow:AuthorativeSourceSet" relation="Requires">
      Authoritative source sets via authoritativeSources aggregation.
    </see>
  </references>
  <properties>
    <summary type="type:Text">
      <documentation>
        Short statement of what this annotation asserts — the editorial or knowledge
        claim itself, not reader-facing page copy.
      </documentation>
    </summary>
  </properties>
  <aggregations>
    <authoritativeSources type="workflow:AuthorativeSourceSet[]">
      <documentation>
        Authoritative source sets this annotation relates to or elaborates.
      </documentation>
    </authoritativeSources>
  </aggregations>
</dcore:SemanticAnnotation>
