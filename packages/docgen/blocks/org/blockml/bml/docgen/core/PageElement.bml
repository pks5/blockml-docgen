<!--BlockML DocGen — abstract page content element

  FQN: org.blockml.bml.docgen.core.PageElement-->
<dcore:PageElement xmlns="http://blockml.org/bml"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:page="org.blockml.bml.docgen.page"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    dcore:DocElement
  </baseType>
  <is>
    A documentation page content element
  </is>
  <documentation>
    Abstract base for all documentation page content elements — block-level and inline. Concrete
    specializations live in org.blockml.bml.docgen.page (BlockElement, InlineElement, ListItem,
    Navigation, …). purpose describes why the element exists for the documentation renderer —
    it is renderer-facing metadata, not reader-facing page copy.
  </documentation>
  <abstract>
    true
  </abstract>
  <references>
    <see type="dcore:DocElement" relation="Extends">
      Semantic base for all docgen domain Blocks (except Library / README).
    </see>
    <see type="page:BlockElement" relation="SeeAlso">
      Block-level content specializations.
    </see>
    <see type="page:InlineElement" relation="SeeAlso">
      Inline content specializations.
    </see>
    <see type="page:Navigation" relation="SeeAlso">
      In-page navigation list of page links.
    </see>
  </references>
  <properties>
    <purpose type="org.blockml.bml.type.Text">
      <documentation>
        Purpose of this element for the documentation renderer — why it is present
        and what it should accomplish. Not reader-facing page copy.
      </documentation>
    </purpose>
  </properties>
</dcore:PageElement>
