<!--BlockML DocGen — Role of a content fragment in the documentation argument

  FQN: org.blockml.bml.docgen.core.ContentRole-->
<dcore:ContentRole xmlns="http://blockml.org/bml"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    dcore:DocElement
  </baseType>
  <is>
    Role of a content fragment in the documentation argument
  </is>
  <documentation>
    Labels how a piece of content functions rhetorically (definition, warning, example cue,
    bridge to next topic) independent of its PageElement layout type. Captures default detail
    level and weight for content in this role, whether new concepts may be introduced, and
    typical scope/exclusion bounds. Concrete roles live in org.blockml.bml.docgen.role
    (Lead, Definition, Explanation, …).
  </documentation>
  <references>
    <see type="dcore:DocElement" relation="Extends">
      Semantic base for all docgen domain Blocks (except Library / README).
    </see>
    <see type="dcore:DetailLevel" relation="Requires">
      Target branch for defaultDetailLevel.
    </see>
    <see type="dcore:Weight" relation="Requires">
      Target branch for defaultWeight.
    </see>
  </references>
  <properties>
    <displayName type="type:Text">
      <documentation>
        Stable human-readable display name of this definitional semantic element (for
        catalogue identity, linking, and generation).
      </documentation>
    </displayName>
    <defaultDetailLevel type="type:TypeReference(dcore:DetailLevel)">
      <documentation>
        Default detail level for content in this role (reference into the DetailLevel
        branch).
      </documentation>
    </defaultDetailLevel>
    <defaultWeight type="type:TypeReference(dcore:Weight)">
      <documentation>
        Default understanding weight for content in this role (reference into the
        Weight branch).
      </documentation>
    </defaultWeight>
    <allowsNewConcepts type="type:Boolean">
      <documentation>
        Whether content in this role may introduce concepts not yet established on
        the page.
      </documentation>
    </allowsNewConcepts>
  </properties>
  <aggregations>
    <scopes type="sem:Scope[]">
      <documentation>
        Owned Scope instances typical for this content role — direct instances, not
        type references.
      </documentation>
    </scopes>
    <exclusions type="sem:Exclusion[]">
      <documentation>
        Owned Exclusion instances for what this role must not cover — direct
        instances, not type references.
      </documentation>
    </exclusions>
  </aggregations>
</dcore:ContentRole>
