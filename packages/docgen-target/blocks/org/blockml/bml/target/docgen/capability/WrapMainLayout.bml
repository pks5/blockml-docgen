<!--DocGen Capability — WrapMainLayout
  FQN: org.blockml.bml.target.docgen.capability.WrapMainLayout-->
<dgcap:WrapMainLayout xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:dgcap="org.blockml.bml.target.docgen.capability"
  xmlns:dgconfig="org.blockml.bml.target.docgen.config"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Wrap a page body in DefaultMainLayout with DefaultTheme CSS and HighlightJs
  </is>
  <documentation>
    Produces a full HTML document: doctype, head with HighlightJs stylesheet
    then inline DefaultTheme CSS, header nav, main content slot, then
    highlight.min.js, the BlockML grammar, and highlightAll(). V1 always uses
    DefaultMainLayout, DefaultTheme, and HighlightJs.
  </documentation>
  <references>
    <see type="dgconfig:DefaultMainLayout" relation="Requires" />
    <see type="dgconfig:DefaultTheme" relation="Requires" />
    <see type="dgconfig:HighlightJs" relation="Requires" />
  </references>
  <properties>
    <title type="type:Text">
      <documentation>
        Document title (required).
      </documentation>
    </title>
    <bodyInner type="type:Text">
      <documentation>
        Page body HTML fragment (required).
      </documentation>
    </bodyInner>
    <result type="type:Text">
      <documentation>
        Full HTML document (required).
      </documentation>
    </result>
  </properties>
</dgcap:WrapMainLayout>
