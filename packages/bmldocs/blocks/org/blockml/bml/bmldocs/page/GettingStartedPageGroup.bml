<!--BlockML Documentation — Getting Started page group

  FQN: org.blockml.bml.bmldocs.page.GettingStartedPageGroup-->
<pgroup:GettingStartedPageGroup xmlns="http://blockml.org/bml"
  xmlns:pgroup="org.blockml.bml.bmldocs.page"
  xmlns:page="org.blockml.bml.bmldocs.page.docs"
  xmlns:dcore="org.blockml.bml.docgen.core">

  <baseType>
    dcore:PageGroup
  </baseType>
  <is>
    A documentation page group for Getting Started
  </is>
  <documentation>
    Page group corresponding to the “Getting Started” TOC section on blockml.org. pages lists the
    section’s leaf NavigationItem targets as page type references. parentGroup is
    DocsPageGroup.
  </documentation>
  <references>
    <see type="dcore:PageGroup" relation="Extends">
      Docgen page group base.
    </see>
    <see type="pgroup:DocsPageGroup" relation="Requires">
      Parent Documentation root page group.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Getting Started</value>
    </title>
    <parentGroup override="true">
      <value>pgroup:DocsPageGroup</value>
    </parentGroup>
  </properties>
  <aggregations>
    <pages override="true">
      <composition>
        <page:Intro />
        <page:FirstBlock />
        <page:FileAnatomy />
      </composition>
    </pages>
  </aggregations>
</pgroup:GettingStartedPageGroup>
