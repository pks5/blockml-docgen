<!--
  BlockML Documentation — Visibility basics

  FQN: org.blockml.bml.bmldocs.page.docs.VisibilityBasics
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:page="org.blockml.bml.bmldocs.page.docs"
  xmlns:docset="org.blockml.bml.bmldocs.docset"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:dlevel="org.blockml.bml.docgen.level"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:role="org.blockml.bml.docgen.role"
  xmlns:weight="org.blockml.bml.docgen.weight"
  xmlns:core="org.blockml.bml.core"
  xmlns:doc="org.blockml.bml.documentation">

  <name>VisibilityBasics</name>
  <type>page:VisibilityBasics</type>
  <baseType>docset:BmlDocPage</baseType>
  <is>A website intro to member visibility</is>

  <documentation>
    Marker page: public / protected / private naming prefixes for members and Sub-Blocks — short
    rules with examples.

    content is a structural scaffold only; generate prose and examples from referenced core
    documentation (doc:MemberVisibility).
  </documentation>

  <references>
    <see type="doc:MemberVisibility" relation="Requires">
      Primary content — visibility naming and access rules.
    </see>
  </references>

  <properties>
    <title override="true">
      <value>Visibility</value>
    </title>

    <purpose override="true">
      <value>
        Explain member and Sub-Block visibility as access control in the model.
      </value>
    </purpose>

    <detailLevel override="true">
      <value>
        dlevel:Introductory
      </value>
    </detailLevel>

    <pageType override="true">
      <value>
        ptype:Concept
      </value>
    </pageType>
  </properties>

  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <doc:MemberVisibility />
        <core:Block />
      </composition>
    </authoritativeSources>

    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>
            Treat visibility as model access control for members and Sub-Blocks, not as a
            renderer presentation setting.
          </summary>
          <authoritativeSources>
            <doc:MemberVisibility />
            <core:Block />
          </authoritativeSources>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>

    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>
            The reader can map public, protected, and private naming prefixes to access rules.
          </summary>
          <authoritativeSources>
            <doc:MemberVisibility />
          </authoritativeSources>
        </sem:ReaderOutcome>

        <sem:ReaderOutcome>
          <summary>
            The reader can explain that Renderers still receive the full Canonical BOM.
          </summary>
          <authoritativeSources>
            <doc:MemberVisibility />
          </authoritativeSources>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>

    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>
            Introduce visibility naming prefixes for members and Sub-Blocks, the three access
            levels, aggregation id reachability under those levels, and the distinction from
            renderer UI hiding.
          </summary>
          <authoritativeSources>
            <doc:MemberVisibility />
            <core:Block />
          </authoritativeSources>
        </sem:Scope>
      </composition>
    </scopes>

    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>
            Renderer UI hiding strategies.
          </summary>
          <reason>
            Visibility here is model access control, not target presentation tactics.
          </reason>
        </sem:Exclusion>

        <sem:Exclusion>
          <summary>
            Diagnostic codes.
          </summary>
          <reason>
            Diagnostic identifiers belong on reference and troubleshooting pages.
          </reason>
        </sem:Exclusion>
      </composition>
    </exclusions>

    <content override="true">
      <composition>

        <!-- 1. Lead -->

        <dpage:Section
          heading="Visibility is model access control"
          purpose="Orient readers that visibility is not renderer hiding">

          <content>
            <dpage:Paragraph
              purpose="Introduce visibility as BlockML access control">

              <role>role:Lead</role>

              <detailLevel>dlevel:Overview</detailLevel>

              <weight>weight:Primary</weight>

              <message>
                Visibility controls who may access members and Sub-Blocks in the model; it is
                not a setting for hiding UI in a Renderer.
              </message>

              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>
                    The same naming rules apply to ordinary members and nested Sub-Blocks.
                  </summary>
                  <authoritativeSources>
                    <doc:MemberVisibility />
                    <core:Block />
                  </authoritativeSources>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    Access meaning lives in the authored name prefix, not in target presentation
                    filters.
                  </summary>
                  <authoritativeSources>
                    <doc:MemberVisibility />
                  </authoritativeSources>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    Renderers still receive the full Canonical BOM even when members are private.
                  </summary>
                  <authoritativeSources>
                    <doc:MemberVisibility />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>

        <!-- 2. Naming and BOM -->

        <dpage:Section
          heading="Naming prefixes and the Canonical BOM"
          purpose="Explain how prefixes encode visibility and what Renderers still see">

          <content>

            <dpage:Paragraph
              purpose="Explain naming prefixes for public, protected, and private">

              <role>role:Explanation</role>

              <detailLevel>dlevel:Introductory</detailLevel>

              <weight>weight:Primary</weight>

              <message>
                Public names are unprefixed, protected names use a single underscore, and
                private names use a double underscore on members and Sub-Blocks.
              </message>

              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>
                    The prefix is part of the authored name and carries access meaning.
                  </summary>
                  <authoritativeSources>
                    <doc:MemberVisibility />
                  </authoritativeSources>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    Authors encode access intent in the name itself rather than in a separate
                    visibility attribute.
                  </summary>
                  <authoritativeSources>
                    <doc:MemberVisibility />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>

            <dpage:Paragraph
              purpose="Explain that Renderers still see the full Canonical BOM">

              <role>role:Explanation</role>

              <detailLevel>dlevel:Introductory</detailLevel>

              <weight>weight:Primary</weight>

              <message>
                Renderers still receive the full Canonical BOM; visibility restricts model
                access rules rather than stripping content from the BOM.
              </message>

              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>
                    Model access control and target UI hiding remain separate concerns.
                  </summary>
                  <authoritativeSources>
                    <doc:MemberVisibility />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>

              <exclusions>
                <sem:Exclusion>
                  <summary>
                    Renderer UI hiding strategies and presentation filters.
                  </summary>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>

          </content>
        </dpage:Section>

        <!-- 3. Access levels -->

        <dpage:Section
          heading="Access levels"
          purpose="Summarize public, protected, and private access">

          <content>

            <dpage:Paragraph
              purpose="Prepare the reader for the three access levels">

              <role>role:Transition</role>

              <detailLevel>dlevel:Overview</detailLevel>

              <weight>weight:Supporting</weight>

              <message>
                Three levels cover access inside and outside the enclosing definition and for
                derived Blocks.
              </message>
            </dpage:Paragraph>

            <dpage:List
              purpose="Present visibility levels as a concise summary">

              <role>role:Summary</role>

              <detailLevel>dlevel:Overview</detailLevel>

              <weight>weight:Primary</weight>

              <message>
                Three levels cover access inside and outside the enclosing definition.
              </message>

              <items>
                <dpage:ListItem
                  text="Public"
                  purpose="Explain public access">

                  <message>
                    Public members are accessible inside and outside the enclosing definition.
                  </message>
                </dpage:ListItem>

                <dpage:ListItem
                  text="Protected"
                  purpose="Explain protected access">

                  <message>
                    Protected members are accessible to the enclosing definition and derived
                    Blocks.
                  </message>
                </dpage:ListItem>

                <dpage:ListItem
                  text="Private"
                  purpose="Explain private access">

                  <message>
                    Private members are accessible only to the immediately declaring Block.
                  </message>
                </dpage:ListItem>
              </items>
            </dpage:List>

          </content>
        </dpage:Section>

        <!-- 4. Aggregation reachability -->

        <dpage:Section
          heading="Aggregation IDs follow visibility"
          purpose="Explain that composition bml:id reachability follows aggregation visibility">

          <content>

            <dpage:Paragraph
              purpose="Explain that aggregation visibility gates which bml:id values may be referenced">

              <role>role:Explanation</role>

              <detailLevel>dlevel:Introductory</detailLevel>

              <weight>weight:Primary</weight>

              <message>
                Aggregation-member visibility also controls which composition bml:id values may
                be referenced; there is no separate export flag on composition or bml:container.
              </message>

              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>
                    Reachability follows the aggregation member's visibility prefix, just as
                    ordinary member access does.
                  </summary>
                  <authoritativeSources>
                    <doc:MemberVisibility />
                  </authoritativeSources>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    Qualified cross-document id references need a public target aggregation and
                    a literal static bml:id.
                  </summary>
                  <authoritativeSources>
                    <doc:MemberVisibility />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>

              <exclusions>
                <sem:Exclusion>
                  <summary>
                    Diagnostic codes and renderer presentation tactics.
                  </summary>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>

            <dpage:Paragraph
              purpose="Prepare the reader for aggregation id reachability levels">

              <role>role:Transition</role>

              <detailLevel>dlevel:Overview</detailLevel>

              <weight>weight:Supporting</weight>

              <message>
                The same three visibility levels decide how far an aggregation id can be named.
              </message>
            </dpage:Paragraph>

            <dpage:List
              purpose="Present aggregation id reachability by visibility level">

              <role>role:Summary</role>

              <detailLevel>dlevel:Overview</detailLevel>

              <weight>weight:Primary</weight>

              <message>
                These levels decide how far composition ids remain reachable.
              </message>

              <items>
                <dpage:ListItem
                  text="Public"
                  purpose="Explain public aggregation id reachability">

                  <message>
                    Public aggregations allow cross-document qualified ids and unqualified ids
                    within permitted access.
                  </message>
                </dpage:ListItem>

                <dpage:ListItem
                  text="Protected"
                  purpose="Explain protected aggregation id reachability">

                  <message>
                    Protected aggregations keep ids reachable to the declaring Block and its
                    child Blocks in the same tree.
                  </message>
                </dpage:ListItem>

                <dpage:ListItem
                  text="Private"
                  purpose="Explain private aggregation id reachability">

                  <message>
                    Private aggregations keep ids reachable only inside the declaring Block
                    definition.
                  </message>
                </dpage:ListItem>
              </items>
            </dpage:List>

          </content>
        </dpage:Section>

        <!-- 5. Minimal example -->

        <dpage:Section
          heading="Named members at each level"
          purpose="Connect the prefixes to a small naming sketch">

          <content>

            <dpage:Paragraph
              purpose="Introduce property names that show the three visibility prefixes">

              <role>role:Explanation</role>

              <detailLevel>dlevel:Introductory</detailLevel>

              <weight>weight:Supporting</weight>

              <message>
                Ordinary property names such as myVar, _myVar, and __myVar show public,
                protected, and private prefixes in everyday authoring.
              </message>

              <exclusions>
                <sem:Exclusion>
                  <summary>
                    Diagnostic codes and renderer presentation tactics.
                  </summary>
                  <reason>
                    The example teaches naming prefixes, not diagnostics or UI filters.
                  </reason>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>

            <dpage:CodeBlock
              purpose="Illustrate myVar, _myVar, and __myVar with matching intent">

              <role>role:Example</role>

              <detailLevel>dlevel:Overview</detailLevel>

              <weight>weight:Supporting</weight>

              <message>
                Property names such as myVar, _myVar, and __myVar show the three visibility
                prefixes in ordinary authoring.
              </message>

              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>
                    Highlight the three property names that differ only by visibility prefix.
                  </summary>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    Keep surrounding Block structure minimal so the prefixes remain obvious.
                  </summary>
                </sem:SupportingPoint>
              </supportingPoints>

              <exclusions>
                <sem:Exclusion>
                  <summary>
                    Diagnostic codes and renderer presentation tactics.
                  </summary>
                </sem:Exclusion>
              </exclusions>
            </dpage:CodeBlock>

            <dpage:Paragraph
              purpose="Interpret the visibility prefixes on the example property names">

              <role>role:Explanation</role>

              <detailLevel>dlevel:Introductory</detailLevel>

              <weight>weight:Supporting</weight>

              <message>
                In the example, myVar is public, _myVar is protected for derived Blocks, and
                __myVar is private to the declaring Block alone.
              </message>

              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>
                    The underscore prefixes are part of the authored names and encode access,
                    not decoration.
                  </summary>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    The same prefix rules apply if those names were Sub-Blocks instead of
                    properties.
                  </summary>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>

          </content>
        </dpage:Section>

        <!-- 6. Continuation -->

        <dpage:Section
          heading="Continue with overrides and Sub-Blocks"
          purpose="Direct the reader to related conceptual pages">

          <content>
            <dpage:Navigation
              purpose="Continue the learning sequence">

              <title>Next</title>

              <items>
                <dpage:NavigationItem
                  label="Overrides"
                  summary="Learn how partial member overrides refine inherited members.">

                  <target>
                    page:OverridesBasics
                  </target>
                </dpage:NavigationItem>

                <dpage:NavigationItem
                  label="Sub-Blocks"
                  summary="See how nested types under a parent Block relate to visibility.">

                  <target>
                    page:SubBlocksIntro
                  </target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>

      </composition>
    </content>
  </aggregations>

</block>
