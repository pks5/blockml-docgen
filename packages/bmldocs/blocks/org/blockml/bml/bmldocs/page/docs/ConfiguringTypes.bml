<!--
  BlockML Documentation — Configuring ValueTypes

  FQN: org.blockml.bml.bmldocs.page.docs.ConfiguringTypes
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:page="org.blockml.bml.bmldocs.page.docs"
  xmlns:docset="org.blockml.bml.bmldocs.docset"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:dlevel="org.blockml.bml.docgen.level"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:role="org.blockml.bml.docgen.role"
  xmlns:weight="org.blockml.bml.docgen.weight"
  xmlns:core="org.blockml.bml.core"
  xmlns:doc="org.blockml.bml.documentation">

  <name>ConfiguringTypes</name>
  <type>page:ConfiguringTypes</type>
  <baseType>docset:BmlDocPage</baseType>
  <is>A website page for ValueType configuration</is>

  <documentation>
    Marker page: show Text{maxLength: …} style configuration and Constant(T) singleton domains
    with short examples readers can copy.
    content is a structural scaffold only; generate prose and examples from referenced core
    documentation (doc:ValueTypeConfiguration, doc:ConstantValueType).
  </documentation>

  <references>
    <see type="doc:ValueTypeConfiguration" relation="Requires">
      Primary content source — ValueType instance configuration on property types.
    </see>
    <see type="doc:ConstantValueType" relation="Requires">
      Primary content source — Constant(T){value: …} singleton domains.
    </see>
  </references>

  <properties>
    <title>
      <value>Configuring ValueTypes</value>
    </title>

    <purpose>
      <value>
        Explain curly-brace configuration of ValueType instances on properties.
      </value>
    </purpose>

    <detailLevel>
      <value>
        dlevel:Introductory
      </value>
    </detailLevel>

    <pageType>
      <value>
        ptype:Guide
      </value>
    </pageType>
  </properties>

  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <doc:ValueTypeConfiguration />
        <doc:ConstantValueType />
        <doc:TypeExpressions />
      </composition>
    </authoritativeSources>

    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>
            Understand curly-brace configuration as specializing a ValueType instance on a
            property, orthogonal to generic binding.
          </summary>
          <authoritativeSources>
            <doc:ValueTypeConfiguration />
            <doc:TypeExpressions />
          </authoritativeSources>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>

    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>
            The reader can explain that configuration applies to the property type instance
            and does not redefine the ValueType Block itself.
          </summary>
          <authoritativeSources>
            <doc:ValueTypeConfiguration />
          </authoritativeSources>
        </sem:ReaderOutcome>

        <sem:ReaderOutcome>
          <summary>
            The reader recognizes Constant singleton domains and how generic bind and value
            config work together.
          </summary>
          <authoritativeSources>
            <doc:ConstantValueType />
          </authoritativeSources>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>

    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>
            Explain curly-brace configuration of ValueType instances on properties, including
            Constant singleton domains.
          </summary>
          <authoritativeSources>
            <doc:ValueTypeConfiguration />
            <doc:ConstantValueType />
            <doc:TypeExpressions />
          </authoritativeSources>
        </sem:Scope>
      </composition>
    </scopes>

    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>
            Constraint branch inventory.
          </summary>
          <reason>
            Constraints are a separate topic and should not compete with configuration basics.
          </reason>
        </sem:Exclusion>

        <sem:Exclusion>
          <summary>
            Renderer mapping of configured types.
          </summary>
          <reason>
            Renderer interpretation belongs on renderer-focused pages.
          </reason>
        </sem:Exclusion>
      </composition>
    </exclusions>

    <content override="true">
      <composition>
        <!-- 1. Lead -->

        <dpage:Section
          heading="Curly-brace configuration on properties"
          purpose="Orient readers to ValueType instance configuration">

          <content>
            <dpage:Paragraph
              purpose="Introduce curly-brace configuration as orthogonal to generic binding">

              <role>role:Lead</role>

              <detailLevel>dlevel:Overview</detailLevel>

              <weight>weight:Primary</weight>

              <message>
                Curly-brace configuration specializes a ValueType instance on a property
                without redefining the type declaration itself.
              </message>

              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>
                    Configuration is written at the property type use site.
                  </summary>
                  <authoritativeSources>
                    <doc:ValueTypeConfiguration />
                  </authoritativeSources>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    Generic binding and value configuration are complementary mechanisms.
                  </summary>
                  <authoritativeSources>
                    <doc:TypeExpressions />
                    <doc:ValueTypeConfiguration />
                  </authoritativeSources>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    Everyday forms include Text{maxLength: …} and Decimal{precision: …, scale: …}.
                  </summary>
                  <authoritativeSources>
                    <doc:ValueTypeConfiguration />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>

        <!-- 2. Configuration on the type instance -->

        <dpage:Section
          heading="Configuration applies to the type instance"
          purpose="Establish where configuration attaches without rewriting the shared type">

          <content>
            <dpage:Paragraph
              purpose="Explain that config applies to the property type instance">

              <role>role:Explanation</role>

              <detailLevel>dlevel:Introductory</detailLevel>

              <weight>weight:Primary</weight>

              <message>
                Configuration attaches to the ValueType instance used on a property; it does
                not rewrite the shared ValueType Block definition.
              </message>

              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>
                    Different properties may configure the same ValueType differently.
                  </summary>
                  <authoritativeSources>
                    <doc:ValueTypeConfiguration />
                  </authoritativeSources>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    The named type remains the reusable semantic definition.
                  </summary>
                  <authoritativeSources>
                    <doc:ValueTypeConfiguration />
                  </authoritativeSources>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    Prefer inline configuration for type-intrinsic thresholds; keep Constraints
                    for contextual or composable rules.
                  </summary>
                  <authoritativeSources>
                    <doc:ValueTypeConfiguration />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>

              <exclusions>
                <sem:Exclusion>
                  <summary>
                    Constraint branch inventory and renderer mapping details.
                  </summary>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>
          </content>
        </dpage:Section>

        <!-- 3. Together with generics -->

        <dpage:Section
          heading="Together with generics"
          purpose="Explain that parentheses bind generics while braces configure the instance">

          <content>
            <dpage:Paragraph
              purpose="Explain that configuration may coexist with generics">

              <role>role:Explanation</role>

              <detailLevel>dlevel:Introductory</detailLevel>

              <weight>weight:Primary</weight>

              <message>
                Generic binding and curly-brace configuration may appear together on the
                same property type expression.
              </message>

              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>
                    Parentheses bind generic arguments; braces configure the resulting instance.
                  </summary>
                  <authoritativeSources>
                    <doc:TypeExpressions />
                    <doc:ValueTypeConfiguration />
                  </authoritativeSources>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    Multiplicity brackets apply after configuration on the same type reference.
                  </summary>
                  <authoritativeSources>
                    <doc:ValueTypeConfiguration />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>

              <exclusions>
                <sem:Exclusion>
                  <summary>
                    Full generics inheritance rules.
                  </summary>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>
          </content>
        </dpage:Section>

        <!-- 4. Constant details -->

        <dpage:Section
          heading="Constant singleton domains"
          purpose="Introduce Constant configuration surface points">

          <content>
            <dpage:Paragraph
              purpose="Introduce Constant(T){value: …} singleton domains">

              <role>role:Explanation</role>

              <detailLevel>dlevel:Introductory</detailLevel>

              <weight>weight:Primary</weight>

              <message>
                Constant describes a singleton domain by binding a type argument and
                configuring a fixed value.
              </message>

              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>
                    The singleton value is part of the configured type instance.
                  </summary>
                  <authoritativeSources>
                    <doc:ConstantValueType />
                  </authoritativeSources>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    Constant is especially useful as a union alternative for sentinel literals.
                  </summary>
                  <authoritativeSources>
                    <doc:ConstantValueType />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>

            <dpage:Paragraph
              purpose="Prepare the reader for the Constant surface-point summary">

              <role>role:Transition</role>

              <detailLevel>dlevel:Overview</detailLevel>

              <weight>weight:Supporting</weight>

              <message>
                Constant combines generic bind and value config on one type reference.
              </message>
            </dpage:Paragraph>

            <dpage:List
              purpose="Present Constant surface points as a concise summary">

              <role>role:Summary</role>

              <detailLevel>dlevel:Overview</detailLevel>

              <weight>weight:Primary</weight>

              <message>
                These points describe how Constant combines generic bind and value config.
              </message>

              <items>
                <dpage:ListItem
                  text="Generic bind"
                  purpose="Explain that parentheses bind generic T">

                  <message>
                    Parentheses bind the generic type argument of Constant.
                  </message>
                </dpage:ListItem>

                <dpage:ListItem
                  text="Value config"
                  purpose="Explain that braces set the singleton value">

                  <message>
                    Curly braces configure the singleton value for that Constant instance.
                  </message>
                </dpage:ListItem>

                <dpage:ListItem
                  text="Named constants"
                  purpose="Explain named singletons as alternatives">

                  <message>
                    Named constants can provide reusable singleton alternatives where defined.
                  </message>
                </dpage:ListItem>
              </items>
            </dpage:List>
          </content>
        </dpage:Section>

        <!-- 5. Example -->

        <dpage:Section
          heading="A configured property type"
          purpose="Connect the guide to a small configuration example">

          <content>
            <dpage:Paragraph
              purpose="Introduce a property with configured Text or Constant">

              <role>role:Explanation</role>

              <detailLevel>dlevel:Introductory</detailLevel>

              <weight>weight:Supporting</weight>

              <message>
                A short example shows a property type using curly-brace configuration,
                optionally with Constant.
              </message>

              <exclusions>
                <sem:Exclusion>
                  <summary>
                    Constraint inventories and renderer-specific mapping.
                  </summary>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>

            <dpage:CodeBlock
              purpose="Illustrate a complete Block with configured property types">

              <role>role:Example</role>

              <detailLevel>dlevel:Overview</detailLevel>

              <weight>weight:Supporting</weight>

              <message>
                Show a complete root Block whose property types use curly-brace configuration,
                such as Text{maxLength: …} or Constant(T){value: …}.
              </message>

              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>
                    Provide a complete Block so the configured type attributes sit on real
                    properties in a valid definition.
                  </summary>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    Highlight the braces that configure the ValueType instance, and when
                    Constant is used, also highlight the parentheses that bind T.
                  </summary>
                </sem:SupportingPoint>
              </supportingPoints>

              <exclusions>
                <sem:Exclusion>
                  <summary>
                    Full Constant catalogue and constraint branches.
                  </summary>
                </sem:Exclusion>
              </exclusions>
            </dpage:CodeBlock>

            <dpage:Paragraph
              purpose="Interpret the configuration braces and optional Constant bind in the example">

              <role>role:Explanation</role>

              <detailLevel>dlevel:Introductory</detailLevel>

              <weight>weight:Supporting</weight>

              <message>
                In the example, the braces specialize the property's ValueType instance; if
                Constant appears, the parentheses bind T while the braces supply the singleton
                value on that same reference.
              </message>

              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>
                    Notice that the named ValueType itself is unchanged; only this property's
                    type instance carries the configuration.
                  </summary>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    Parentheses and braces remain distinct mechanisms even when they appear
                    side by side on Constant.
                  </summary>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>

        <!-- 6. Navigation -->

        <dpage:Section
          heading="Continue with types and constraints"
          purpose="Direct the reader to related pages">

          <content>
            <dpage:Navigation
              purpose="Continue the type-system learning sequence">

              <title>Next</title>

              <items>
                <dpage:NavigationItem
                  label="Types at a glance"
                  summary="Return to the four ValueType kinds as the type-system entry point.">

                  <target>
                    page:TypesOverview
                  </target>
                </dpage:NavigationItem>

                <dpage:NavigationItem
                  label="Constraints"
                  summary="See how constraints further shape typed members.">

                  <target>
                    page:ConstraintsBasics
                  </target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>

      </composition>
    </content>
  </aggregations>

</block>
