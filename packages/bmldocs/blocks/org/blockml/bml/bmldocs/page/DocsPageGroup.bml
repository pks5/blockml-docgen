<!--BlockML Documentation — Documentation page group

  FQN: org.blockml.bml.bmldocs.page.DocsPageGroup-->
<pgroup:DocsPageGroup xmlns="http://blockml.org/bml"
  xmlns:pgroup="org.blockml.bml.bmldocs.page"
  xmlns:page="org.blockml.bml.bmldocs.page.docs"
  xmlns:dcore="org.blockml.bml.docgen.core">

  <baseType>
    dcore:PageGroup
  </baseType>
  <is>
    The Documentation page group for blockml.org docs
  </is>
  <documentation>
    Documentation subtree under RootPageGroup. title is “Documentation”; landingPage is
    TableOfContents. Does not list pages itself — child section PageGroups nest under this group
    via parentGroup.
  </documentation>
  <references>
    <see type="dcore:PageGroup" relation="Extends">
      Docgen page group base.
    </see>
    <see type="pgroup:RootPageGroup" relation="Requires">
      Top-level site root page group.
    </see>
    <see type="page:TableOfContents" relation="Requires">
      Landing page for this documentation group.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Documentation</value>
    </title>
    <parentGroup override="true">
      <value>pgroup:RootPageGroup</value>
    </parentGroup>
    <landingPage override="true">
      <value>page:TableOfContents</value>
    </landingPage>
  </properties>
</pgroup:DocsPageGroup>
