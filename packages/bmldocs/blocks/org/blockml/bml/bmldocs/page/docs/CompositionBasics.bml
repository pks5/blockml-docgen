<!--
  BlockML Documentation — Composition basics

  FQN: org.blockml.bml.bmldocs.page.docs.CompositionBasics
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:page="org.blockml.bml.bmldocs.page.docs"
  xmlns:docset="org.blockml.bml.bmldocs.docset"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:dlevel="org.blockml.bml.docgen.level"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:role="org.blockml.bml.docgen.role"
  xmlns:weight="org.blockml.bml.docgen.weight"
  xmlns:core="org.blockml.bml.core"
  xmlns:doc="org.blockml.bml.documentation">

  <name>CompositionBasics</name>
  <type>page:CompositionBasics</type>
  <baseType>docset:BmlDocPage</baseType>
  <is>A website intro to composition</is>

  <documentation>
    Marker page: how aggregations get filled — definition composition vs instance fill — with a
    tiny nested example. Defer advanced directives and ID reachability to deeper pages.

    content is a structural scaffold only; generate prose and examples from referenced core
    documentation (doc:CompositionModel).
  </documentation>

  <references>
    <see type="doc:CompositionModel" relation="Requires">
      Primary content — aggregation fill, placement, and recursion.
    </see>
  </references>

  <properties>
    <title>
      <value>Composition</value>
    </title>

    <purpose>
      <value>
        Explain how aggregations receive child Block instances through composition.
      </value>
    </purpose>

    <detailLevel>
      <value>
        dlevel:Introductory
      </value>
    </detailLevel>

    <pageType>
      <value>
        ptype:Concept
      </value>
    </pageType>
  </properties>

  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <doc:CompositionModel />
        <doc:BlockAndInstance />
        <core:Block />
      </composition>
    </authoritativeSources>

    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>
            Explain how aggregations receive child Block instances through composition.
          </summary>
          <authoritativeSources>
            <doc:CompositionModel />
            <doc:BlockAndInstance />
            <core:Block />
          </authoritativeSources>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>

    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>
            The reader can contrast definition-time composition with instance-time aggregation fill.
          </summary>
          <authoritativeSources>
            <doc:CompositionModel />
            <doc:BlockAndInstance />
          </authoritativeSources>
        </sem:ReaderOutcome>

        <sem:ReaderOutcome>
          <summary>
            The reader can recall placement, override, and recursion rules at a high level.
          </summary>
          <authoritativeSources>
            <doc:CompositionModel />
          </authoritativeSources>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>

    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>
            Introduce composition as aggregation fill, contrast definition and instance paths,
            and retain a short set of placement rules.
          </summary>
          <authoritativeSources>
            <doc:CompositionModel />
            <doc:BlockAndInstance />
            <core:Block />
          </authoritativeSources>
        </sem:Scope>
      </composition>
    </scopes>

    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>
            Full override merge algorithm.
          </summary>
          <reason>
            Merge details belong on overrides and reference pages.
          </reason>
        </sem:Exclusion>

        <sem:Exclusion>
          <summary>
            Annotation and directive containers.
          </summary>
          <reason>
            Directives need dedicated pages and would distract from aggregation fill.
          </reason>
        </sem:Exclusion>

        <sem:Exclusion>
          <summary>
            Validator error codes.
          </summary>
          <reason>
            Diagnostic identifiers belong on troubleshooting and reference pages.
          </reason>
        </sem:Exclusion>
      </composition>
    </exclusions>

    <content override="true">
      <composition>
        <!-- 1. Lead -->

        <dpage:Section
          heading="Filling aggregations"
          purpose="State that composition is how aggregations receive child Block instances">

          <content>
            <dpage:Paragraph
              purpose="Introduce composition as aggregation fill">

              <role>role:Lead</role>

              <detailLevel>dlevel:Overview</detailLevel>

              <weight>weight:Primary</weight>

              <message>
                Composition is how aggregations receive child Block instances.
              </message>

              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>
                    Child Blocks nest under an aggregation member rather than floating free.
                  </summary>
                  <authoritativeSources>
                    <doc:CompositionModel />
                  </authoritativeSources>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    Definition-time and instance-time fill use different surface forms for the
                    same idea.
                  </summary>
                  <authoritativeSources>
                    <doc:CompositionModel />
                    <doc:BlockAndInstance />
                  </authoritativeSources>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    A few placement rules keep nesting predictable before overrides go deeper.
                  </summary>
                  <authoritativeSources>
                    <doc:CompositionModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>

        <!-- 2. Definition vs instance fill -->

        <dpage:Section
          heading="Definition composition versus instance fill"
          purpose="Contrast definition-time composition with instance-time aggregation fill">

          <content>

            <dpage:Paragraph
              purpose="Explain composition nested inside aggregations on definitions">

              <role>role:Explanation</role>

              <detailLevel>dlevel:Introductory</detailLevel>

              <weight>weight:Primary</weight>

              <message>
                On definitions, child instances nest inside a composition member of the aggregation.
              </message>

              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>
                    The composition wrapper marks definition-time children of that aggregation.
                  </summary>
                  <authoritativeSources>
                    <doc:CompositionModel />
                    <doc:BlockAndInstance />
                  </authoritativeSources>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    Those children are instances of other Block types nested under the parent
                    definition.
                  </summary>
                  <authoritativeSources>
                    <doc:CompositionModel />
                    <doc:BlockAndInstance />
                  </authoritativeSources>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    Definition composition is authored once on the type and shared by later uses.
                  </summary>
                  <authoritativeSources>
                    <doc:CompositionModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>

            <dpage:Paragraph
              purpose="Explain direct aggregation fill on instances">

              <role>role:Explanation</role>

              <detailLevel>dlevel:Introductory</detailLevel>

              <weight>weight:Primary</weight>

              <message>
                On instances, aggregations are filled directly by member name — without a
                composition wrapper.
              </message>

              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>
                    Instance fill uses the aggregation name as the container for children.
                  </summary>
                  <authoritativeSources>
                    <doc:CompositionModel />
                    <doc:BlockAndInstance />
                  </authoritativeSources>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    There is no composition wrapper on instances — the aggregation element
                    itself holds the children.
                  </summary>
                  <authoritativeSources>
                    <doc:CompositionModel />
                  </authoritativeSources>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    The same child types can appear in either path; only the placement form differs.
                  </summary>
                  <authoritativeSources>
                    <doc:CompositionModel />
                    <doc:BlockAndInstance />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>

          </content>
        </dpage:Section>

        <!-- 3. Placement rules -->

        <dpage:Section
          heading="Placement rules to remember"
          purpose="Summarize placement, override, and recursion rules">

          <content>

            <dpage:Paragraph
              purpose="Prepare the reader for the placement rules summary">

              <role>role:Transition</role>

              <detailLevel>dlevel:Overview</detailLevel>

              <weight>weight:Supporting</weight>

              <message>
                A few placement rules keep composition predictable once both fill paths are clear.
              </message>
            </dpage:Paragraph>

            <dpage:List
              purpose="Rules to retain from doc:CompositionModel">

              <role>role:Summary</role>

              <detailLevel>dlevel:Overview</detailLevel>

              <weight>weight:Primary</weight>

              <message>
                A few placement rules keep composition predictable.
              </message>

              <items>
                <dpage:ListItem
                  text="Placement"
                  purpose="composition must nest inside an aggregation — never standalone">

                  <message>
                    A composition belongs inside an aggregation; it is never a free-standing root.
                  </message>
                </dpage:ListItem>

                <dpage:ListItem
                  text="Overrides"
                  purpose="Inherited aggregation overrides need override=&quot;true&quot;">

                  <message>
                    Overriding an inherited aggregation requires an explicit override marker.
                  </message>
                </dpage:ListItem>

                <dpage:ListItem
                  text="Recursion"
                  purpose="Nested aggregations make recursive structures first-class">

                  <message>
                    Nested aggregations make recursive Block structures first-class.
                  </message>
                </dpage:ListItem>
              </items>
            </dpage:List>

          </content>
        </dpage:Section>

        <!-- 4. Filling an aggregation -->

        <dpage:Section
          heading="Filling an aggregation"
          purpose="Show a definition-time composition and the instance-time equivalent">

          <content>

            <dpage:Paragraph
              purpose="Introduce a tiny nested fill example">

              <role>role:Explanation</role>

              <detailLevel>dlevel:Introductory</detailLevel>

              <weight>weight:Supporting</weight>

              <message>
                A short example shows the same children declared at definition time and filled
                at instance time.
              </message>

              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>
                    Definition-time composition nests children under a composition member.
                  </summary>
                  <authoritativeSources>
                    <doc:CompositionModel />
                  </authoritativeSources>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    Instance-time fill places the same child kinds directly under the aggregation.
                  </summary>
                  <authoritativeSources>
                    <doc:CompositionModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>

            <dpage:CodeBlock
              purpose="Aggregation with composition children using qualified Block tags">

              <role>role:Example</role>

              <detailLevel>dlevel:Overview</detailLevel>

              <weight>weight:Supporting</weight>

              <message>
                Qualified Block tags appear as composition children under the aggregation.
              </message>

              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>
                    Highlight an aggregation that contains a composition wrapper with nested
                    child Block instances.
                  </summary>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    Optionally contrast the same aggregation filled directly on an instance
                    without a composition wrapper.
                  </summary>
                </sem:SupportingPoint>
              </supportingPoints>

              <exclusions>
                <sem:Exclusion>
                  <summary>
                    Override merge algorithms, directives, and validator codes.
                  </summary>
                </sem:Exclusion>
              </exclusions>
            </dpage:CodeBlock>

            <dpage:Paragraph
              purpose="Interpret the aggregation, composition wrapper, and nested children">

              <role>role:Explanation</role>

              <detailLevel>dlevel:Introductory</detailLevel>

              <weight>weight:Supporting</weight>

              <message>
                In the definition path, the aggregation owns a composition member and the
                nested qualified Block tags inside it are the child instances; on an instance,
                those same children sit directly under the aggregation name.
              </message>

              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>
                    Notice that composition is never a free-standing root — it always nests
                    inside the aggregation being filled.
                  </summary>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    The contrast shows one conceptual fill with two surface forms, matching
                    the earlier definition-versus-instance explanation.
                  </summary>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>

            <dpage:Image
              purpose="Diagram: definition composition vs instance aggregation fill">

              <role>role:Example</role>

              <detailLevel>dlevel:Overview</detailLevel>

              <weight>weight:Supporting</weight>

              <message>
                Definition composition and instance fill place the same children differently.
              </message>
            </dpage:Image>

          </content>
        </dpage:Section>

        <!-- 5. Aggregation versus association -->

        <dpage:Section
          heading="Aggregation versus association"
          purpose="Contrast composition fill on aggregations with association references">

          <content>

            <dpage:Paragraph
              purpose="Explain that composition fills aggregations that own nested children">

              <role>role:Explanation</role>

              <detailLevel>dlevel:Introductory</detailLevel>

              <weight>weight:Primary</weight>

              <message>
                Aggregation members are the containers composition fills: child instances nest
                under the aggregation because the parent owns that structure.
              </message>

              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>
                    Definition composition and instance fill both target aggregations, not
                    free-floating children.
                  </summary>
                  <authoritativeSources>
                    <doc:CompositionModel />
                    <doc:BlockAndInstance />
                  </authoritativeSources>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    Nested aggregations can recurse because ownership of children stays inside
                    the aggregation model.
                  </summary>
                  <authoritativeSources>
                    <doc:CompositionModel />
                  </authoritativeSources>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    The earlier example's composition wrapper and direct fill both answer the
                    same aggregation-ownership question.
                  </summary>
                  <authoritativeSources>
                    <doc:CompositionModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>

            <dpage:Paragraph
              purpose="Contrast associations as references that are not composition fill">

              <role>role:Explanation</role>

              <detailLevel>dlevel:Introductory</detailLevel>

              <weight>weight:Primary</weight>

              <message>
                Associations relate Blocks without nesting those related Blocks as composition
                children under an aggregation.
              </message>

              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>
                    An association points to related types or instances; it does not use the
                    composition-wrapper fill path taught above.
                  </summary>
                  <authoritativeSources>
                    <doc:BlockAndInstance />
                    <core:Block />
                  </authoritativeSources>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    Keep the contrast light: choose aggregation when children belong inside the
                    parent structure, and association when the link should not be composition fill.
                  </summary>
                  <authoritativeSources>
                    <doc:CompositionModel />
                    <doc:BlockAndInstance />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>

              <exclusions>
                <sem:Exclusion>
                  <summary>
                    Full association meta-model detail, override merge, and directive containers.
                  </summary>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>

          </content>
        </dpage:Section>

        <!-- 6. Continuation -->

        <dpage:Section
          heading="Continue nesting and practice"
          purpose="Direct the reader to Sub-Blocks and Author a new Block">

          <content>
            <dpage:Navigation
              purpose="Continue the introductory learning sequence">

              <title>Next</title>

              <items>
                <dpage:NavigationItem
                  label="Sub-Blocks"
                  summary="Learn how nested Block types are declared and referenced.">

                  <target>
                    page:SubBlocksIntro
                  </target>
                </dpage:NavigationItem>

                <dpage:NavigationItem
                  label="Author a new Block"
                  summary="Put the core ideas into practice with a small new Block.">

                  <target>
                    page:AuthorNewBlockGuide
                  </target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>

      </composition>
    </content>
  </aggregations>

</block>
