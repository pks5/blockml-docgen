<!--
  BlockML Documentation — Your first Block

  FQN: org.blockml.bml.bmldocs.page.docs.FirstBlock
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:page="org.blockml.bml.bmldocs.page.docs"
  xmlns:docset="org.blockml.bml.bmldocs.docset"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:dlevel="org.blockml.bml.docgen.level"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:role="org.blockml.bml.docgen.role"
  xmlns:weight="org.blockml.bml.docgen.weight"
  xmlns:core="org.blockml.bml.core"
  xmlns:doc="org.blockml.bml.documentation">

  <name>FirstBlock</name>
  <type>page:FirstBlock</type>
  <baseType>docset:BmlDocPage</baseType>
  <is>A first-Block walkthrough for website readers</is>

  <documentation>
    Marker page: hands-on first contact — what a Block definition looks like and how definition,
    instance, and composition fit together. Prefer a small worked example over full theory.
    content is a structural scaffold only; generate prose and examples from referenced core
    documentation (doc:BlockAndInstance, doc:DefinitionModel).
  </documentation>

  <references>
    <see type="doc:BlockAndInstance" relation="Requires">
      Primary content — definition, instance, and composition mental model.
    </see>
    <see type="doc:DefinitionModel" relation="Requires">
      Primary content — is, members, and documentation on definitions.
    </see>
  </references>

  <properties>
    <title override="true">
      <value>Your first Block</value>
    </title>

    <purpose override="true">
      <value>
        Walk a new reader through their first Block definition and the definition/instance distinction.
      </value>
    </purpose>

    <detailLevel override="true">
      <value>
        dlevel:Introductory
      </value>
    </detailLevel>

    <pageType override="true">
      <value>
        ptype:Tutorial
      </value>
    </pageType>
  </properties>

  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <doc:BlockAndInstance />
        <doc:DefinitionModel />
        <core:Block />
      </composition>
    </authoritativeSources>

    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>
            Understand the distinction between a Block definition and a Block instance.
          </summary>
          <authoritativeSources>
            <doc:BlockAndInstance />
          </authoritativeSources>
        </sem:LearningObjective>

        <sem:LearningObjective>
          <summary>
            Recognize the main member kinds that appear on a first Block definition.
          </summary>
          <authoritativeSources>
            <doc:DefinitionModel />
          </authoritativeSources>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>

    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>
            The reader can sketch a minimal Block definition with identity and one property.
          </summary>
          <authoritativeSources>
            <core:Block />
            <doc:DefinitionModel />
          </authoritativeSources>
        </sem:ReaderOutcome>

        <sem:ReaderOutcome>
          <summary>
            The reader can explain definition versus instance in one sentence.
          </summary>
          <authoritativeSources>
            <doc:BlockAndInstance />
          </authoritativeSources>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>

    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>
            First-contact walkthrough of a Block definition for website readers.
          </summary>
          <authoritativeSources>
            <doc:BlockAndInstance />
            <doc:DefinitionModel />
            <core:Block />
          </authoritativeSources>
        </sem:Scope>
      </composition>
    </scopes>

    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>
            Full Definition meta-model.
          </summary>
          <reason>
            This page introduces only the members a first author will meet.
          </reason>
        </sem:Exclusion>

        <sem:Exclusion>
          <summary>
            Runtime OOP semantics.
          </summary>
          <reason>
            The Class/Object analogy is conceptual only and must not imply runtime objects.
          </reason>
        </sem:Exclusion>

        <sem:Exclusion>
          <summary>
            Validator diagnostics.
          </summary>
          <reason>
            Diagnostic identifiers belong on reference and troubleshooting pages.
          </reason>
        </sem:Exclusion>

        <sem:Exclusion>
          <summary>
            Full composition rules.
          </summary>
          <reason>
            Composition has a dedicated page after this walkthrough.
          </reason>
        </sem:Exclusion>
      </composition>
    </exclusions>

    <content override="true">
      <composition>
        <!-- 1. Lead -->

        <dpage:Section
          heading="Start with a Block definition"
          purpose="Orient readers authoring their first Block definition">

          <content>
            <dpage:Paragraph
              purpose="State audience: readers authoring their first Block definition">

              <role>role:Lead</role>

              <detailLevel>dlevel:Overview</detailLevel>

              <weight>weight:Primary</weight>

              <message>
                This walkthrough shows what a first Block definition looks like and how
                definition and instance relate before deeper theory.
              </message>

              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>
                    Prefer a small worked example over a full Definition meta-model tour.
                  </summary>
                  <authoritativeSources>
                    <doc:DefinitionModel />
                    <doc:BlockAndInstance />
                  </authoritativeSources>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    Readers leave able to sketch identity, is, and one property on a root Block.
                  </summary>
                  <authoritativeSources>
                    <core:Block />
                    <doc:DefinitionModel />
                  </authoritativeSources>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    Definition versus instance is introduced here and deepened on later pages.
                  </summary>
                  <authoritativeSources>
                    <doc:BlockAndInstance />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>

        <!-- 2. Definition and instance -->

        <dpage:Section
          heading="Definition and instance"
          purpose="Establish the Block definition versus Block instance distinction">

          <content>
            <dpage:Paragraph
              purpose="Explain the Class/Object analogy from doc:BlockAndInstance without implying runtime OOP">

              <role>role:Explanation</role>

              <detailLevel>dlevel:Introductory</detailLevel>

              <weight>weight:Primary</weight>

              <message>
                A Block definition is like a Class and a Block instance is like an Object,
                but the analogy stays conceptual and does not imply runtime OOP.
              </message>

              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>
                    The definition describes the reusable shape and meaning of a Block type.
                  </summary>
                  <authoritativeSources>
                    <doc:BlockAndInstance />
                  </authoritativeSources>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    An instance is a concrete use of that definition with specific values.
                  </summary>
                  <authoritativeSources>
                    <doc:BlockAndInstance />
                  </authoritativeSources>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    The analogy helps authors navigate roles without importing language-runtime
                    object semantics.
                  </summary>
                  <authoritativeSources>
                    <doc:BlockAndInstance />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>

              <exclusions>
                <sem:Exclusion>
                  <summary>
                    Runtime object models, inheritance mechanics, and language-runtime mapping.
                  </summary>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>

            <dpage:Paragraph
              purpose="Distinguish block documents (definitions) from composition instances">

              <role>role:Explanation</role>

              <detailLevel>dlevel:Introductory</detailLevel>

              <weight>weight:Primary</weight>

              <message>
                A .bml document typically authors a Block definition, while composition holds
                instances of other Blocks inside aggregations.
              </message>

              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>
                    Root documents declare named Block types for reuse.
                  </summary>
                  <authoritativeSources>
                    <doc:BlockAndInstance />
                  </authoritativeSources>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    Nested composition places instances where a parent aggregation expects them.
                  </summary>
                  <authoritativeSources>
                    <doc:BlockAndInstance />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>

        <!-- 3. Members -->

        <dpage:Section
          heading="Members you will meet"
          purpose="Preview the Definition branch members readers will meet first">

          <content>
            <dpage:Paragraph
              purpose="Introduce is, documentation, and member kinds from doc:DefinitionModel">

              <role>role:Transition</role>

              <detailLevel>dlevel:Overview</detailLevel>

              <weight>weight:Supporting</weight>

              <message>
                A first definition usually starts with identity and is, then adds a few
                familiar member kinds.
              </message>

              <exclusions>
                <sem:Exclusion>
                  <summary>
                    Deep DefinitionModel detail beyond the first-contact member kinds.
                  </summary>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>

            <dpage:List
              purpose="Member kinds to preview on a first definition">

              <role>role:Summary</role>

              <detailLevel>dlevel:Overview</detailLevel>

              <weight>weight:Primary</weight>

              <message>
                These three member kinds appear most often on early Block definitions.
              </message>

              <items>
                <dpage:ListItem
                  text="Properties"
                  purpose="Properties hold typed values">

                  <message>
                    Properties declare named, typed values on the Block.
                  </message>
                </dpage:ListItem>

                <dpage:ListItem
                  text="Aggregations"
                  purpose="Aggregations hold child Block instances">

                  <message>
                    Aggregations hold child Block instances in composition.
                  </message>
                </dpage:ListItem>

                <dpage:ListItem
                  text="Capabilities"
                  purpose="Capabilities express behaviour">

                  <message>
                    Capabilities express behaviour the Block can offer.
                  </message>
                </dpage:ListItem>
              </items>
            </dpage:List>
          </content>
        </dpage:Section>

        <!-- 4. Worked example -->

        <dpage:Section
          heading="A tiny worked example"
          purpose="Connect the walkthrough to a minimal Block definition">

          <content>
            <dpage:Paragraph
              purpose="Describe a minimal worked example preferring practice over full theory">

              <role>role:Explanation</role>

              <detailLevel>dlevel:Introductory</detailLevel>

              <weight>weight:Supporting</weight>

              <message>
                A tiny first Block needs identity fields, a short is statement, and one
                property before other members are introduced.
              </message>

              <exclusions>
                <sem:Exclusion>
                  <summary>
                    Aggregations, associations, capabilities, constraints, and versioning.
                  </summary>
                  <reason>
                    The example should stay minimal and practice-oriented.
                  </reason>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>

            <dpage:CodeBlock
              purpose="Minimal Block with name, type, baseType, is, and one property">

              <role>role:Example</role>

              <detailLevel>dlevel:Overview</detailLevel>

              <weight>weight:Supporting</weight>

              <message>
                Illustrate a minimal root Block with name, type, baseType, is, and one property.
              </message>

              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>
                    Highlight the root identity fields name, type, and baseType together with
                    the short is statement.
                  </summary>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    Highlight a single named property under properties as the first member kind.
                  </summary>
                </sem:SupportingPoint>
              </supportingPoints>

              <exclusions>
                <sem:Exclusion>
                  <summary>
                    Other members beyond a single property.
                  </summary>
                </sem:Exclusion>
              </exclusions>
            </dpage:CodeBlock>

            <dpage:Paragraph
              purpose="Interpret the worked example's definition fields and single property">

              <role>role:Explanation</role>

              <detailLevel>dlevel:Introductory</detailLevel>

              <weight>weight:Supporting</weight>

              <message>
                The root document is the Block definition: name, type, and baseType identify
                it, is states what it is in one sentence, and the single property is the first
                concrete member on that type.
              </message>

              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>
                    Notice that this file authors a definition, not an instance — instances
                    appear later inside aggregations on other Blocks.
                  </summary>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    The property demonstrates a typed value on the definition without yet
                    introducing aggregations or capabilities.
                  </summary>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>

        <!-- 5. is and documentation -->

        <dpage:Section
          heading="is and documentation"
          purpose="Separate the short is statement and documentation from ordinary members">

          <content>

            <dpage:Paragraph
              purpose="Explain is as the one-sentence statement on a definition">

              <role>role:Explanation</role>

              <detailLevel>dlevel:Introductory</detailLevel>

              <weight>weight:Primary</weight>

              <message>
                is is not a property: it is the short sentence that states what the Block is
                before ordinary members begin.
              </message>

              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>
                    A first definition uses is to give humans and tools a one-line reading of
                    the type.
                  </summary>
                  <authoritativeSources>
                    <doc:DefinitionModel />
                  </authoritativeSources>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    Keep is short; it is an identity statement, not a full description.
                  </summary>
                  <authoritativeSources>
                    <doc:DefinitionModel />
                  </authoritativeSources>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    The worked example's is line sits with identity fields, ahead of the
                    property that demonstrates a member.
                  </summary>
                  <authoritativeSources>
                    <doc:DefinitionModel />
                    <core:Block />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>

            <dpage:Paragraph
              purpose="Explain documentation as expanded intent beyond is">

              <role>role:Explanation</role>

              <detailLevel>dlevel:Introductory</detailLevel>

              <weight>weight:Primary</weight>

              <message>
                documentation expands intent for humans and tools when the one-line is
                statement is not enough.
              </message>

              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>
                    Add documentation after is when readers need purpose, constraints, or
                    usage notes on the definition.
                  </summary>
                  <authoritativeSources>
                    <doc:DefinitionModel />
                  </authoritativeSources>
                </sem:SupportingPoint>

                <sem:SupportingPoint>
                  <summary>
                    Documentation remains part of the definition model, not a substitute for
                    properties, aggregations, or capabilities.
                  </summary>
                  <authoritativeSources>
                    <doc:DefinitionModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>

              <exclusions>
                <sem:Exclusion>
                  <summary>
                    Full DocumentationModel field catalogues and style-guide prose rules.
                  </summary>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>

          </content>
        </dpage:Section>

        <!-- 6. Navigation -->

        <dpage:Section
          heading="Continue with definition and composition"
          purpose="Direct the reader to related concept pages">

          <content>
            <dpage:Navigation
              purpose="Continue from the first-Block walkthrough">

              <title>Next</title>

              <items>
                <dpage:NavigationItem
                  label="Definition and instance"
                  summary="Deepen the definition versus instance model.">

                  <target>
                    page:DefinitionAndInstance
                  </target>
                </dpage:NavigationItem>

                <dpage:NavigationItem
                  label="Composition"
                  summary="Learn how instances nest inside aggregations.">

                  <target>
                    page:CompositionBasics
                  </target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>

      </composition>
    </content>
  </aggregations>

</block>
