<!--BlockML Documentation — TOC plan for the BlockML website docs

  FQN: org.blockml.bml.bmldocs.a01_planning.data.BmlDocSetPlan-->
<pdata:BmlDocSetPlan xmlns="http://blockml.org/bml"
  xmlns:pdata="org.blockml.bml.bmldocs.a01_planning.data"
  xmlns:dplan="org.blockml.bml.docgen.plan">

  <baseType>
    dplan:DocSetPlan
  </baseType>
  <is>
    The TOC plan for the BlockML website documentation
  </is>
  <isNot>
    A concrete DocSet or a documentation Page
  </isNot>
  <documentation>
    Concrete DocSetPlan for the table of contents of the BlockML website
    documentation: a developer handbook that teaches the fundamental mental
    models required to understand BlockML Core and use it correctly,
    covering how to use it, what it is for, examples, and how-tos.
    Specializes the abstract DocSetPlan template.

    rootPageGroupPlan is that TOC: RootPageGroup → DocsPageGroup → section
    PageGroups (title + nesting), with PagePlan entries (relative name +
    planning fields) for each planned page. Later sectors materialize the
    planned Pages and PageGroups from this plan.
  </documentation>
  <references>
    <see type="dplan:DocSetPlan" relation="Extends">
      Abstract TOC-plan template.
    </see>
    <see type="dplan:PageGroupPlan" relation="Requires">
      TOC groups — titles and nesting under rootPageGroupPlan.
    </see>
    <see type="dplan:PagePlan" relation="Requires">
      TOC pages — relative name and planning fields.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>BlockML Documentation</value>
    </title>
    <summary override="true">
      <value>A developer handbook for BlockML Core: the fundamental mental models —
Blocks, definitions and instances, inheritance and contracts, namespaces and
identity, the type system, the member model, behaviour and values,
composition and structure, and the BML authoring format — explained
individually and example-driven, from first orientation to reference-level
depth.</value>
    </summary>
    <version override="true">
      <value>0.1.0</value>
    </version>
    <homePage override="true">
      <value>page:TableOfContents</value>
    </homePage>
  </properties>
  <aggregations>
    <rootPageGroupPlan override="true">
      <composition>
        <dplan:PageGroupPlan name="RootPageGroup" title="Root">
          <plans>
            <dplan:PageGroupPlan name="DocsPageGroup" title="Documentation">
              <plans>

                <dplan:PagePlan name="docs.TableOfContents"
                  scope="documentation menu, entry points, navigation overview"
                  readerOutcome="The reader can locate the page for any topic and knows where to start."
                  learningObjective="Present the site structure as a navigable menu, not teach a concept."
                  exclusion="No BlockML concept in depth; that lives on the linked pages."
                  supportingPoint="Groups mirror the learning path from Getting Started through BML." />

                <dplan:PageGroupPlan name="GettingStartedPageGroup" title="Getting Started">
                  <plans>

                    <dplan:PagePlan name="docs.Introduction"
                      scope="what BlockML is, BML versus BOM, who the handbook is for, how to read it"
                      readerOutcome="The reader knows what BlockML is for and how the handbook is organized."
                      learningObjective="Establish the BML-versus-BOM distinction before any syntax."
                      exclusion="No Block syntax, inheritance, or type system detail."
                      supportingPoint="Domain knowledge lives in Blocks, not the compiler." />

                    <dplan:PagePlan name="docs.CoreUseCases"
                      scope="the three core BlockML use cases, when to reach for BlockML"
                      readerOutcome="The reader can recognize a problem that fits a core use case."
                      learningObjective="Ground BlockML's purpose in its core use cases, not a feature list."
                      exclusion="No Block-authoring how-to; only why and when."
                      supportingPoint="Contrasts structured semantic models with unstructured text." />

                  </plans>
                </dplan:PageGroupPlan>

                <dplan:PageGroupPlan name="FoundationsPageGroup" title="Foundations">
                  <plans>

                    <dplan:PagePlan name="docs.EverythingIsABlockPage"
                      scope="the Everything-is-a-Block model, single inheritance root, why one grammar covers domain and framework types"
                      readerOutcome="The reader can explain why every BlockML concept is a Block."
                      learningObjective="Teach Everything-is-a-Block as the language's unifying principle."
                      exclusion="No full member model or inheritance mechanics; own pages."
                      supportingPoint="A concrete domain example grounds the abstraction." />

                    <dplan:PagePlan name="docs.Blocks"
                      scope="what a Block is, defining, identifying, and referencing a Block, definition versus use"
                      readerOutcome="The reader can point to a Block's FQN, its definition, and a use of it."
                      learningObjective="Introduce the Block as the basic unit and separate defining from using one."
                      exclusion="No definition-versus-instance depth or inheritance; own pages."
                      supportingPoint="Reuses the Everything-is-a-Block framing as its starting example." />

                    <dplan:PagePlan name="docs.BlockDefinitionsAndInstances"
                      scope="Block definition versus instance, class/object analogy, defining a concept versus configuring one"
                      readerOutcome="The reader can tell a Block definition from a Block instance."
                      learningObjective="Teach the definition-versus-instance distinction."
                      exclusion="No inheritance, contracts, or member overrides."
                      supportingPoint="The class/object analogy aids orientation but is not the topic." />

                    <dplan:PagePlan name="docs.Inheritance"
                      scope="specialization via baseType, single inheritance, effective definition, abstract and final Blocks"
                      readerOutcome="The reader can trace a Block's effective definition through baseType."
                      learningObjective="Teach single inheritance and how members combine into an effective definition."
                      exclusion="No contracts or override-flag mechanics in depth."
                      supportingPoint="Sets up the baseType-versus-contracts contrast." />

                    <dplan:PagePlan name="docs.Contracts"
                      scope="contracts as composable reusable definitions, contracts versus inheritance, root-level declaration"
                      readerOutcome="The reader can choose baseType or a contract for reuse."
                      learningObjective="Teach contracts as composable member fragments, distinct from inheritance."
                      exclusion="No re-teaching of baseType mechanics or override syntax."
                      supportingPoint="Contract completion follows the same override rule as baseType refinement." />

                    <dplan:PagePlan name="docs.NamespacesAndFullyQualifiedNames"
                      scope="packages, Libraries, fully qualified names, namespace prefixes, name resolution"
                      readerOutcome="The reader can compute a Block's FQN and knows what a Library groups."
                      learningObjective="Teach how packages, Libraries, and FQNs relate."
                      exclusion="No reference resolution depth or the bml: authoring namespace."
                      supportingPoint="FQN follows a fixed formula from package and file location." />

                    <dplan:PagePlan name="docs.IdentifiersAndReferences"
                      scope="identifiers versus validated references, Type Identifier and Type Reference, abbreviated references"
                      readerOutcome="The reader can distinguish an identifier from a validated reference."
                      learningObjective="Teach the identifier-versus-reference distinction and its normalization forms."
                      exclusion="No Type Selector pattern matching in depth."
                      supportingPoint="Implicit namespace resolution is a single-stage, site-specific expansion." />

                  </plans>
                </dplan:PageGroupPlan>

                <dplan:PageGroupPlan name="TypeSystemPageGroup" title="Type System">
                  <plans>

                    <dplan:PagePlan name="docs.TypeSystem"
                      scope="type system overview, the four ValueType kinds and how they relate to Blocks and members"
                      readerOutcome="The reader can name the four ValueType kinds and classify a given type."
                      learningObjective="Teach the type-system mental model as four sibling kinds."
                      exclusion="No depth on any one kind; each gets its own page."
                      supportingPoint="The four kinds are siblings, not a hierarchy." />

                    <dplan:PagePlan name="docs.PrimitiveTypes"
                      scope="atomic scalar ValueTypes, primitive value semantics, built-in primitive branches"
                      readerOutcome="The reader can list the built-in primitive branches."
                      learningObjective="Teach that PrimitiveTypes describe atomic scalar semantics only."
                      exclusion="No parsing mechanics or PrimitiveEntity wrapping."
                      supportingPoint="Values live in Properties, never in the type itself." />

                    <dplan:PagePlan name="docs.StructTypes"
                      scope="composite named-field ValueTypes, struct fields, configuration and use"
                      readerOutcome="The reader can define a StructType and configure a struct value."
                      learningObjective="Teach StructType as the composite named-field branch."
                      exclusion="No EnumType or ConstantType depth."
                      supportingPoint="StructType is a sibling branch, not a supertype of EnumType." />

                    <dplan:PagePlan name="docs.EnumTypes"
                      scope="closed set of named literal values, enum branch, contrast with Primitive and Struct"
                      readerOutcome="The reader can define a closed enum and use its literal values."
                      learningObjective="Teach EnumType as a finite, closed set of named values."
                      exclusion="No suggestions mechanics; only the enum prohibition is noted."
                      supportingPoint="Enum-typed properties cannot carry suggestions." />

                    <dplan:PagePlan name="docs.PrimitiveEntities"
                      scope="primitive values represented as Block instances, the PrimitiveEntity wrapper"
                      readerOutcome="The reader knows when a primitive value needs a PrimitiveEntity wrapper."
                      learningObjective="Teach PrimitiveEntity as the wrapper that lets primitives appear as instances."
                      exclusion="No generics mechanics beyond the binding needed here."
                      supportingPoint="Ties to the *Entity wrapper convention used elsewhere." />

                    <dplan:PagePlan name="docs.TypesAndValues"
                      scope="type describing possible values versus instance holding an actual value"
                      readerOutcome="The reader keeps type-versus-value straight when reading any member."
                      learningObjective="Teach the general type-versus-value distinction."
                      exclusion="No per-kind detail already covered on the four type pages."
                      supportingPoint="Every Property is Optional — a value or none, never null." />

                    <dplan:PagePlan name="docs.GenericTypes"
                      scope="generic type parameters, declaring genericTypes, concrete application, binding versus forwarding"
                      readerOutcome="The reader can declare, bind, or forward a generic parameter."
                      learningObjective="Teach generic parameter declaration and the bind-or-forward rule."
                      exclusion="No constraint generic binding depth."
                      supportingPoint="A bound generic instance becomes a Sub-Block of that instance." />

                  </plans>
                </dplan:PageGroupPlan>

                <dplan:PageGroupPlan name="MembersPageGroup" title="Members">
                  <plans>

                    <dplan:PagePlan name="docs.Members"
                      scope="Block member model overview, how Properties, Aggregations, Associations, Capabilities relate"
                      readerOutcome="The reader can name the four member kinds and pick the right one."
                      learningObjective="Give an overview of the member model before its own pages."
                      exclusion="No depth on any one member kind."
                      supportingPoint="All four share the same container-plus-member-name authoring pattern." />

                    <dplan:PagePlan name="docs.Properties"
                      scope="typed value members, definition, configuration, inheritance and override"
                      readerOutcome="The reader can declare a typed Property with a default value."
                      learningObjective="Teach Property as a scalar or structured value member."
                      exclusion="No suggestions or constraints depth."
                      supportingPoint="Declaration order among properties can matter elsewhere." />

                    <dplan:PagePlan name="docs.Aggregations"
                      scope="owned collection members, ownership, composition fill, aggregations versus associations"
                      readerOutcome="The reader can declare and fill an owned collection member."
                      learningObjective="Teach Aggregation as an owned collection filled by Composition."
                      exclusion="No Association depth beyond the ownership contrast."
                      supportingPoint="Instance-side fill has no composition wrapper, unlike definitions." />

                    <dplan:PagePlan name="docs.Associations"
                      scope="non-owning instance links, associations versus aggregation, associations versus references"
                      readerOutcome="The reader can add a non-owning link without confusing it with ownership."
                      learningObjective="Teach Association as a non-owning instance-to-instance link."
                      exclusion="No Aggregation ownership mechanics or full reference model."
                      supportingPoint="A three-way contrast: Aggregation, Association, Reference." />

                    <dplan:PagePlan name="docs.Capabilities"
                      scope="Block behaviour as members, capability implementation bodies, common roles"
                      readerOutcome="The reader can declare a Capability and knows there is no separate constructor."
                      learningObjective="Teach Capability as ordinary behaviour with a language-tagged body."
                      exclusion="No embedded-expression syntax depth."
                      supportingPoint="Domain operations live in their own capability packages." />

                    <dplan:PagePlan name="docs.MemberInheritanceAndOverrides"
                      scope="combining inherited members, the override flag, refining or finalizing members"
                      readerOutcome="The reader knows when override must be set on a redeclared member."
                      learningObjective="Teach when a local redeclaration must set override."
                      exclusion="No re-teaching of baseType or contracts from scratch."
                      supportingPoint="The same override rule applies to baseType and contract completion." />

                    <dplan:PagePlan name="docs.Visibility"
                      scope="member and Sub-Block visibility, public/protected/private naming convention"
                      readerOutcome="The reader can tell visibility from a member's name."
                      learningObjective="Teach the naming-convention visibility model."
                      exclusion="No renderer implementation detail."
                      supportingPoint="Visibility restricts authoring access only, not renderer output." />

                    <dplan:PagePlan name="docs.MultiplicityAndCollections"
                      scope="optional, singular, and multiple values, multiplicity brackets, collection semantics"
                      readerOutcome="The reader can read a multiplicity bracket and place it in a type expression."
                      learningObjective="Teach multiplicity as one axis of a type expression."
                      exclusion="No MinItems/MaxItems constraint depth."
                      supportingPoint="Multiplicity brackets apply after type configuration." />

                  </plans>
                </dplan:PageGroupPlan>

                <dplan:PageGroupPlan name="BehaviourAndValuesPageGroup" title="Behaviour &amp; Values">
                  <plans>

                    <dplan:PagePlan name="docs.Constraints"
                      scope="declarative validation rules, the constraints container, constraint branches, when evaluated"
                      readerOutcome="The reader can attach the right constraint branch to a member."
                      learningObjective="Teach the constraints container and its branch-to-member-kind mapping."
                      exclusion="No Suggestions depth beyond the enforced/non-enforced contrast."
                      supportingPoint="Wrong-branch placement is a checked error, not a convention." />

                    <dplan:PagePlan name="docs.Suggestions"
                      scope="non-mandatory modeling guidance, suggestions versus constraints"
                      readerOutcome="The reader knows suggestions are hints, never validation."
                      learningObjective="Teach suggestions as non-enforced guidance for editors and renderers."
                      exclusion="No repeat of constraint mechanics."
                      supportingPoint="A suggested value must still be type-compatible." />

                    <dplan:PagePlan name="docs.Expressions"
                      scope="the BlockML expression language, dollar-brace expressions, evaluation context, interpolation"
                      readerOutcome="The reader can recognize an expression and know its evaluation context."
                      learningObjective="Teach the expression language as the mechanism for dynamic member values."
                      exclusion="No Capability implementation language tagging depth."
                      supportingPoint="Text properties may hold restricted expression holes as interpolation." />

                    <dplan:PagePlan name="docs.ValueConfiguration"
                      scope="configuring values and Block instances in BML, curly-brace ValueType configuration"
                      readerOutcome="The reader can write curly-brace configuration on a Property."
                      learningObjective="Teach ValueType configuration as distinct from generic binding."
                      exclusion="No multiplicity depth beyond noting the ordering."
                      supportingPoint="Configuration is per-property, not global to the type." />

                  </plans>
                </dplan:PageGroupPlan>

                <dplan:PageGroupPlan name="CompositionAndStructurePageGroup" title="Composition &amp; Structure">
                  <plans>

                    <dplan:PagePlan name="docs.Composition"
                      scope="composing Blocks through aggregations, composition fill syntax"
                      readerOutcome="The reader can fill an aggregation with the correct composition syntax."
                      learningObjective="Teach Composition as the mechanism that fills an Aggregation."
                      exclusion="No re-teaching of Aggregation ownership."
                      supportingPoint="Bare children without the aggregation wrapper are invalid." />

                    <dplan:PagePlan name="docs.SubBlocks"
                      scope="nested Block definitions, Sub-Block identity and scope, nesting depth"
                      readerOutcome="The reader can nest a Block definition inside a parent Block."
                      learningObjective="Teach Sub-Blocks as nested definitions sharing the parent's FQN prefix."
                      exclusion="No embedded Blocks depth beyond the nesting note."
                      supportingPoint="Outer type parameters are forwarded explicitly, not implicitly." />

                    <dplan:PagePlan name="docs.EmbeddedBlocks"
                      scope="embedded Block definitions and instances, embedded virtual documents"
                      readerOutcome="The reader can author an embedded Block as a full document."
                      learningObjective="Teach embedded Blocks as inlined full documents, not lightweight fragments."
                      exclusion="No repeat of Sub-Block nesting mechanics."
                      supportingPoint="Embedding follows the same document-root conventions as top-level files." />

                    <dplan:PagePlan name="docs.DocumentingBlocks"
                      scope="Block documentation model: is, documentation, and references fields"
                      readerOutcome="The reader can fill a Block's is, documentation, and references correctly."
                      learningObjective="Teach the documentation model as the definition-site source of truth."
                      exclusion="No bml: directive namespace depth."
                      supportingPoint="References connect types or instances for documentation only." />

                  </plans>
                </dplan:PageGroupPlan>

                <dplan:PageGroupPlan name="BmlFormatPageGroup" title="BML: The Authoring Format">
                  <plans>

                    <dplan:PagePlan name="docs.Bml"
                      scope="BML as the human-authored representation, relationship to the BOM"
                      readerOutcome="The reader can identify a Block document's root element and format."
                      learningObjective="Teach BML as the authoring format and the BOM as its canonical form."
                      exclusion="No namespace declaration mechanics or bml: directives depth."
                      supportingPoint="The compiler is domain-agnostic; it understands only BML and the BOM." />

                    <dplan:PagePlan name="docs.BmlNamespaces"
                      scope="XML namespace usage in BML, declarations and prefixes, the bml package placement rule"
                      readerOutcome="The reader can declare an xmlns prefix and place a definition correctly."
                      learningObjective="Teach namespace declarations and the bml-namespace placement rule."
                      exclusion="No BlockML naming/reference model beyond the XML mechanics."
                      supportingPoint="Every definition must live under the owning domain's bml namespace." />

                  </plans>
                </dplan:PageGroupPlan>

              </plans>
            </dplan:PageGroupPlan>
          </plans>
        </dplan:PageGroupPlan>
      </composition>
    </rootPageGroupPlan>
  </aggregations>
</pdata:BmlDocSetPlan>
