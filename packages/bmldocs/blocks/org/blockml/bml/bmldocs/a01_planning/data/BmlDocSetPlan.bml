<!--BlockML Documentation — TOC plan for the BlockML website docs

  FQN: org.blockml.bml.bmldocs.a01_planning.data.BmlDocSetPlan-->
<pdata:BmlDocSetPlan xmlns="http://blockml.org/bml"
  xmlns:pdata="org.blockml.bml.bmldocs.a01_planning.data"
  xmlns:dplan="org.blockml.bml.docgen.plan">

  <baseType>
    dplan:DocSetPlan
  </baseType>
  <is>
    The TOC plan for the BlockML website documentation
  </is>
  <isNot>
    A concrete DocSet or a documentation Page
  </isNot>
  <documentation>
    Concrete DocSetPlan for the table of contents of the BlockML website
    documentation: a developer handbook that teaches the fundamental mental
    models required to understand BlockML Core and use it correctly,
    covering how to use it, what it is for, examples, and how-tos.
    Specializes the abstract DocSetPlan template.

    rootPageGroupPlan is that TOC: RootPageGroup → DocsPageGroup → section
    PageGroups (title + nesting), with PagePlan entries (relative name +
    scope) for each planned page. Later sectors materialize the planned
    Pages and PageGroups from this plan.
  </documentation>
  <references>
    <see type="dplan:DocSetPlan" relation="Extends">
      Abstract TOC-plan template.
    </see>
    <see type="dplan:PageGroupPlan" relation="Requires">
      TOC groups — titles and nesting under rootPageGroupPlan.
    </see>
    <see type="dplan:PagePlan" relation="Requires">
      TOC pages — relative name and scope.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>BlockML Documentation</value>
    </title>
    <summary override="true">
      <value>A developer handbook for BlockML Core: the fundamental mental models —
Blocks, definitions and instances, inheritance and contracts, namespaces and
identity, the type system, the member model, behaviour and values,
composition and structure, and the BML authoring format — explained
individually and example-driven, from first orientation to reference-level
depth.</value>
    </summary>
    <version override="true">
      <value>0.1.0</value>
    </version>
    <homePage override="true">
      <value>page:TableOfContents</value>
    </homePage>
  </properties>
  <aggregations>
    <rootPageGroupPlan override="true">
      <composition>
        <dplan:PageGroupPlan name="RootPageGroup" title="Root">
          <plans>
            <dplan:PageGroupPlan name="DocsPageGroup" title="Documentation">
              <plans>
                <dplan:PagePlan name="docs.TableOfContents" scope="documentation menu, entry points, navigation overview" />
                <dplan:PageGroupPlan name="GettingStartedPageGroup" title="Getting Started">
                  <plans>
                    <dplan:PagePlan name="docs.Introduction" scope="what BlockML is, BML as human-authored format versus BOM as canonical model, who this handbook is for, how to read it" />
                    <dplan:PagePlan name="docs.CoreUseCases" scope="the three core BlockML use cases, structured semantic documentation, when to reach for BlockML, practical orientation" />
                  </plans>
                </dplan:PageGroupPlan>
                <dplan:PageGroupPlan name="FoundationsPageGroup" title="Foundations">
                  <plans>
                    <dplan:PagePlan name="docs.EverythingIsABlockPage" scope="Everything-is-a-Block mental model, single inheritance root, Block as universal abstraction, why one grammar covers domain and framework types" />
                    <dplan:PagePlan name="docs.Blocks" scope="what a Block is, defining a Block, identifying and referencing a Block, Block use and configuration versus its definition" />
                    <dplan:PagePlan name="docs.BlockDefinitionsAndInstances" scope="Block definition versus Block instance, class and object analogy, defining a reusable concept versus configuring an instance of it" />
                    <dplan:PagePlan name="docs.Inheritance" scope="specialization through baseType, single inheritance, effective definition, inherited members, abstract Blocks, final Blocks" />
                    <dplan:PagePlan name="docs.Contracts" scope="contracts as composable reusable definitions, contract member fragment merge, contracts versus inheritance, root-level contract declaration" />
                    <dplan:PagePlan name="docs.NamespacesAndFullyQualifiedNames" scope="packages, Libraries as publishable units, fully qualified names, namespace prefixes, name resolution" />
                    <dplan:PagePlan name="docs.IdentifiersAndReferences" scope="identifiers versus validated references, Type Identifier, Type Reference, abbreviated references through namespaces, implicit namespace resolution" />
                  </plans>
                </dplan:PageGroupPlan>
                <dplan:PageGroupPlan name="TypeSystemPageGroup" title="Type System">
                  <plans>
                    <dplan:PagePlan name="docs.TypeSystem" scope="type system mental model, the four ValueType kinds, how PrimitiveType StructType EnumType and ConstantType relate to Blocks and members" />
                    <dplan:PagePlan name="docs.PrimitiveTypes" scope="atomic scalar ValueTypes, primitive value semantics, parsing authored text into a primitive value, built-in primitive branches" />
                    <dplan:PagePlan name="docs.StructTypes" scope="composite named-field ValueTypes, structured values, struct fields, struct configuration and use" />
                    <dplan:PagePlan name="docs.EnumTypes" scope="closed set of named literal values, enum ValueType branch, enum values, contrast with PrimitiveType and StructType" />
                    <dplan:PagePlan name="docs.PrimitiveEntities" scope="primitive values represented as Block instances, generic PrimitiveEntity wrapper, why aggregations of primitive values need entity wrappers" />
                    <dplan:PagePlan name="docs.TypesAndValues" scope="a type describing possible values versus an instance or member holding an actual value, ValueType definition versus configured type instance" />
                    <dplan:PagePlan name="docs.GenericTypes" scope="generic type parameters, declaring genericTypes on a Block, concrete generic type application, binding versus forwarding parameters" />
                  </plans>
                </dplan:PageGroupPlan>
                <dplan:PageGroupPlan name="MembersPageGroup" title="Members">
                  <plans>
                    <dplan:PagePlan name="docs.Members" scope="Block member model overview, how Properties Aggregations Associations and Capabilities relate to each other" />
                    <dplan:PagePlan name="docs.Properties" scope="typed value members, property definition, property configuration, property inheritance and override, common usage patterns" />
                    <dplan:PagePlan name="docs.Aggregations" scope="owned collection members, aggregation ownership, composition fill of aggregations, aggregations versus associations" />
                    <dplan:PagePlan name="docs.Associations" scope="non-owning instance-to-instance links, associations versus aggregation ownership, associations versus documentation references" />
                    <dplan:PagePlan name="docs.Capabilities" scope="Block behaviour as ordinary members, Capability members, capability implementation bodies, callable functionality" />
                    <dplan:PagePlan name="docs.MemberInheritanceAndOverrides" scope="combining inherited members, the override flag, refining restricting or finalizing inherited members, abstract member obligations" />
                    <dplan:PagePlan name="docs.Visibility" scope="member and Sub-Block visibility, public protected private naming convention, effect of visibility on access from other contexts" />
                    <dplan:PagePlan name="docs.MultiplicityAndCollections" scope="optional singular and multiple values, multiplicity brackets, collection semantics on properties and aggregations" />
                  </plans>
                </dplan:PageGroupPlan>
                <dplan:PageGroupPlan name="BehaviourAndValuesPageGroup" title="Behaviour &amp; Values">
                  <plans>
                    <dplan:PagePlan name="docs.Constraints" scope="declarative validation rules, the constraints container, constraint target binding, constraint branches, when constraints are evaluated" />
                    <dplan:PagePlan name="docs.Suggestions" scope="non-mandatory modeling guidance metadata, suggestions versus constraints, suggestions on properties for editors and renderers" />
                    <dplan:PagePlan name="docs.Expressions" scope="the BlockML expression language, dollar-brace expressions, evaluation context, interpolation versus whole-value expressions, use by other Core concepts" />
                    <dplan:PagePlan name="docs.ValueConfiguration" scope="configuring values and Block instances in BML, primitive structured collection enum reference and nested value configuration, curly-brace ValueType configuration" />
                  </plans>
                </dplan:PageGroupPlan>
                <dplan:PageGroupPlan name="CompositionAndStructurePageGroup" title="Composition &amp; Structure">
                  <plans>
                    <dplan:PagePlan name="docs.Composition" scope="composing Blocks through aggregations, composition fill syntax, how composition relates to inheritance and other reuse mechanisms" />
                    <dplan:PagePlan name="docs.SubBlocks" scope="nested or subordinate Block definitions, Sub-Block identity and scope, relationship to the containing Block, nesting depth" />
                    <dplan:PagePlan name="docs.EmbeddedBlocks" scope="embedded Block definitions and instances, embedded virtual documents, distinguishing embedded Blocks from referenced or independently defined Blocks" />
                    <dplan:PagePlan name="docs.DocumentingBlocks" scope="Block documentation model, is documentation summary and examples fields, documentation conventions and references" />
                  </plans>
                </dplan:PageGroupPlan>
                <dplan:PageGroupPlan name="BmlFormatPageGroup" title="BML: The Authoring Format">
                  <plans>
                    <dplan:PagePlan name="docs.Bml" scope="BML as the human-authored representation of BlockML, relationship between the conceptual model and its XML representation, BOM as canonical representation" />
                    <dplan:PagePlan name="docs.BmlNamespaces" scope="XML namespace usage in BML, xmlns declarations and prefixes, BML namespace mechanics versus BlockML's conceptual naming and reference model" />
                  </plans>
                </dplan:PageGroupPlan>
              </plans>
            </dplan:PageGroupPlan>
          </plans>
        </dplan:PageGroupPlan>
      </composition>
    </rootPageGroupPlan>
  </aggregations>
</pdata:BmlDocSetPlan>
