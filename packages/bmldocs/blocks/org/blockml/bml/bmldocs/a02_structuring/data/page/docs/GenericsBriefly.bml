<!--BlockML Documentation — Generics briefly (structuring skeleton)

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.page.docs.GenericsBriefly-->
<page:GenericsBriefly xmlns="http://blockml.org/bml"
  xmlns:page="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:dlevel="org.blockml.bml.docgen.level"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A short website introduction to generics
  </is>
  <documentation>
    Structuring skeleton for the "Generics briefly" documentation page. Scopes: generics,
    declaring Block parameters, generic type arguments. Bound authoritative sources:
    org.blockml.bml.documentation.GenericsModel, org.blockml.bml.documentation.TypeExpressions.
    The a03 authoring stage writes the page body from those sources; this skeleton carries only
    page identity, the title / purpose / detailLevel / pageType overrides, and the see links to
    those sources.
  </documentation>
  <references>
    <see type="doc:GenericsModel" relation="Requires">
      Primary content — generic parameters belong to the declaring Block and are never inherited implicitly; a derived Block must bind or forward every base parameter.
    </see>
    <see type="doc:TypeExpressions" relation="SeeAlso">
      Supporting background — generic application as one form of type expression.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Generics briefly</value>
    </title>
    <purpose override="true">
      <value>Explain the ownership and bind-or-forward rule for generic parameters in a short page, sending readers who need more to the type-expression material.</value>
    </purpose>
    <detailLevel override="true">
      <value>dlevel:Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>ptype:Concept</value>
    </pageType>
  </properties>
</page:GenericsBriefly>
