<!--BlockML Documentation — Libraries and packages (structuring skeleton)

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.page.docs.LibrariesAndPackages-->
<page:LibrariesAndPackages xmlns="http://blockml.org/bml"
  xmlns:page="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A website page on libraries and packages
  </is>
  <documentation>
    Structuring skeleton for the "Libraries and packages" documentation page. Scopes: Library
    publishable unit, packages, domain bml package convention. Bound authoritative sources:
    org.blockml.bml.documentation.LibrarySystem, org.blockml.bml.documentation.BmlNamespace.
    The a03 authoring stage writes the page body from those sources; this skeleton carries only
    page identity, the title / purpose / detailLevel / pageType overrides, and the see links to
    those sources.
  </documentation>
  <references>
    <see type="doc:LibrarySystem" relation="Requires">
      Primary content — a Library is a publishable unit whose membership is defined by its blocks list, not by directory layout.
    </see>
    <see type="doc:BmlNamespace" relation="Requires">
      Primary content — every BlockML definition must reside below its owning domain's bml package.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Libraries and packages</value>
    </title>
    <purpose override="true">
      <value>Explain the Library as the publishable unit defined by its blocks list, and the rule that every definition lives under a domain's bml namespace.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
</page:LibrariesAndPackages>
