<!--BlockML Documentation — Modeling guidelines (structuring skeleton)

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.page.docs.ModelingGuidelinesPage-->
<page:ModelingGuidelinesPage xmlns="http://blockml.org/bml"
  xmlns:page="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A website page of practical modeling guidelines
  </is>
  <documentation>
    Structuring skeleton for the "Modeling guidelines" documentation page. Scopes: modeling
    patterns, practical authoring guidance, non-normative tips. Bound authoritative sources:
    org.blockml.bml.documentation.ModelingGuidelines, org.blockml.bml.documentation.ContractsModel,
    org.blockml.bml.documentation.ConstraintsModel. The a03 authoring stage writes the page body
    from those sources; this skeleton carries only page identity, the title / purpose /
    detailLevel / pageType overrides, and the see links to those sources.
  </documentation>
  <references>
    <see type="doc:ModelingGuidelines" relation="Requires">
      Primary content — recommended patterns for inheritance, member fragments, and branch membership.
    </see>
    <see type="doc:ContractsModel" relation="SeeAlso">
      Supporting background — choosing contracts over baseType for shared member fragments.
    </see>
    <see type="doc:ConstraintsModel" relation="SeeAlso">
      Supporting background — where constraints fit into a well-shaped model.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Modeling guidelines</value>
    </title>
    <purpose override="true">
      <value>Collect practical, non-normative modeling patterns so authors have guidance without turning the page into a second language specification.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Practical</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Guide</value>
    </pageType>
  </properties>
</page:ModelingGuidelinesPage>
