<!--BlockML Documentation — Constraints (structuring skeleton)

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.page.docs.ConstraintsBasics-->
<page:ConstraintsBasics xmlns="http://blockml.org/bml"
  xmlns:page="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A website introduction to constraints
  </is>
  <documentation>
    Structuring skeleton for the "Constraints" documentation page. Scopes: validation rules,
    constrainable definition elements, reusable constraints. Bound authoritative sources:
    org.blockml.bml.documentation.ConstraintsModel, org.blockml.bml.documentation.ValueTypeConfiguration.
    The a03 authoring stage writes the page body from those sources; this skeleton carries only
    page identity, the title / purpose / detailLevel / pageType overrides, and the see links to
    those sources.
  </documentation>
  <references>
    <see type="doc:ConstraintsModel" relation="Requires">
      Primary content — reusable validation rules attached through one constraints container on Blocks and members, with the constraint's type bound from context.
    </see>
    <see type="doc:ValueTypeConfiguration" relation="SeeAlso">
      Supporting background — constraints also reached through ValueType configuration on a property.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Constraints</value>
    </title>
    <purpose override="true">
      <value>Introduce constraints as reusable, context-bound validation rules on constrainable definition elements, so authors know where they attach and how their type parameter is supplied.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
</page:ConstraintsBasics>
