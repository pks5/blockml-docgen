<!--BlockML Documentation — cohesive BlockML core documentation set

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.BmlDocSet_A02-->
<adata:BmlDocSet_A02 xmlns="http://blockml.org/bml"
  xmlns:adata="org.blockml.bml.bmldocs.a02_structuring.data"
  xmlns:docs="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:pgroup="org.blockml.bml.bmldocs.a02_structuring.data.pagegroup"
  xmlns:dcore="org.blockml.bml.docgen.core">

  <baseType>
    dcore:DocSet
  </baseType>
  <is>
    The BlockML core documentation set
  </is>
  <isNot>
    A single DocPage or a bml-core narrative Documentation Block
  </isNot>
  <documentation>
    The complete documentation set for BlockML core — syntax, rules, examples, best practices,
    and use cases — with a learning path from quick start to deep study for junior through
    senior developers.

    pages and homePage are filled by A02_02_UpdatePageSkeletons. pageGroups and rootPageGroup are
    filled by A02_03_UpdatePageGroups.
  </documentation>
  <references>
    <see type="dcore:DocSet" relation="Extends">
      Docgen DocSet container.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>BlockML Documentation</value>
    </title>
    <summary override="true">
      <value>Complete BlockML core documentation — syntax, rules, examples, best practices, and
use cases — with a learning path from quick start to deep study for junior through senior
developers.</value>
    </summary>
    <version override="true">
      <value>0.1.0</value>
    </version>
    <homePage override="true">
      <value>docs:TableOfContents</value>
    </homePage>
    <rootPageGroup override="true">
      <value>pgroup:RootPageGroup</value>
    </rootPageGroup>
  </properties>
  <aggregations>
    <pages override="true">
      <composition>
        <docs:TableOfContents />
        <docs:Intro />
        <docs:FirstBlock />
        <docs:FileAnatomy />
        <docs:EverythingIsABlockPage />
        <docs:DefinitionAndInstance />
        <docs:CompositionBasics />
        <docs:TypesOverview />
        <docs:TypeExpressionsBasics />
        <docs:GenericsBriefly />
        <docs:ConfiguringTypes />
        <docs:CapabilitiesIntro />
        <docs:ExpressionsIntro />
        <docs:EmbeddedExpressionsIntro />
        <docs:LibrariesAndPackages />
        <docs:ReadmeAndBootstrap />
        <docs:ModelingGuidelinesPage />
        <docs:VisibilityBasics />
        <docs:OverridesBasics />
        <docs:ConstraintsBasics />
        <docs:AnnotationsAndDirectives />
        <docs:SubBlocksIntro />
        <docs:ContractsIntro />
        <docs:CompilerOverview />
        <docs:AuthorNewBlockGuide />
      </composition>
    </pages>
    <pageGroups override="true">
      <composition>
        <pgroup:RootPageGroup />
        <pgroup:DocsPageGroup />
        <pgroup:GettingStartedPageGroup />
        <pgroup:CoreIdeasPageGroup />
        <pgroup:TypesPageGroup />
        <pgroup:BehaviourPageGroup />
        <pgroup:LibrariesPageGroup />
        <pgroup:AuthoringPageGroup />
        <pgroup:DeeperTopicsPageGroup />
        <pgroup:HowToPageGroup />
      </composition>
    </pageGroups>
  </aggregations>
</adata:BmlDocSet_A02>
