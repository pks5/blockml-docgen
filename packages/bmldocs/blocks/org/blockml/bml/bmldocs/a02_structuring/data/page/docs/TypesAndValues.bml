<!--BlockML Documentation — a guide to the type-versus-value distinction

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.page.docs.TypesAndValues-->
<docs:TypesAndValues xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:docs="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to the type-versus-value distinction
  </is>
  <documentation>
    Scope: a type describing possible values versus an instance holding an actual value,
    grounded in org.blockml.bml.core.ValueType and
    org.blockml.bml.documentation.EverythingIsABlock. Body content is authored in a03 from those
    sources.
  </documentation>
  <references>
    <see type="core:ValueType" relation="Requires">
      The typed value domain this page's distinction is built on.
    </see>
    <see type="doc:EverythingIsABlock" relation="Requires">
      Primary content source — ValueTypes never store data; Properties own all concrete values.
    </see>
    <see type="doc:ValueTypeConfiguration" relation="SeeAlso">
      How a Property's owned type instance, not the ValueType definition, carries configuration.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Types and Values</value>
    </title>
    <purpose override="true">
      <value>Teach the general type-versus-value distinction that underlies every member kind, so readers keep type and value apart before reading any of the four ValueType kind pages.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <workflow:AuthorativeSourceSet>
          <includedTypes>
            <type:TypeSelectorEntity value="org.blockml.bml.core.ValueType" />
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.EverythingIsABlock" />
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.ValueTypeConfiguration" />
          </includedTypes>
        </workflow:AuthorativeSourceSet>
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>Teach the general type-versus-value distinction that underlies every member kind.</summary>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>The reader keeps type-versus-value straight when reading any member declaration.</summary>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>A type describing possible values versus an instance holding an actual value.</summary>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>Per-kind detail already covered on the four ValueType kind pages.</summary>
          <reason>This page states the general principle only.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <supportingPoints override="true">
      <composition>
        <sem:SupportingPoint>
          <summary>ValueTypes never store data; every Property is Optional — a value or none, never null.</summary>
        </sem:SupportingPoint>
      </composition>
    </supportingPoints>
  </aggregations>
</docs:TypesAndValues>
