<!--BlockML Documentation — Everything is a Block (structuring skeleton)

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.page.docs.EverythingIsABlockPage-->
<page:EverythingIsABlockPage xmlns="http://blockml.org/bml"
  xmlns:page="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A website page for the everything-is-a-Block principle
  </is>
  <documentation>
    Structuring skeleton for the "Everything is a Block" documentation page. Scopes: Block as
    universal abstraction, World grammar, core mental model. Bound authoritative sources:
    org.blockml.bml.documentation.EverythingIsABlock, org.blockml.bml.documentation.WOTFoundation.
    The a03 authoring stage writes the page body from those sources; this skeleton carries only
    page identity, the title / purpose / detailLevel / pageType overrides, and the see links to
    those sources.
  </documentation>
  <references>
    <see type="doc:EverythingIsABlock" relation="Requires">
      Primary content — one root, one parser, one bootstrap path; domain types, ValueTypes, languages, and documentation are all Blocks.
    </see>
    <see type="doc:WOTFoundation" relation="SeeAlso">
      Supporting background — the Web of Things framing behind the principle, offered as optional context.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Everything is a Block</value>
    </title>
    <purpose override="true">
      <value>Establish the central mental model — every element of a World's grammar descends from one root Block — so that later pages can rely on it without re-explaining it.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
</page:EverythingIsABlockPage>
