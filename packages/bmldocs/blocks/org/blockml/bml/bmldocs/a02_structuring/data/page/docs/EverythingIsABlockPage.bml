<!--BlockML Documentation — Everything is a Block (structuring skeleton)

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.page.docs.EverythingIsABlockPage-->
<page:EverythingIsABlockPage xmlns="http://blockml.org/bml"
  xmlns:page="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:dlevel="org.blockml.bml.docgen.level"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A website page for the everything-is-a-Block idea
  </is>
  <documentation>
    Structuring skeleton for the “Everything is a Block” documentation page. Planned scopes: Block as universal abstraction, World grammar, core mental model. Purpose and detailLevel are derived from the a01 BmlDocSetPlan PagePlan docs.EverythingIsABlockPage. This skeleton carries page identity, properties, and authoritative-source references only; sections and prose are authored in the a03 stage.
  </documentation>
  <references>
    <see type="doc:EverythingIsABlock" relation="Requires">
      Primary content source — the central ontological principle.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Everything is a Block</value>
    </title>
    <purpose override="true">
      <value>Establish Block as the universal abstraction of a World's grammar.</value>
    </purpose>
    <detailLevel override="true">
      <value>dlevel:Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>ptype:Concept</value>
    </pageType>
  </properties>
</page:EverythingIsABlockPage>
