<!--BlockML Documentation — Contracts (structuring skeleton)

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.page.docs.ContractsIntro-->
<page:ContractsIntro xmlns="http://blockml.org/bml"
  xmlns:page="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:dlevel="org.blockml.bml.docgen.level"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A website introduction to contracts
  </is>
  <documentation>
    Structuring skeleton for the "Contracts" documentation page. Scopes: contracts, reusable
    partial definitions, member fragment merge. Bound authoritative sources:
    org.blockml.bml.documentation.ContractsModel, org.blockml.bml.documentation.PartialMemberOverrides.
    The a03 authoring stage writes the page body from those sources; this skeleton carries only
    page identity, the title / purpose / detailLevel / pageType overrides, and the see links to
    those sources.
  </documentation>
  <references>
    <see type="doc:ContractsModel" relation="Requires">
      Primary content — root-level contracts compose reusable partial definitions whose member fragments merge into the effective Block; contrast with single baseType.
    </see>
    <see type="doc:PartialMemberOverrides" relation="SeeAlso">
      Supporting background — the member-merge rule contract completion shares with baseType refinement.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Contracts</value>
    </title>
    <purpose override="true">
      <value>Introduce contracts as reusable partial definitions merged at the document root, and set them apart from the single-baseType inheritance readers already know.</value>
    </purpose>
    <detailLevel override="true">
      <value>dlevel:Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>ptype:Concept</value>
    </pageType>
  </properties>
</page:ContractsIntro>
