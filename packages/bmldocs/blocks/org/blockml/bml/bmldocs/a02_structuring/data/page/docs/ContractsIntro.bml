<!--BlockML Documentation — Contracts (structuring skeleton)

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.page.docs.ContractsIntro-->
<page:ContractsIntro xmlns="http://blockml.org/bml"
  xmlns:page="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:dlevel="org.blockml.bml.docgen.level"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A website intro to contracts
  </is>
  <documentation>
    Structuring skeleton for the “Contracts” documentation page. Planned scopes: contracts, reusable partial definitions, member fragment merge. Purpose and detailLevel are derived from the a01 BmlDocSetPlan PagePlan docs.ContractsIntro. This skeleton carries page identity, properties, and authoritative-source references only; sections and prose are authored in the a03 stage.
  </documentation>
  <references>
    <see type="doc:ContractsModel" relation="Requires">
      Primary content — contracts, member merge, and type bounds.
    </see>
    <see type="doc:PartialMemberOverrides" relation="SeeAlso">
      Related — how member fragments merge.
    </see>
    <see type="doc:ModelingGuidelines" relation="SeeAlso">
      Related — when to use contracts versus baseType.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Contracts</value>
    </title>
    <purpose override="true">
      <value>Introduce contracts as reusable partial definitions that merge member fragments.</value>
    </purpose>
    <detailLevel override="true">
      <value>dlevel:Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>ptype:Concept</value>
    </pageType>
  </properties>
</page:ContractsIntro>
