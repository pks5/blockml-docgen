<!--BlockML Documentation — README and Bootstrap (structuring skeleton)

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.page.docs.ReadmeAndBootstrap-->
<page:ReadmeAndBootstrap xmlns="http://blockml.org/bml"
  xmlns:page="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:dlevel="org.blockml.bml.docgen.level"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A website page for README versus Bootstrap
  </is>
  <documentation>
    Structuring skeleton for the “README and Bootstrap” documentation page. Planned scopes: README entry point, compiler bootstrap, human versus machine entry. Purpose and detailLevel are derived from the a01 BmlDocSetPlan PagePlan docs.ReadmeAndBootstrap. This skeleton carries page identity, properties, and authoritative-source references only; sections and prose are authored in the a03 stage.
  </documentation>
  <references>
    <see type="doc:BootstrapModel" relation="Requires">
      Primary content — README, Bootstrap SPOE, and interpretation context.
    </see>
    <see type="doc:LibrarySystem" relation="SeeAlso">
      Related — Library.readMe and Library.bootstrap wiring.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>README and Bootstrap</value>
    </title>
    <purpose override="true">
      <value>Distinguish human-facing README from compiler bootstrap entry points.</value>
    </purpose>
    <detailLevel override="true">
      <value>dlevel:Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>ptype:Concept</value>
    </pageType>
  </properties>
</page:ReadmeAndBootstrap>
