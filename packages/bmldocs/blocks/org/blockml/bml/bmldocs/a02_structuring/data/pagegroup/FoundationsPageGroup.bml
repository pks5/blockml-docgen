<!--BlockML Documentation — Foundations page group

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.pagegroup.FoundationsPageGroup-->
<a02pgroup:FoundationsPageGroup xmlns="http://blockml.org/bml"
  xmlns:a02pgroup="org.blockml.bml.bmldocs.a02_structuring.data.pagegroup"
  xmlns:docs="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dcore="org.blockml.bml.docgen.core">

  <baseType>
    dcore:PageGroup
  </baseType>
  <is>
    The Foundations page group for the A02 documentation set
  </is>
  <documentation>
    Section page group under DocsPageGroup, from BmlDocSetPlan.rootPageGroupPlan
    (FoundationsPageGroup). Direct pages: EverythingIsABlockPage, Blocks,
    BlockDefinitionsAndInstances, Inheritance, Contracts, NamespacesAndFullyQualifiedNames,
    IdentifiersAndReferences.
  </documentation>
  <references>
    <see type="dcore:PageGroup" relation="Extends">
      Docgen page group base.
    </see>
    <see type="a02pgroup:DocsPageGroup" relation="Requires">
      Parent Documentation page group.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Foundations</value>
    </title>
    <parentGroup override="true">
      <value>a02pgroup:DocsPageGroup</value>
    </parentGroup>
  </properties>
  <aggregations>
    <pages override="true">
      <composition>
        <docs:EverythingIsABlockPage />
        <docs:Blocks />
        <docs:BlockDefinitionsAndInstances />
        <docs:Inheritance />
        <docs:Contracts />
        <docs:NamespacesAndFullyQualifiedNames />
        <docs:IdentifiersAndReferences />
      </composition>
    </pages>
  </aggregations>
</a02pgroup:FoundationsPageGroup>
