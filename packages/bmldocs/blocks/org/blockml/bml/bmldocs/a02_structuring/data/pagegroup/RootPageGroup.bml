<!--BlockML Documentation — top-level root page group

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.pagegroup.RootPageGroup-->
<pgroup:RootPageGroup xmlns="http://blockml.org/bml"
  xmlns:pgroup="org.blockml.bml.bmldocs.a02_structuring.data.pagegroup"
  xmlns:dcore="org.blockml.bml.docgen.core">

  <baseType>
    dcore:PageGroup
  </baseType>
  <is>
    The top-level container for all a02 page groups
  </is>
  <documentation>
    Outermost A02 page group, materialized from the plan's root PageGroupPlan. Has no direct
    pages and no parentGroup. DocsPageGroup nests under this group via parentGroup.
  </documentation>
  <references>
    <see type="dcore:PageGroup" relation="Extends">
      Docgen page group base.
    </see>
    <see type="pgroup:DocsPageGroup" relation="Requires">
      Documentation subtree nested under this root.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Root</value>
    </title>
  </properties>
</pgroup:RootPageGroup>
