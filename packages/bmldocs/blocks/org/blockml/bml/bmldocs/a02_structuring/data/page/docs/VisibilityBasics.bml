<!--BlockML Documentation — Visibility (structuring skeleton)

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.page.docs.VisibilityBasics-->
<page:VisibilityBasics xmlns="http://blockml.org/bml"
  xmlns:page="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:dlevel="org.blockml.bml.docgen.level"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A website intro to member visibility
  </is>
  <documentation>
    Structuring skeleton for the “Visibility” documentation page. Planned scopes: member visibility, Sub-Block visibility, access control. Purpose and detailLevel are derived from the a01 BmlDocSetPlan PagePlan docs.VisibilityBasics. This skeleton carries page identity, properties, and authoritative-source references only; sections and prose are authored in the a03 stage.
  </documentation>
  <references>
    <see type="doc:MemberVisibility" relation="Requires">
      Primary content — visibility naming and access rules.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Visibility</value>
    </title>
    <purpose override="true">
      <value>Explain member and Sub-Block visibility as access control in the model.</value>
    </purpose>
    <detailLevel override="true">
      <value>dlevel:Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>ptype:Concept</value>
    </pageType>
  </properties>
</page:VisibilityBasics>
