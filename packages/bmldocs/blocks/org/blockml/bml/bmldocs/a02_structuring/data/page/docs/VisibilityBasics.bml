<!--BlockML Documentation — Visibility (structuring skeleton)

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.page.docs.VisibilityBasics-->
<page:VisibilityBasics xmlns="http://blockml.org/bml"
  xmlns:page="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A website introduction to member and Sub-Block visibility
  </is>
  <documentation>
    Structuring skeleton for the "Visibility" documentation page. Scopes: member visibility,
    Sub-Block visibility, access control. Bound authoritative sources:
    org.blockml.bml.documentation.MemberVisibility, org.blockml.bml.documentation.SubBlockModel.
    The a03 authoring stage writes the page body from those sources; this skeleton carries only
    page identity, the title / purpose / detailLevel / pageType overrides, and the see links to
    those sources.
  </documentation>
  <references>
    <see type="doc:MemberVisibility" relation="Requires">
      Primary content — visibility (public, protected, private, signalled by naming) governs BlockML authoring access, not how a renderer manifests it.
    </see>
    <see type="doc:SubBlockModel" relation="SeeAlso">
      Supporting background — visibility as it applies to nested Sub-Block types.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Visibility</value>
    </title>
    <purpose override="true">
      <value>Explain member and Sub-Block visibility as authoring-time access control, and make clear that renderers still see the entire Canonical BOM.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
</page:VisibilityBasics>
