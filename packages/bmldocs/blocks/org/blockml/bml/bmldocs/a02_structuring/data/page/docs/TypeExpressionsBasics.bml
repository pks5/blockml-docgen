    <title override="true">
      <value>Type expressions</value>
    </title>
    <purpose override="true">
      <value>Cheat-sheet for combining named types into type expressions.</value>
    </purpose>
    <detailLevel override="true">
      <value>dlevel:Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>ptype:Guide</value>
    </pageType>
  </properties>
</page:TypeExpressionsBasics>
