  xmlns:page="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:dlevel="org.blockml.bml.docgen.level"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A website intro to \${ } expressions
  </is>
  <documentation>
    Structuring skeleton for the “Expressions” documentation page. Planned scopes: dollar-brace expressions, dynamic member values, expression basics. Purpose and detailLevel are derived from the a01 BmlDocSetPlan PagePlan docs.ExpressionsIntro. This skeleton carries page identity, properties, and authoritative-source references only; sections and prose are authored in the a03 stage.
  </documentation>
  <references>
    <see type="doc:Expressions" relation="Requires">
      Primary content source — expression language, scope, and builtins.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Expressions</value>
    </title>
    <purpose override="true">
      <value>Introduce \${ } expressions for dynamic member values.</value>
    </purpose>
    <detailLevel override="true">
      <value>dlevel:Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>ptype:Concept</value>
    </pageType>
  </properties>
</page:ExpressionsIntro>
