<!--BlockML Documentation — Expressions (structuring skeleton)

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.page.docs.ExpressionsIntro-->
<page:ExpressionsIntro xmlns="http://blockml.org/bml"
  xmlns:page="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:dlevel="org.blockml.bml.docgen.level"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A website introduction to the BlockML expression language
  </is>
  <documentation>
    Structuring skeleton for the "Expressions" documentation page. Scopes: dollar-brace
    expressions, dynamic member values, expression basics. Bound authoritative sources:
    org.blockml.bml.documentation.Expressions, org.blockml.bml.documentation.EmbeddedExpressions.
    The a03 authoring stage writes the page body from those sources; this skeleton carries only
    page identity, the title / purpose / detailLevel / pageType overrides, and the see links to
    those sources.
  </documentation>
  <references>
    <see type="doc:Expressions" relation="Requires">
      Primary content — the dollar-brace expression language as extended JSON used wherever a member value must be derived, computed, or service-bound, plus restricted text interpolation.
    </see>
    <see type="doc:EmbeddedExpressions" relation="SeeAlso">
      Supporting background — the same language used inside Capability implementation embeds, covered on its own page.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Expressions</value>
    </title>
    <purpose override="true">
      <value>Introduce the dollar-brace expression language and the situations that call for a dynamic member value, keeping embedded implementations for the next page.</value>
    </purpose>
    <detailLevel override="true">
      <value>dlevel:Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>ptype:Concept</value>
    </pageType>
  </properties>
</page:ExpressionsIntro>
