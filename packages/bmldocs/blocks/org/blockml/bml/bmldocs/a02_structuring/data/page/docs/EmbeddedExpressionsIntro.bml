<!--BlockML Documentation — Embedded expressions (structuring skeleton)

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.page.docs.EmbeddedExpressionsIntro-->
<page:EmbeddedExpressionsIntro xmlns="http://blockml.org/bml"
  xmlns:page="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A website introduction to embedded expressions in Capability implementations
  </is>
  <documentation>
    Structuring skeleton for the "Embedded expressions" documentation page. Scopes: embedded
    expressions, Capability implementation bodies, embed syntax. Bound authoritative sources:
    org.blockml.bml.documentation.EmbeddedExpressions, org.blockml.bml.documentation.CapabilitySemantics.
    The a03 authoring stage writes the page body from those sources; this skeleton carries only
    page identity, the title / purpose / detailLevel / pageType overrides, and the see links to
    those sources.
  </documentation>
  <references>
    <see type="doc:EmbeddedExpressions" relation="Requires">
      Primary content — language-neutral expression regions inside a Capability implementation body that the renderer replaces with equivalent target-language code.
    </see>
    <see type="doc:CapabilitySemantics" relation="SeeAlso">
      Supporting background — the language-tagged implementation body that hosts the embedded regions.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Embedded expressions</value>
    </title>
    <purpose override="true">
      <value>Explain how embedded expression regions inside an implementation body are resolved by the renderer, and how that differs from a plain expression member value.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
</page:EmbeddedExpressionsIntro>
