<!--BlockML Documentation — Annotations and directives (structuring skeleton)

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.page.docs.AnnotationsAndDirectives-->
<page:AnnotationsAndDirectives xmlns="http://blockml.org/bml"
  xmlns:page="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:dlevel="org.blockml.bml.docgen.level"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A website page for annotations and bml: directives
  </is>
  <documentation>
    Structuring skeleton for the “Annotations and directives” documentation page. Planned scopes: annotations, directive namespaces, orthogonal to Definition members. Purpose and detailLevel are derived from the a01 BmlDocSetPlan PagePlan docs.AnnotationsAndDirectives. This skeleton carries page identity, properties, and authoritative-source references only; sections and prose are authored in the a03 stage.
  </documentation>
  <references>
    <see type="doc:AnnotationModel" relation="Requires">
      Primary content — annotation namespaces and facets.
    </see>
    <see type="doc:BmlDirectives" relation="Requires">
      Primary content — bml:each, bml:if, bml:container, bml:with, bml:xml.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Annotations and directives</value>
    </title>
    <purpose override="true">
      <value>Frame annotations as directive namespaces orthogonal to Definition members.</value>
    </purpose>
    <detailLevel override="true">
      <value>dlevel:Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>ptype:Concept</value>
    </pageType>
  </properties>
</page:AnnotationsAndDirectives>
