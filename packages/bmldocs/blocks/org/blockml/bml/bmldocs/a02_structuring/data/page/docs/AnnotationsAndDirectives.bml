<!--BlockML Documentation — Annotations and directives (structuring skeleton)

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.page.docs.AnnotationsAndDirectives-->
<page:AnnotationsAndDirectives xmlns="http://blockml.org/bml"
  xmlns:page="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A website page on annotations and bml directives
  </is>
  <documentation>
    Structuring skeleton for the "Annotations and directives" documentation page. Scopes:
    annotations, directive namespaces, orthogonal to Definition members. Bound authoritative
    sources: org.blockml.bml.documentation.AnnotationModel, org.blockml.bml.documentation.BmlDirectives.
    The a03 authoring stage writes the page body from those sources; this skeleton carries only
    page identity, the title / purpose / detailLevel / pageType overrides, and the see links to
    those sources.
  </documentation>
  <references>
    <see type="doc:AnnotationModel" relation="Requires">
      Primary content — annotations formalize directive namespaces and are orthogonal to the Definition meta-model; naming overlap classifies directive form only.
    </see>
    <see type="doc:BmlDirectives" relation="Requires">
      Primary content — bml directives as the concrete flow-control and serialization form of that annotation model.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Annotations and directives</value>
    </title>
    <purpose override="true">
      <value>Frame annotations as directive namespaces that sit beside, not inside, the Definition meta-model, and present bml directives as their built-in concrete form.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
</page:AnnotationsAndDirectives>
