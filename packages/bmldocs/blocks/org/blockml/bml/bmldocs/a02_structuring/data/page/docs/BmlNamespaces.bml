<!--BlockML Documentation — a guide to XML namespace usage in BML

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.page.docs.BmlNamespaces-->
<docs:BmlNamespaces xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:docs="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to XML namespace usage in BML
  </is>
  <documentation>
    Scope: XML namespace usage in BML, xmlns declarations and prefixes, and the bml package
    placement rule, grounded in org.blockml.bml.documentation.BmlNamespace. Body content is
    authored in a03 from that source.
  </documentation>
  <references>
    <see type="doc:BmlNamespace" relation="Requires">
      Primary content source — mandatory domain.bml namespace and xmlns prefix conventions.
    </see>
    <see type="doc:LibrarySystem" relation="SeeAlso">
      Libraries, packages, and namespace membership.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>BML Namespaces</value>
    </title>
    <purpose override="true">
      <value>Teach xmlns namespace declarations and the bml-namespace placement rule, so readers can declare a prefix and place a new definition under the correct package.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <workflow:AuthorativeSourceSet>
          <includedTypes>
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.BmlNamespace" />
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.LibrarySystem" />
          </includedTypes>
        </workflow:AuthorativeSourceSet>
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>Teach namespace declarations and the bml-namespace placement rule.</summary>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>The reader can declare an xmlns prefix and place a new definition under the correct package.</summary>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>XML namespace usage in BML: xmlns declarations and prefixes, and the rule that every BML definition lives under its domain's bml package.</summary>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>BlockML naming and reference model beyond the XML mechanics.</summary>
          <reason>FQNs and references are covered on the earlier Namespaces and Identifiers pages.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <supportingPoints override="true">
      <composition>
        <sem:SupportingPoint>
          <summary>A bare short xmlns prefix conventionally means BlockML core; domain mirrors add a domain token in front, such as mb for MachineBlocks.</summary>
        </sem:SupportingPoint>
      </composition>
    </supportingPoints>
  </aggregations>
</docs:BmlNamespaces>
