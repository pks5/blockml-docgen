<!--BlockML Documentation — Types at a glance (structuring skeleton)

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.page.docs.TypesOverview-->
<page:TypesOverview xmlns="http://blockml.org/bml"
  xmlns:page="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:dlevel="org.blockml.bml.docgen.level"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A website overview of the BlockML type system
  </is>
  <documentation>
    Structuring skeleton for the "Types at a glance" documentation page. Scopes: ValueType kinds,
    type-system entry point, named types overview. Bound authoritative sources:
    org.blockml.bml.documentation.TypeSystemOverview, org.blockml.bml.documentation.TypeExpressions.
    The a03 authoring stage writes the page body from those sources; this skeleton carries only
    page identity, the title / purpose / detailLevel / pageType overrides, and the see links to
    those sources.
  </documentation>
  <references>
    <see type="doc:TypeSystemOverview" relation="Requires">
      Primary content — the four ValueType kinds (Primitive, Enum, Struct, Constant) as sibling branches under ValueType.
    </see>
    <see type="doc:TypeExpressions" relation="SeeAlso">
      Supporting background — everything beyond the four kinds is a type expression, covered on its own page.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Types at a glance</value>
    </title>
    <purpose override="true">
      <value>Introduce the four ValueType kinds as the entry point to the type pages, making clear they are sibling branches rather than subtypes of one another.</value>
    </purpose>
    <detailLevel override="true">
      <value>dlevel:Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>ptype:Concept</value>
    </pageType>
  </properties>
</page:TypesOverview>
