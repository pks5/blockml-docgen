<!--BlockML Documentation — Anatomy of a .bml file (structuring skeleton)

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.page.docs.FileAnatomy-->
<page:FileAnatomy xmlns="http://blockml.org/bml"
  xmlns:page="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:dlevel="org.blockml.bml.docgen.level"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A cheat-sheet for the fields of a .bml root document
  </is>
  <documentation>
    Structuring skeleton for the "Anatomy of a .bml file" documentation page. Scopes: root Block
    document fields, file structure cheat-sheet, ordered members. Bound authoritative sources:
    org.blockml.bml.documentation.DocumentationModel, org.blockml.bml.documentation.DocumentFormat,
    org.blockml.bml.documentation.BlockNameConvention. The a03 authoring stage writes the page
    body from those sources; this skeleton carries only page identity, the title / purpose /
    detailLevel / pageType overrides, and the see links to those sources.
  </documentation>
  <references>
    <see type="doc:DocumentationModel" relation="Requires">
      Primary content — identity first (name / type / baseType), then is and documentation, then the ordered member sections.
    </see>
    <see type="doc:DocumentFormat" relation="Requires">
      Primary content — the element-tag document wrapper and the valid authoring formats.
    </see>
    <see type="doc:BlockNameConvention" relation="SeeAlso">
      Supporting background — PascalCase rules for the name field.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Anatomy of a .bml file</value>
    </title>
    <purpose override="true">
      <value>Give readers a compact structural map of a root Block document — identity fields, then is and documentation, then the ordered member sections — so they can read and lay out a .bml file with confidence.</value>
    </purpose>
    <detailLevel override="true">
      <value>dlevel:Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>ptype:Guide</value>
    </pageType>
  </properties>
</page:FileAnatomy>
