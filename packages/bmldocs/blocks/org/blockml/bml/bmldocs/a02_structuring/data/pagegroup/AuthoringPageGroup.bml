<!--BlockML Documentation — Authoring page group

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.pagegroup.AuthoringPageGroup-->
<pgroup:AuthoringPageGroup xmlns="http://blockml.org/bml"
  xmlns:pgroup="org.blockml.bml.bmldocs.a02_structuring.data.pagegroup"
  xmlns:docs="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dcore="org.blockml.bml.docgen.core">

  <baseType>
    dcore:PageGroup
  </baseType>
  <is>
    The Authoring page group for the a02 documentation set
  </is>
  <documentation>
    Section page group materialized from the plan's AuthoringPageGroup PageGroupPlan.
    Direct pages: ModelingGuidelinesPage, VisibilityBasics, OverridesBasics, ConstraintsBasics,
    AnnotationsAndDirectives. parentGroup is DocsPageGroup.
  </documentation>
  <references>
    <see type="dcore:PageGroup" relation="Extends">
      Docgen page group base.
    </see>
    <see type="pgroup:DocsPageGroup" relation="Requires">
      Parent Documentation page group.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Authoring</value>
    </title>
    <parentGroup override="true">
      <value>pgroup:DocsPageGroup</value>
    </parentGroup>
  </properties>
  <aggregations>
    <pages override="true">
      <composition>
        <docs:ModelingGuidelinesPage />
        <docs:VisibilityBasics />
        <docs:OverridesBasics />
        <docs:ConstraintsBasics />
        <docs:AnnotationsAndDirectives />
      </composition>
    </pages>
  </aggregations>
</pgroup:AuthoringPageGroup>
