<!--BlockML Documentation — What is BlockML? (structuring skeleton)

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.page.docs.Intro-->
<page:Intro xmlns="http://blockml.org/bml"
  xmlns:page="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:dlevel="org.blockml.bml.docgen.level"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A short website introduction to BlockML
  </is>
  <documentation>
    Structuring skeleton for the “What is BlockML?” documentation page. Planned scopes: BlockML overview, mental model, learning path orientation. Purpose and detailLevel are derived from the a01 BmlDocSetPlan PagePlan docs.Intro. This skeleton carries page identity, properties, and authoritative-source references only; sections and prose are authored in the a03 stage.
  </documentation>
  <references>
    <see type="doc:Introduction" relation="Requires">
      Primary content source — BlockML goals and overview.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>What is BlockML?</value>
    </title>
    <purpose override="true">
      <value>Give new readers a clear first mental model of BlockML and prepare them for the more detailed concept pages that follow.</value>
    </purpose>
    <detailLevel override="true">
      <value>dlevel:Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>ptype:Introduction</value>
    </pageType>
  </properties>
</page:Intro>
