<!--BlockML Documentation — What is BlockML? (structuring skeleton)

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.page.docs.Intro-->
<page:Intro xmlns="http://blockml.org/bml"
  xmlns:page="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:dlevel="org.blockml.bml.docgen.level"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A short website introduction to BlockML
  </is>
  <documentation>
    Structuring skeleton for the "What is BlockML?" documentation page. Scopes: BlockML overview,
    mental model, learning path orientation. Bound authoritative sources:
    org.blockml.bml.documentation.Introduction, org.blockml.bml.documentation.EverythingIsABlock.
    The a03 authoring stage writes the page body from those sources; this skeleton carries only
    page identity, the title / purpose / detailLevel / pageType overrides, and the see links to
    those sources.
  </documentation>
  <references>
    <see type="doc:Introduction" relation="Requires">
      Primary content — what BlockML is: a declarative language of composable semantic Blocks, with BML as the authoring format and the BOM as its canonical representation.
    </see>
    <see type="doc:EverythingIsABlock" relation="SeeAlso">
      Supporting background — the everything-is-a-Block mental model the intro previews.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>What is BlockML?</value>
    </title>
    <purpose override="true">
      <value>Give first-time readers BlockML's core idea and vocabulary, then orient them toward the concept pages that follow; keep it to a short introduction rather than a deep dive.</value>
    </purpose>
    <detailLevel override="true">
      <value>dlevel:Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>ptype:Introduction</value>
    </pageType>
  </properties>
</page:Intro>
