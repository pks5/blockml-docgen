<!--BlockML Documentation — Sub-Blocks (structuring skeleton)

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.page.docs.SubBlocksIntro-->
<page:SubBlocksIntro xmlns="http://blockml.org/bml"
  xmlns:page="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:dlevel="org.blockml.bml.docgen.level"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A website introduction to Sub-Blocks
  </is>
  <documentation>
    Structuring skeleton for the "Sub-Blocks" documentation page. Scopes: Sub-Blocks, nested types,
    parent Block nesting. Bound authoritative sources:
    org.blockml.bml.documentation.SubBlockModel, org.blockml.bml.documentation.TypeIdentityDerivation.
    The a03 authoring stage writes the page body from those sources; this skeleton carries only
    page identity, the title / purpose / detailLevel / pageType overrides, and the see links to
    those sources.
  </documentation>
  <references>
    <see type="doc:SubBlockModel" relation="Requires">
      Primary content — Sub-Blocks as Block definitions nested inside a parent, like static nested classes, declared under subBlocks.
    </see>
    <see type="doc:TypeIdentityDerivation" relation="Requires">
      Primary content — how a Sub-Block's canonical FQN is derived from the parent's prefix.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Sub-Blocks</value>
    </title>
    <purpose override="true">
      <value>Introduce Sub-Blocks as parent-nested definitions that share the parent's FQN prefix and have no enclosing-instance scope, and show how their identity is formed.</value>
    </purpose>
    <detailLevel override="true">
      <value>dlevel:Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>ptype:Concept</value>
    </pageType>
  </properties>
</page:SubBlocksIntro>
