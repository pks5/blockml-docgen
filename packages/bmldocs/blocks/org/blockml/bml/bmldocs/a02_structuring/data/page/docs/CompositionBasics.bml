<!--BlockML Documentation — Composition (structuring skeleton)

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.page.docs.CompositionBasics-->
<page:CompositionBasics xmlns="http://blockml.org/bml"
  xmlns:page="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A website introduction to composition
  </is>
  <documentation>
    Structuring skeleton for the "Composition" documentation page. Scopes: aggregations,
    composition fill, child Block instances. Bound authoritative sources:
    org.blockml.bml.documentation.CompositionModel, org.blockml.bml.documentation.MemberAuthoring.
    The a03 authoring stage writes the page body from those sources; this skeleton carries only
    page identity, the title / purpose / detailLevel / pageType overrides, and the see links to
    those sources.
  </documentation>
  <references>
    <see type="doc:CompositionModel" relation="Requires">
      Primary content — a Composition fills an Aggregation with concrete child Block instances; nesting on definitions versus direct member-name fill on instances.
    </see>
    <see type="doc:MemberAuthoring" relation="SeeAlso">
      Supporting background — the common mistake of wrapping instance aggregation children in composition.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Composition</value>
    </title>
    <purpose override="true">
      <value>Show how an aggregation receives concrete child Block instances through composition, and contrast the definition-side and instance-side syntax so readers avoid the usual wrapper mistakes.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
</page:CompositionBasics>
