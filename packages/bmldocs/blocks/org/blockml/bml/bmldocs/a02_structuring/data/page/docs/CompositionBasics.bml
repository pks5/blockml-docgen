<!--BlockML Documentation — Composition (structuring skeleton)

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.page.docs.CompositionBasics-->
<page:CompositionBasics xmlns="http://blockml.org/bml"
  xmlns:page="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:dlevel="org.blockml.bml.docgen.level"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A website intro to composition
  </is>
  <documentation>
    Structuring skeleton for the “Composition” documentation page. Planned scopes: aggregations, composition fill, child Block instances. Purpose and detailLevel are derived from the a01 BmlDocSetPlan PagePlan docs.CompositionBasics. This skeleton carries page identity, properties, and authoritative-source references only; sections and prose are authored in the a03 stage.
  </documentation>
  <references>
    <see type="doc:CompositionModel" relation="Requires">
      Primary content — aggregation fill, placement, and recursion.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Composition</value>
    </title>
    <purpose override="true">
      <value>Explain how aggregations receive child Block instances through composition.</value>
    </purpose>
    <detailLevel override="true">
      <value>dlevel:Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>ptype:Concept</value>
    </pageType>
  </properties>
</page:CompositionBasics>
