<!--BlockML Documentation — Behaviour page group

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.pagegroup.BehaviourPageGroup-->
<pgroup:BehaviourPageGroup xmlns="http://blockml.org/bml"
  xmlns:pgroup="org.blockml.bml.bmldocs.a02_structuring.data.pagegroup"
  xmlns:docs="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dcore="org.blockml.bml.docgen.core">

  <baseType>
    dcore:PageGroup
  </baseType>
  <is>
    The Behaviour page group for the a02 documentation set
  </is>
  <documentation>
    Section page group materialized from the plan's BehaviourPageGroup PageGroupPlan.
    Direct pages: CapabilitiesIntro, ExpressionsIntro, EmbeddedExpressionsIntro.
    parentGroup is DocsPageGroup.
  </documentation>
  <references>
    <see type="dcore:PageGroup" relation="Extends">
      Docgen page group base.
    </see>
    <see type="pgroup:DocsPageGroup" relation="Requires">
      Parent Documentation page group.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Behaviour</value>
    </title>
    <parentGroup override="true">
      <value>pgroup:DocsPageGroup</value>
    </parentGroup>
  </properties>
  <aggregations>
    <pages override="true">
      <composition>
        <docs:CapabilitiesIntro />
        <docs:ExpressionsIntro />
        <docs:EmbeddedExpressionsIntro />
      </composition>
    </pages>
  </aggregations>
</pgroup:BehaviourPageGroup>
