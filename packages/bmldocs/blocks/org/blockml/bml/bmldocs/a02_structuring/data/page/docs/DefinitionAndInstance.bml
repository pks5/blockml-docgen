<!--BlockML Documentation — Definition and instance (structuring skeleton)

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.page.docs.DefinitionAndInstance-->
<page:DefinitionAndInstance xmlns="http://blockml.org/bml"
  xmlns:page="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:dlevel="org.blockml.bml.docgen.level"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A website page for definition versus instance
  </is>
  <documentation>
    Structuring skeleton for the “Definition and instance” documentation page. Planned scopes: Block definition, Block instance, definition versus instance distinction. Purpose and detailLevel are derived from the a01 BmlDocSetPlan PagePlan docs.DefinitionAndInstance. This skeleton carries page identity, properties, and authoritative-source references only; sections and prose are authored in the a03 stage.
  </documentation>
  <references>
    <see type="doc:BlockAndInstance" relation="Requires">
      Primary content — definition, Block, instance, and composition.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Definition and instance</value>
    </title>
    <purpose override="true">
      <value>Clarify the distinction between Block definitions and Block instances.</value>
    </purpose>
    <detailLevel override="true">
      <value>dlevel:Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>ptype:Concept</value>
    </pageType>
  </properties>
</page:DefinitionAndInstance>
