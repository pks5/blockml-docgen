<!--BlockML Documentation — Definition and instance (structuring skeleton)

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.page.docs.DefinitionAndInstance-->
<page:DefinitionAndInstance xmlns="http://blockml.org/bml"
  xmlns:page="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:dlevel="org.blockml.bml.docgen.level"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A website page on the Block definition versus instance distinction
  </is>
  <documentation>
    Structuring skeleton for the "Definition and instance" documentation page. Scopes: Block
    definition, Block instance, definition versus instance distinction. Bound authoritative
    sources: org.blockml.bml.documentation.BlockAndInstance,
    org.blockml.bml.documentation.MemberAuthoring. The a03 authoring stage writes the page body
    from those sources; this skeleton carries only page identity, the title / purpose /
    detailLevel / pageType overrides, and the see links to those sources.
  </documentation>
  <references>
    <see type="doc:BlockAndInstance" relation="Requires">
      Primary content — a Block is a declarative semantic class; a Block instance is an object; the analogy is semantic, not a runtime-OOP mandate.
    </see>
    <see type="doc:MemberAuthoring" relation="SeeAlso">
      Supporting background — how definition-declaration syntax differs from instance-assignment syntax.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Definition and instance</value>
    </title>
    <purpose override="true">
      <value>Make the definition/instance split precise and warn that it is a semantic analogy rather than a claim about runtime objects, so readers stop conflating the two.</value>
    </purpose>
    <detailLevel override="true">
      <value>dlevel:Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>ptype:Concept</value>
    </pageType>
  </properties>
</page:DefinitionAndInstance>
