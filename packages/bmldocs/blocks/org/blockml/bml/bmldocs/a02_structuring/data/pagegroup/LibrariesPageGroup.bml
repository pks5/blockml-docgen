<!--BlockML Documentation — Libraries page group (A02 structuring)

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.pagegroup.LibrariesPageGroup-->
<pgroup:LibrariesPageGroup xmlns="http://blockml.org/bml"
  xmlns:pgroup="org.blockml.bml.bmldocs.a02_structuring.data.pagegroup"
  xmlns:page="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dcore="org.blockml.bml.docgen.core">

  <baseType>
    dcore:PageGroup
  </baseType>
  <is>
    A documentation page group for Libraries
  </is>
  <documentation>
    A02 structuring PageGroup materialized from BmlDocSetPlan (LibrariesPageGroup,
    title "Libraries"). Nests under DocsPageGroup via parentGroup. pages lists
    this section's PagePlan children in plan order.
  </documentation>
  <references>
    <see type="dcore:PageGroup" relation="Extends">
      Docgen page group base.
    </see>
    <see type="pgroup:DocsPageGroup" relation="Requires">
      Parent Documentation page group.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Libraries</value>
    </title>
    <parentGroup override="true">
      <value>pgroup:DocsPageGroup</value>
    </parentGroup>
  </properties>
  <aggregations>
    <pages override="true">
      <composition>
        <page:LibrariesAndPackages />
        <page:ReadmeAndBootstrap />
      </composition>
    </pages>
  </aggregations>
</pgroup:LibrariesPageGroup>
