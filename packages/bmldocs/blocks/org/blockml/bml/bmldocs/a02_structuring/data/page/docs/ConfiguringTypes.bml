<!--BlockML Documentation — Configuring ValueTypes (structuring skeleton)

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.page.docs.ConfiguringTypes-->
<page:ConfiguringTypes xmlns="http://blockml.org/bml"
  xmlns:page="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:dlevel="org.blockml.bml.docgen.level"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A website page on configuring ValueType instances
  </is>
  <documentation>
    Structuring skeleton for the "Configuring ValueTypes" documentation page. Scopes: ValueType
    configuration, curly-brace property config, configured types. Bound authoritative sources:
    org.blockml.bml.documentation.ValueTypeConfiguration, org.blockml.bml.documentation.ConstantValueType.
    The a03 authoring stage writes the page body from those sources; this skeleton carries only
    page identity, the title / purpose / detailLevel / pageType overrides, and the see links to
    those sources.
  </documentation>
  <references>
    <see type="doc:ValueTypeConfiguration" relation="Requires">
      Primary content — curly braces configure the property's owned ValueType instance, orthogonal to generic binding, with multiplicity applied afterwards.
    </see>
    <see type="doc:ConstantValueType" relation="SeeAlso">
      Supporting background — Constant(T){value: ...} as a configured singleton domain.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Configuring ValueTypes</value>
    </title>
    <purpose override="true">
      <value>Show how curly-brace configuration tunes the ValueType instance a property owns, how it differs from generic binding, and how the two combine on one property.</value>
    </purpose>
    <detailLevel override="true">
      <value>dlevel:Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>ptype:Guide</value>
    </pageType>
  </properties>
</page:ConfiguringTypes>
