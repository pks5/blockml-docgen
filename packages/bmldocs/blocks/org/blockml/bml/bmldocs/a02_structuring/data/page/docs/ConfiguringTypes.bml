<page:ConfiguringTypes xmlns="http://blockml.org/bml"
  xmlns:page="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:dlevel="org.blockml.bml.docgen.level"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A website page for ValueType configuration
  </is>
  <documentation>
    Structuring skeleton for the “Configuring ValueTypes” documentation page. Planned scopes: ValueType configuration, curly-brace property config, configured types. Purpose and detailLevel are derived from the a01 BmlDocSetPlan PagePlan docs.ConfiguringTypes. This skeleton carries page identity, properties, and authoritative-source references only; sections and prose are authored in the a03 stage.
  </documentation>
  <references>
    <see type="doc:ValueTypeConfiguration" relation="Requires">
      Primary content source — ValueType instance configuration on property types.
    </see>
    <see type="doc:ConstantValueType" relation="Requires">
      Primary content source — Constant(T) singleton domains.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Configuring ValueTypes</value>
    </title>
    <purpose override="true">
      <value>Explain curly-brace configuration of ValueType instances on properties.</value>
    </purpose>
    <detailLevel override="true">
      <value>dlevel:Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>ptype:Guide</value>
    </pageType>
  </properties>
</page:ConfiguringTypes>
