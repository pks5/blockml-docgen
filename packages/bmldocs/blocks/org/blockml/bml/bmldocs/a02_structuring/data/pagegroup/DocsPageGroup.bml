<!--BlockML Documentation — Documentation page group (A02 structuring)

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.pagegroup.DocsPageGroup-->
<pgroup:DocsPageGroup xmlns="http://blockml.org/bml"
  xmlns:pgroup="org.blockml.bml.bmldocs.a02_structuring.data.pagegroup"
  xmlns:page="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dcore="org.blockml.bml.docgen.core">

  <baseType>
    dcore:PageGroup
  </baseType>
  <is>
    The Documentation page group for blockml.org docs
  </is>
  <documentation>
    A02 structuring PageGroup materialized from BmlDocSetPlan (DocsPageGroup,
    title "Documentation"). Nests under RootPageGroup via parentGroup. Direct
    page: TableOfContents. Section PageGroups nest under this group.
  </documentation>
  <references>
    <see type="dcore:PageGroup" relation="Extends">
      Docgen page group base.
    </see>
    <see type="pgroup:RootPageGroup" relation="Requires">
      Top-level site root page group.
    </see>
    <see type="page:TableOfContents" relation="Requires">
      Direct page of this documentation group.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Documentation</value>
    </title>
    <parentGroup override="true">
      <value>pgroup:RootPageGroup</value>
    </parentGroup>
  </properties>
  <aggregations>
    <pages override="true">
      <composition>
        <page:TableOfContents />
      </composition>
    </pages>
  </aggregations>
</pgroup:DocsPageGroup>
