<!--BlockML Documentation — Documentation page group

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.pagegroup.DocsPageGroup-->
<pgroup:DocsPageGroup xmlns="http://blockml.org/bml"
  xmlns:pgroup="org.blockml.bml.bmldocs.a02_structuring.data.pagegroup"
  xmlns:docs="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dcore="org.blockml.bml.docgen.core">

  <baseType>
    dcore:PageGroup
  </baseType>
  <is>
    The Documentation page group for the a02 documentation set
  </is>
  <documentation>
    Documentation subtree under RootPageGroup, materialized from the plan's DocsPageGroup
    PageGroupPlan. Direct pages: TableOfContents. Section PageGroups (GettingStarted, CoreIdeas,
    Types, Behaviour, Libraries, Authoring, DeeperTopics, HowTo) nest under this group via
    parentGroup.
  </documentation>
  <references>
    <see type="dcore:PageGroup" relation="Extends">
      Docgen page group base.
    </see>
    <see type="pgroup:RootPageGroup" relation="Requires">
      Top-level root page group.
    </see>
    <see type="docs:TableOfContents" relation="Requires">
      Direct page of this group.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Documentation</value>
    </title>
    <parentGroup override="true">
      <value>pgroup:RootPageGroup</value>
    </parentGroup>
  </properties>
  <aggregations>
    <pages override="true">
      <composition>
        <docs:TableOfContents />
      </composition>
    </pages>
  </aggregations>
</pgroup:DocsPageGroup>
