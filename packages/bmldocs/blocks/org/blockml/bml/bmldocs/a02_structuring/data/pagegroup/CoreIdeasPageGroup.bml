<!--BlockML Documentation — Core Ideas page group

  FQN: org.blockml.bml.bmldocs.a02_structuring.data.pagegroup.CoreIdeasPageGroup-->
<pgroup:CoreIdeasPageGroup xmlns="http://blockml.org/bml"
  xmlns:pgroup="org.blockml.bml.bmldocs.a02_structuring.data.pagegroup"
  xmlns:docs="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:dcore="org.blockml.bml.docgen.core">

  <baseType>
    dcore:PageGroup
  </baseType>
  <is>
    The Core Ideas page group for the a02 documentation set
  </is>
  <documentation>
    Section page group materialized from the plan's CoreIdeasPageGroup PageGroupPlan.
    Direct pages: EverythingIsABlockPage, DefinitionAndInstance, CompositionBasics.
    parentGroup is DocsPageGroup.
  </documentation>
  <references>
    <see type="dcore:PageGroup" relation="Extends">
      Docgen page group base.
    </see>
    <see type="pgroup:DocsPageGroup" relation="Requires">
      Parent Documentation page group.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Core Ideas</value>
    </title>
    <parentGroup override="true">
      <value>pgroup:DocsPageGroup</value>
    </parentGroup>
  </properties>
  <aggregations>
    <pages override="true">
      <composition>
        <docs:EverythingIsABlockPage />
        <docs:DefinitionAndInstance />
        <docs:CompositionBasics />
      </composition>
    </pages>
  </aggregations>
</pgroup:CoreIdeasPageGroup>
