<!--BlockML Documentation — abstract bmldocs DocPage base

  FQN: org.blockml.bml.bmldocs.lib.page.BmlDocPage-->
<lpage:BmlDocPage xmlns="http://blockml.org/bml"
  xmlns:lpage="org.blockml.bml.bmldocs.lib.page"
  xmlns:adata="org.blockml.bml.bmldocs.a03_authoring.data"
  xmlns:dpage="org.blockml.bml.docgen.page">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A DocPage belonging to the BlockML core documentation set
  </is>
  <isNot>
    A narrative bml-core Documentation Block or a DocPage outside BmlDocSet
  </isNot>
  <documentation>
    Abstract base for all concrete blockml.org documentation pages under
    org.blockml.bml.bmldocs.a03_authoring.data.page.docs.*. Fixes docset to BmlDocSet so every page belongs to the
    BlockML core documentation set; pageKey and path remain on BmlDocSet.pageMapping.
  </documentation>
  <abstract>
    true
  </abstract>
  <references>
    <see type="dpage:DocPage" relation="Extends">
      Docgen human-facing documentation page marker.
    </see>
    <see type="adata:BmlDocSet" relation="Requires">
      Documentation set bound via docset.
    </see>
  </references>
  <properties>
    <docset override="true">
      <value>adata:BmlDocSet</value>
    </docset>
  </properties>
</lpage:BmlDocPage>
