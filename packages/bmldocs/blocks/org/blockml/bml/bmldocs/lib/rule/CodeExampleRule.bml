<!--BlockML Documentation — code example content rule

  FQN: org.blockml.bml.bmldocs.lib.rule.CodeExampleRule-->
<lrule:CodeExampleRule xmlns="http://blockml.org/bml"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule"
  xmlns:rule="org.blockml.bml.docgen.rule">

  <baseType>
    rule:ContentRule
  </baseType>
  <is>
    A content rule for complete and focused BlockML code examples
  </is>
  <documentation>
    Page-rendering obligation: how to fill CodeBlock.code once a CodeBlock already exists.
    Every listing must be a complete, valid Block rather than an isolated snippet, with
    enough surrounding structure to make the illustrated construct understandable. Highlight
    the demonstrated section with an XML comment immediately before it.

    Placing the CodeBlock element belongs to CodeExamplePlacementRule at authoring.
    This rule does not add CodeBlocks to a page that has none.
  </documentation>
  <references>
    <see type="rule:ContentRule" relation="Extends">
      Documentation content-rule branch.
    </see>
    <see type="lrule:CodeExamplePlacementRule" relation="SeeAlso">
      Authoring-stage placement of the CodeBlock this rule fills.
    </see>
  </references>
  <properties>
    <name override="true">
      <value>Code examples</value>
    </name>
    <summary override="true">
      <value>Use complete BlockML Blocks and highlight the relevant section with an XML
comment.</value>
    </summary>
    <instructions override="true">
      <value>When filling CodeBlock.code, generate every BlockML listing as a complete Block,
never as an isolated snippet. Include the surrounding Block structure necessary to
understand the example in context. Immediately before the section that demonstrates
the concept being explained, add a concise XML comment that highlights the relevant
section. Keep unrelated parts of the Block simple so that they provide context without
distracting from the concept being demonstrated. Do not add, remove, or reorder
CodeBlock elements to satisfy this rule.</value>
    </instructions>
  </properties>
</lrule:CodeExampleRule>
