<!--BlockML Documentation — match declared detail level content rule

  FQN: org.blockml.bml.bmldocs.lib.rule.MatchDetailLevelRule-->
<lrule:MatchDetailLevelRule xmlns="http://blockml.org/bml"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule"
  xmlns:rule="org.blockml.bml.docgen.rule">

  <baseType>
    rule:ContentRule
  </baseType>
  <is>
    A content rule requiring generated detail to match DetailLevel
  </is>
  <documentation>
    Requires that generated detail matches the declared DetailLevel. Introductory and overview
    content must omit internal type names, parser structures, diagnostic identifiers,
    version-specific behavior, and implementation-status notes. Such details belong only at
    Detailed, Reference, Exhaustive, or Implementation level.
  </documentation>
  <references>
    <see type="rule:ContentRule" relation="Extends">
      Documentation content-rule branch.
    </see>
  </references>
  <properties>
    <name override="true">
      <value>Match detail level</value>
    </name>
    <summary override="true">
      <value>Generated detail must match the declared DetailLevel.</value>
    </summary>
    <instructions override="true">
      <value>For introductory or overview content, omit internal type names, parser structures,
diagnostic identifiers, version-specific behavior, and implementation-status notes.
Include such details only at Detailed, Reference, Exhaustive, or Implementation level.</value>
    </instructions>
  </properties>
</lrule:MatchDetailLevelRule>
