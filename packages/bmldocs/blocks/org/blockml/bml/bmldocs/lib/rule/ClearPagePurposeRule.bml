<!--BlockML Documentation — clear page purpose rule

  FQN: org.blockml.bml.bmldocs.lib.rule.ClearPagePurposeRule-->
<lrule:ClearPagePurposeRule xmlns="http://blockml.org/bml"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule"
  xmlns:rule="org.blockml.bml.docgen.rule"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:dplan="org.blockml.bml.docgen.plan">

  <baseType>
    rule:ContentRule
  </baseType>
  <is>
    A content rule requiring every concrete Page to have a clear formulated purpose
  </is>
  <documentation>
    Defines how Page.purpose is established during DocSet structuring.

    Every concrete Page must override purpose with a clear, specific, and unambiguous
    renderer instruction: why the page exists in the DocSet and what it must accomplish.
    purpose is not PagePlan planning text, not a topic list, and not reader-facing body
    copy.

    Planning already set direction via PagePlan.scope, readerOutcome, learningObjective,
    exclusion, and supportingPoint (see PagePlanDirectionRule). Structuring formulates
    purpose from that direction and the bound authoritative sources — one focused
    objective, distinct from neighbouring pages.

    Do not prescribe sections, examples, or finished handbook prose in purpose. Those
    belong to later authoring and rendering.
  </documentation>
  <references>
    <see type="rule:ContentRule" relation="Extends">
      Documentation content-rule branch.
    </see>
    <see type="dcore:Page" relation="Requires">
      Concrete page whose purpose property this rule constrains.
    </see>
    <see type="dplan:PagePlan" relation="SeeAlso">
      Planning direction — refined into Page.purpose during structuring.
    </see>
    <see type="lrule:PagePlanDirectionRule" relation="SeeAlso">
      Keeps PagePlan fields coarse; this rule applies after that altitude.
    </see>
  </references>
  <properties>
    <name override="true">
      <value>Clear page purpose</value>
    </name>
    <summary override="true">
      <value>Formulate a clear Page.purpose from the plan direction and bound sources.</value>
    </summary>
    <instructions override="true">
      <value>When writing a concrete Page skeleton, override purpose as a finished renderer
instruction: why this page exists and what it must accomplish. Ground purpose in the
PagePlan direction fields and the bound authoritative sources. Keep one focused
objective. Do not copy PagePlan.scope verbatim into purpose, do not leave purpose as
a topic list, and do not prescribe sections, examples, or body prose.</value>
    </instructions>
  </properties>
</lrule:ClearPagePurposeRule>
