<!--BlockML Documentation — stable page identity rule

  FQN: org.blockml.bml.bmldocs.lib.rule.StablePageIdentityRule-->
<lrule:StablePageIdentityRule xmlns="http://blockml.org/bml"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule"
  xmlns:rule="org.blockml.bml.docgen.rule"
  xmlns:dplan="org.blockml.bml.docgen.plan"
  xmlns:dcore="org.blockml.bml.docgen.core">

  <baseType>
    rule:StructureRule
  </baseType>
  <is>
    A structure rule requiring page identity to stay stable unless the conceptual role changes
  </is>
  <documentation>
    Defines how page identity is preserved across planning and structuring updates.

    Planning: a PagePlan that still represents the same conceptual page retains its
    relative PagePlan.name. Do not rename merely because wording, ordering, scopes,
    or supporting fields evolve.

    Structuring: the concrete Page keeps the same FQN / file path derived from
    PagePlan.name (a02 page package + name). When regenerating a skeleton, overwrite
    content in place — do not invent a replacement Block for the same conceptual page.

    Identity changes only when the page is conceptually replaced, split, merged, or
    intentionally relocated as a different page. Prefer stable names so later sectors
    can recognize and update the same Blocks.
  </documentation>
  <references>
    <see type="rule:StructureRule" relation="Extends">
      Documentation structure-rule branch.
    </see>
    <see type="dplan:PagePlan" relation="Requires">
      Relative name preserved during plan updates.
    </see>
    <see type="dcore:Page" relation="Requires">
      Concrete page FQN preserved when regenerating skeletons.
    </see>
  </references>
  <properties>
    <name override="true">
      <value>Stable page identity</value>
    </name>
    <summary override="true">
      <value>Preserve PagePlan.name and the derived Page FQN unless the conceptual role changed.</value>
    </summary>
    <instructions override="true">
      <value>When updating a DocSetPlan, preserve PagePlan.name for every page that still
represents the same conceptual page. When regenerating page skeletons, keep the same
FQN / file path and overwrite that Block — do not create a replacement under a new
name for the same role. Change identity only when the page is replaced, split, merged,
or intentionally relocated as a different page. Do not rename merely because scopes,
wording, order, or later content evolve.</value>
    </instructions>
  </properties>
</lrule:StablePageIdentityRule>
