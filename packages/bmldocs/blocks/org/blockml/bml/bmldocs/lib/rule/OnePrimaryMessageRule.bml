<!--BlockML Documentation — one primary message content rule

  FQN: org.blockml.bml.bmldocs.lib.rule.OnePrimaryMessageRule-->
<lrule:OnePrimaryMessageRule xmlns="http://blockml.org/bml"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule"
  xmlns:rule="org.blockml.bml.docgen.rule">

  <baseType>
    rule:ContentRule
  </baseType>
  <is>
    A content rule requiring one primary message per ContentElement
  </is>
  <documentation>
    Requires that every ContentElement communicates exactly one primary message. Supporting
    details may clarify that statement; unrelated topics must move into separate ContentElements
    or be omitted.
  </documentation>
  <references>
    <see type="rule:ContentRule" relation="Extends">
      Documentation content-rule branch.
    </see>
  </references>
  <properties>
    <name override="true">
      <value>One primary message</value>
    </name>
    <summary override="true">
      <value>Every ContentElement communicates one primary message.</value>
    </summary>
    <instructions override="true">
      <value>Generate each ContentElement around exactly one central factual or conceptual
statement. Supporting details may clarify that statement, but unrelated topics must be
moved into separate ContentElements or omitted.</value>
    </instructions>
  </properties>
</lrule:OnePrimaryMessageRule>
