<!--Workspace program — BuildA03
  FQN: org.blockml.bml.bmldocs.program.BuildA03-->
<program:BuildA01 xmlns="http://blockml.org/bml"
  xmlns:workflow="org.blockml.bml.transformer.workflow"
  xmlns:type="org.blockml.bml.type"
  xmlns:program="org.blockml.bml.bmldocs.program"
  xmlns:a01_task="org.blockml.bml.bmldocs.a01_planning.task">

  <baseType>
    workflow:ModelTransformation(program:BuildA01.Parameters, type:Text)
  </baseType>
  <is>
    A pending ModelTransformation that creates the doc set plan.
  </is>
  <properties>
    <description override="true">
      <value>A transformation that creates the doc set plan.</value>
    </description>
    <status override="true" type="workflow:ExecutionStatus">
      <value>Pending</value>
    </status>
    <createdAt override="true" type="type:DateTime">
      <value>2026-09-06T00:00:00</value>
    </createdAt>
    <template override="true" type="type:Boolean">
      <value>true</value>
    </template>
  </properties>
  <aggregations>
    <operations override="true">
      <composition>
        <workflow:AgenticOperation name="Create A01 Plan" status="Pending" captureOutput="true">
          <task>
            <a01_task:A01_CreatePlan />
          </task>
        </workflow:AgenticOperation>
      </composition>
    </operations>
  </aggregations>
  <subBlocks>
    <Parameters>
      <baseType>
        type:StructType
      </baseType>
      <is>
        Run parameters for this transformation
      </is>
      <properties>
       
      </properties>
    </Parameters>
  </subBlocks>
</program:BuildA01>
