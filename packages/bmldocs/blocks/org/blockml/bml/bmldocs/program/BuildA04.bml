<!--Workspace program — BuildA04
  FQN: org.blockml.bml.bmldocs.program.BuildA04-->
<program:BuildA04 xmlns="http://blockml.org/bml"
  xmlns:workflow="org.blockml.bml.transformer.workflow"
  xmlns:type="org.blockml.bml.type"
  xmlns:program="org.blockml.bml.bmldocs.program"
  xmlns:a04_task="org.blockml.bml.bmldocs.a04_rendering.task">

  <baseType>
    workflow:ModelTransformation(program:BuildA04.Parameters, type:Text)
  </baseType>
  <is>
    A pending ModelTransformation that builds the A04 rendering data
  </is>
  <properties>
    <description override="true">
      <value>A transformation that imports A03 data into A04 and renders the pages.</value>
    </description>
    <status override="true" type="workflow:ExecutionStatus">
      <value>Pending</value>
    </status>
    <createdAt override="true" type="type:DateTime">
      <value>2026-09-06T00:00:00</value>
    </createdAt>
    <template override="true" type="type:Boolean">
      <value>true</value>
    </template>
  </properties>
  <aggregations>
    <operations override="true">
      <composition>
        <workflow:AgenticOperation name="Copy A03 data into A04" status="Pending" captureOutput="true">
          <task>
            <a04_task:A04_01_CopyData />
          </task>
        </workflow:AgenticOperation>
        <workflow:AgenticOperation name="Render A04 pages" status="Pending" captureOutput="true">
          <task>
            <a04_task:A04_02_RenderPages />
          </task>
        </workflow:AgenticOperation>
      </composition>
    </operations>
  </aggregations>
  <subBlocks>
    <Parameters>
      <baseType>
        type:StructType
      </baseType>
      <is>
        Run parameters for this transformation
      </is>
      <properties>
       
      </properties>
    </Parameters>
  </subBlocks>
</program:BuildA04>
