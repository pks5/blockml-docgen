<!--Workspace program — BuildAll
  FQN: org.blockml.bml.bmldocs.program.BuildAll-->
<program:BuildAll xmlns="http://blockml.org/bml"
  xmlns:workflow="org.blockml.bml.transformer.workflow"
  xmlns:type="org.blockml.bml.type"
  xmlns:program="org.blockml.bml.bmldocs.program"
  xmlns:a01_task="org.blockml.bml.bmldocs.a01_planning.task"
  xmlns:a02_task="org.blockml.bml.bmldocs.a02_structuring.task"
  xmlns:a03_task="org.blockml.bml.bmldocs.a03_authoring.task"
  xmlns:a04_task="org.blockml.bml.bmldocs.a04_rendering.task">

  <baseType>
    workflow:ModelTransformation(program:BuildAll.Parameters, type:Text)
  </baseType>
  <is>
    A pending ModelTransformation that creates skeletons for all planned pages.
  </is>
  <properties>
    <description override="true">
      <value>A transformation that creates skeletons for all planned pages.</value>
    </description>
    <status override="true" type="workflow:ExecutionStatus">
      <value>Pending</value>
    </status>
    <createdAt override="true" type="type:DateTime">
      <value>2026-09-06T00:00:00</value>
    </createdAt>
    <template override="true" type="type:Boolean">
      <value>true</value>
    </template>
    <parameters override="true" type="program:BuildAll.Parameters">
      <value>{targetBlock:"org.blockml.bml.workspace.program.RandomBlock"}</value>
    </parameters>
  </properties>
  <aggregations>
    <operations override="true">
      <composition>
        <workflow:AgenticOperation name="Create A01 Plan" status="Pending" captureOutput="true">
          <task>
            <a01_task:A01_01_CreatePlan />
          </task>
        </workflow:AgenticOperation>
        <workflow:AgenticOperation name="Update A02 doc set" status="Pending" captureOutput="true">
          <task>
            <a02_task:A02_01_UpdateDocSet />
          </task>
        </workflow:AgenticOperation>
        <workflow:AgenticOperation name="Update A02 page skeletons" status="Pending" captureOutput="true">
          <task>
            <a02_task:A02_02_UpdatePageSkeletons />
          </task>
        </workflow:AgenticOperation>
        <workflow:AgenticOperation name="Update A02 page groups" status="Pending" captureOutput="true">
          <task>
            <a02_task:A02_03_UpdatePageGroups />
          </task>
        </workflow:AgenticOperation>
        <workflow:AgenticOperation name="Copy A02 data into A03" status="Pending" captureOutput="true">
          <task>
            <a03_task:A03_01_CopyData />
          </task>
        </workflow:AgenticOperation>
        <workflow:AgenticOperation name="Author A03 pages" status="Pending" captureOutput="true">
          <task>
            <a03_task:A03_02_AuthorPages />
          </task>
        </workflow:AgenticOperation>
        <workflow:AgenticOperation name="Copy A03 data into A04" status="Pending" captureOutput="true">
          <task>
            <a04_task:A04_01_CopyData />
          </task>
        </workflow:AgenticOperation>
        <workflow:AgenticOperation name="Render A04 pages" status="Pending" captureOutput="true">
          <task>
            <a04_task:A04_02_RenderPages />
          </task>
        </workflow:AgenticOperation>
      </composition>
    </operations>
  </aggregations>
  <subBlocks>
    <Parameters>
      <baseType>
        type:StructType
      </baseType>
      <is>
        Run parameters for this transformation
      </is>
      <properties>
        <targetBlock type="type:Text" />
      </properties>
    </Parameters>
  </subBlocks>
</program:BuildAll>
