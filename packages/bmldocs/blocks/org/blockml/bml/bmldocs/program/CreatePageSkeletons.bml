<!--Workspace program — CreatePageSkeletons
  FQN: org.blockml.bml.bmldocs.program.CreatePageSkeletons-->
<program:CreatePageSkeletons xmlns="http://blockml.org/bml"
  xmlns:workflow="org.blockml.bml.transformer.workflow"
  xmlns:type="org.blockml.bml.type"
  xmlns:program="org.blockml.bml.bmldocs.program"
  xmlns:a02_task="org.blockml.bml.bmldocs.a02_structuring.task">

  <baseType>
    workflow:ModelTransformation(program:CreatePageSkeletons.Parameters, type:Text)
  </baseType>
  <is>
    A pending ModelTransformation that creates skeletons for all planned pages.
  </is>
  <properties>
    <description override="true">
      <value>A transformation that creates skeletons for all planned pages.</value>
    </description>
    <status override="true" type="workflow:ExecutionStatus">
      <value>Pending</value>
    </status>
    <createdAt override="true" type="type:DateTime">
      <value>2026-09-06T00:00:00</value>
    </createdAt>
    <template override="true" type="type:Boolean">
      <value>true</value>
    </template>
    <parameters override="true" type="program:CreatePageSkeletons.Parameters">
      <value>{targetBlock:"org.blockml.bml.workspace.program.RandomBlock"}</value>
    </parameters>
  </properties>
  <aggregations>
    <operations override="true">
      <composition>
        <workflow:AgenticOperation name="Update A02 page skeletons" status="Pending" captureOutput="true">
          <task>
            <a02_task:A02_UpdatePageSkeletons />
          </task>
        </workflow:AgenticOperation>
        <workflow:AgenticOperation name="Update A02 page groups" status="Pending" captureOutput="true">
          <task>
            <a02_task:A02_UpdatePageGroups />
          </task>
        </workflow:AgenticOperation>
      </composition>
    </operations>
  </aggregations>
  <subBlocks>
    <Parameters>
      <baseType>
        type:StructType
      </baseType>
      <is>
        Run parameters for this transformation
      </is>
      <properties>
        <targetBlock type="type:Text" />
      </properties>
    </Parameters>
  </subBlocks>
</program:CreatePageSkeletons>
