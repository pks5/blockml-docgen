<!--BlockML Documentation — abstract bmldocs DocPage base

  FQN: org.blockml.bml.bmldocs.docset.BmlDocPage-->
<docset:BmlDocPage xmlns="http://blockml.org/bml"
  xmlns:docset="org.blockml.bml.bmldocs.docset"
  xmlns:structuring="org.blockml.bml.bmldocs.a02_structuring"
  xmlns:dpage="org.blockml.bml.docgen.page">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A DocPage belonging to the BlockML core documentation set
  </is>
  <isnot>
    A narrative bml-core Documentation Block or a DocPage outside BmlDocSet
  </isnot>
  <documentation>
    Abstract base for all concrete blockml.org documentation pages under
    org.blockml.bml.bmldocs.page.docs.*. Fixes docset to BmlDocSet so every page belongs to the
    BlockML core documentation set; pageKey and path remain on BmlDocSet.pageMapping.
  </documentation>
  <abstract>
    true
  </abstract>
  <references>
    <see type="dpage:DocPage" relation="Extends">
      Docgen human-facing documentation page marker.
    </see>
    <see type="structuring:BmlDocSet" relation="Requires">
      Documentation set bound via docset.
    </see>
  </references>
  <properties>
    <docset override="true">
      <value>structuring:BmlDocSet</value>
    </docset>
  </properties>
</docset:BmlDocPage>
