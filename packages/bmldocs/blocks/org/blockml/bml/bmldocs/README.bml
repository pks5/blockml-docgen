<!--BlockML Documentation Sector Model — README / reading entry point

  FQN: org.blockml.bml.bmldocs.README-->
<bmldocs:README xmlns="http://blockml.org/bml"
  xmlns:bmldocs="org.blockml.bml.bmldocs"
  xmlns:pdata="org.blockml.bml.bmldocs.a01_planning.data"
  xmlns:task="org.blockml.bml.bmldocs.a02_structuring.task"
  xmlns:adata="org.blockml.bml.bmldocs.a03_authoring.data"
  xmlns:page="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:docgen="org.blockml.bml.docgen"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    core:ReadMe
  </baseType>
  <is>
    A sector-model reading entry point
  </is>
  <isNot>
    A reading entry for a classical cohesive documentation library
  </isNot>
  <documentation>
    README for the BlockML documentation sector model (org.blockml.bml.bmldocs). bmldocs is a
    sector model: numbered sectors (a01_planning, a02_structuring, a03_authoring, …) each contain
    an autonomous sub-model. A later sector can be produced from an earlier one. The goal is to
    develop documentation in multiple steps rather than as one monolithic catalogue.
    
    docgen is used only as the content-structure foundation inside sectors (DocSetPlan, DocSet,
    Page, PageGroup, and related types). Sector models are not classical cohesive libraries.
    
    Start with this README and bmldocs:Library, then read each sector as its own sub-model.
  </documentation>
  <references>
    <see type="bmldocs:Library" relation="ReadFirst">
      Sector-model catalog — not a classical cohesive library.
    </see>
    <see type="pdata:BmlDocSetPlan" relation="ReadFirst">
      a01_planning sector — autonomous DocSetPlan sub-model.
    </see>
    <see type="task:A02_UpdatePageSkeletons" relation="SeeAlso">
      a02_structuring sector — task that updates page skeletons from earlier sectors.
    </see>
    <see type="adata:BmlDocSet_A03" relation="SeeAlso">
      a03_authoring sector — autonomous authored DocSet sub-model.
    </see>
    <see type="docgen:Library" relation="Requires">
      Content-structure foundation for models inside sectors — not a site catalogue.
    </see>
    <see type="dpage:DocPage" relation="SeeAlso">
      Docgen page marker specialized by sector page models.
    </see>
    <see type="page:TableOfContents" relation="SeeAlso">
      a03 authoring menu page — one sector artifact, not the model root.
    </see>
  </references>
</bmldocs:README>
