<!--BlockML Documentation — documentation menu and navigation entry point

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.TableOfContents-->
<docs:TableOfContents xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:dcore="org.blockml.bml.docgen.core">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    The documentation menu and navigation entry point
  </is>
  <documentation>
    Index/menu page for the BlockML Core handbook. Scope is documentation menu, entry points,
    and navigation overview only — no BlockML concept is explained here. This page has no
    domain-content authoritative sources; it links structurally to the handbook's page groups.
    Body content (the link list) is authored in A03 from this DocSet's page and pageGroup structure.
  </documentation>
  <references>
    <see type="dcore:DocSet" relation="SeeAlso">
      DocSet this page belongs to; pageGroups supply the menu structure.
    </see>
    <see type="dcore:PageGroup" relation="SeeAlso">
      Nested navigational groups this menu presents (structural template, not domain content).
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Documentation</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Overview</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Index</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="Getting Started">
          <content>
            <dpage:Navigation>
              <title>Getting Started</title>
              <items>
                <dpage:NavigationItem label="Introduction to BlockML" summary="A first mental model of BlockML and how this handbook is organized.">
                  <target>docs:Introduction</target>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Core Use Cases" summary="The kinds of problems BlockML is meant to describe.">
                  <target>docs:CoreUseCases</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
        <dpage:Section heading="Foundations">
          <content>
            <dpage:Navigation>
              <title>Foundations</title>
              <items>
                <dpage:NavigationItem label="Everything Is a Block" summary="Why Block is the universal abstraction at the heart of BlockML.">
                  <target>docs:EverythingIsABlockPage</target>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Blocks" summary="Defining, naming, and referencing a Block.">
                  <target>docs:Blocks</target>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Block Definitions and Instances" summary="The difference between defining a Block and using one.">
                  <target>docs:BlockDefinitionsAndInstances</target>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Inheritance" summary="How a Block extends and specializes a base type.">
                  <target>docs:Inheritance</target>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Contracts" summary="How capabilities and behaviour are declared and honored.">
                  <target>docs:Contracts</target>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Namespaces and Fully Qualified Names" summary="How packages give every Block a unique identity.">
                  <target>docs:NamespacesAndFullyQualifiedNames</target>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Identifiers and References" summary="How one Block refers to another by name.">
                  <target>docs:IdentifiersAndReferences</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
        <dpage:Section heading="Type System">
          <content>
            <dpage:Navigation>
              <title>Type System</title>
              <items>
                <dpage:NavigationItem label="Type System" summary="An overview of the kinds of types BlockML defines.">
                  <target>docs:TypeSystem</target>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Primitive Types" summary="The built-in scalar types available to every model.">
                  <target>docs:PrimitiveTypes</target>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Struct Types" summary="Composite value types built from named fields.">
                  <target>docs:StructTypes</target>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Enum Types" summary="Types restricted to a fixed set of named values.">
                  <target>docs:EnumTypes</target>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Primitive Entities" summary="Wrapping a primitive value with semantic type identity.">
                  <target>docs:PrimitiveEntities</target>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Types and Values" summary="How declared types constrain and describe authored values.">
                  <target>docs:TypesAndValues</target>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Generic Types" summary="Parameterizing a type definition over other types.">
                  <target>docs:GenericTypes</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
        <dpage:Section heading="Members">
          <content>
            <dpage:Navigation>
              <title>Members</title>
              <items>
                <dpage:NavigationItem label="Members" summary="The overall member model shared by every Block.">
                  <target>docs:Members</target>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Properties" summary="Single-valued members that hold a Block's own data.">
                  <target>docs:Properties</target>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Aggregations" summary="Members that compose or associate collections of other Blocks.">
                  <target>docs:Aggregations</target>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Associations" summary="Referencing other Blocks without owning them.">
                  <target>docs:Associations</target>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Capabilities" summary="Declaring the behaviour a Block exposes.">
                  <target>docs:Capabilities</target>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Member Inheritance and Overrides" summary="How a subtype refines members it inherits.">
                  <target>docs:MemberInheritanceAndOverrides</target>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Visibility" summary="Controlling where a member may be seen or changed.">
                  <target>docs:Visibility</target>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Multiplicity and Collections" summary="How many values a member may hold.">
                  <target>docs:MultiplicityAndCollections</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
        <dpage:Section heading="Behaviour &amp; Values">
          <content>
            <dpage:Navigation>
              <title>Behaviour &amp; Values</title>
              <items>
                <dpage:NavigationItem label="Constraints" summary="Rules that limit which values a member may hold.">
                  <target>docs:Constraints</target>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Suggestions" summary="Non-binding guidance offered to an author.">
                  <target>docs:Suggestions</target>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Expressions" summary="Computing a value from other parts of the model.">
                  <target>docs:Expressions</target>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Value Configuration" summary="How a member's actual value is authored and resolved.">
                  <target>docs:ValueConfiguration</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
        <dpage:Section heading="Composition &amp; Structure">
          <content>
            <dpage:Navigation>
              <title>Composition &amp; Structure</title>
              <items>
                <dpage:NavigationItem label="Composition" summary="Building larger Blocks out of smaller ones.">
                  <target>docs:Composition</target>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Sub-Blocks" summary="Declaring a nested Block type inside a Block.">
                  <target>docs:SubBlocks</target>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Embedded Blocks" summary="Composing a Block instance directly inside another.">
                  <target>docs:EmbeddedBlocks</target>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Documenting Blocks" summary="Attaching narrative documentation to a Block.">
                  <target>docs:DocumentingBlocks</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
        <dpage:Section heading="BML: The Authoring Format">
          <content>
            <dpage:Navigation>
              <title>BML: The Authoring Format</title>
              <items>
                <dpage:NavigationItem label="BML" summary="The XML-based authoring format used to write BlockML models.">
                  <target>docs:Bml</target>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="BML Namespaces" summary="How XML namespaces map BML element tags to types.">
                  <target>docs:BmlNamespaces</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
