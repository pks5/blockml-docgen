<!--BlockML Documentation — Behaviour & Values page group

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.pagegroup.BehaviourAndValuesPageGroup-->
<a04pgroup:BehaviourAndValuesPageGroup xmlns="http://blockml.org/bml"
  xmlns:a04pgroup="org.blockml.bml.bmldocs.a04_rendering.data.pagegroup"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dcore="org.blockml.bml.docgen.core">

  <baseType>
    dcore:PageGroup
  </baseType>
  <is>
    The Behaviour &amp; Values page group for the A04 documentation set
  </is>
  <documentation>
    Section page group under DocsPageGroup, from BmlDocSetPlan.rootPageGroupPlan
    (BehaviourAndValuesPageGroup). Direct pages: Constraints, Suggestions, Expressions,
    ValueConfiguration.
  </documentation>
  <references>
    <see type="dcore:PageGroup" relation="Extends">
      Docgen page group base.
    </see>
    <see type="a04pgroup:DocsPageGroup" relation="Requires">
      Parent Documentation page group.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Behaviour &amp; Values</value>
    </title>
    <parentGroup override="true">
      <value>a04pgroup:DocsPageGroup</value>
    </parentGroup>
  </properties>
  <aggregations>
    <pages override="true">
      <composition>
        <docs:Constraints />
        <docs:Suggestions />
        <docs:Expressions />
        <docs:ValueConfiguration />
      </composition>
    </pages>
  </aggregations>
</a04pgroup:BehaviourAndValuesPageGroup>
