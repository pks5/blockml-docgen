<!--BlockML Documentation — a guide to BML as BlockML's human-authored format

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Bml-->
<docs:Bml xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to BML as BlockML's human-authored format
  </is>
  <documentation>
    Scope: BML as the human-authored representation and its relationship to the canonical BOM,
    grounded in org.blockml.bml.documentation.Introduction and
    org.blockml.bml.documentation.DocumentFormat. Body content is rendered in a04 from those
    sources.
  </documentation>
  <references>
    <see type="doc:Introduction" relation="Requires">
      Primary content source — the BML-authoring versus BOM-canonical distinction.
    </see>
    <see type="doc:DocumentFormat" relation="Requires">
      Document root, Sub-Block, and embedded Block authoring format.
    </see>
    <see type="doc:CompilerArchitecture" relation="SeeAlso">
      BML to Parser to BOM pipeline context.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>BML: The Authoring Format</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="What authors actually write">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="BML is what authors actually write — the human- and editor-friendly representation of a BlockML model, with the .bml extension and XML as its sole current serialization." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Root, Sub-Block, and embed authoring-->
        <dpage:Section heading="Root, Sub-Block, and embed authoring">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A document root or embedded Block uses its qualified type as the element tag; a Sub-Block uses its unqualified name as the tag — the same identity-as-tag principle this handbook has used in every earlier example." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. BML to BOM, once more-->
        <dpage:Section heading="BML to BOM, and the domain-agnostic compiler">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="The compiler that reads BML and produces the BOM understands only BML and the BOM object model — every domain-specific meaning this handbook has covered lives in the authored Blocks themselves, never in the compiler." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="A complete small BML document">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A complete BML document combines identity, required documentation fields, and at least one member — everything this handbook has introduced, in one small file." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- Identity, is, documentation, and one property — one complete BML document -->
<acme:Basket xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Block
  </baseType>
  <is>
    A basket with a counted quantity
  </is>
  <documentation>
    Holds a count of items.
  </documentation>
  <properties>
    <count type="type:Integer">
      <value>3</value>
    </count>
  </properties>
</acme:Basket>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Every field in the example traces back to an earlier page — the qualified tag and baseType from Blocks, is and documentation from Documenting Blocks, and the count property from Properties — brought together as one authored BML file." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next page">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should be able to identify a Block document's root element and format, before BML Namespaces covers the xmlns declarations every one of this handbook's examples has relied on." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with BML namespaces">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="BML Namespaces" summary="Learn XML namespace usage in BML.">
                  <target>docs:BmlNamespaces</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Bml>
