<!--BlockML Documentation — a guide to generic type parameters

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.GenericTypes-->
<docs:GenericTypes xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to generic type parameters
  </is>
  <documentation>
    Scope: generic type parameters, declaring genericTypes, concrete application, and the
    bind-or-forward rule, grounded in org.blockml.bml.documentation.GenericsModel and
    org.blockml.bml.definition.GenericTypeDefinition. Body content is rendered in a04 from those
    sources.
  </documentation>
  <references>
    <see type="doc:GenericsModel" relation="Requires">
      Primary content source — declaration, binding, forwarding, and instance bml:generics.
    </see>
    <see type="def:GenericTypeDefinition" relation="Requires">
      Meta-model for one genericTypes parameter entry.
    </see>
    <see type="doc:TypeExpressions" relation="SeeAlso">
      Generic application as a type expression.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Generic Types</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Parameters that belong to their declaring Block">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Generic parameters belong exclusively to the Block that declares them — never inherited implicitly — so a derived Block using a generic Block as baseType must account for every one of its parameters explicitly." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Declaring a parameter-->
        <dpage:Section heading="Declaring a generic parameter">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A generic parameter is declared inside genericTypes as an element whose local name is the parameter itself, carrying a baseType constraint that every concrete argument at a reference site must satisfy." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Bind or forward-->
        <dpage:Section heading="Bind or forward — every base parameter must ground out">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="When a generic Block is used as baseType, the derived Block must bind each base parameter to a concrete type expression or forward it to a parameter declared locally — every parameter must eventually ground to a concrete type somewhere in the chain." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="Binding a generic parameter through baseType">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A generic Block declares one open parameter; a concrete specialization binds that parameter to a specific type through its baseType application." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- Box declares one open parameter T, bounded by core:Block -->
<acme:Box xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    core:Block
  </baseType>
  <genericTypes>
    <T baseType="core:Block" />
  </genericTypes>
  <properties>
    <item type="T" />
  </properties>
</acme:Box>

<!-- WidgetBox binds T to acme:Widget through its baseType application -->
<acme:WidgetBox xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example">

  <baseType>
    acme:Box(acme:Widget)
  </baseType>
</acme:WidgetBox>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Box's item property is typed T, the still-open parameter; WidgetBox's baseType, acme:Box(acme:Widget), binds T to acme:Widget. That binding substitutes acme:Widget everywhere T appeared in Box's definition, so WidgetBox's own item property ends up typed acme:Widget, with no open parameters left." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should be able to declare, bind, or forward a generic parameter, closing out the type system group before the member model begins." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with members">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Members" summary="Learn the Block member model overview.">
                  <target>docs:Members</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:GenericTypes>
