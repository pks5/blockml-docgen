<!--BlockML Documentation — a guide to generic type parameters

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.GenericTypes-->
<docs:GenericTypes xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to generic type parameters
  </is>
  <documentation>
    Scope: generic type parameters, declaring genericTypes, concrete application, and the
    bind-or-forward rule, grounded in org.blockml.bml.documentation.GenericsModel and
    org.blockml.bml.definition.GenericTypeDefinition. Body content is authored in a04 from those
    sources.
  </documentation>
  <references>
    <see type="doc:GenericsModel" relation="Requires">
      Primary content source — declaration, binding, forwarding, and instance bml:generics.
    </see>
    <see type="def:GenericTypeDefinition" relation="Requires">
      Meta-model for one genericTypes parameter entry.
    </see>
    <see type="doc:TypeExpressions" relation="SeeAlso">
      Generic application as a type expression.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Generic Types</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="Parameters belong to their declaring Block">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Generic parameters belong exclusively to the Block that declares them; a derived Block never inherits them implicitly." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Declaring a parameter">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A generic parameter is declared inside genericTypes as an element whose local name becomes the parameter's identifier, carrying a baseType constraint that every concrete type argument supplied for it must satisfy." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Bind or forward every base parameter">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="When a derived Block uses a generic Block as its baseType, it must account for every one of that Block's base parameters — either binding each to a concrete type expression or forwarding it to a parameter the derived Block declares itself." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Concrete application syntax">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Generic applications in BML attributes use round parentheses rather than angle brackets, which keeps the syntax valid XML; resolution then runs during inheritance, substituting each bound parameter throughout the inherited definition." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Readers can now declare a generic parameter on a Block, bind it to a concrete type when using that Block as a baseType, or forward it to a parameter of their own." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with the member model">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Members" summary="See how Properties, Aggregations, Associations, and Capabilities relate.">
                  <target>docs:Members</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:GenericTypes>
