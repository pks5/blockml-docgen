<!--BlockML Documentation — BML: The Authoring Format page group

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.pagegroup.BmlFormatPageGroup-->
<a04pgroup:BmlFormatPageGroup xmlns="http://blockml.org/bml"
  xmlns:a04pgroup="org.blockml.bml.bmldocs.a04_rendering.data.pagegroup"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dcore="org.blockml.bml.docgen.core">

  <baseType>
    dcore:PageGroup
  </baseType>
  <is>
    The BML: The Authoring Format page group for the A04 documentation set
  </is>
  <documentation>
    Section page group under DocsPageGroup, from BmlDocSetPlan.rootPageGroupPlan
    (BmlFormatPageGroup). Direct pages: Bml, BmlNamespaces.
  </documentation>
  <references>
    <see type="dcore:PageGroup" relation="Extends">
      Docgen page group base.
    </see>
    <see type="a04pgroup:DocsPageGroup" relation="Requires">
      Parent Documentation page group.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>BML: The Authoring Format</value>
    </title>
    <parentGroup override="true">
      <value>a04pgroup:DocsPageGroup</value>
    </parentGroup>
  </properties>
  <aggregations>
    <pages override="true">
      <composition>
        <docs:Bml />
        <docs:BmlNamespaces />
      </composition>
    </pages>
  </aggregations>
</a04pgroup:BmlFormatPageGroup>
