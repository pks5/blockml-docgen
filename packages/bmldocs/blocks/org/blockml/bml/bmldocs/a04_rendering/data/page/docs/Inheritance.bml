<!--BlockML Documentation — a guide to specialization via baseType

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Inheritance-->
<docs:Inheritance xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to specialization via baseType
  </is>
  <documentation>
    Scope: specialization via baseType, single inheritance, the effective definition, and
    abstract/final Blocks, grounded in org.blockml.bml.documentation.ModelingGuidelines
    (Inheritance section) and org.blockml.bml.documentation.PartialMemberOverrides. Body content
    is rendered in a04 from those sources.
  </documentation>
  <references>
    <see type="doc:ModelingGuidelines" relation="Requires">
      Primary content source — single inheritance, branch membership, final baseType.
    </see>
    <see type="doc:PartialMemberOverrides" relation="Requires">
      abstract, final, and override semantics that shape the effective definition.
    </see>
    <see type="doc:ContractsModel" relation="SeeAlso">
      Contrasting composable member-fragment mechanism, covered next.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Inheritance</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Specialization via baseType">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Every Block specializes exactly one parent through baseType — single inheritance, mandatory on every definition except the root org.blockml.bml.core.Block, which has none." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. What baseType is for-->
        <dpage:Section heading="What baseType is for">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="baseType is used for branch membership — placing a Block under ValueType, Language, or a domain base — and for sharing member fragments that every specialization needs." />
              </content>
            </dpage:Paragraph>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="abstract marks a Block as incomplete, creating an implementation obligation for descendants, while final on a Block or member prevents any further override." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. The effective definition-->
        <dpage:Section heading="The effective definition">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Block's effective definition is not just what it declares locally — it is the merge of every member along its baseType chain, with local declarations refining what came before." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="Refining an inherited member">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A child Block that specializes a parent through baseType can refine one of the parent's members, declaring only what changes." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- Parent: declares the "count" Property with a default of 3 -->
<acme:Basket xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Block
  </baseType>
  <properties>
    <count type="type:Integer">
      <value>3</value>
    </count>
  </properties>
</acme:Basket>

<!-- Child: baseType points at the parent; count is refined with override -->
<acme:SmallBasket xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    acme:Basket
  </baseType>
  <properties>
    <count override="true" type="type:Integer">
      <value>1</value>
    </count>
  </properties>
</acme:SmallBasket>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="SmallBasket's baseType points at Basket, and its count property is redeclared with override, changing only the default from 3 to 1. The child's effective definition still has every member Basket declared; only the refined property changes, and only because the child marked it as an override." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should be able to trace a Block's effective definition through its baseType chain, before contrasting that mechanism with contracts on the next page." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with contracts">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Contracts" summary="Learn contracts as composable member fragments distinct from inheritance.">
                  <target>docs:Contracts</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Inheritance>
