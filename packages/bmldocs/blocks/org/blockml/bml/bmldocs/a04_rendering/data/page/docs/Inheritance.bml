<!--BlockML Documentation — a guide to specialization via baseType

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Inheritance-->
<docs:Inheritance xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to specialization via baseType
  </is>
  <documentation>
    Scope: specialization via baseType, single inheritance, the effective definition, and
    abstract/final Blocks, grounded in org.blockml.bml.documentation.ModelingGuidelines
    (Inheritance section) and org.blockml.bml.documentation.PartialMemberOverrides. Body content
    is authored in a04 from those sources.
  </documentation>
  <references>
    <see type="doc:ModelingGuidelines" relation="Requires">
      Primary content source — single inheritance, branch membership, final baseType.
    </see>
    <see type="doc:PartialMemberOverrides" relation="Requires">
      abstract, final, and override semantics that shape the effective definition.
    </see>
    <see type="doc:ContractsModel" relation="SeeAlso">
      Contrasting composable member-fragment mechanism, covered next.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Inheritance</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Specialization via baseType">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Every Block specializes exactly one parent through baseType — this is single inheritance, and baseType is mandatory on every definition except the root core:Block, which has none." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. What baseType is for-->
        <dpage:Section heading="What baseType is for">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="baseType is used for branch membership — placing a Block under ValueType, Language, or a domain base — and for sharing member fragments that every specialization along that branch needs." />
              </content>
            </dpage:Paragraph>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Two modifiers shape how that chain behaves: abstract marks a Block as incomplete, creating an implementation obligation for descendants." />
                <dpage:Text text="final, on a Block or on a member, prevents any further override — it seals the declaration at that point in the chain." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. The effective definition-->
        <dpage:Section heading="The effective definition">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Block's effective definition is not just what it declares locally — it is the merge of every member along its baseType chain, with local declarations refining what came before." />
                <dpage:Text text="Reading only a Block's own file never shows the full picture; the effective definition only appears once every ancestor's members are folded in." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="Refining an inherited member" purpose="Ground the merge behaviour in a small refinement example">
          <content>
            <dpage:Paragraph purpose="Set up a parent and child Block where the child refines an inherited member">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>A child Block that specializes a parent through baseType can refine one of
the parent's members, declaring only what changes.</message>
              <exclusions>
                <sem:Exclusion>
                  <summary>Contracts and multi-level chains.</summary>
                  <reason>The example isolates one baseType step and one refined member.</reason>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>
            <dpage:CodeBlock purpose="Show a child Block refining one inherited property with override">
              <role>org.blockml.bml.docgen.role.Example</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>The child declares baseType on the parent and refines one property with override.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>Show the child's baseType pointing at the parent, and one property redeclared with override.</summary>
                </sem:SupportingPoint>
              </supportingPoints>
              <exclusions>
                <sem:Exclusion>
                  <summary>Unrelated inherited members that stay unchanged.</summary>
                </sem:Exclusion>
              </exclusions>
            </dpage:CodeBlock>
            <dpage:Paragraph purpose="Interpret the refinement in terms of the effective definition">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>The child's effective definition still has every member the parent
declared; only the refined property changes, and only because the child marked it
as an override.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages" purpose="Anchor the outcome this page should leave behind">
          <content>
            <dpage:Paragraph purpose="State the outcome this page should leave behind">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>After this page, readers should be able to trace a Block's effective
definition through its baseType chain, before contrasting that mechanism with
contracts on the next page.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with contracts" purpose="Direct the reader to the next page">
          <content>
            <dpage:Navigation purpose="Continue the foundations learning sequence">
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Contracts" summary="Learn contracts as composable member fragments distinct from inheritance.">
                  <target>docs:Contracts</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Inheritance>
