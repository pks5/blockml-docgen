<!--BlockML Documentation — a guide to specialization via baseType

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Inheritance-->
<docs:Inheritance xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to specialization via baseType
  </is>
  <documentation>
    Scope: specialization via baseType, single inheritance, the effective definition, and
    abstract/final Blocks, grounded in org.blockml.bml.documentation.ModelingGuidelines
    (Inheritance section) and org.blockml.bml.documentation.PartialMemberOverrides. Body content
    is authored in a04 from those sources.
  </documentation>
  <references>
    <see type="doc:ModelingGuidelines" relation="Requires">
      Primary content source — single inheritance, branch membership, final baseType.
    </see>
    <see type="doc:PartialMemberOverrides" relation="Requires">
      abstract, final, and override semantics that shape the effective definition.
    </see>
    <see type="doc:ContractsModel" relation="SeeAlso">
      Contrasting composable member-fragment mechanism, covered next.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Inheritance</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="Specialization via baseType">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Each Block has exactly one baseType, mandatory for every definition except the root org.blockml.bml.core.Block." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="The effective definition">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Block's effective definition is merged from its baseType chain — every inherited member combines with the Block's own local declarations." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Abstract and final Blocks">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="An abstract Block creates an implementation obligation for concrete descendants, while a final Block cannot be used as baseType by any other definition." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Branch membership">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Framework branches such as ValueType and Language inherit via their branch root, and every root Block in the core package must inherit directly from org.blockml.bml.core.Block." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Readers should now be able to trace a Block back to what it actually inherits through its baseType chain." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with contracts">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Contracts" summary="Learn the composable alternative to single inheritance.">
                  <target>docs:Contracts</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Inheritance>
