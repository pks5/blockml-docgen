<!--BlockML Documentation — a guide to specialization via baseType

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Inheritance-->
<docs:Inheritance xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to specialization via baseType
  </is>
  <documentation>
    Scope: specialization via baseType, single inheritance, the effective definition, and
    abstract/final Blocks, grounded in org.blockml.bml.documentation.ModelingGuidelines
    (Inheritance section) and org.blockml.bml.documentation.PartialMemberOverrides. Body content
    is authored in a03 from those sources.
  </documentation>
  <references>
    <see type="doc:ModelingGuidelines" relation="Requires">
      Primary content source — single inheritance, branch membership, final baseType.
    </see>
    <see type="doc:PartialMemberOverrides" relation="Requires">
      abstract, final, and override semantics that shape the effective definition.
    </see>
    <see type="doc:ContractsModel" relation="SeeAlso">
      Contrasting composable member-fragment mechanism, covered next.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Inheritance</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Specialization happens through baseType">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>A Block specializes another Block by declaring it as its baseType, inheriting
that parent's members and refining them for its own, narrower concept.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Single inheritance-->
        <dpage:Section heading="Single inheritance">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>Every Block declares exactly one baseType, mandatory for every Block except
the single root all Blocks ultimately trace back to.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. The effective definition-->
        <dpage:Section heading="The effective definition">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>A Block's effective, usable definition is formed by merging everything it
inherits along its baseType chain with what it declares itself, so tracing that
chain shows exactly what the Block actually has.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Abstract and final-->
        <dpage:Section heading="Abstract and final Blocks">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>Marking a Block or member abstract leaves it incomplete, expecting a later
specialization to finish it; marking it final seals it so no further
specialization can override it.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. Looking ahead-->
        <dpage:Section heading="Another way to share behavior">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>Single inheritance is the main way a Block specializes another, but BlockML
also offers a separate mechanism for sharing member fragments across Blocks
that have no common ancestor to inherit from.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with contracts">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Contracts" summary="Learn how contracts share member fragments across unrelated Blocks.">
                  <target>docs:Contracts</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Inheritance>
