<!--BlockML Documentation — a guide to BlockML's four ValueType kinds

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.TypeSystem-->
<docs:TypeSystem xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to BlockML's four ValueType kinds
  </is>
  <documentation>
    Scope: type system overview and the four ValueType kinds and how they relate to Blocks and
    members, grounded in org.blockml.bml.documentation.TypeSystemOverview. Body content is
    authored in a04 from that source.
  </documentation>
  <references>
    <see type="doc:TypeSystemOverview" relation="Requires">
      Primary content source — PrimitiveType, StructType, EnumType, ConstantType as sibling branches.
    </see>
    <see type="doc:TypeExpressions" relation="ReadNext">
      Next reading step — multiplicity, unions, and other type-expression forms.
    </see>
    <see type="doc:ContractsModel" relation="SeeAlso">
      baseType versus contracts in the wider type system.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>The Type System</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Overview</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Guide</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="Four sibling kinds">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="BlockML knows four ValueType kinds at language level, each naming a distinct semantic meaning, as sibling branches under ValueType rather than subtypes of one another." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="The four kinds">
          <content>
            <dpage:List>
              <items>
                <dpage:ListItem text="PrimitiveType describes atomic scalar semantics with no stored values on the type itself." />
                <dpage:ListItem text="StructType describes composite values shaped by ordinary Properties." />
                <dpage:ListItem text="EnumType describes a closed set of named members, storing only member identity." />
                <dpage:ListItem text="ConstantType describes a singleton value domain — one configured literal." />
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <dpage:Section heading="Type expressions are not a fifth kind">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Multiplicity, unions, generic application, and instance configuration combine named types as type expressions — they are not new BlockML type classes." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Where ValueTypes may appear">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Only ValueTypes may appear as a Property type or a Capability inputType or outputType; an Aggregation type may be any Block FQN, and an Association type must be InstanceReference(T)." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Readers should now be able to name the four ValueType kinds and classify a given type among them." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with primitive types">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Primitive Types" summary="Learn the atomic scalar ValueType kind.">
                  <target>docs:PrimitiveTypes</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:TypeSystem>
