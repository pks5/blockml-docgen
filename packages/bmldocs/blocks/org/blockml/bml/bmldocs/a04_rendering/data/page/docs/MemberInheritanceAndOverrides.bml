<!--BlockML Documentation — a guide to combining inherited members

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.MemberInheritanceAndOverrides-->
<docs:MemberInheritanceAndOverrides xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to combining inherited members
  </is>
  <documentation>
    Scope: combining inherited members, the override flag, and refining or finalizing members,
    grounded in org.blockml.bml.documentation.PartialMemberOverrides and
    org.blockml.bml.definition.MemberDefinition. Body content is rendered in a04 from those
    sources.
  </documentation>
  <references>
    <see type="doc:PartialMemberOverrides" relation="Requires">
      Primary content source — override modes, partial authoring, and merge rules.
    </see>
    <see type="def:MemberDefinition" relation="Requires">
      Declares abstract, final, override, and readOnly on every member kind.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Member Inheritance and Overrides</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Declaring intent to redefine a member">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="override=&quot;true&quot; confirms that a local member redeclaration is a deliberate redefinition of an inherited member — required whenever a redeclaration merges with a member from the baseType chain or from contracts." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. new versus override-->
        <dpage:Section heading="new versus override">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A member declared for the first time introduces a new member and must not set override=&quot;true&quot;; setting it without a matching parent member fails validation." />
              </content>
            </dpage:Paragraph>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Each redeclaration layer must set override=&quot;true&quot; again, since override is never inherited from a prior layer — a grandchild refining the same member once more restates the flag itself." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Refining versus finalizing an abstract member-->
        <dpage:Section heading="Refining versus finalizing an abstract member">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A locally concrete redeclaration with override=&quot;true&quot; satisfies an inherited abstract obligation once it is complete for its member kind; to keep the member abstract further down the chain, the redeclaration must explicitly restate abstract=&quot;true&quot; as well." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="Implementing an abstract member">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A parent Block can leave a Capability abstract, declaring only its shape; a child Block completes it with override=&quot;true&quot; and a full implementation." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- Parent: "describe" is abstract — its shape is declared, with no implementation -->
<acme:Widget xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:core="org.blockml.bml.core"
  xmlns:cap="org.blockml.bml.capability"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Block
  </baseType>
  <capabilities>
    <describe type="cap:Outbound" outputType="type:Text" abstract="true" />
  </capabilities>
</acme:Widget>

<!-- Child: completes "describe" with override="true" and a real implementation -->
<acme:Label xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:lang="org.blockml.bml.language">

  <baseType>
    acme:Widget
  </baseType>
  <capabilities>
    <describe override="true">
      <implementation language="lang:PseudoCode">
        return #this.caption
      </implementation>
    </describe>
  </capabilities>
</acme:Label>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Label's describe completes exactly the obligation Widget's abstract declaration created — without override=&quot;true&quot; here, the validator would not accept this as a deliberate redefinition of that member. Because Label's redeclaration does not restate abstract=&quot;true&quot;, describe becomes concrete from Label downward." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should know when a local member redeclaration must set override=&quot;true&quot;, before Visibility introduces the naming convention that governs access to any member." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with visibility">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Visibility" summary="Learn member and Sub-Block visibility.">
                  <target>docs:Visibility</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:MemberInheritanceAndOverrides>
