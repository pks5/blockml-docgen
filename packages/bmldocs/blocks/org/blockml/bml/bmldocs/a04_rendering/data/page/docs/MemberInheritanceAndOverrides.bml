<!--BlockML Documentation — a guide to combining inherited members

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.MemberInheritanceAndOverrides-->
<docs:MemberInheritanceAndOverrides xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition"
  xmlns:type="org.blockml.bml.type"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to combining inherited members
  </is>
  <documentation>
    Scope: combining inherited members, the override flag, and refining or finalizing members,
    grounded in org.blockml.bml.documentation.PartialMemberOverrides and
    org.blockml.bml.definition.MemberDefinition. Body content is authored in a03 from those
    sources.
  </documentation>
  <references>
    <see type="doc:PartialMemberOverrides" relation="Requires">
      Primary content source — override modes, partial authoring, and merge rules.
    </see>
    <see type="def:MemberDefinition" relation="Requires">
      Declares abstract, final, override, and readOnly on every member kind.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Member Inheritance and Overrides</value>
    </title>
    <purpose override="true">
      <value>Teach when a local member redeclaration must set override="true" versus introduce a new member, so readers can refine or finalize an inherited member correctly.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <workflow:AuthorativeSourceSet>
          <includedTypes>
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.PartialMemberOverrides" />
            <type:TypeSelectorEntity value="org.blockml.bml.definition.MemberDefinition" />
          </includedTypes>
        </workflow:AuthorativeSourceSet>
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>Teach when a local redeclaration must set override, versus introducing a new member.</summary>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>The reader knows when a local member redeclaration must set override="true".</summary>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>Combining inherited members, the override flag, and refining or finalizing a member.</summary>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>Re-teaching baseType or contracts from scratch.</summary>
          <reason>Those are covered on their own earlier pages.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <supportingPoints override="true">
      <composition>
        <sem:SupportingPoint>
          <summary>Each redeclaration layer must set override="true" again — override is never inherited from a prior layer.</summary>
        </sem:SupportingPoint>
      </composition>
    </supportingPoints>
    <content override="true">
      <composition>
        <dpage:Section heading="Redeclaring an inherited member" purpose="Introduce the two things a local member redeclaration can mean">
          <content>
            <dpage:Paragraph purpose="Introduce redeclaration as either a new member or a refinement of an inherited one">
              <role>org.blockml.bml.docgen.role.Lead</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A child Block may redeclare a member it inherits; whether that redeclaration
introduces a new member or refines the inherited one depends on whether a member of
that same identity already exists above it.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="New member versus override" purpose="Explain the two redeclaration modes and when each applies">
          <content>
            <dpage:Paragraph purpose="Contrast introducing a new member with overriding an inherited one">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A redeclaration that introduces a member not already present must not mark itself
as an override, while a redeclaration that merges with a member already inherited
must mark itself as an override.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>A local redeclaration must set override="true" whenever it merges with an existing inherited member.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.PartialMemberOverrides" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
              <readerOutcomes>
                <sem:ReaderOutcome>
                  <summary>The reader knows when a local member redeclaration must set override="true".</summary>
                </sem:ReaderOutcome>
              </readerOutcomes>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Override is never inherited" purpose="Explain that each redeclaration layer restates override on its own">
          <content>
            <dpage:Paragraph purpose="State that override must be restated at every redeclaration layer">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Each redeclaration layer must set override="true" again on its own — a child Block
never inherits that marker from a parent's redeclaration.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>Each redeclaration layer must set override="true" again — override is never inherited from a prior layer.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.definition.MemberDefinition" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Partial authoring: only what changes" purpose="Explain that an override only needs to restate what it changes">
          <content>
            <dpage:Paragraph purpose="Explain that an override may restate only the attributes it changes">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>An override needs to restate only the member name, the override marker, and the
attributes it actually changes — every other attribute is inherited unchanged from
the parent declaration.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Finalizing an incomplete member" purpose="Explain refining an incomplete inherited member into a complete one">
          <content>
            <dpage:Paragraph purpose="Explain that an override can complete a member a parent left incomplete">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>When a parent Block leaves a member incomplete, a child Block can finalize it by
overriding the member with a complete declaration.</message>
              <exclusions>
                <sem:Exclusion>
                  <summary>Re-teaching baseType or contracts from scratch.</summary>
                  <reason>Those are covered on their own earlier pages.</reason>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with Visibility" purpose="Direct the reader to the next topic">
          <content>
            <dpage:Navigation purpose="Continue from combining inherited members into member visibility">
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Visibility" summary="Learn the naming-convention visibility model for members and Sub-Blocks.">
                  <target>docs:Visibility</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:MemberInheritanceAndOverrides>
