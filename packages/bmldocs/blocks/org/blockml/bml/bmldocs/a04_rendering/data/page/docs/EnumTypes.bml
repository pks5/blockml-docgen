<!--BlockML Documentation — a guide to closed sets of named values

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.EnumTypes-->
<docs:EnumTypes xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to closed sets of named values
  </is>
  <documentation>
    Scope: a closed set of named literal values, the EnumType branch, and its contrast with
    PrimitiveType and StructType, grounded in org.blockml.bml.type.EnumType, the EnumType section
    of org.blockml.bml.documentation.TypeSystemOverview, and the enum-suggestions prohibition in
    org.blockml.bml.documentation.ConstraintsModel. Body content is authored in a03 from those
    sources.
  </documentation>
  <references>
    <see type="type:EnumType" relation="Requires">
      The closed named-value ValueType branch this page introduces.
    </see>
    <see type="doc:TypeSystemOverview" relation="Requires">
      Primary content source — EnumType examples and branch role in the type system.
    </see>
    <see type="doc:ConstraintsModel" relation="SeeAlso">
      Suggestions forbidden on EnumType properties.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Enum Types</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="What an EnumType is">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>An EnumType names a closed, finite set of allowed named values, so a
Property typed with it can only ever hold one member of that fixed set. The
set of allowed members is closed and finite — there is no way to hold a value
outside it.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="EnumType is its own branch">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>EnumType is its own sibling branch under ValueType: unlike PrimitiveType
it does not leave the value domain open, and unlike StructType it identifies a
value by which named member it is, not by a field structure. A PrimitiveType
leaves its value domain open, while an EnumType closes it down to a named,
finite catalog; a StructType shapes a value through fields, while an EnumType
identifies a value by member identity alone.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Declaring the allowed values">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>A concrete EnumType lists its full catalog of allowed members directly
on the type definition, each one identified by its own name. Each catalog
member is identified by a mandatory reference token, which is what a Property
value actually stores.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Using enum values">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>A Property typed with an EnumType can only be set to one of the
catalog's own named values, which is exactly what keeps the set closed.
Suggestions are forbidden on EnumType properties, because valid values come
exclusively from the type's own catalog.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with Primitive Entities">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Primitive Entities" summary="Learn how a primitive value can appear as a Block instance in its own right.">
                  <target>docs:PrimitiveEntities</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:EnumTypes>
