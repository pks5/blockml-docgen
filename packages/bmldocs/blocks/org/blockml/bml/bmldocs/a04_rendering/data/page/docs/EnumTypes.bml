<!--BlockML Documentation — a guide to closed sets of named values

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.EnumTypes-->
<docs:EnumTypes xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to closed sets of named values
  </is>
  <documentation>
    Scope: a closed set of named literal values, the EnumType branch, and its contrast with
    PrimitiveType and StructType, grounded in org.blockml.bml.type.EnumType, the EnumType section
    of org.blockml.bml.documentation.TypeSystemOverview, and the enum-suggestions prohibition in
    org.blockml.bml.documentation.ConstraintsModel. Body content is authored in a04 from those
    sources.
  </documentation>
  <references>
    <see type="type:EnumType" relation="Requires">
      The closed named-value ValueType branch this page introduces.
    </see>
    <see type="doc:TypeSystemOverview" relation="Requires">
      Primary content source — EnumType examples and branch role in the type system.
    </see>
    <see type="doc:ConstraintsModel" relation="SeeAlso">
      Suggestions forbidden on EnumType properties.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Enum Types</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="A closed set of named values">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="EnumType is its own ValueType branch for closed enums — finite sets of named literal values." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Declaring enum members">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A concrete EnumType declares its allowed members as Block instances in a values aggregation, with no special enum syntax." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Not a PrimitiveType, not a StructType">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A PrimitiveType defines an open value domain and a StructType shapes a value via properties, while an EnumType stores only the identity of one closed named member." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="No suggestions on enum properties">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Property typed with an EnumType must not carry suggestions — valid values come exclusively from the type's declared values." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Readers should now be able to define a closed enum and use its literal values." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with primitive entities">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Primitive Entities" summary="Learn how a primitive value becomes a Block instance.">
                  <target>docs:PrimitiveEntities</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:EnumTypes>
