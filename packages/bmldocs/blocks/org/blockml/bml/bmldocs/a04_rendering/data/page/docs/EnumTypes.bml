<!--BlockML Documentation — a guide to closed sets of named values

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.EnumTypes-->
<docs:EnumTypes xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to closed sets of named values
  </is>
  <documentation>
    Scope: a closed set of named literal values, the EnumType branch, and its contrast with
    PrimitiveType and StructType, grounded in org.blockml.bml.type.EnumType, the EnumType section
    of org.blockml.bml.documentation.TypeSystemOverview, and the enum-suggestions prohibition in
    org.blockml.bml.documentation.ConstraintsModel. Body content is authored in a04 from those
    sources.
  </documentation>
  <references>
    <see type="type:EnumType" relation="Requires">
      The closed named-value ValueType branch this page introduces.
    </see>
    <see type="doc:TypeSystemOverview" relation="Requires">
      Primary content source — EnumType examples and branch role in the type system.
    </see>
    <see type="doc:ConstraintsModel" relation="SeeAlso">
      Suggestions forbidden on EnumType properties.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Enum Types</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="A closed set of named members">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="EnumType is its own ValueType branch for closed enum types — a finite set of named literal values." />
                <dpage:Text text="The stored property value of an EnumType is member identity, not a struct payload — a token that names which member was chosen, nothing more." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Why EnumType is its own branch-->
        <dpage:Section heading="Why EnumType is not a StructType">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A PrimitiveType defines an open value domain, a StructType defines shape through its declared properties, and an EnumType defines a closed set of members whose property value is the member's id plus its EnumType — never a struct payload." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Members and catalog metadata-->
        <dpage:Section heading="Members as catalog Block instances">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Each allowed member is a Block instance of the EnumType, declared in its values aggregation and carrying a mandatory bml:id as the reference token." />
                <dpage:Text text="An EnumType may also declare its own properties, which are filled per member as catalog metadata — analogous to fields on a Java enum constant, and not part of the stored property value when the EnumType is used elsewhere." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="Declaring a small closed enum">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A small EnumType declares its allowed members in values, each identified by a distinct bml:id." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- values declares the closed member set; each member is an instance identified by bml:id -->
<acme:Direction xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    type:EnumType
  </baseType>
  <is>
    A closed set of travel directions
  </is>
  <documentation>
    The directions a part may travel.
  </documentation>
  <aggregations>
    <values override="true">
      <composition>
        <acme:Direction bml:id="North" />
        <acme:Direction bml:id="South" />
      </composition>
    </values>
  </aggregations>
</acme:Direction>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Property typed with acme:Direction may take only North or South, the two ids shown in values — any other token fails validation, since the closed set is defined entirely by this catalog." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should be able to define a closed enum and use its literal values, keeping in mind that suggestions never apply to EnumType properties." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with primitive entities">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Primitive Entities" summary="Learn how a primitive value can appear as a Block instance.">
                  <target>docs:PrimitiveEntities</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:EnumTypes>
