<!--BlockML Documentation — a guide to the BlockML expression language

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Expressions-->
<docs:Expressions xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:mapping="org.blockml.bml.mapping"
  xmlns:service="org.blockml.bml.service"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to the BlockML expression language
  </is>
  <documentation>
    Scope: the BlockML expression language, dollar-brace expressions, their evaluation context,
    and Text interpolation holes, grounded in org.blockml.bml.documentation.Expressions. Body
    content is rendered in a04 from that source.
  </documentation>
  <references>
    <see type="doc:Expressions" relation="Requires">
      Primary content source — expression grammar, #this lookup, and interpolation classification.
    </see>
    <see type="mapping:FunctionMapping" relation="SeeAlso">
      Call-argument mapping used at expression call sites.
    </see>
    <see type="service:Math" relation="SeeAlso">
      Built-in #math.* service used inside expressions.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Expressions</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Extended JSON inside dollar-brace delimiters">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="The BML expression language is extended JSON written inside dollar-brace delimiters, appearing wherever a member value needs to be dynamic — derived, computed, or bound to a service." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. What an expression can reference-->
        <dpage:Section heading="What an expression can reference">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="#this is the magic bean of the outer Block instance and the one lookup that works everywhere — a bare property name such as size is shorthand for #this.size, and the binding does not change inside nested compositions." />
              </content>
            </dpage:Paragraph>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Built-in calls such as #math.min(a, b) reach a Capability on a built-in service Block — one of the four additions the expression language layers on top of an ordinary JSON subset." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Text interpolation-->
        <dpage:Section heading="Interpolation holes inside Text">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A member value that is entirely one dollar-brace expression classifies as a full expression, while a Text value that only contains one or more dollar-brace holes among ordinary characters classifies as interpolated text under a restricted grammar profile — distinct classifications on the same delimiter syntax." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="A property referencing another property">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Property's value can be a whole expression that reads another property on the same Block instance, written as a bare property name inside dollar-brace delimiters." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- height's value is a whole expression that reads width by name -->
<acme:Box xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Block
  </baseType>
  <properties>
    <width type="type:Integer">
      <value>4</value>
    </width>
    <height type="type:Integer">
      <value>${ width }</value>
    </height>
  </properties>
</acme:Box>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="width's value, 4, is a plain literal, while height's value, ${ width }, is a whole expression. The bare name width inside that expression is shorthand for #this.width — the same Box instance width belongs to — so height always tracks whatever width currently holds." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should be able to recognize an expression and know its evaluation context, before Value Configuration shows the related but orthogonal curly-brace instance configuration syntax." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with value configuration">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Value Configuration" summary="Learn how to configure ValueType instances.">
                  <target>docs:ValueConfiguration</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Expressions>
