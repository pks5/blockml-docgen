<!--BlockML Documentation — a guide to the BlockML expression language

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Expressions-->
<docs:Expressions xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:mapping="org.blockml.bml.mapping"
  xmlns:service="org.blockml.bml.service">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to the BlockML expression language
  </is>
  <documentation>
    Scope: the BlockML expression language, dollar-brace expressions, their evaluation context,
    and Text interpolation holes, grounded in org.blockml.bml.documentation.Expressions. Body
    content is authored in a04 from that source.
  </documentation>
  <references>
    <see type="doc:Expressions" relation="Requires">
      Primary content source — expression grammar, #this lookup, and interpolation classification.
    </see>
    <see type="mapping:FunctionMapping" relation="SeeAlso">
      Call-argument mapping used at expression call sites.
    </see>
    <see type="service:Math" relation="SeeAlso">
      Built-in #math.* service used inside expressions.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Expressions</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="Dynamic values inside dollar-brace delimiters">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="The BML expression language appears inside \${ } delimiters wherever a Block member's value needs to be dynamic — derived, computed, or bound to a service." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="#this — one lookup everywhere">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="#this refers to the outer Block instance and is the single lookup used the same way inside a whole expression value and inside an interpolation hole." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Text interpolation">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Text property may hold restricted \${ } holes as interpolation inside running text, which is classified differently from a member value that is itself a single, whole expression." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Built-in calls">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Built-in calls such as the numeric #math.* service supply ready-made utilities, for example minimum, maximum, and rounding, that can be used directly inside an expression." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Readers should now be able to recognize an expression and know its evaluation context, including Text interpolation." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with value configuration">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Value Configuration" summary="Learn curly-brace ValueType instance configuration.">
                  <target>docs:ValueConfiguration</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Expressions>
