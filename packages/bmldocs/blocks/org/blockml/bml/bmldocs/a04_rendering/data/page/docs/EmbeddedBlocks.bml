<!--BlockML Documentation — a guide to embedded Block definitions

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.EmbeddedBlocks-->
<docs:EmbeddedBlocks xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to embedded Block definitions
  </is>
  <documentation>
    Scope: embedded Block definitions and instances as full virtual documents, grounded in the
    Embedded Blocks section of org.blockml.bml.documentation.SubBlockModel and
    org.blockml.bml.definition.EmbeddedBlockDefinition. Body content is rendered in a04 from those
    sources.
  </documentation>
  <references>
    <see type="doc:SubBlockModel" relation="Requires">
      Primary content source — embedded Blocks as virtual .bml files under root embeddedBlocks.
    </see>
    <see type="def:EmbeddedBlockDefinition" relation="Requires">
      The virtual embedded Block document shape this page introduces.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Embedded Blocks</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="A full document, inlined at the root">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="An embedded Block is a full virtual .bml document inlined under a root Block's embeddedBlocks — authored the same way as the document root, and never a lightweight fragment or a Sub-Block." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. An independent FQN, not nested-->
        <dpage:Section heading="An independent FQN, not nested under the root">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="An embedded Block's FQN is simply its own resolved type — never nested under the enclosing root's FQN — which is exactly the opposite of how a Sub-Block's identity is derived from its parent." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Root-only placement-->
        <dpage:Section heading="Root-only, and never nested further">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Only the document root may declare embeddedBlocks — Sub-Blocks cannot, and an embedded Block itself cannot declare further embeddedBlocks, which keeps embedding a single flat layer." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="One root, one embedded Block">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A root Block can carry an embeddedBlocks aggregation holding one fully qualified virtual document, authored the same way as the root itself." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- acme:Handle is fully qualified here — its own FQN, not "Basket.Handle" -->
<acme:Basket xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    core:Block
  </baseType>
  <embeddedBlocks>
    <acme:Handle>
      <baseType>
        core:Block
      </baseType>
    </acme:Handle>
  </embeddedBlocks>
</acme:Basket>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="acme:Handle's qualified tag already is its complete FQN, com.acme.example.Handle — nothing about Basket's identity gets prepended to it, unlike the Sub-Block on the previous page whose name became Basket.Handle." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should be able to author an embedded Block without confusing it with a lightweight fragment or a Sub-Block, before Documenting Blocks returns to the documentation model that applies to every kind of Block document, embedded ones included." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with documenting Blocks">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Documenting Blocks" summary="Learn the Block documentation model.">
                  <target>docs:DocumentingBlocks</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:EmbeddedBlocks>
