<!--BlockML Documentation — a guide to embedded Block definitions

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.EmbeddedBlocks-->
<docs:EmbeddedBlocks xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to embedded Block definitions
  </is>
  <documentation>
    Scope: embedded Block definitions and instances as full virtual documents, grounded in the
    Embedded Blocks section of org.blockml.bml.documentation.SubBlockModel and
    org.blockml.bml.definition.EmbeddedBlockDefinition. Body content is authored in a03 from those
    sources.
  </documentation>
  <references>
    <see type="doc:SubBlockModel" relation="Requires">
      Primary content source — embedded Blocks as virtual .bml files under root embeddedBlocks.
    </see>
    <see type="def:EmbeddedBlockDefinition" relation="Requires">
      The virtual embedded Block document shape this page introduces.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Embedded Blocks</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="A full document, inlined">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>An embedded Block is a full Block document inlined under a root Block's
embeddedBlocks, keeping its own independent fully qualified identity rather
than extending the root's identity prefix. An embedded Block's FQN is
resolve(type), not nested under the root's FQN, and embedding is allowed
only at the document root.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Full-document shape-->
        <dpage:Section heading="Authored like any Block document">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>An embedded Block is authored the same way as the document root, with its own
required, fully qualified type, and it may declare Sub-Blocks and generic
type parameters like any other Block.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Where embedding is allowed-->
        <dpage:Section heading="Embedding only at the document root">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>Only the document root owns embeddedBlocks; an embedded Block must not declare
further embeddedBlocks of its own, so embedding does not nest. Several
embedded Blocks may be listed flat at the root of one document to compose a
larger unit.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Scope within the document-->
        <dpage:Section heading="Where an embedded Block is visible">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>Within its own document, an embedded Block's identity takes precedence over a
library or file definition sharing that identity, but the embedded Block
itself stays invisible outside that document.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. Recap-->
        <dpage:Section heading="What to remember about embedded Blocks">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>An embedded Block reads like an ordinary Block document keeping its own
identity, which is what distinguishes it from a Sub-Block, whose identity
instead extends its parent's.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with documenting Blocks">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Documenting Blocks" summary="Learn how a Block definition carries its own documentation model.">
                  <target>docs:DocumentingBlocks</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:EmbeddedBlocks>
