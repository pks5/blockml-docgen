<!--BlockML Documentation — a guide to embedded Block definitions

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.EmbeddedBlocks-->
<docs:EmbeddedBlocks xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to embedded Block definitions
  </is>
  <documentation>
    Scope: embedded Block definitions and instances as full virtual documents, grounded in the
    Embedded Blocks section of org.blockml.bml.documentation.SubBlockModel and
    org.blockml.bml.definition.EmbeddedBlockDefinition. Body content is authored in a04 from those
    sources.
  </documentation>
  <references>
    <see type="doc:SubBlockModel" relation="Requires">
      Primary content source — embedded Blocks as virtual .bml files under root embeddedBlocks.
    </see>
    <see type="def:EmbeddedBlockDefinition" relation="Requires">
      The virtual embedded Block document shape this page introduces.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Embedded Blocks</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="An inlined full document">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="An embedded Block is a virtual .bml file inlined under a root Block's embeddedBlocks — a full Block document in its own right, not a lightweight fragment." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="An independent identity">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="An embedded Block's fully qualified name is resolved from its own type rather than nested under the root's name, and it is authored the same way as a document root, with the element tag itself supplying the type." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Root-only">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Only the document root may own embeddedBlocks — Sub-Blocks and embedded Blocks themselves must not declare further embeds." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Embedded Block versus Sub-Block">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Sub-Block is a semantically nested type sharing the parent's fully qualified name prefix, while an embedded Block is an independent, full document that is only inlined for convenience." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="With this distinction in place, an embedded Block can now be authored as its own full document, without confusing it with a lightweight fragment or a Sub-Block." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with documenting Blocks">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Documenting Blocks" summary="Learn the is, documentation, and references model.">
                  <target>docs:DocumentingBlocks</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:EmbeddedBlocks>
