<!--BlockML Documentation — a guide to the Block-versus-instance distinction

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.BlockDefinitionsAndInstances-->
<docs:BlockDefinitionsAndInstances xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to the Block-versus-instance distinction
  </is>
  <documentation>
    Scope: Block definition versus Block instance and the class/object analogy, grounded in
    org.blockml.bml.documentation.BlockAndInstance and org.blockml.bml.definition.BlockDefinition.
    Body content is authored in a04 from those sources.
  </documentation>
  <references>
    <see type="doc:BlockAndInstance" relation="Requires">
      Primary content source — Block as declarative class, instance as object, composition as containment.
    </see>
    <see type="def:BlockDefinition" relation="Requires">
      Meta-model shape of a Block definition document.
    </see>
    <see type="doc:MemberAuthoring" relation="SeeAlso">
      Definition-field versus instance-payload syntax that follows from this distinction.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Block Definitions and Instances</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="A class-versus-object analogy">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="The closest familiar model is that a Block is a declarative semantic Class, and a Block Instance is an Object." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="A semantic analogy, not a runtime mandate">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="The class/object analogy is semantic, not a mandate for runtime object orientation — the compiler may represent both definitions and instances as plain data." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What a Block definition describes">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Block definition is a .bml file whose meta-model shape describes an FQN, members, and a composition schema — the shape and behaviour of a concept, with no runtime and no address." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What a Block instance is">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Block Instance is one concrete occurrence in a composition, carrying a type FQN, an identity, and member values." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Readers should now be able to tell a Block definition from a Block instance in any piece of BML." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with inheritance">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Inheritance" summary="Learn how Blocks specialize one another via baseType.">
                  <target>docs:Inheritance</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:BlockDefinitionsAndInstances>
