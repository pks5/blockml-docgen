<!--BlockML Documentation — a guide to the Block-versus-instance distinction

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.BlockDefinitionsAndInstances-->
<docs:BlockDefinitionsAndInstances xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to the Block-versus-instance distinction
  </is>
  <documentation>
    Scope: Block definition versus Block instance and the class/object analogy, grounded in
    org.blockml.bml.documentation.BlockAndInstance and org.blockml.bml.definition.BlockDefinition.
    Body content is authored in a03 from those sources.
  </documentation>
  <references>
    <see type="doc:BlockAndInstance" relation="Requires">
      Primary content source — Block as declarative class, instance as object, composition as containment.
    </see>
    <see type="def:BlockDefinition" relation="Requires">
      Meta-model shape of a Block definition document.
    </see>
    <see type="doc:MemberAuthoring" relation="SeeAlso">
      Definition-field versus instance-payload syntax that follows from this distinction.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Block Definitions and Instances</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="A definition is like a class; an instance is like an object">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>A Block definition describes a concept the way a class describes a kind of
thing; a Block instance is one concrete occurrence of that concept, the way an
object is one concrete occurrence of a class.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. The definition-->
        <dpage:Section heading="The Block definition">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>A Block definition is a document that declares a concept's shape: its
identity, and the members it offers, without yet holding any concrete
values.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. The instance-->
        <dpage:Section heading="The Block instance">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>A Block instance is one concrete occurrence of a defined concept, appearing
where a model is being configured, carrying its own identity and its own
concrete member values, distinct from the document that defines that Block's
shape.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Semantic analogy, not a mandate-->
        <dpage:Section heading="A semantic analogy, not a runtime mandate">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>The class/object analogy orients a reader toward the right mental model, but
it is a semantic analogy rather than a mandate that definitions and instances
must be represented as distinct runtime object kinds — the compiler remains
free to represent both as plain data.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. Telling them apart-->
        <dpage:Section heading="Telling a definition from an instance">
          <content>
            <dpage:List>
              <items>
                <dpage:ListItem text="A definition is its own document; an instance appears nested inside another Block's content." />
                <dpage:ListItem text="A definition declares shape and member names; an instance supplies concrete values for those members." />
                <dpage:ListItem text="A definition is identified by the type it names; an instance is identified as one particular occurrence of that type." />
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with inheritance">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Inheritance" summary="Learn how a Block specializes another Block through baseType.">
                  <target>docs:Inheritance</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:BlockDefinitionsAndInstances>
