<!--BlockML Documentation — a guide to the Block-versus-instance distinction

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.BlockDefinitionsAndInstances-->
<docs:BlockDefinitionsAndInstances xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition"
  xmlns:workflow="org.blockml.bml.transformer.workflow"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to the Block-versus-instance distinction
  </is>
  <documentation>
    Scope: Block definition versus Block instance and the class/object analogy, grounded in
    org.blockml.bml.documentation.BlockAndInstance and org.blockml.bml.definition.BlockDefinition.
    Body content is authored in a03 from those sources.
  </documentation>
  <references>
    <see type="doc:BlockAndInstance" relation="Requires">
      Primary content source — Block as declarative class, instance as object, composition as containment.
    </see>
    <see type="def:BlockDefinition" relation="Requires">
      Meta-model shape of a Block definition document.
    </see>
    <see type="doc:MemberAuthoring" relation="SeeAlso">
      Definition-field versus instance-payload syntax that follows from this distinction.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Block Definitions and Instances</value>
    </title>
    <purpose override="true">
      <value>Teach the definition-versus-instance distinction as a semantic analogy — not a runtime OOP mandate — so readers can tell a Block definition from a Block instance in any piece of BML.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <workflow:AuthorativeSourceSet>
          <includedTypes>
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.BlockAndInstance" />
            <type:TypeSelectorEntity value="org.blockml.bml.definition.BlockDefinition" />
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.MemberAuthoring" />
          </includedTypes>
        </workflow:AuthorativeSourceSet>
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>Teach the definition-versus-instance distinction as a semantic analogy, not a runtime OOP mandate.</summary>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>The reader can tell a Block definition from a Block instance in a piece of BML.</summary>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>Block definition versus Block instance: the class/object analogy, and the difference between defining a concept and configuring one.</summary>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>Inheritance, contracts, and member overrides.</summary>
          <reason>Those build on this distinction on their own following pages.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <supportingPoints override="true">
      <composition>
        <sem:SupportingPoint>
          <summary>The class/object analogy orients readers but is a semantic analogy — the compiler may represent both as plain data.</summary>
        </sem:SupportingPoint>
      </composition>
    </supportingPoints>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="A definition is like a class; an instance is like an object" purpose="Give an immediate orientation to the definition-versus-instance distinction">
          <content>
            <dpage:Paragraph purpose="State the class/object analogy in one sentence">
              <role>org.blockml.bml.docgen.role.Lead</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A Block definition describes a concept the way a class describes a kind of
thing; a Block instance is one concrete occurrence of that concept, the way an
object is one concrete occurrence of a class.</message>
              <authoritativeSources>
                <doc:BlockAndInstance />
              </authoritativeSources>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. The definition-->
        <dpage:Section heading="The Block definition" purpose="Explain what a Block definition declares">
          <content>
            <dpage:Paragraph purpose="Explain the role of a Block definition document">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A Block definition is a document that declares a concept's shape: its
identity, and the members it offers, without yet holding any concrete
values.</message>
              <authoritativeSources>
                <def:BlockDefinition />
              </authoritativeSources>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. The instance-->
        <dpage:Section heading="The Block instance" purpose="Explain what a Block instance is">
          <content>
            <dpage:Paragraph purpose="Explain the role of a Block instance">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A Block instance is one concrete occurrence of a defined concept, appearing
where a model is being configured, carrying its own identity and its own
concrete member values.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>An instance is one concrete occurrence of a Block, distinct from the document that defines that Block's shape.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.BlockAndInstance" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Semantic analogy, not a mandate-->
        <dpage:Section heading="A semantic analogy, not a runtime mandate" purpose="Qualify the class/object analogy so it is not overread">
          <content>
            <dpage:Paragraph purpose="Explain that the analogy is semantic rather than a literal runtime requirement">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>The class/object analogy orients a reader toward the right mental model, but
it is a semantic analogy rather than a mandate that definitions and instances
must be represented as distinct runtime object kinds.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>The class/object analogy orients readers but is a semantic analogy — the compiler may represent both as plain data.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.BlockAndInstance" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. Telling them apart-->
        <dpage:Section heading="Telling a definition from an instance" purpose="Give the reader concrete cues for distinguishing the two in BML">
          <content>
            <dpage:List purpose="Summarize the cues that distinguish a definition from an instance">
              <role>org.blockml.bml.docgen.role.Summary</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>A short set of cues is usually enough to tell whether a piece of BML is
defining a concept or configuring one.</message>
              <items>
                <dpage:ListItem text="Where it appears" purpose="Contrast a definition's own document with an instance nested inside another Block">
                  <message>A definition is its own document; an instance appears nested inside another Block's content.</message>
                </dpage:ListItem>
                <dpage:ListItem text="What it declares" purpose="Contrast declared shape with concrete values">
                  <message>A definition declares shape and member names; an instance supplies concrete values for those members.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Its identity" purpose="Contrast a definition's type identity with an instance's own occurrence identity">
                  <message>A definition is identified by the type it names; an instance is identified as one particular occurrence of that type.</message>
                </dpage:ListItem>
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with inheritance" purpose="Direct the reader to the next page">
          <content>
            <dpage:Navigation purpose="Continue from the definition-versus-instance distinction into inheritance">
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Inheritance" summary="Learn how a Block specializes another Block through baseType.">
                  <target>docs:Inheritance</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:BlockDefinitionsAndInstances>
