<!--BlockML Documentation — a guide to packages, Libraries, and fully qualified names

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.NamespacesAndFullyQualifiedNames-->
<docs:NamespacesAndFullyQualifiedNames xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to packages, Libraries, and fully qualified names
  </is>
  <documentation>
    Scope: packages, Libraries, fully qualified names, namespace prefixes, and name resolution,
    grounded in org.blockml.bml.documentation.BmlNamespace and
    org.blockml.bml.documentation.LibrarySystem. Body content is authored in a04 from those
    sources.
  </documentation>
  <references>
    <see type="doc:BmlNamespace" relation="Requires">
      Primary content source — mandatory domain.bml namespace and xmlns prefix conventions.
    </see>
    <see type="doc:LibrarySystem" relation="Requires">
      Primary content source — Library grouping, membership, and FQN derivation from package path.
    </see>
    <see type="doc:TypeIdentityDerivation" relation="SeeAlso">
      Deeper FQN and identity derivation rules.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Namespaces and Fully Qualified Names</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="The domain.bml namespace rule">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Every BML definition — Blocks, Libraries, Types, Languages, Services, Capabilities, and other BlockML definitions — must reside below its owning domain's bml package, in the general form domain.bml.* (for example org.blockml.bml.* or com.example.bml.*)." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Physical layout mirrors the FQN">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Physical source layout mirrors the fully qualified name: a Block's package path and file name determine its FQN, so the file blocks/org/blockml/bml/core/Block.bml defines org.blockml.bml.core.Block." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What a Library groups">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Library groups related Block and ValueType definitions into a publishable unit. Membership is defined exclusively by what its Library.bml block lists, not by directory layout — without a Library block, every .bml source file in the directory is public." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Namespace prefixes">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="An xmlns prefix maps to a package segment of a Block's fully qualified name. By convention, a bare short prefix such as core or type always refers to BlockML itself, while a domain's mirror of the same segment adds a domain token in front." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Readers should now be able to compute a Block's fully qualified name from its package and file location, and know what a Library groups." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with identifiers and references">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Identifiers and References" summary="Learn the identifier-versus-reference distinction.">
                  <target>docs:IdentifiersAndReferences</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:NamespacesAndFullyQualifiedNames>
