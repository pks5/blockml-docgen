<!--BlockML Documentation — a guide to packages, Libraries, and fully qualified names

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.NamespacesAndFullyQualifiedNames-->
<docs:NamespacesAndFullyQualifiedNames xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to packages, Libraries, and fully qualified names
  </is>
  <documentation>
    Scope: packages, Libraries, fully qualified names, namespace prefixes, and name resolution,
    grounded in org.blockml.bml.documentation.BmlNamespace and
    org.blockml.bml.documentation.LibrarySystem. Body content is authored in a03 from those
    sources.
  </documentation>
  <references>
    <see type="doc:BmlNamespace" relation="Requires">
      Primary content source — mandatory domain.bml namespace and xmlns prefix conventions.
    </see>
    <see type="doc:LibrarySystem" relation="Requires">
      Primary content source — Library grouping, membership, and FQN derivation from package path.
    </see>
    <see type="doc:TypeIdentityDerivation" relation="SeeAlso">
      Deeper FQN and identity derivation rules.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Namespaces and Fully Qualified Names</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="Every Block lives at a fully qualified address">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>Every Block has one fully qualified name, built from the package it lives
in and its own name. That single address is how the rest of a model points back
to it.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Packages and the domain namespace">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>Every BML definition lives under a package dedicated to its owning
domain, following the pattern domain.bml.* — for example org.blockml.bml.* for
the BlockML framework itself. Gathering a domain's definitions under one
namespace keeps that domain's whole vocabulary of Blocks in one place, and no
Block or Library may be declared outside it.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Fully qualified names">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>A Block's fully qualified name combines its package with its own name.
The physical location of its source file mirrors that same address, so a
Block's file can always be found from its fully qualified name alone.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Namespace prefixes">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>A namespace prefix is a short alias bound to one package. It lets an
author write a brief prefixed name instead of repeating the full package path
every time a Block from that package is named.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What a Library groups">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>A Library groups a set of Block and value type definitions into one
publishable unit. Membership is stated explicitly by the Library's own declared
list of exported definitions, not assumed from where the files happen to sit in
the source tree.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with identifiers and references">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Identifiers and References" summary="Learn the difference between a name that is only checked for syntax and one that must resolve.">
                  <target>docs:IdentifiersAndReferences</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:NamespacesAndFullyQualifiedNames>
