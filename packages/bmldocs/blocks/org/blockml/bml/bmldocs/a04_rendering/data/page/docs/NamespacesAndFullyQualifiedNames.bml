<!--BlockML Documentation — a guide to packages, Libraries, and fully qualified names

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.NamespacesAndFullyQualifiedNames-->
<docs:NamespacesAndFullyQualifiedNames xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to packages, Libraries, and fully qualified names
  </is>
  <documentation>
    Scope: packages, Libraries, fully qualified names, namespace prefixes, and name resolution,
    grounded in org.blockml.bml.documentation.BmlNamespace and
    org.blockml.bml.documentation.LibrarySystem. Body content is rendered in a04 from those
    sources.
  </documentation>
  <references>
    <see type="doc:BmlNamespace" relation="Requires">
      Primary content source — mandatory domain.bml namespace and xmlns prefix conventions.
    </see>
    <see type="doc:LibrarySystem" relation="Requires">
      Primary content source — Library grouping, membership, and FQN derivation from package path.
    </see>
    <see type="doc:TypeIdentityDerivation" relation="SeeAlso">
      Deeper FQN and identity derivation rules.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Namespaces and Fully Qualified Names</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Where a Block lives">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Every BML definition — Blocks, Libraries, types, and every other BlockML definition — must reside below its owning domain's bml package, in the general form domain.bml.*." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Physical layout mirrors the FQN-->
        <dpage:Section heading="Physical layout mirrors the FQN">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Physical source layout mirrors the FQN, so a Block's package alone tells a reader exactly where its file lives — no separate directory convention is needed." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Libraries group FQNs-->
        <dpage:Section heading="How a Library groups Blocks">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Library groups related Block and ValueType definitions into one publishable unit, whose FQN is derived from its own package path; membership is defined exclusively by what the Library's blocks list names, not by directory layout." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="Reading a package into a prefix">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="An xmlns binding maps a short authoring prefix to the full package FQN, so a qualified reference stays readable without repeating the whole package name." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- xmlns:acme binds the prefix "acme" to the package "com.acme.example" -->
<acme:Basket xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    core:Block
  </baseType>
</acme:Basket>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="The root tag acme:Basket expands to the FQN com.acme.example.Basket, and baseType's core:Block expands to org.blockml.bml.core.Block using the same kind of binding. The prefix in the example is authoring convenience only — the canonical FQN it expands to is what actually identifies the Block, and that FQN is what a reader could reconstruct from the package's physical file location alone." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should be able to compute a Block's FQN from its package and know what a Library groups, before distinguishing identifiers from references on the next page." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with identifiers and references">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Identifiers and References" summary="Learn the identifier-versus-reference distinction.">
                  <target>docs:IdentifiersAndReferences</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:NamespacesAndFullyQualifiedNames>
