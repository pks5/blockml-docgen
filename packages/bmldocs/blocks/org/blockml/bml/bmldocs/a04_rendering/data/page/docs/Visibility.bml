<!--BlockML Documentation — a guide to member and Sub-Block visibility

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Visibility-->
<docs:Visibility xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to member and Sub-Block visibility
  </is>
  <documentation>
    Scope: member and Sub-Block visibility and the public/protected/private naming convention,
    grounded in org.blockml.bml.documentation.MemberVisibility and
    org.blockml.bml.definition.SubBlockDefinition. Body content is authored in a04 from those
    sources.
  </documentation>
  <references>
    <see type="doc:MemberVisibility" relation="Requires">
      Primary content source — naming convention, formal access, and visibility diagnostics.
    </see>
    <see type="def:SubBlockDefinition" relation="Requires">
      Sub-Blocks share the same naming-convention visibility rules as members.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Visibility</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="Visibility by naming convention">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A member's name signals its visibility by naming convention: myVar is public, _myVar is protected, and __myVar is private." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What visibility restricts">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Visibility controls which definitions may reference, read, or set a member — it restricts BlockML authoring access only, and renderers always see the entire Canonical BOM, public, protected, and private members alike." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Widening on override">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A child Block may redeclare an inherited member with wider visibility, such as widening protected to public, but narrowing visibility on override is not allowed." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Sub-Blocks share the same rule">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Sub-Blocks follow the same naming-convention visibility rules as ordinary members — a Sub-Block's own name marks it public, protected, or private in exactly the same way." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Readers should now be able to tell a member's visibility from its name alone, using the public, protected, and private naming convention." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with multiplicity and collections">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Multiplicity and Collections" summary="Learn how optional, singular, and multiple values are expressed.">
                  <target>docs:MultiplicityAndCollections</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Visibility>
