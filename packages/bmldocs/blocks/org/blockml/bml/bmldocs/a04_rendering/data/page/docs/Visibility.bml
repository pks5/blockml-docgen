<!--BlockML Documentation — a guide to member and Sub-Block visibility

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Visibility-->
<docs:Visibility xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to member and Sub-Block visibility
  </is>
  <documentation>
    Scope: member and Sub-Block visibility and the public/protected/private naming convention,
    grounded in org.blockml.bml.documentation.MemberVisibility and
    org.blockml.bml.definition.SubBlockDefinition. Body content is authored in a04 from those
    sources.
  </documentation>
  <references>
    <see type="doc:MemberVisibility" relation="Requires">
      Primary content source — naming convention, formal access, and visibility diagnostics.
    </see>
    <see type="def:SubBlockDefinition" relation="Requires">
      Sub-Blocks share the same naming-convention visibility rules as members.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Visibility</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Visibility lives in the name">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A member or Sub-Block's visibility is signaled primarily by its own name: myVar is public, _myVar is protected, and __myVar is private." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. What visibility actually restricts-->
        <dpage:Section heading="What visibility actually restricts">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Visibility controls which definitions may reference, read, or set a member — it does not prescribe how a renderer manifests that member, since renderers always see the entire canonical BOM regardless of declared visibility." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Widening on override-->
        <dpage:Section heading="Visibility may widen, never narrow">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A child Block's redeclaration may widen a member's visibility, such as protected to public, but it may never narrow it; collision checks always compare members by their normalized logical name with visibility prefixes stripped, so a logical member exists exactly once regardless of which prefix names it." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="Three visibilities on one Block">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A single Block can declare properties at all three visibilities side by side, distinguished purely by their names." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- title, _internalNote, and __cache read as public, protected, and private purely from their name prefixes -->
<acme:Widget xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Block
  </baseType>
  <properties>
    <title type="type:Text">
      <value>Untitled</value>
    </title>
    <_internalNote type="type:Text">
      <value>Draft</value>
    </_internalNote>
    <__cache type="type:Text" />
  </properties>
</acme:Widget>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Nothing but the name distinguishes these three properties' visibility — title, _internalNote, and __cache read as public, protected, and private purely from their prefixes, with no separate visibility attribute needed on any of them." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should be able to tell a member's visibility from its name, before multiplicity closes out the member model with how many values a member may hold." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with multiplicity and collections">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Multiplicity and Collections" summary="Learn optional, singular, and multiple values.">
                  <target>docs:MultiplicityAndCollections</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Visibility>
