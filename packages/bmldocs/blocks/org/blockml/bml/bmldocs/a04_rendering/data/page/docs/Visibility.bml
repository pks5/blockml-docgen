<!--BlockML Documentation — a guide to member and Sub-Block visibility

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Visibility-->
<docs:Visibility xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to member and Sub-Block visibility
  </is>
  <documentation>
    Scope: member and Sub-Block visibility and the public/protected/private naming convention,
    grounded in org.blockml.bml.documentation.MemberVisibility and
    org.blockml.bml.definition.SubBlockDefinition. Body content is authored in a03 from those
    sources.
  </documentation>
  <references>
    <see type="doc:MemberVisibility" relation="Requires">
      Primary content source — naming convention, formal access, and visibility diagnostics.
    </see>
    <see type="def:SubBlockDefinition" relation="Requires">
      Sub-Blocks share the same naming-convention visibility rules as members.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Visibility</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="Visibility is a naming convention">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>A member's visibility — public, protected, or private — is signalled directly
by how its name is written. No separate visibility declaration is required; the name itself
carries the meaning.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Reading visibility from a member's name">
          <content>
            <dpage:List>
              <items>
                <dpage:ListItem text="An ordinary name with no leading underscore is public." />
                <dpage:ListItem text="A name with a single leading underscore is protected." />
                <dpage:ListItem text="A name with two leading underscores is private." />
              </items>
            </dpage:List>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>Once these three forms are known, a member's visibility can always be read
directly from how it is named, without consulting anything else.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What visibility actually restricts">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>Visibility controls BlockML authoring access — which definitions may reference,
read, or set a given member or Sub-Block.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Renderers see everything">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>Visibility restricts authoring access only — renderers always see the entire
canonical model regardless of a member's visibility.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Sub-Blocks follow the same convention">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>A Sub-Block's visibility is read from its own name the same way a member's is —
the same public, protected, and private naming convention applies to both.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with Multiplicity and Collections">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Multiplicity and Collections" summary="Learn multiplicity as one axis of a type expression.">
                  <target>docs:MultiplicityAndCollections</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Visibility>
