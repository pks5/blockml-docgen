<!--BlockML Documentation — a guide to typed value members

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Properties-->
<docs:Properties xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to typed value members
  </is>
  <documentation>
    Scope: typed value members, their definition, configuration, and inheritance and override,
    grounded in org.blockml.bml.definition.PropertyDefinition and the Property authoring rules in
    org.blockml.bml.documentation.MemberAuthoring. Body content is authored in a04 from those
    sources.
  </documentation>
  <references>
    <see type="def:PropertyDefinition" relation="Requires">
      The typed value member this page introduces.
    </see>
    <see type="doc:MemberAuthoring" relation="Requires">
      Primary content source — definition-field value versus instance-side payload syntax.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Properties</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="A scalar or structured value member">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Property describes a Block member that carries a scalar or structured value — its declared type must resolve to a ValueType, and its value lives on the declaration itself." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Definition value versus instance payload-->
        <dpage:Section heading="Definition value versus instance payload">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="On a Property declaration inside properties, the default value lives in the declaration's own value field — element form such as value is preferred, and a compact value attribute is also valid, but never both together on the same declaration." />
              </content>
            </dpage:Paragraph>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="On a Block instance, that same property is set as a plain attribute on the Block or as the property element's direct content — never wrapped in a value element, which is a definition-only field and not a general-purpose instance container." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Inheritance and override-->
        <dpage:Section heading="Inheriting and overriding a Property">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A child Block that refines an inherited Property restates only the attributes that change and marks the declaration override=&quot;true&quot; — a type that stays the same should be omitted rather than repeated." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="A typed Property with a default value">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Property declaration states its type and, when it has one, a default value, both as sibling fields on the same declaration element." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- The greeting property declares its type and a default value as sibling fields -->
<acme:Greeter xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Block
  </baseType>
  <properties>
    <greeting type="type:Text">
      <value>Hello, BlockML.</value>
    </greeting>
  </properties>
</acme:Greeter>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="An instance of Greeter would set this same greeting property as a plain attribute, greeting=&quot;Hi there&quot;, or as the element's direct content, never repeating the value wrapper shown on the declaration." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should be able to declare a typed Property with a default value and tell the definition-side value field apart from an instance-side payload, before Aggregations extends the member model to owned collections." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with aggregations">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Aggregations" summary="Learn owned collection members.">
                  <target>docs:Aggregations</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Properties>
