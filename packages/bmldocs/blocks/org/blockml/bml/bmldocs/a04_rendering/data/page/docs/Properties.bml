<!--BlockML Documentation — a guide to typed value members

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Properties-->
<docs:Properties xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to typed value members
  </is>
  <documentation>
    Scope: typed value members, their definition, configuration, and inheritance and override,
    grounded in org.blockml.bml.definition.PropertyDefinition and the Property authoring rules in
    org.blockml.bml.documentation.MemberAuthoring. Body content is rendered in a04 from those
    sources.
  </documentation>
  <references>
    <see type="def:PropertyDefinition" relation="Requires">
      The typed value member this page introduces.
    </see>
    <see type="doc:MemberAuthoring" relation="Requires">
      Primary content source — definition-field value versus instance-side payload syntax.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Properties</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="A scalar or structured value member">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Property describes a Block member that carries a scalar or structured value — its type must resolve to a ValueType, and its value lives in the declaration's own value field." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Definition value versus instance payload-->
        <dpage:Section heading="Definition value versus instance payload">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="On the declaration, a Property's default lives in its value field — element form is preferred, and a compact attribute form is also valid, but never both on the same declaration." />
              </content>
            </dpage:Paragraph>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="On a Block instance the Property is a plain attribute or the element's direct content — never wrapped in value, which is a definition-only field, not a general instance-payload container." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Inheritance and override-->
        <dpage:Section heading="Inheriting and overriding a Property">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A child Block refining an inherited Property restates only the changed attributes with override=&quot;true&quot; — an unchanged type should be omitted rather than repeated." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="A typed Property with a default value">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Property declaration states its type and, when it has one, its default value — both as sibling fields on the same declaration element." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- "caption" declares type Text and a default value -->
<acme:Label xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Block
  </baseType>
  <properties>
    <caption type="type:Text">
      <value>Untitled</value>
    </caption>
  </properties>
</acme:Label>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="caption's declaration carries type Text and a value child holding the default, Untitled. An instance of Label would set this same property as a plain attribute, caption=&quot;Front Door&quot;, or as direct element content — never repeating the value wrapper shown on the declaration." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should be able to declare a typed Property with a default value and tell the definition-side value field apart from an instance-side payload, before Aggregations extend the member model to owned collections." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with aggregations">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Aggregations" summary="Learn owned collection members.">
                  <target>docs:Aggregations</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Properties>
