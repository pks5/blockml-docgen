<!--BlockML Documentation — a guide to typed value members

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Properties-->
<docs:Properties xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to typed value members
  </is>
  <documentation>
    Scope: typed value members, their definition, configuration, and inheritance and override,
    grounded in org.blockml.bml.definition.PropertyDefinition and the Property authoring rules in
    org.blockml.bml.documentation.MemberAuthoring. Body content is authored in a04 from those
    sources.
  </documentation>
  <references>
    <see type="def:PropertyDefinition" relation="Requires">
      The typed value member this page introduces.
    </see>
    <see type="doc:MemberAuthoring" relation="Requires">
      Primary content source — definition-field value versus instance-side payload syntax.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Properties</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="A scalar or structured value member">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Property is a Block member that carries a scalar or structured value, typed by a ValueType." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Declaring a Property">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Property declaration names its value's ValueType in a type field and may set an optional default in a value field, both written inside the properties container on the Block definition." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Definition value versus instance payload">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="The value field belongs only to the Property declaration itself; on a Block instance, the Property's value is supplied directly as a Block attribute or as the Property element's own content, and must never be wrapped in a nested value element." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Optional, never null">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Every Property behaves as Optional: it either holds a value or holds none at all — there is no null state." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="With this, you can declare a typed Property with a default value and tell the definition-side value field apart from the instance-side payload." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with Aggregations">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Aggregations" summary="Learn how an owned collection member is declared and filled.">
                  <target>docs:Aggregations</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Properties>
