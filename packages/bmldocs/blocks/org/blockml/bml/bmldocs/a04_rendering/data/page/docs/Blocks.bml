<!--BlockML Documentation — a guide to defining, naming, and referencing a Block

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Blocks-->
<docs:Blocks xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:core="org.blockml.bml.core"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to defining, naming, and referencing a Block
  </is>
  <documentation>
    Scope: what a Block is, defining a Block, identifying a Block, referencing a Block, and the
    difference between defining and using a Block, grounded in org.blockml.bml.core.Block,
    org.blockml.bml.documentation.BlockNameConvention, and
    org.blockml.bml.documentation.DocumentFormat. Body content is authored in a04 from those
    sources.
  </documentation>
  <references>
    <see type="core:Block" relation="Requires">
      The Block root type this page introduces.
    </see>
    <see type="doc:BlockNameConvention" relation="Requires">
      Block name formatting and its relationship to type identity.
    </see>
    <see type="doc:DocumentFormat" relation="Requires">
      Element-tag authoring for defining a Block document.
    </see>
    <see type="doc:TypeIdentityDerivation" relation="SeeAlso">
      Full type-reference and identity derivation rules.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Blocks</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="A Block is BlockML's basic unit">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Block is BlockML's basic unit: a named, typed definition with an explicit identity that other Blocks can extend, reference, or compose." />
                <dpage:Text text="Every concept this handbook covers, from a simple domain type to a documentation page like this one, is authored as a Block." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Naming a Block-->
        <dpage:Section heading="Naming a Block">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Block's name is a PascalCase class name — letters and digits only, starting with an uppercase letter, as in Wall or StandardBrick." />
                <dpage:Text text="That convention keeps composition instance tags, which carry an xmlns prefix, visually unambiguous against camelCase member names such as a Property or an Aggregation." />
                <dpage:Text text="On a root Block, an explicit name is optional; when it is present it must equal the last segment of the Block's resolved type, so name never contradicts identity." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Defining versus referencing-->
        <dpage:Section heading="Defining a Block versus referencing one">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Defining a Block means authoring its root document, where the element tag itself supplies the Block's type — the preferred root tag is the type itself, such as acme:MyBlock, rather than a generic wrapper." />
                <dpage:Text text="Referencing a Block means writing its FQN or an xmlns-qualified name somewhere else, such as at a member type or a baseType site." />
                <dpage:Text text="The two are never confused, because only one document can define a given FQN — every other mention of that name is necessarily a reference to it." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="Defining a small Block">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Defining a Block requires only a type identity and a baseType — everything else, including documentation and members, may follow once identity is established." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- The qualified root tag supplies the type; an optional name must match the tag's last segment -->
<acme:Calibrator xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:core="org.blockml.bml.core">

  <name>
    Calibrator
  </name>
  <baseType>
    core:Block
  </baseType>
</acme:Calibrator>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="The root tag acme:Calibrator in the example is both the Block's type and, by the PascalCase rule, the basis of its name." />
                <dpage:Text text="The explicit name element only repeats that same last segment, Calibrator, which is why it stays optional rather than required." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should be able to point at a Block's FQN, its definition file, and a place where it is used — the distinction the next page deepens into definitions and instances." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with definitions and instances">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Block Definitions and Instances" summary="Learn the Block-versus-instance distinction.">
                  <target>docs:BlockDefinitionsAndInstances</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Blocks>
