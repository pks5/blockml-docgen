<!--BlockML Documentation — a guide to defining, naming, and referencing a Block

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Blocks-->
<docs:Blocks xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:core="org.blockml.bml.core"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to defining, naming, and referencing a Block
  </is>
  <documentation>
    Scope: what a Block is, defining a Block, identifying a Block, referencing a Block, and the
    difference between defining and using a Block, grounded in org.blockml.bml.core.Block,
    org.blockml.bml.documentation.BlockNameConvention, and
    org.blockml.bml.documentation.DocumentFormat. Body content is rendered in a04 from those
    sources.
  </documentation>
  <references>
    <see type="core:Block" relation="Requires">
      The Block root type this page introduces.
    </see>
    <see type="doc:BlockNameConvention" relation="Requires">
      Block name formatting and its relationship to type identity.
    </see>
    <see type="doc:DocumentFormat" relation="Requires">
      Element-tag authoring for defining a Block document.
    </see>
    <see type="doc:TypeIdentityDerivation" relation="SeeAlso">
      Full type-reference and identity derivation rules.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Blocks</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="A Block is BlockML's basic unit">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Block is BlockML's basic unit: a named, typed definition with an explicit identity that other Blocks can extend, reference, or compose." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Naming a Block-->
        <dpage:Section heading="Naming a Block">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Block's name is a PascalCase class name — letters and digits only, starting with an uppercase letter — which keeps composition instance tags with xmlns prefixes unambiguous against camelCase member names. On a root Block, name is optional and, when present, must equal the last segment of the resolved type." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Defining versus referencing-->
        <dpage:Section heading="Defining a Block versus referencing one">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Defining a Block means authoring its root document, where the element tag supplies its type; referencing a Block elsewhere means writing its FQN or an xmlns-qualified name at a member type or baseType site — the two are never confused because only one document can define a given FQN. The preferred document root tag is the type itself, such as acme:Widget, rather than a generic block wrapper." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="Defining a small Block">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Defining a Block requires only a type identity and a baseType — everything else, including documentation and members, may follow once identity is established." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- The root tag "acme:Widget" supplies the type; name is optional here -->
<acme:Widget xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:core="org.blockml.bml.core">

  <name>Widget</name>
  <baseType>
    core:Block
  </baseType>
</acme:Widget>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="The root tag in the example is both the Block's type and, by the PascalCase rule, the basis of its name — the explicit name element only repeats that same last segment, Widget, and could equally have been omitted." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should be able to point at a Block's FQN, its definition file, and a place where it is used — the distinction the next page deepens into definitions and instances." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with definitions and instances">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Block Definitions and Instances" summary="Learn the Block-versus-instance distinction.">
                  <target>docs:BlockDefinitionsAndInstances</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Blocks>
