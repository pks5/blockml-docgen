<!--BlockML Documentation — a guide to defining, naming, and referencing a Block

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Blocks-->
<docs:Blocks xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to defining, naming, and referencing a Block
  </is>
  <documentation>
    Scope: what a Block is, defining a Block, identifying a Block, referencing a Block, and the
    difference between defining and using a Block, grounded in org.blockml.bml.core.Block,
    org.blockml.bml.documentation.BlockNameConvention, and
    org.blockml.bml.documentation.DocumentFormat. Body content is authored in a03 from those
    sources.
  </documentation>
  <references>
    <see type="core:Block" relation="Requires">
      The Block root type this page introduces.
    </see>
    <see type="doc:BlockNameConvention" relation="Requires">
      Block name formatting and its relationship to type identity.
    </see>
    <see type="doc:DocumentFormat" relation="Requires">
      Element-tag authoring for defining a Block document.
    </see>
    <see type="doc:TypeIdentityDerivation" relation="SeeAlso">
      Full type-reference and identity derivation rules.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Blocks</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="The Block: BlockML's basic unit">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>A Block is the basic unit BlockML is built from: a named, identifiable
description of a concept, with its own place among the language's other
concepts.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Defining-->
        <dpage:Section heading="Defining a Block">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>Defining a Block means writing a document that gives it a name, states its
own type identity, and declares what kind of concept it specializes. Identity
comes first in a Block document, before any prose describing what the Block
means.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Naming and identity-->
        <dpage:Section heading="Naming a Block">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>A Block's name is a PascalCase word, and its canonical type identity comes
either from the tag that opens its document or from an explicit type field
inside it.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<acme:StandardBrick>
  <is>
    A brick of standard size
  </is>
</acme:StandardBrick>]]></code>
            </dpage:CodeBlock>
          </content>
        </dpage:Section>
        <!--4. Referencing-->
        <dpage:Section heading="Locating and referencing a Block">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>Referencing a Block elsewhere in a model means pointing at the name of its
own defining document, so a reader can always find the single place that Block
is actually defined.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. Defining versus using-->
        <dpage:Section heading="Defining a Block versus using one">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>Defining a Block creates its one canonical description; using a Block only
ever points back to that description, so the same Block can be pointed at from
many places without ever being redefined.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with definitions and instances">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Block Definitions and Instances" summary="Learn the difference between a Block definition and a Block instance.">
                  <target>docs:BlockDefinitionsAndInstances</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Blocks>
