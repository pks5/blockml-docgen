<!--BlockML Documentation — a guide to defining, naming, and referencing a Block

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Blocks-->
<docs:Blocks xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to defining, naming, and referencing a Block
  </is>
  <documentation>
    Scope: what a Block is, defining a Block, identifying a Block, referencing a Block, and the
    difference between defining and using a Block, grounded in org.blockml.bml.core.Block,
    org.blockml.bml.documentation.BlockNameConvention, and
    org.blockml.bml.documentation.DocumentFormat. Body content is authored in a04 from those
    sources.
  </documentation>
  <references>
    <see type="core:Block" relation="Requires">
      The Block root type this page introduces.
    </see>
    <see type="doc:BlockNameConvention" relation="Requires">
      Block name formatting and its relationship to type identity.
    </see>
    <see type="doc:DocumentFormat" relation="Requires">
      Element-tag authoring for defining a Block document.
    </see>
    <see type="doc:TypeIdentityDerivation" relation="SeeAlso">
      Full type-reference and identity derivation rules.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Blocks</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="The basic unit of BlockML">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Block is BlockML's basic unit — a semantic building block, and the sole inheritance root for all Block definitions is org.blockml.bml.core.Block." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Defining a Block">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Block definition's document root uses its type as the element tag, identifying the Block being defined before any member is declared." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Naming a Block">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Block's name is a PascalCase class name — letters and digits only, starting with an uppercase letter." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Referencing a Block">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Block is defined once in its own file, then referenced elsewhere by its fully qualified name — defining and referencing are separate acts." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Readers should now be able to point to a Block's FQN, its definition file, and a use of it." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with definitions and instances">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Block Definitions and Instances" summary="Learn the Block-versus-instance distinction.">
                  <target>docs:BlockDefinitionsAndInstances</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Blocks>
