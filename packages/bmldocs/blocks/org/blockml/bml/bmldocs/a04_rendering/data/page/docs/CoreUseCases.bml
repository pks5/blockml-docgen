<!--BlockML Documentation — a guide to the three problems BlockML is designed to solve

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.CoreUseCases-->
<docs:CoreUseCases xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to the three problems BlockML is designed to solve
  </is>
  <documentation>
    Scope: the three core BlockML use cases and when to reach for BlockML, grounded in
    org.blockml.bml.documentation.CoreUseCases. Body content is authored in a04 from that source.
  </documentation>
  <references>
    <see type="doc:CoreUseCases" relation="Requires">
      Primary content source — structured project documentation, domain modeling, and AI workspaces.
    </see>
    <see type="doc:Introduction" relation="Prerequisite">
      BlockML goals and the BML/BOM split, read before the use cases.
    </see>
    <see type="doc:EverythingIsABlock" relation="ReadNext">
      Next reading step — the ontological principle these use cases rest on.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Core Use Cases</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Guide</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="Three problems, one principle">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="BlockML is designed around three core use cases that all build on one principle: information is represented as a structured semantic model instead of unstructured text." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Structured project documentation">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="BlockML can serve as a structured alternative to Markdown, making a project's documentation structure explicit while still carrying human-readable prose. The generated documentation is not the source of truth — the BlockML model is." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="General-purpose domain modeling">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="BlockML describes what something is; Renderers decide how that description manifests in a particular target. The same BlockML model may have multiple manifestations, since the model stays independent of any one target." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="AI workspaces">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Instead of repeatedly generating isolated text, an AI can inspect, validate, extend, and transform a persistent BlockML model while preserving explicit structure. The model is the workspace; the AI works on the model; Renderers manifest its current state." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Recognizing a problem as one of these three use cases means recognizing a need for a structured semantic model instead of unstructured text." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with the ontological principle">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Everything Is a Block" summary="Learn the ontological principle these use cases rest on.">
                  <target>docs:EverythingIsABlockPage</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:CoreUseCases>
