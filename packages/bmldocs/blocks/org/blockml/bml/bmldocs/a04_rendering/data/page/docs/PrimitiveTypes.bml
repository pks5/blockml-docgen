<!--BlockML Documentation — a guide to atomic scalar ValueTypes

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.PrimitiveTypes-->
<docs:PrimitiveTypes xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to atomic scalar ValueTypes
  </is>
  <documentation>
    Scope: atomic scalar ValueTypes, primitive value semantics, and the built-in primitive
    branches, grounded in org.blockml.bml.type.PrimitiveType and the PrimitiveType section of
    org.blockml.bml.documentation.TypeSystemOverview. Body content is authored in a04 from those
    sources.
  </documentation>
  <references>
    <see type="type:PrimitiveType" relation="Requires">
      The atomic scalar ValueType branch this page introduces.
    </see>
    <see type="doc:TypeSystemOverview" relation="Requires">
      Primary content source — PrimitiveType examples and branch role in the type system.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Primitive Types</value>
    </title>
    <purpose override="true">
      <value>Teach that PrimitiveTypes describe atomic scalar semantics with no stored values on the type itself, so readers can list the built-in primitive branches before deeper parsing detail.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <workflow:AuthorativeSourceSet>
          <includedTypes>
            <type:TypeSelectorEntity value="org.blockml.bml.type.PrimitiveType" />
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.TypeSystemOverview" />
          </includedTypes>
        </workflow:AuthorativeSourceSet>
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>Teach that PrimitiveTypes describe atomic scalar semantics only, with no stored values on the type itself.</summary>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>The reader can list the built-in primitive branches.</summary>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>Atomic scalar ValueTypes, primitive value semantics, and the built-in primitive branches such as Boolean, Integer, Decimal, Text, and Date.</summary>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>Parsing mechanics or PrimitiveEntity wrapping.</summary>
          <reason>Those belong to later, more technical pages.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <supportingPoints override="true">
      <composition>
        <sem:SupportingPoint>
          <summary>Values live in Properties, never in the ValueType itself.</summary>
        </sem:SupportingPoint>
      </composition>
    </supportingPoints>
    <content override="true">
      <composition>
        <dpage:Section heading="Atomic scalar semantics" purpose="State what a PrimitiveType is">
          <content>
            <dpage:Paragraph purpose="Introduce PrimitiveType">
              <role>org.blockml.bml.docgen.role.Lead</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>PrimitiveType is the abstract branch for built-in scalar ValueTypes — it describes semantics only and never stores concrete values on the type itself.</message>
              <authoritativeSources>
                <workflow:AuthorativeSourceSet>
                  <includedTypes>
                    <type:TypeSelectorEntity value="org.blockml.bml.type.PrimitiveType" />
                  </includedTypes>
                </workflow:AuthorativeSourceSet>
              </authoritativeSources>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="The built-in primitive branches" purpose="Name the built-in branch families">
          <content>
            <dpage:List purpose="List the built-in primitive branch families">
              <role>org.blockml.bml.docgen.role.Summary</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Built-in primitives fall into a small number of branch families.</message>
              <items>
                <dpage:ListItem text="Numeric" purpose="Name the numeric branch">
                  <message>The numeric branch covers Integer, Decimal, and Float.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Textual" purpose="Name the textual branch">
                  <message>The textual branch covers Text and text-based specializations.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Temporal" purpose="Name the temporal branch">
                  <message>The temporal branch covers Date, Time, and DateTime as calendar or clock positions.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Boolean and Duration" purpose="Name the two standalone branches">
                  <message>Boolean and Duration are each their own branch — Duration is an elapsed-time magnitude, not a Temporal subtype.</message>
                </dpage:ListItem>
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <dpage:Section heading="Values live in Properties" purpose="State where concrete values are stored">
          <content>
            <dpage:Paragraph purpose="State that PrimitiveTypes never carry values">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A PrimitiveType cannot itself carry a value — all values are stored exclusively in the Properties that reference it.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages" purpose="Anchor the reader outcome before struct types are introduced">
          <content>
            <dpage:Paragraph purpose="State the retained outcome">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Readers should now be able to list the built-in primitive branches.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with struct types" purpose="Direct the reader to the next kind">
          <content>
            <dpage:Navigation purpose="Continue into the Type System section">
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Struct Types" summary="Learn the composite named-field ValueType kind.">
                  <target>docs:StructTypes</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:PrimitiveTypes>
