<!--BlockML Documentation — a guide to atomic scalar ValueTypes

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.PrimitiveTypes-->
<docs:PrimitiveTypes xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to atomic scalar ValueTypes
  </is>
  <documentation>
    Scope: atomic scalar ValueTypes, primitive value semantics, and the built-in primitive
    branches, grounded in org.blockml.bml.type.PrimitiveType and the PrimitiveType section of
    org.blockml.bml.documentation.TypeSystemOverview. Body content is rendered in a04 from those
    sources.
  </documentation>
  <references>
    <see type="type:PrimitiveType" relation="Requires">
      The atomic scalar ValueType branch this page introduces.
    </see>
    <see type="doc:TypeSystemOverview" relation="Requires">
      Primary content source — PrimitiveType examples and branch role in the type system.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Primitive Types</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Atomic scalar semantics">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="PrimitiveType is the abstract branch for built-in scalar ValueTypes — PrimitiveTypes describe semantics only and never store concrete values themselves." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. The built-in branches-->
        <dpage:Section heading="The built-in primitive branches">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="PrimitiveType organizes into a numeric branch, a textual branch, a temporal branch, and two standalone branches for Boolean and Duration that belong to neither. Every built-in primitive belongs to exactly one of these branches:" />
              </content>
            </dpage:Paragraph>
            <dpage:List>
              <items>
                <dpage:ListItem text="Number">
                  <content>
                    <dpage:Paragraph>
                      <content>
                        <dpage:Text text="Integer, Decimal, and Float." />
                      </content>
                    </dpage:Paragraph>
                  </content>
                </dpage:ListItem>
                <dpage:ListItem text="Text">
                  <content>
                    <dpage:Paragraph>
                      <content>
                        <dpage:Text text="Text and its subtypes such as Color, URL, and Version." />
                      </content>
                    </dpage:Paragraph>
                  </content>
                </dpage:ListItem>
                <dpage:ListItem text="Temporal">
                  <content>
                    <dpage:Paragraph>
                      <content>
                        <dpage:Text text="Date, Time, and DateTime." />
                      </content>
                    </dpage:Paragraph>
                  </content>
                </dpage:ListItem>
                <dpage:ListItem text="Boolean and Duration">
                  <content>
                    <dpage:Paragraph>
                      <content>
                        <dpage:Text text="Boolean is neither textual nor numeric; Duration is a sibling of Temporal, not one of its subtypes." />
                      </content>
                    </dpage:Paragraph>
                  </content>
                </dpage:ListItem>
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <!--3. No stored values on the type-->
        <dpage:Section heading="Values live only in Properties">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A PrimitiveType such as Integer describes what a value may be, but never carries one — an authored value belongs exclusively to a Property whose type is that PrimitiveType." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="A property with a primitive value">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Property typed Integer carries its default value in the Property's own value field — never as an attribute on the Integer type itself." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- "count" is typed with the PrimitiveType Integer; its value lives on the Property -->
<acme:Basket xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Block
  </baseType>
  <properties>
    <count type="type:Integer">
      <value>3</value>
    </count>
  </properties>
</acme:Basket>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="In the example, type:Integer only names the branch; the concrete number, 3, is carried entirely by count's value field, matching the rule that PrimitiveTypes never store values themselves." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should be able to list the built-in primitive branches and place a value correctly on the owning Property, before moving to the composite StructType branch." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with struct types">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Struct Types" summary="Learn composite named-field ValueTypes.">
                  <target>docs:StructTypes</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:PrimitiveTypes>
