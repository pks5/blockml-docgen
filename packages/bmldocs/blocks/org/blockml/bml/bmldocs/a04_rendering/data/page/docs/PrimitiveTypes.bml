<!--BlockML Documentation — a guide to atomic scalar ValueTypes

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.PrimitiveTypes-->
<docs:PrimitiveTypes xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to atomic scalar ValueTypes
  </is>
  <documentation>
    Scope: atomic scalar ValueTypes, primitive value semantics, and the built-in primitive
    branches, grounded in org.blockml.bml.type.PrimitiveType and the PrimitiveType section of
    org.blockml.bml.documentation.TypeSystemOverview. Body content is authored in a03 from those
    sources.
  </documentation>
  <references>
    <see type="type:PrimitiveType" relation="Requires">
      The atomic scalar ValueType branch this page introduces.
    </see>
    <see type="doc:TypeSystemOverview" relation="Requires">
      Primary content source — PrimitiveType examples and branch role in the type system.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Primitive Types</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="What a PrimitiveType is">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>A PrimitiveType names atomic scalar semantics — such as boolean truth, a
whole number, or a piece of text — and never carries a concrete value itself.
Every value is stored exclusively in the Property that uses the type.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="The built-in primitive branches">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>The primitive branches group scalar values by the kind of meaning they
carry — numeric, textual, temporal, or boolean.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
            <dpage:List>
              <items>
                <dpage:ListItem text="Boolean describes truth values on its own, forming its own branch that is neither numeric nor textual." />
                <dpage:ListItem text="The numeric branch covers whole numbers and decimal numbers as related primitive kinds." />
                <dpage:ListItem text="The textual branch covers plain text and specialized text-like values." />
                <dpage:ListItem text="The temporal branch covers calendar and clock positions such as a date." />
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <dpage:Section heading="Values live in Properties">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>A PrimitiveType only names atomic scalar semantics; the concrete value
always belongs to the Property that uses that type, never to the type
definition itself.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<property name="count" type="Integer">
  <value>5</value>
</property>]]></code>
            </dpage:CodeBlock>
          </content>
        </dpage:Section>
        <dpage:Section heading="Why the distinction matters">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>Keeping semantics on the type and values on the Property lets many
different Properties across a model share exactly the same PrimitiveType
definition.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with Struct Types">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Struct Types" summary="Learn the composite named-field kind, the next sibling under ValueType.">
                  <target>docs:StructTypes</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:PrimitiveTypes>
