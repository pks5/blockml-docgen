<!--BlockML Documentation — a guide to atomic scalar ValueTypes

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.PrimitiveTypes-->
<docs:PrimitiveTypes xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to atomic scalar ValueTypes
  </is>
  <documentation>
    Scope: atomic scalar ValueTypes, primitive value semantics, and the built-in primitive
    branches, grounded in org.blockml.bml.type.PrimitiveType and the PrimitiveType section of
    org.blockml.bml.documentation.TypeSystemOverview. Body content is authored in a04 from those
    sources.
  </documentation>
  <references>
    <see type="type:PrimitiveType" relation="Requires">
      The atomic scalar ValueType branch this page introduces.
    </see>
    <see type="doc:TypeSystemOverview" relation="Requires">
      Primary content source — PrimitiveType examples and branch role in the type system.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Primitive Types</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="Atomic scalar semantics">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="PrimitiveType is the abstract branch for built-in scalar ValueTypes — it describes semantics only and never stores concrete values on the type itself." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="The built-in primitive branches">
          <content>
            <dpage:List>
              <items>
                <dpage:ListItem text="Numeric — the numeric branch covers Integer, Decimal, and Float." />
                <dpage:ListItem text="Textual — the textual branch covers Text and text-based specializations." />
                <dpage:ListItem text="Temporal — the temporal branch covers Date, Time, and DateTime as calendar or clock positions." />
                <dpage:ListItem text="Boolean and Duration — Boolean and Duration are each their own branch; Duration is an elapsed-time magnitude, not a Temporal subtype." />
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <dpage:Section heading="Values live in Properties">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A PrimitiveType cannot itself carry a value — all values are stored exclusively in the Properties that reference it." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Readers should now be able to list the built-in primitive branches." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with struct types">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Struct Types" summary="Learn the composite named-field ValueType kind.">
                  <target>docs:StructTypes</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:PrimitiveTypes>
