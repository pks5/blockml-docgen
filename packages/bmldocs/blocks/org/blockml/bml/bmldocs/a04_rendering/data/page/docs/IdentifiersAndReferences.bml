<!--BlockML Documentation — a guide to identifiers versus validated references

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.IdentifiersAndReferences-->
<docs:IdentifiersAndReferences xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to identifiers versus validated references
  </is>
  <documentation>
    Scope: identifiers versus validated references, the Type Identifier and Type Reference
    distinction, and abbreviated reference forms, grounded in
    org.blockml.bml.documentation.TypeIdentityDerivation. Body content is authored in a03 from
    that source.
  </documentation>
  <references>
    <see type="doc:TypeIdentityDerivation" relation="Requires">
      Primary content source — Identifier syntax-only checks versus Reference existence checks.
    </see>
    <see type="type:TypeIdentifier" relation="Requires">
      Concrete identifier type checked for syntax only.
    </see>
    <see type="type:TypeReference" relation="Requires">
      Concrete reference type that must resolve in the TypeRegistry.
    </see>
    <see type="doc:ImplicitNamespaceResolution" relation="SeeAlso">
      Context-bound unqualified reference forms.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Identifiers and References</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="Not every type name is checked the same way">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>A type name in BML is treated in one of two ways: as an identifier,
checked only for well-formed syntax, or as a reference, which must actually
resolve to a Block that exists.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Identifiers: syntax only">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>A type identifier only needs to be well-formed; the name it names does
not need to already exist. This fits a site such as the very name being given
to a new Block, where the name is being minted rather than looked up.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="References: must resolve">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>A type reference must actually name a Block that exists. When it does
not, the compiler reports an error rather than silently accepting the name.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Abbreviated reference forms">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>Wherever a full name would be accepted, a shorter prefixed form bound to
the same package is accepted as well, so an author rarely has to spell out the
whole name.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Telling which check applies">
          <content>
            <dpage:List>
              <items>
                <dpage:ListItem text="The type name a new Block declares for itself is an identifier — it need not already exist." />
                <dpage:ListItem text="The parent a Block declares it specializes must resolve, so it is a reference." />
                <dpage:ListItem text="A contract a Block pulls in must also resolve to an existing Block, so it too is a reference." />
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with the type system">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Type System" summary="Start the next part of the handbook, on BlockML's type system.">
                  <target>docs:TypeSystem</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:IdentifiersAndReferences>
