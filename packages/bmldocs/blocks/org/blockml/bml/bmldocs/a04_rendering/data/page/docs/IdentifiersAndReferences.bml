<!--BlockML Documentation — a guide to identifiers versus validated references

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.IdentifiersAndReferences-->
<docs:IdentifiersAndReferences xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to identifiers versus validated references
  </is>
  <documentation>
    Scope: identifiers versus validated references, the Type Identifier and Type Reference
    distinction, and abbreviated reference forms, grounded in
    org.blockml.bml.documentation.TypeIdentityDerivation. Body content is rendered in a04 from
    that source.
  </documentation>
  <references>
    <see type="doc:TypeIdentityDerivation" relation="Requires">
      Primary content source — Identifier syntax-only checks versus Reference existence checks.
    </see>
    <see type="type:TypeIdentifier" relation="Requires">
      Concrete identifier type checked for syntax only.
    </see>
    <see type="type:TypeReference" relation="Requires">
      Concrete reference type that must resolve in the TypeRegistry.
    </see>
    <see type="doc:ImplicitNamespaceResolution" relation="SeeAlso">
      Context-bound unqualified reference forms.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Identifiers and References</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Syntax-only versus must-resolve">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="The validator keys off a field's declared ValueType, never its name: a TypeIdentifier field checks syntax only, while a TypeReference field must resolve in the TypeRegistry or the compiler reports an error." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Two concrete types-->
        <dpage:Section heading="TypeIdentifier and TypeReference">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="type:TypeIdentifier names the FQN a Block definition is minting — the named type need not already exist, because the definition is what creates it." />
              </content>
            </dpage:Paragraph>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="type:TypeReference names a type that must already exist — used for baseType, member types, and other sites where the compiler needs a real target to resolve against." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Why an unresolved reference is not proof of a bad document-->
        <dpage:Section heading="An unresolved reference is not a broken document">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="An unresolved TypeReference is an error, but not proof the document is ill-formed — like a Java class-not-found, it may simply be a typo or a library that is not yet on the classpath." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="Minting a type, then referencing it">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Defining a Block mints its FQN through a TypeIdentifier field; a second Block extending it uses that same FQN through a TypeReference field, which must now resolve." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- Widget mints its own FQN through the "type" TypeIdentifier field -->
<block>
  <type>com.acme.example.Widget</type>
  <baseType>org.blockml.bml.core.Block</baseType>
</block>

<!-- Gadget references Widget's FQN through the "baseType" TypeReference field -->
<block>
  <type>com.acme.example.Gadget</type>
  <baseType>com.acme.example.Widget</baseType>
</block>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Widget's type field is checked only for well-formed syntax, since it is minting a brand-new FQN; Gadget's baseType field is checked for existence, since com.acme.example.Widget must already resolve in the TypeRegistry for Gadget to be valid. The same FQN text plays two different validator roles depending on which field carries it." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should be able to predict whether an unresolved name is a syntax error or a validator error, closing out the Foundations group before the type system pages begin." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with the type system">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="The Type System" summary="Learn the four ValueType kinds.">
                  <target>docs:TypeSystem</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:IdentifiersAndReferences>
