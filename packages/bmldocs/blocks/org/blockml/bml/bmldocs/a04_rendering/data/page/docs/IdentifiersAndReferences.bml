<!--BlockML Documentation — a guide to identifiers versus validated references

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.IdentifiersAndReferences-->
<docs:IdentifiersAndReferences xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to identifiers versus validated references
  </is>
  <documentation>
    Scope: identifiers versus validated references, the Type Identifier and Type Reference
    distinction, and abbreviated reference forms, grounded in
    org.blockml.bml.documentation.TypeIdentityDerivation. Body content is authored in a04 from
    that source.
  </documentation>
  <references>
    <see type="doc:TypeIdentityDerivation" relation="Requires">
      Primary content source — Identifier syntax-only checks versus Reference existence checks.
    </see>
    <see type="type:TypeIdentifier" relation="Requires">
      Concrete identifier type checked for syntax only.
    </see>
    <see type="type:TypeReference" relation="Requires">
      Concrete reference type that must resolve in the TypeRegistry.
    </see>
    <see type="doc:ImplicitNamespaceResolution" relation="SeeAlso">
      Context-bound unqualified reference forms.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Identifiers and References</value>
    </title>
    <purpose override="true">
      <value>Teach the identifier-versus-reference distinction and its abbreviated forms, so readers can predict whether an unresolved name is a syntax error or a validator error.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <workflow:AuthorativeSourceSet>
          <includedTypes>
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.TypeIdentityDerivation" />
            <type:TypeSelectorEntity value="org.blockml.bml.type.TypeIdentifier" />
            <type:TypeSelectorEntity value="org.blockml.bml.type.TypeReference" />
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.ImplicitNamespaceResolution" />
          </includedTypes>
        </workflow:AuthorativeSourceSet>
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>Teach the identifier-versus-reference distinction and its normalization forms.</summary>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>The reader can distinguish an identifier, checked for syntax only, from a validated reference, which must resolve.</summary>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>Identifiers versus validated references, the Type Identifier and Type Reference distinction, and abbreviated xmlns-prefixed forms of a reference.</summary>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>Type Selector wildcard pattern matching in depth.</summary>
          <reason>Wildcard selector matching is a separate, more advanced topic.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <supportingPoints override="true">
      <composition>
        <sem:SupportingPoint>
          <summary>A TypeIdentifier checks syntax only, while a TypeReference must resolve in the TypeRegistry or the compiler reports an unknown-type error.</summary>
        </sem:SupportingPoint>
      </composition>
    </supportingPoints>
    <content override="true">
      <composition>
        <dpage:Section heading="Four forms, one canonical FQN" purpose="Introduce the forms a type name may take">
          <content>
            <dpage:Paragraph purpose="Introduce the forms a type name may take">
              <role>org.blockml.bml.docgen.role.Lead</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A type name in BML may be written as a fully qualified name, an xmlns-prefixed QName, an unqualified fallback, or a Sub-Block-relative name — all normalize to one canonical FQN.</message>
              <authoritativeSources>
                <workflow:AuthorativeSourceSet>
                  <includedTypes>
                    <type:TypeSelectorEntity value="org.blockml.bml.documentation.TypeIdentityDerivation" />
                  </includedTypes>
                </workflow:AuthorativeSourceSet>
              </authoritativeSources>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Identifier versus reference" purpose="Establish the central distinction of this page">
          <content>
            <dpage:Paragraph purpose="Distinguish syntax-only checking from existence checking">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A TypeIdentifier is checked for syntax only and need not exist, while a TypeReference additionally must resolve in the TypeRegistry.</message>
              <authoritativeSources>
                <workflow:AuthorativeSourceSet>
                  <includedTypes>
                    <type:TypeSelectorEntity value="org.blockml.bml.type.TypeIdentifier" />
                    <type:TypeSelectorEntity value="org.blockml.bml.type.TypeReference" />
                  </includedTypes>
                </workflow:AuthorativeSourceSet>
              </authoritativeSources>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Abbreviated forms at specialized sites" purpose="Explain context-bound implicit namespaces">
          <content>
            <dpage:Paragraph purpose="Explain implicit namespace resolution">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Unqualified names are accepted only at specialized, unambiguous reference sites, where each site expands to exactly one implicit namespace.</message>
              <authoritativeSources>
                <workflow:AuthorativeSourceSet>
                  <includedTypes>
                    <type:TypeSelectorEntity value="org.blockml.bml.documentation.ImplicitNamespaceResolution" />
                  </includedTypes>
                </workflow:AuthorativeSourceSet>
              </authoritativeSources>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="General block references need a full name" purpose="State where implicit resolution does not apply">
          <content>
            <dpage:Paragraph purpose="State that general block references have no implicit namespace">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>General block references such as baseType, aggregation type, and composition instance tags have no implicit namespace and require a full FQN or xmlns prefix.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages" purpose="Anchor the reader outcome before the type system is introduced">
          <content>
            <dpage:Paragraph purpose="State the retained outcome">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Readers should now be able to predict whether an unresolved name is a syntax error or a validator error.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with the type system" purpose="Direct the reader to the next page">
          <content>
            <dpage:Navigation purpose="Continue into the Type System section">
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="The Type System" summary="See the four ValueType kinds that make up BlockML's type system.">
                  <target>docs:TypeSystem</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:IdentifiersAndReferences>
