<!--BlockML Documentation — a guide to identifiers versus validated references

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.IdentifiersAndReferences-->
<docs:IdentifiersAndReferences xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to identifiers versus validated references
  </is>
  <documentation>
    Scope: identifiers versus validated references, the Type Identifier and Type Reference
    distinction, and abbreviated reference forms, grounded in
    org.blockml.bml.documentation.TypeIdentityDerivation. Body content is authored in a04 from
    that source.
  </documentation>
  <references>
    <see type="doc:TypeIdentityDerivation" relation="Requires">
      Primary content source — Identifier syntax-only checks versus Reference existence checks.
    </see>
    <see type="type:TypeIdentifier" relation="Requires">
      Concrete identifier type checked for syntax only.
    </see>
    <see type="type:TypeReference" relation="Requires">
      Concrete reference type that must resolve in the TypeRegistry.
    </see>
    <see type="doc:ImplicitNamespaceResolution" relation="SeeAlso">
      Context-bound unqualified reference forms.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Identifiers and References</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="Four forms, one canonical FQN">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A type name in BML may be written in one of four forms — a fully qualified name, an xmlns-prefixed QName, an unqualified fallback at a context-bound site, or a Sub-Block-relative name — and all four normalize to the same canonical fully qualified name during resolution." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Identifier versus reference">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A TypeIdentifier is checked for syntax only — the name it holds need not exist anywhere. A TypeReference extends TypeIdentifier with an existence requirement: its fully qualified name must additionally resolve to a real Block in the TypeRegistry, or the compiler reports an unknown-type error." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Abbreviated forms at specialized sites">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Unqualified names are accepted only at specialized, unambiguous reference sites — such as a property's type or a Capability's implementation language. Each such site expands directly to exactly one implicit namespace, with no broader search across the type registry." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="General block references need a full name">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="General block references — such as baseType, an aggregation's type, or a composition's instance tag — have no implicit namespace. Each one requires a full fully qualified name or an xmlns prefix instead of an unqualified name." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Readers should now be able to predict whether an unresolved name is a syntax error, because it is checked as an identifier, or a validator error, because it failed to resolve as a reference." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with the type system">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="The Type System" summary="See the four ValueType kinds that make up BlockML's type system.">
                  <target>docs:TypeSystem</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:IdentifiersAndReferences>
