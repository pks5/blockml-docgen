<!--BlockML Documentation — a guide to optional, singular, and multiple values

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.MultiplicityAndCollections-->
<docs:MultiplicityAndCollections xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to optional, singular, and multiple values
  </is>
  <documentation>
    Scope: optional, singular, and multiple values, multiplicity brackets, and collection
    semantics, grounded in the multiplicity sections of
    org.blockml.bml.documentation.TypeExpressions. Body content is rendered in a04 from that
    source.
  </documentation>
  <references>
    <see type="doc:TypeExpressions" relation="Requires">
      Primary content source — multiplicity as a postfix type-expression operation, and nested collections.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Multiplicity and Collections</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Multiplicity is a bracket, not a type">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="BlockML has no separate Array type — bracket notation such as Integer[] is a postfix operation on a type expression, metadata on the reference rather than an intrinsic property of the named ValueType." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Reading the bracket forms-->
        <dpage:Section heading="Reading the bracket forms">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A bare type such as Integer means exactly one; Integer[] means zero to n, equivalent to Integer[0..n]; and forms such as Integer[3] or Integer[1..5] fix or bound the count explicitly." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Nesting requires explicit grouping-->
        <dpage:Section heading="Nesting requires explicit grouping">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Because multiplicity applies to any type expression including one that already carries multiplicity, a collection of collections needs explicit grouping — (Integer[])[] — since Integer[][] leaves the binding of each bracket ambiguous and is not supported." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="An aggregation of a bounded collection">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="An aggregation's type attribute can bound how many children it holds using a ranged multiplicity bracket, directly on the Block type it aggregates." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- "items" holds between 1 and 5 acme:Widget instances -->
<acme:Basket xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    core:Block
  </baseType>
  <aggregations>
    <items type="acme:Widget[1..5]" />
  </aggregations>
</acme:Basket>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="The 1..5 range on items is metadata on the type reference itself — Widget's own definition is unaffected by how many instances any particular aggregation happens to bound. A Basket with no items, or with six, would both fail validation against this bracket." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should be able to read a multiplicity bracket and place it correctly in a type expression, closing out the member model before Constraints introduces declarative validation rules." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with constraints">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Constraints" summary="Learn declarative validation rules.">
                  <target>docs:Constraints</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:MultiplicityAndCollections>
