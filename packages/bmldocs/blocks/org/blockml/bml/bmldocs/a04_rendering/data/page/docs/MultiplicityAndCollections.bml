<!--BlockML Documentation — a guide to optional, singular, and multiple values

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.MultiplicityAndCollections-->
<docs:MultiplicityAndCollections xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to optional, singular, and multiple values
  </is>
  <documentation>
    Scope: optional, singular, and multiple values, multiplicity brackets, and collection
    semantics, grounded in the multiplicity sections of
    org.blockml.bml.documentation.TypeExpressions. Body content is authored in a04 from that
    source.
  </documentation>
  <references>
    <see type="doc:TypeExpressions" relation="Requires">
      Primary content source — multiplicity as a postfix type-expression operation, and nested collections.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Multiplicity and Collections</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="Multiplicity, not a separate Array type">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="BlockML has no separate Array type. Multiplicity — the number of values a type expression admits — is expressed as a postfix bracket operation on the type expression itself, not as a distinct type." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Bracket forms">
          <content>
            <dpage:List>
              <items>
                <dpage:ListItem text="A type written with no bracket at all, such as Integer, names exactly one value." />
                <dpage:ListItem text="Integer[] is an open collection, equivalent to Integer[0..n]: zero or more values." />
                <dpage:ListItem text="Integer[3] fixes the count at exactly three values, and Integer[1..5] bounds the count between one and five." />
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <dpage:Section heading="Nesting requires explicit grouping">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Multiplicity may apply to any type expression, including one that already carries multiplicity of its own, but nested collections need explicit grouping to stay unambiguous: write (Integer[])[] for a collection of collections, never the ungrouped Integer[][]." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Readers should now be able to read a multiplicity bracket and place it correctly within a type expression." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with constraints">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Constraints" summary="Learn how declarative validation rules attach to members.">
                  <target>docs:Constraints</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:MultiplicityAndCollections>
