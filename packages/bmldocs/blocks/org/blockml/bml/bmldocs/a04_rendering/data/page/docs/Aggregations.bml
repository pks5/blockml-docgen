<!--BlockML Documentation — a guide to owned collection members

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Aggregations-->
<docs:Aggregations xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to owned collection members
  </is>
  <documentation>
    Scope: owned collection members, ownership, composition fill, and aggregations versus
    associations, grounded in org.blockml.bml.definition.AggregationDefinition and
    org.blockml.bml.documentation.CompositionModel. Body content is authored in a04 from those
    sources.
  </documentation>
  <references>
    <see type="def:AggregationDefinition" relation="Requires">
      The owned collection member this page introduces.
    </see>
    <see type="doc:CompositionModel" relation="Requires">
      Primary content source — composition fill rules and instance-side aggregation opening.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Aggregations</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="An owned collection member">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="An Aggregation describes a Block member that owns a collection of Block instances — its children are always Block instances, and the aggregation's type attribute selects what kind of Block the collection may hold." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. No default aggregation-->
        <dpage:Section heading="There is no default aggregation">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="On a Block instance, aggregation children always sit directly inside the named aggregation element — there is no default aggregation, so a bare child instance placed directly under the parent instance, outside any named aggregation, is invalid." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Filling with composition versus opening on an instance-->
        <dpage:Section heading="Filling the definition, opening on the instance">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="An initial fill on the Block definition nests its child instances inside a composition element on the aggregation declaration, but a Block instance opens that same aggregation directly by name with no composition wrapper at all — the two contexts are never mixed." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="Declaring and filling an aggregation">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="An aggregation declaration states its payload type and, optionally, an initial composition fill with one or more child instances." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- The tools aggregation declares its payload type and an initial composition fill -->
<acme:AssemblyStation xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    core:Block
  </baseType>
  <aggregations>
    <tools type="acme:Tool[]">
      <composition>
        <acme:Tool bml:id="wrench" />
      </composition>
    </tools>
  </aggregations>
</acme:AssemblyStation>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="The Tool instance nested inside composition belongs entirely to this AssemblyStation's tools aggregation — it has no separate existence outside it, which is the ownership the example illustrates; wrench is simply its bml:id, the identity used to refer back to it inside this Block." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should be able to declare and fill an owned collection member and open it correctly on an instance, before contrasting ownership with the non-owning links Associations describe next." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with associations">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Associations" summary="Learn non-owning instance-to-instance links.">
                  <target>docs:Associations</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Aggregations>
