<!--BlockML Documentation — a guide to owned collection members

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Aggregations-->
<docs:Aggregations xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to owned collection members
  </is>
  <documentation>
    Scope: owned collection members, ownership, composition fill, and aggregations versus
    associations, grounded in org.blockml.bml.definition.AggregationDefinition and
    org.blockml.bml.documentation.CompositionModel. Body content is authored in a03 from those
    sources.
  </documentation>
  <references>
    <see type="def:AggregationDefinition" relation="Requires">
      The owned collection member this page introduces.
    </see>
    <see type="doc:CompositionModel" relation="Requires">
      Primary content source — composition fill rules and instance-side aggregation opening.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Aggregations</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="What an Aggregation is">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>An Aggregation is a Block member representing an owned collection: its
children are Block instances whose lifecycle belongs to the owning Block.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Declaring an owned collection member">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>Declaring an Aggregation means naming the kind of Block its children must
be, so the collection knows what it may own.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Filling an Aggregation with composition">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>On a Block definition, a composition nested inside the Aggregation member
supplies the concrete child Block instances that fill it.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<aggregations>
  <items type="core:Block[]">
    <composition>
      <myns:Widget />
    </composition>
  </items>
</aggregations>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>In the example, the composition is nested inside the Aggregation member
itself — it is a declaration-only field, never a wrapper used when a domain instance is
authored.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Opening an Aggregation on an instance">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>On a Block instance, aggregation children sit directly inside the named
aggregation element. There is no composition wrapper and no default aggregation, so the
aggregation must always be opened by its member name.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Aggregation versus Association: who owns what">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>An Aggregation owns the Block instances it holds, while an Association only
points to an instance elsewhere without taking ownership of it.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with Associations">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Associations" summary="Learn Association as a non-owning instance-to-instance link.">
                  <target>docs:Associations</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Aggregations>
