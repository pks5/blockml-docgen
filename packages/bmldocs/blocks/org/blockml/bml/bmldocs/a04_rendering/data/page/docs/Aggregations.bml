<!--BlockML Documentation — a guide to owned collection members

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Aggregations-->
<docs:Aggregations xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to owned collection members
  </is>
  <documentation>
    Scope: owned collection members, ownership, composition fill, and aggregations versus
    associations, grounded in org.blockml.bml.definition.AggregationDefinition and
    org.blockml.bml.documentation.CompositionModel. Body content is authored in a04 from those
    sources.
  </documentation>
  <references>
    <see type="def:AggregationDefinition" relation="Requires">
      The owned collection member this page introduces.
    </see>
    <see type="doc:CompositionModel" relation="Requires">
      Primary content source — composition fill rules and instance-side aggregation opening.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Aggregations</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="An owned collection">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="An Aggregation is a Block member that represents an owned collection, filled with concrete child Block instances through composition." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What an aggregation may hold">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="An aggregation's type decides what it may hold: a plain Block type means the aggregation owns instances of that Block, while a TypeReferenceEntity application means it owns TypeReferenceEntity instances that each point at a type by name." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Filling an aggregation on the definition">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="On a Block definition, an aggregation's initial set of children is supplied by a composition nested inside that aggregation member." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="No default aggregation on instances">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="On a Block instance, children are placed directly inside the aggregation element itself, opened by its member name — there is no composition wrapper and no default aggregation to fall back on." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="With this, you can declare an Aggregation, fill it with composition on the definition, and open it correctly by name on an instance." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with Associations">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Associations" summary="Learn the non-owning instance-to-instance link member kind.">
                  <target>docs:Associations</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Aggregations>
