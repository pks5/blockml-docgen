<!--BlockML Documentation — a guide to filling aggregations through composition

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Composition-->
<docs:Composition xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to filling aggregations through composition
  </is>
  <documentation>
    Scope: composing Blocks through aggregations and the composition fill syntax on Block
    definitions, grounded in org.blockml.bml.documentation.CompositionModel and
    org.blockml.bml.definition.AggregationDefinition. Body content is authored in a04 from those
    sources.
  </documentation>
  <references>
    <see type="doc:CompositionModel" relation="Requires">
      Primary content source — composition placement rules and instance-side aggregation fill.
    </see>
    <see type="def:AggregationDefinition" relation="Requires">
      The aggregation member composition fills, including its nested Composition sub-type.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Composition</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Composition fills an aggregation">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A composition fills an aggregation with concrete child Block instances on a Block definition." />
                <dpage:Text text="It is always nested inside the aggregation member it fills — never written as a standalone element on its own." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. One container, two forms-->
        <dpage:Section heading="One container concept, two forms">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Composition is the initial fill of an aggregation on a Block definition only." />
                <dpage:Text text="bml:container is the same container concept used everywhere else, on Block instances, and both support the same flow-control directives for shaping what gets filled in." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Recursive composition-->
        <dpage:Section heading="Composition nests recursively">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Every Block instance inside a composition may itself contain aggregation members, opened directly by name just like any other instance." />
                <dpage:Text text="Complex nested structures build up this way without ever needing a further nested composition wrapper around any of the inner instances." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="Filling an aggregation with one child">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="An aggregation on a Block definition can declare an initial fill, nesting its composition directly inside the aggregation member." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- composition is nested directly inside the children aggregation it fills -->
<acme:Panel xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:core="org.blockml.bml.core"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation">

  <baseType>
    core:Block
  </baseType>
  <is>
    A panel holding one child widget
  </is>
  <documentation>
    Demonstrates an aggregation filled through a nested composition.
  </documentation>
  <aggregations>
    <children type="core:Block[]">
      <composition>
        <acme:Widget bml:id="first" />
      </composition>
    </children>
  </aggregations>
</acme:Panel>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="The composition in the example only makes sense as the fill of the children aggregation it sits inside." />
                <dpage:Text text="The same acme:Widget element written outside any aggregation member would be a standalone composition, and invalid." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should be able to fill an aggregation with the correct composition syntax, before Sub-Blocks introduces nested Block definitions that composition children may also be typed by." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with Sub-Blocks">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Sub-Blocks" summary="Learn nested Block definitions.">
                  <target>docs:SubBlocks</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Composition>
