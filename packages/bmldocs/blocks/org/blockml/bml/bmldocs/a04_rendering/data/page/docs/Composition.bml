<!--BlockML Documentation — a guide to filling aggregations through composition

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Composition-->
<docs:Composition xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to filling aggregations through composition
  </is>
  <documentation>
    Scope: composing Blocks through aggregations and the composition fill syntax on Block
    definitions, grounded in org.blockml.bml.documentation.CompositionModel and
    org.blockml.bml.definition.AggregationDefinition. Body content is authored in a03 from those
    sources.
  </documentation>
  <references>
    <see type="doc:CompositionModel" relation="Requires">
      Primary content source — composition placement rules and instance-side aggregation fill.
    </see>
    <see type="def:AggregationDefinition" relation="Requires">
      The aggregation member composition fills, including its nested Composition sub-type.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Composition</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Filling an aggregation">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>Composition is how a Block definition fills an Aggregation member with
concrete child Block instances. A composition element must always be nested
inside the aggregation member it fills — a standalone composition element on
its own is invalid.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Definitions vs instances-->
        <dpage:Section heading="Composition on definitions, no wrapper on instances">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>On a Block definition, a composition element is nested inside the aggregation
member it fills, and it may only appear there — never standing alone.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>On a Block instance, an aggregation is filled directly by opening its member
name, with no composition wrapper and no default aggregation. Bare child
instances placed directly under a parent instance are not valid; every
aggregation on an instance must be opened by its member name before children
are listed.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. What a composition child is-->
        <dpage:Section heading="Composition children are Block instances">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>Each child inside a composition is a Block instance identified by its type,
optionally given a local identity, and filled with its own member values and
nested aggregations. Composition nests recursively: any Block instance may
itself open further aggregations wherever instances appear.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Declaring the aggregation itself-->
        <dpage:Section heading="Declaring the aggregation an instance goes into">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>An Aggregation member declares the payload type its children must satisfy, and
its optional composition template fills that member on the Block definition
where it is declared. A new aggregation declaration states its payload type;
an inherited aggregation may be refilled without restating an identical
type.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. Recap-->
        <dpage:Section heading="What to remember about Composition">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>Filling an aggregation correctly means nesting composition inside the member on
the definition, and opening the member by name directly on an instance —
never the other way around.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with nested Block definitions">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Sub-Blocks" summary="Learn how a Block definition can nest further Block definitions inside it.">
                  <target>docs:SubBlocks</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Composition>
