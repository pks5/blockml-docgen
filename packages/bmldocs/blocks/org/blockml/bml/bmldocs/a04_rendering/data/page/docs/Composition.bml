<!--BlockML Documentation — a guide to filling aggregations through composition

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Composition-->
<docs:Composition xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to filling aggregations through composition
  </is>
  <documentation>
    Scope: composing Blocks through aggregations and the composition fill syntax on Block
    definitions, grounded in org.blockml.bml.documentation.CompositionModel and
    org.blockml.bml.definition.AggregationDefinition. Body content is authored in a04 from those
    sources.
  </documentation>
  <references>
    <see type="doc:CompositionModel" relation="Requires">
      Primary content source — composition placement rules and instance-side aggregation fill.
    </see>
    <see type="def:AggregationDefinition" relation="Requires">
      The aggregation member composition fills, including its nested Composition sub-type.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Composition</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="Filling an aggregation">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A composition fills an aggregation with concrete child Block instances, giving the aggregation its initial contents on a Block definition." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Never standalone">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A composition element must always be nested inside an aggregation member; a standalone composition, opened on its own outside an aggregation, is not valid." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Definition composition versus instance fill">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="On a Block definition, a composition nested inside the aggregation member supplies that aggregation's initial fill; on a Block instance, child Blocks fill the aggregation directly by member name, with no composition wrapper and no default aggregation to fall back on." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Composition recurses naturally">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Every Block instance inside a composition may itself open aggregation members of its own, so complex nested structures compose naturally wherever instances appear, with no special recursion syntax required." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="With composition understood, readers can fill an aggregation with the correct syntax, keeping composition nested inside its aggregation member rather than standing alone." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with Sub-Blocks">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Sub-Blocks" summary="Learn how a definition nests inside a parent Block.">
                  <target>docs:SubBlocks</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Composition>
