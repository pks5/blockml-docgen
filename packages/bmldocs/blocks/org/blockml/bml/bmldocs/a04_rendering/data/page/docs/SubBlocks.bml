<!--BlockML Documentation — a guide to nested Block definitions

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.SubBlocks-->
<docs:SubBlocks xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to nested Block definitions
  </is>
  <documentation>
    Scope: nested Block definitions, Sub-Block identity and scope, and nesting depth, grounded in
    the Sub-Block sections of org.blockml.bml.documentation.SubBlockModel and
    org.blockml.bml.definition.SubBlockDefinition. Body content is authored in a04 from those
    sources.
  </documentation>
  <references>
    <see type="doc:SubBlockModel" relation="Requires">
      Primary content source — Sub-Block nesting, identity derivation, and generic scope.
    </see>
    <see type="def:SubBlockDefinition" relation="Requires">
      The nested Sub-Block definition shape this page introduces.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Sub-Blocks</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="A nested definition">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Sub-Block is a Block definition nested inside a parent Block, sharing the parent's fully qualified name prefix — much like a Java static nested class." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Deriving a Sub-Block's identity">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Sub-Block's name is its required local identity, supplied by the element tag under the parent's Sub-Blocks, while its type is normally omitted and derived automatically as the enclosing Block's type plus that name; Sub-Blocks may nest inside one another to any depth." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="No enclosing generic scope">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Sub-Blocks do not see the enclosing Block's generic type parameters — any outer parameters a Sub-Block needs must be forwarded to it explicitly." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Naming distinctly from the parent">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Sub-Block's name should differ from the enclosing root Block's name, since an identical name makes short reference tags ambiguous." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="With Sub-Blocks understood, a definition can now be nested inside a parent Block using that parent's Sub-Blocks." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with embedded Blocks">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Embedded Blocks" summary="Learn the full-document alternative to Sub-Block nesting.">
                  <target>docs:EmbeddedBlocks</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:SubBlocks>
