<!--BlockML Documentation — a guide to nested Block definitions

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.SubBlocks-->
<docs:SubBlocks xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition"
  xmlns:type="org.blockml.bml.type"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to nested Block definitions
  </is>
  <documentation>
    Scope: nested Block definitions, Sub-Block identity and scope, and nesting depth, grounded in
    the Sub-Block sections of org.blockml.bml.documentation.SubBlockModel and
    org.blockml.bml.definition.SubBlockDefinition. Body content is authored in a04 from those
    sources.
  </documentation>
  <references>
    <see type="doc:SubBlockModel" relation="Requires">
      Primary content source — Sub-Block nesting, identity derivation, and generic scope.
    </see>
    <see type="def:SubBlockDefinition" relation="Requires">
      The nested Sub-Block definition shape this page introduces.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Sub-Blocks</value>
    </title>
    <purpose override="true">
      <value>Teach Sub-Blocks as nested Block definitions sharing the parent's FQN prefix, so readers can nest a definition inside a parent Block and know how deep nesting resolves.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <workflow:AuthorativeSourceSet>
          <includedTypes>
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.SubBlockModel" />
            <type:TypeSelectorEntity value="org.blockml.bml.definition.SubBlockDefinition" />
          </includedTypes>
        </workflow:AuthorativeSourceSet>
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>Teach Sub-Blocks as nested definitions that share the parent's FQN prefix.</summary>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>The reader can nest a Block definition inside a parent Block.</summary>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>Nested Block definitions, Sub-Block identity and scope, and nesting depth.</summary>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>Embedded Blocks depth beyond the nesting note.</summary>
          <reason>Embedded Blocks get their own contrasting page next.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <supportingPoints override="true">
      <composition>
        <sem:SupportingPoint>
          <summary>Sub-Blocks do not see the enclosing Block's generic type parameters — outer parameters must be forwarded explicitly.</summary>
        </sem:SupportingPoint>
      </composition>
    </supportingPoints>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="A nested definition, sharing the parent's FQN prefix" purpose="Introduce Sub-Blocks as Java static-nested-class-style definitions">
          <content>
            <dpage:Paragraph purpose="Introduce Sub-Blocks as nested definitions analogous to Java static nested classes">
              <role>org.blockml.bml.docgen.role.Lead</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A Sub-Block is a Block definition nested inside a parent Block, analogous
to a Java static nested class — it shares the parent's FQN prefix and may declare
its own generic type parameters.</message>
              <authoritativeSources>
                <workflow:AuthorativeSourceSet>
                  <includedTypes>
                    <type:TypeSelectorEntity value="org.blockml.bml.documentation.SubBlockModel" />
                  </includedTypes>
                </workflow:AuthorativeSourceSet>
              </authoritativeSources>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Identity derivation-->
        <dpage:Section heading="Deriving a Sub-Block's identity" purpose="Explain how a Sub-Block's name and type are derived from its parent">
          <content>
            <dpage:Paragraph purpose="Explain that the element tag under subBlocks supplies the Sub-Block name, with type normally derived">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Preferred authoring uses the unqualified element tag under subBlocks as the
Sub-Block's name, while its type is normally omitted and derived as the parent's
resolved type plus a dot plus that name.</message>
              <authoritativeSources>
                <workflow:AuthorativeSourceSet>
                  <includedTypes>
                    <type:TypeSelectorEntity value="org.blockml.bml.definition.SubBlockDefinition" />
                  </includedTypes>
                </workflow:AuthorativeSourceSet>
              </authoritativeSources>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. No outer generic scope-->
        <dpage:Section heading="No outer generic or instance scope" purpose="Explain why enclosing generics must be forwarded explicitly">
          <content>
            <dpage:Paragraph purpose="Explain that a Sub-Block does not see its enclosing Block's generic parameters">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A Sub-Block has no enclosing-instance and no outer generic-type scope — a
parameter declared on the enclosing Block must be forwarded explicitly on the
Sub-Block's own baseType if it is still needed there.</message>
              <authoritativeSources>
                <workflow:AuthorativeSourceSet>
                  <includedTypes>
                    <type:TypeSelectorEntity value="org.blockml.bml.documentation.SubBlockModel" />
                  </includedTypes>
                </workflow:AuthorativeSourceSet>
              </authoritativeSources>
              <exclusions>
                <sem:Exclusion>
                  <summary>Sub-Block visibility naming and access rules.</summary>
                  <reason>Visibility mechanics are covered on their own dedicated page.</reason>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="Nesting one Sub-Block" purpose="Ground identity derivation in one small nested definition">
          <content>
            <dpage:Paragraph purpose="Set up a parent Block declaring one Sub-Block by unqualified tag">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>A parent Block nests one Sub-Block under subBlocks, using the unqualified
tag as the Sub-Block's name with no explicit type needed.</message>
              <exclusions>
                <sem:Exclusion>
                  <summary>A second level of nesting and generic forwarding.</summary>
                  <reason>The example isolates one nesting level to keep identity derivation clear.</reason>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>
            <dpage:CodeBlock purpose="Show a parent Block declaring one Sub-Block by its unqualified element tag">
              <role>org.blockml.bml.docgen.role.Example</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>The Sub-Block's tag under subBlocks supplies its name; no type element is needed.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>Show a parent Block with one nested Sub-Block using the unqualified tag under subBlocks.</summary>
                </sem:SupportingPoint>
              </supportingPoints>
              <exclusions>
                <sem:Exclusion>
                  <summary>An explicit type element on the Sub-Block.</summary>
                </sem:Exclusion>
              </exclusions>
            </dpage:CodeBlock>
            <dpage:Paragraph purpose="Interpret the Sub-Block's derived FQN relative to its parent">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>The Sub-Block in the example resolves to the parent's own FQN with its tag
name appended after a dot — exactly the derivation rule this page states, with no
explicit type needed to see it.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages" purpose="Anchor the outcome this page should leave behind">
          <content>
            <dpage:Paragraph purpose="State the outcome this page should leave behind">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>After this page, readers should be able to nest a definition inside a
parent Block and know how deep nesting resolves, before Embedded Blocks
contrasts this with a very different kind of nested document.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with embedded Blocks" purpose="Direct the reader to the next page">
          <content>
            <dpage:Navigation purpose="Continue the composition-and-structure learning sequence">
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Embedded Blocks" summary="Learn embedded Block definitions and instances.">
                  <target>docs:EmbeddedBlocks</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:SubBlocks>
