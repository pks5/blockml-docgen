<!--BlockML Documentation — a guide to nested Block definitions

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.SubBlocks-->
<docs:SubBlocks xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to nested Block definitions
  </is>
  <documentation>
    Scope: nested Block definitions, Sub-Block identity and scope, and nesting depth, grounded in
    the Sub-Block sections of org.blockml.bml.documentation.SubBlockModel and
    org.blockml.bml.definition.SubBlockDefinition. Body content is rendered in a04 from those
    sources.
  </documentation>
  <references>
    <see type="doc:SubBlockModel" relation="Requires">
      Primary content source — Sub-Block nesting, identity derivation, and generic scope.
    </see>
    <see type="def:SubBlockDefinition" relation="Requires">
      The nested Sub-Block definition shape this page introduces.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Sub-Blocks</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="A nested definition, sharing the parent's FQN prefix">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Sub-Block is a Block definition nested inside a parent Block, analogous to a Java static nested class — it shares the parent's FQN prefix and may declare its own generic type parameters." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Identity derivation-->
        <dpage:Section heading="Deriving a Sub-Block's identity">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Preferred authoring uses the unqualified element tag under subBlocks as the Sub-Block's name, while its type is normally omitted and derived as the parent's resolved type plus a dot plus that name." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. No outer generic scope-->
        <dpage:Section heading="No outer generic or instance scope">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Sub-Block has no enclosing-instance and no outer generic-type scope — a parameter declared on the enclosing Block must be forwarded explicitly on the Sub-Block's own baseType if it is still needed there." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="Nesting one Sub-Block">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A parent Block nests one Sub-Block under subBlocks, using the unqualified tag as the Sub-Block's name with no explicit type needed." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- Handle's tag under subBlocks supplies its name; no type element is needed -->
<acme:Basket xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    core:Block
  </baseType>
  <subBlocks>
    <Handle>
      <baseType>
        core:Block
      </baseType>
    </Handle>
  </subBlocks>
</acme:Basket>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Handle resolves to com.acme.example.Basket.Handle — the parent's own FQN with its tag name appended after a dot — exactly the derivation rule this page states, with no explicit type needed to see it." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should be able to nest a definition inside a parent Block and know how deep nesting resolves, before Embedded Blocks contrasts this with a very different kind of nested document." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with embedded Blocks">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Embedded Blocks" summary="Learn embedded Block definitions and instances.">
                  <target>docs:EmbeddedBlocks</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:SubBlocks>
