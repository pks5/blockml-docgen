<!--BlockML Documentation — a guide to BlockML's unifying Everything-is-a-Block principle

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.EverythingIsABlockPage-->
<docs:EverythingIsABlockPage xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to BlockML's unifying Everything-is-a-Block principle
  </is>
  <documentation>
    Scope: the Everything-is-a-Block model, single inheritance root, and why one grammar covers
    domain and framework types, grounded in org.blockml.bml.documentation.EverythingIsABlock and
    org.blockml.bml.core.Block. Body content is authored in a04 from those sources.
  </documentation>
  <references>
    <see type="doc:EverythingIsABlock" relation="Requires">
      Primary content source — one root, one parser, one TypeRegistry bootstrap path.
    </see>
    <see type="core:Block" relation="Requires">
      Sole inheritance root every BlockML concept ultimately extends.
    </see>
    <see type="doc:CoreUseCases" relation="SeeAlso">
      What the principle is used for.
    </see>
    <see type="doc:BlockAndInstance" relation="ReadNext">
      Next reading step — definition versus instance.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Everything Is a Block</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="One root, one grammar">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="BlockML describes everything that belongs to its grammar as a Block — there is one root, org.blockml.bml.core.Block, one parser, and one TypeRegistry bootstrap path." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Two layers of the same idea">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="The authoring ontology treats a Block as a named, definable unit with an FQN and a baseType chain, while the compiler internally remains free to use plain data and split indexes rather than a mandatory uniform runtime class hierarchy." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="A concrete domain example">
          <content>
            <dpage:List>
              <items>
                <dpage:ListItem text="Composable domain types are Blocks, just like every other concept in the grammar." />
                <dpage:ListItem text="ValueTypes such as Integer are Blocks — type definitions, not runtime values." />
                <dpage:ListItem text="Languages such as TypeScript are Blocks — capability implementation contracts." />
                <dpage:ListItem text="Definition meta-model types describe block structure in BlockML's own language and are themselves Blocks." />
                <dpage:ListItem text="Documentation blocks, Libraries, Services, Constraints, Capabilities, and Exceptions are all Blocks too." />
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <dpage:Section heading="Types describe, Properties hold">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="ValueTypes never store data — the type describes the nature of a value, and Properties own all concrete values." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Readers should now be able to explain why domain types, ValueTypes, Languages, and documentation blocks are all Blocks under one root." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with defining a Block">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Blocks" summary="Learn how to define, name, and reference a Block.">
                  <target>docs:Blocks</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:EverythingIsABlockPage>
