<!--BlockML Documentation — Getting Started page group

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.pagegroup.GettingStartedPageGroup-->
<a04pgroup:GettingStartedPageGroup xmlns="http://blockml.org/bml"
  xmlns:a04pgroup="org.blockml.bml.bmldocs.a04_rendering.data.pagegroup"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dcore="org.blockml.bml.docgen.core">

  <baseType>
    dcore:PageGroup
  </baseType>
  <is>
    The Getting Started page group for the A04 documentation set
  </is>
  <documentation>
    Section page group under DocsPageGroup, from BmlDocSetPlan.rootPageGroupPlan
    (GettingStartedPageGroup). Direct pages: Introduction, CoreUseCases.
  </documentation>
  <references>
    <see type="dcore:PageGroup" relation="Extends">
      Docgen page group base.
    </see>
    <see type="a04pgroup:DocsPageGroup" relation="Requires">
      Parent Documentation page group.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Getting Started</value>
    </title>
    <parentGroup override="true">
      <value>a04pgroup:DocsPageGroup</value>
    </parentGroup>
  </properties>
  <aggregations>
    <pages override="true">
      <composition>
        <docs:Introduction />
        <docs:CoreUseCases />
      </composition>
    </pages>
  </aggregations>
</a04pgroup:GettingStartedPageGroup>
