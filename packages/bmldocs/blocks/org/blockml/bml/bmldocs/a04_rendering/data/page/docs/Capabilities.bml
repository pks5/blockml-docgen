<!--BlockML Documentation — a guide to Block behaviour as Capabilities

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Capabilities-->
<docs:Capabilities xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to Block behaviour as Capabilities
  </is>
  <documentation>
    Scope: Block behaviour expressed as members, Capability implementation bodies, and common
    behavioural roles, grounded in org.blockml.bml.definition.CapabilityDefinition and
    org.blockml.bml.documentation.CapabilitySemantics. Body content is authored in a04 from those
    sources.
  </documentation>
  <references>
    <see type="def:CapabilityDefinition" relation="Requires">
      The behaviour member shape this page introduces — inputType, outputType, throws, implementation.
    </see>
    <see type="doc:CapabilitySemantics" relation="Requires">
      Primary content source — Capability kinds and the readings an implementation body may carry.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Capabilities</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Behaviour, expressed as a member">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="There are no special language concepts for a constructor, a getter, a setter, or a render step — all Block behaviour is expressed as ordinary Capabilities, declared like any other member." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Four kinds of communication shape-->
        <dpage:Section heading="Four communication shapes">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Capability's kind describes its payload shape: Inbound requires only an inputType, Outbound requires only an outputType, Transformation requires both, and Action requires neither." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. What an implementation body means-->
        <dpage:Section heading="What an implementation body means">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Capability implementation is a language-tagged body that may be read as intent for a human or an LLM, as a companion template a renderer transpiles, or as a deterministic function a host evaluates — no single reading is mandatory, and a Capability may serve more than one of them at once." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="Declaring a Transformation capability">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Transformation capability declares both an inputType and an outputType, alongside an implementation body tagged with its language." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- format is a Transformation capability: it declares both inputType and outputType -->
<acme:Greeter xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:cap="org.blockml.bml.capability"
  xmlns:core="org.blockml.bml.core"
  xmlns:lang="org.blockml.bml.language"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Block
  </baseType>
  <capabilities>
    <format type="cap:Transformation" inputType="type:Text" outputType="type:Text">
      <implementation language="lang:PseudoCode">
        Uppercase the first letter of the input text and return it.
      </implementation>
    </format>
  </capabilities>
</acme:Greeter>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="The format capability in the example commits only to its shape — one Text in, one Text out — and its PseudoCode implementation states that shape's intent for a human or LLM reader; a renderer or host remains free to read the same body as a template to transpile or a function to evaluate, but neither reading is required." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should be able to declare a Capability and know there is no separate constructor concept, closing out the four member kinds before override mechanics get their own page." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with member inheritance and overrides">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Member Inheritance and Overrides" summary="Learn how to refine or finalize an inherited member.">
                  <target>docs:MemberInheritanceAndOverrides</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Capabilities>
