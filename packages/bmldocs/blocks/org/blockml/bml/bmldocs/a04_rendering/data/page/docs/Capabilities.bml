<!--BlockML Documentation — a guide to Block behaviour as Capabilities

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Capabilities-->
<docs:Capabilities xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to Block behaviour as Capabilities
  </is>
  <documentation>
    Scope: Block behaviour expressed as members, Capability implementation bodies, and common
    behavioural roles, grounded in org.blockml.bml.definition.CapabilityDefinition and
    org.blockml.bml.documentation.CapabilitySemantics. Body content is authored in a03 from those
    sources.
  </documentation>
  <references>
    <see type="def:CapabilityDefinition" relation="Requires">
      The behaviour member shape this page introduces — inputType, outputType, throws, implementation.
    </see>
    <see type="doc:CapabilitySemantics" relation="Requires">
      Primary content source — Capability kinds and the readings an implementation body may carry.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Capabilities</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="Behaviour is just another kind of member">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>A Capability is an ordinary Block member that expresses behaviour. BlockML has
no separate constructor, getter, or setter concepts — every behaviour a Block exposes is
declared as a Capability.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Declaring a Capability">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>Declaring a Capability means naming what it does and, optionally, giving it an
implementation body tagged with the language that body is written in.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<capabilities>
  <getValue type="Outbound" outputType="Integer">
    <implementation language="PseudoCode">
      Return the current value of the Property this Capability exposes.
    </implementation>
  </getValue>
</capabilities>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>In the example, the implementation body is the Capability's declared behaviour,
and its language attribute tells readers and tools which language that body is written in.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What an implementation body can mean">
          <content>
            <dpage:List>
              <items>
                <dpage:ListItem text="An implementation body may be read as intent, describing what the Capability does for humans and language models." />
                <dpage:ListItem text="An implementation body may serve as a companion template that a renderer transpiles or emits into another form." />
                <dpage:ListItem text="An implementation body may be a deterministic, host-evaluable function that a toolchain executes directly." />
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <dpage:Section heading="Common behavioural roles">
          <content>
            <dpage:List>
              <items>
                <dpage:ListItem text="A Capability named init commonly plays the role a constructor would play elsewhere." />
                <dpage:ListItem text="A Capability named getValue commonly plays the role a getter would play elsewhere." />
                <dpage:ListItem text="A Capability named setValue commonly plays the role a setter would play elsewhere." />
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <dpage:Section heading="No separate constructor, getter, or setter concept">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>BlockML has no dedicated constructor, getter, or setter syntax; these roles are
modelled as ordinary Capabilities identified only by their conventional names.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with Member Inheritance and Overrides">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Member Inheritance and Overrides" summary="Learn when a local redeclaration must set override versus introduce a new member.">
                  <target>docs:MemberInheritanceAndOverrides</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Capabilities>
