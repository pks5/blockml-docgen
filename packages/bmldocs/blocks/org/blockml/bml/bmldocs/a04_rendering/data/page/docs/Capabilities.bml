<!--BlockML Documentation — a guide to Block behaviour as Capabilities

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Capabilities-->
<docs:Capabilities xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to Block behaviour as Capabilities
  </is>
  <documentation>
    Scope: Block behaviour expressed as members, Capability implementation bodies, and common
    behavioural roles, grounded in org.blockml.bml.definition.CapabilityDefinition and
    org.blockml.bml.documentation.CapabilitySemantics. Body content is authored in a04 from those
    sources.
  </documentation>
  <references>
    <see type="def:CapabilityDefinition" relation="Requires">
      The behaviour member shape this page introduces — inputType, outputType, throws, implementation.
    </see>
    <see type="doc:CapabilitySemantics" relation="Requires">
      Primary content source — Capability kinds and the readings an implementation body may carry.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Capabilities</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="Behaviour as ordinary members">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="BlockML has no special language concepts for a constructor, getter, setter, or render step; every behaviour a Block exposes — such as init(), getValue(), setValue(), or render() — is written as an ordinary Capability." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Four capability kinds">
          <content>
            <dpage:List>
              <items>
                <dpage:ListItem text="Inbound receives input from outside the Block, such as setValue or configure, and requires an inputType." />
                <dpage:ListItem text="Outbound produces output to the outside, such as getValue or emit, and requires an outputType." />
                <dpage:ListItem text="Transformation maps input to output, such as compute, format, or parse, and requires both an inputType and an outputType." />
                <dpage:ListItem text="Action performs a side effect, such as trigger, reset, or refresh, and requires neither an inputType nor an outputType." />
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <dpage:Section heading="Reading an implementation body">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Capability implementation may be read as intent for humans and language models, as a companion template that a renderer transpiles, or as a host-evaluable function that a toolchain executes — no single reading is mandatory, and one implementation may serve more than one of these at once." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Declaring exceptions">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="The throws aggregation lists the Exception types a Capability may raise, serving the same purpose as a throws clause on a Java method." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Readers should now be able to declare a Capability and know that BlockML has no separate constructor, getter, or setter concept — that behaviour is expressed as an ordinary Capability instead." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with member overrides">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Member Inheritance and Overrides" summary="Learn when a redeclaration must set override.">
                  <target>docs:MemberInheritanceAndOverrides</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Capabilities>
