<!--BlockML Documentation — a guide to Block behaviour as Capabilities

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Capabilities-->
<docs:Capabilities xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to Block behaviour as Capabilities
  </is>
  <documentation>
    Scope: Block behaviour expressed as members, Capability implementation bodies, and common
    behavioural roles, grounded in org.blockml.bml.definition.CapabilityDefinition and
    org.blockml.bml.documentation.CapabilitySemantics. Body content is rendered in a04 from those
    sources.
  </documentation>
  <references>
    <see type="def:CapabilityDefinition" relation="Requires">
      The behaviour member shape this page introduces — inputType, outputType, throws, implementation.
    </see>
    <see type="doc:CapabilitySemantics" relation="Requires">
      Primary content source — Capability kinds and the readings an implementation body may carry.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Capabilities</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Behaviour, expressed as a member">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="There are no special language concepts for constructor, getter, setter, or render — all behaviour is expressed as ordinary Capabilities, declared like any other member." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Four kinds of communication shape-->
        <dpage:Section heading="Four communication shapes">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Capability's kind describes its payload shape: Inbound requires only inputType, Outbound requires only outputType, Transformation requires both, and Action requires neither." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. What an implementation body means-->
        <dpage:Section heading="What an implementation body means">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Capability implementation is a language-tagged body that may serve as intent for humans and LLMs, as a companion template a renderer transpiles, or as a deterministic function a host evaluates — with no ranking among these readings." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="Declaring a Transformation capability">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Transformation capability declares both inputType and outputType, alongside an implementation body tagged with its language." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- priceWithTax is a Transformation: it declares both inputType and outputType -->
<acme:Basket xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:core="org.blockml.bml.core"
  xmlns:cap="org.blockml.bml.capability"
  xmlns:type="org.blockml.bml.type"
  xmlns:lang="org.blockml.bml.language">

  <baseType>
    core:Block
  </baseType>
  <capabilities>
    <priceWithTax type="cap:Transformation" inputType="type:Decimal" outputType="type:Decimal">
      <implementation language="lang:PseudoCode">
        return input * 1.19
      </implementation>
    </priceWithTax>
  </capabilities>
</acme:Basket>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="priceWithTax's type, cap:Transformation, is what requires both inputType and outputType to be present; its PseudoCode implementation states intent for a human or LLM reader, while a renderer or host remains free to read the same body as a template to transpile or a function to evaluate — neither reading is mandatory." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should be able to declare a Capability and know there is no separate constructor concept, closing out the four member kinds before override mechanics get their own page." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with member inheritance and overrides">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Member Inheritance and Overrides" summary="Learn how to refine or finalize an inherited member.">
                  <target>docs:MemberInheritanceAndOverrides</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Capabilities>
