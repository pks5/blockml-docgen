<!--BlockML Documentation — render A04 pages in place (semantic scaffold → real content)
  FQN: org.blockml.bml.bmldocs.a04_rendering.task.A04_02_RenderPages-->
<task:A04_02_RenderPages xmlns="http://blockml.org/bml"
  xmlns:task="org.blockml.bml.bmldocs.a04_rendering.task"
  xmlns:ltask="org.blockml.bml.bmldocs.lib.task"
  xmlns:source="org.blockml.bml.bmldocs.lib.source"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule"
  xmlns:lcrit="org.blockml.bml.bmldocs.lib.criterion"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    ltask:RuleAwareInstructionTask
  </baseType>
  <is>
    A task that renders A04 pages in place from semantic scaffold to real content
  </is>
  <documentation>
    A04 rendering task: rewrite each imported A04 DocPage in BML so semantic
    scaffold becomes reader-facing content — not an export to HTML, JSON, or
    another format.

    - **Import** — A04_01_CopyData already wiped A04 data and imported the
      full A03 data tree with packages and names remapped
    - **Input** — live A04 DocSet and pages
    - **Output** — the same A04 page Files, with real body slots filled and
      semantic / claim metadata removed; do not redesign structure
    - **Rules** — RenderingRules (inspect each subRule); do not paraphrase
      them in instructions
    - **Sources** — authorativeSources is BlockMLSourceSet
  </documentation>
  <properties>
    <instructions type="type:Text" override="true">
      <value>
        <![CDATA[
          Render every A04 page in place: turn the imported semantic scaffold
          into finished reader-facing BML content on the same DocPages. Do not
          export to HTML, JSON, Markdown, or any other manifestation. Do not
          add, remove, or reorder content elements. Do not invent pages or
          edit A01 / A02 / A03.

          A04_01_CopyData has already wiped live A04 data and imported the
          full A03 data tree with packages and names remapped.

          1. Read org.blockml.bml.bmldocs.a04_rendering.data.BmlDocSet_A04.
          Walk BmlDocSet_A04.pages in listed order. The imported fields are
          the specification.

          2. Resolve this task's authorativeSources (inspect
          BlockMLSourceSet). For each Block named by a page or element
          source set, inspect is, documentation, and references before
          writing. Never link a Block from another sector. Never keep an
          A03 FQN on an A04 page.

          3. Follow DocPage.content order. Fill each element's real body
          slot from its purpose, message, role, detailLevel, weight, and
          element semantics. Inspect the element type (Paragraph, CodeBlock,
          ListItem, Image, Navigation, Section) for which slot to fill.

          4. Strip specification altitude from each written A04 page.

          On DocPage: remove authoritativeSources, scopes, readerOutcomes,
          learningObjectives, exclusions, supportingPoints, audiences, and
          purpose. Keep title, docset, pageType, detailLevel, rules, and
          the content tree.

          On every Section, Navigation, NavigationItem, and page:Text:
          remove purpose once heading / labels / text are filled.

          On every ContentElement: remove message, role, weight,
          detailLevel, authoritativeSources, audiences, supportingPoints,
          readerOutcomes, learningObjectives, scopes, exclusions, and
          purpose. Keep the real body slots.
        ]]>
      </value>
    </instructions>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:RenderingRules />
      </composition>
    </rules>
    <successCriteria override="true">
      <composition>
        <lcrit:CodeBlockHasListing />
        <lcrit:CodeBlockFollowedByExplanation />
      </composition>
    </successCriteria>
    <authorativeSources override="true">
      <composition>
        <source:BlockMLSourceSet />
      </composition>
    </authorativeSources>
  </aggregations>
</task:A04_02_RenderPages>
