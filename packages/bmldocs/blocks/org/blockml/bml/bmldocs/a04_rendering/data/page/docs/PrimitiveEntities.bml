<!--BlockML Documentation — a guide to wrapping primitive values as Block instances

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.PrimitiveEntities-->
<docs:PrimitiveEntities xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to wrapping primitive values as Block instances
  </is>
  <documentation>
    Scope: primitive values represented as Block instances via the PrimitiveEntity wrapper,
    grounded in org.blockml.bml.core.PrimitiveEntity and its authoring rules in
    org.blockml.bml.documentation.MemberAuthoring. Body content is authored in a03 from those
    sources.
  </documentation>
  <references>
    <see type="core:PrimitiveEntity" relation="Requires">
      The wrapper type this page introduces — a primitive value as a Block instance.
    </see>
    <see type="doc:MemberAuthoring" relation="Requires">
      Primary content source — the value-named-member exception on PrimitiveEntity instances.
    </see>
    <see type="type:TextEntity" relation="SeeAlso">
      A concrete PrimitiveEntity specialization.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Primitive Entities</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="What a PrimitiveEntity is">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>A PrimitiveEntity wraps an ordinary primitive value so that value can appear as a
Block instance in its own right, carrying its own identity, documentation, or metadata,
wherever a bare Property value is not enough. The wrapper exists only for that
situation — most primitive values never need it.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="When a wrapper is needed">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>Properties normally store primitive values directly, and that remains the ordinary
case throughout a BlockML model. A PrimitiveEntity becomes necessary only when a
primitive value itself must become an aggregation child — for example, when several
tagged values need to be collected as individually addressable instances rather than
folded into a single Property.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Concrete wrappers bind a primitive type">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>PrimitiveEntity itself is a generic, uninstantiable wrapper. A concrete
specialization, such as TextEntity, binds one primitive type and becomes an ordinary,
instantiable Block, so every instance of that specialization already carries the
bound type.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Setting the wrapped value">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>On a PrimitiveEntity instance, the wrapped value is set using ordinary instance
syntax — an attribute or a direct element — because the wrapper's Property happens to
be named value, not because of any special wrapping mechanism.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock code="&lt;type:TextEntity value=&quot;Release notes&quot; /&gt;" />
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with Types and Values">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Types and Values" summary="Step back to the general principle underlying every member kind, including this wrapper.">
                  <target>docs:TypesAndValues</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:PrimitiveEntities>
