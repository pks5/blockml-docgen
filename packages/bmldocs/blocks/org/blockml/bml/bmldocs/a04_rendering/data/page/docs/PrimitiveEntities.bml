<!--BlockML Documentation — a guide to wrapping primitive values as Block instances

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.PrimitiveEntities-->
<docs:PrimitiveEntities xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to wrapping primitive values as Block instances
  </is>
  <documentation>
    Scope: primitive values represented as Block instances via the PrimitiveEntity wrapper,
    grounded in org.blockml.bml.core.PrimitiveEntity and its authoring rules in
    org.blockml.bml.documentation.MemberAuthoring. Body content is rendered in a04 from those
    sources.
  </documentation>
  <references>
    <see type="core:PrimitiveEntity" relation="Requires">
      The wrapper type this page introduces — a primitive value as a Block instance.
    </see>
    <see type="doc:MemberAuthoring" relation="Requires">
      Primary content source — the value-named-member exception on PrimitiveEntity instances.
    </see>
    <see type="type:TextEntity" relation="SeeAlso">
      A concrete PrimitiveEntity specialization.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Primitive Entities</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="When a primitive value needs to be an instance">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="core:PrimitiveEntity is the abstract wrapper that lets a primitive value appear as a Block instance — needed only where an instance is required, such as inside an aggregation, not wherever a primitive value merely needs to exist." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Binding T and the value member-->
        <dpage:Section heading="Binding T and the value member">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A concrete specialization such as type:TextEntity binds PrimitiveEntity's generic parameter T through baseType, which yields a normal, instantiable Block carrying a single property named value." />
              </content>
            </dpage:Paragraph>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Because the member's name genuinely is value, an instance writes value=&quot;…&quot; directly — this is ordinary instance syntax for that member, not the definition-only value wrapper that other Properties must never use." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Why an aggregation needs the wrapper-->
        <dpage:Section heading="Why an aggregation needs the wrapper">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A bare Property already stores a primitive value directly; a PrimitiveEntity is needed only when that same kind of value must appear as a child inside an aggregation, which requires a Block instance rather than a scalar value." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="Collecting keywords as PrimitiveEntity instances">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="An aggregation whose payload type is a concrete PrimitiveEntity holds each value as one child instance, each with its own value attribute." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- Widget declares "keywords" as an aggregation of TextEntity instances -->
<acme:Widget xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Block
  </baseType>
  <aggregations>
    <keywords type="type:TextEntity">
      <composition>
        <type:TextEntity value="fastener" />
        <type:TextEntity value="hardware" />
      </composition>
    </keywords>
  </aggregations>
</acme:Widget>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Each of the two strings, fastener and hardware, needed to become an aggregation child, so each one is wrapped as a TextEntity instance whose value attribute carries it — a bare Property could not hold more than one such value at all." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should know when a bare Property value is not enough and a PrimitiveEntity wrapper is needed instead, before the next page states the type-versus-value principle these first four pages all rest on." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with types and values">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Types and Values" summary="Learn the general type-versus-value distinction.">
                  <target>docs:TypesAndValues</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:PrimitiveEntities>
