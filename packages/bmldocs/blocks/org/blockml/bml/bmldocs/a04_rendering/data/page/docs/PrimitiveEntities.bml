<!--BlockML Documentation — a guide to wrapping primitive values as Block instances

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.PrimitiveEntities-->
<docs:PrimitiveEntities xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to wrapping primitive values as Block instances
  </is>
  <documentation>
    Scope: primitive values represented as Block instances via the PrimitiveEntity wrapper,
    grounded in org.blockml.bml.core.PrimitiveEntity and its authoring rules in
    org.blockml.bml.documentation.MemberAuthoring. Body content is authored in a04 from those
    sources.
  </documentation>
  <references>
    <see type="core:PrimitiveEntity" relation="Requires">
      The wrapper type this page introduces — a primitive value as a Block instance.
    </see>
    <see type="doc:MemberAuthoring" relation="Requires">
      Primary content source — the value-named-member exception on PrimitiveEntity instances.
    </see>
    <see type="type:TextEntity" relation="SeeAlso">
      A concrete PrimitiveEntity specialization.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Primitive Entities</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="A primitive value as a Block instance">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="PrimitiveEntity is the abstract generic Block that lets a primitive value appear as a Block instance wherever an instance is required, such as inside a composition or aggregation." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Binding the generic parameter">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A concrete specialization binds PrimitiveEntity's generic parameter through baseType; for example, TextEntity binds the parameter to Text and thereby inherits a value property typed as Text." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="The value member exception">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Because a PrimitiveEntity's member is literally named value, writing value=&quot;…&quot; on an instance is ordinary instance syntax for that member, not a PropertyDefinition value wrapper, which only belongs to a member declaration." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="When a wrapper is needed">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Ordinary Properties continue to store primitive values directly; a PrimitiveEntity wrapper is needed only when that primitive value itself must become a Block instance with its own identity, for example as a child in an aggregation." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Readers now know when a bare Property value is enough and when the value itself must become a Block instance through a PrimitiveEntity wrapper." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with types and values">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Types and Values" summary="See the general type-versus-value distinction behind every member kind.">
                  <target>docs:TypesAndValues</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:PrimitiveEntities>
