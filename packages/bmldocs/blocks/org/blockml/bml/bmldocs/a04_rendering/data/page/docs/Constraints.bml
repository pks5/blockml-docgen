<!--BlockML Documentation — a guide to declarative validation rules

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Constraints-->
<docs:Constraints xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to declarative validation rules
  </is>
  <documentation>
    Scope: declarative validation rules, the constraints container, constraint branches, and when
    a constraint is evaluated, grounded in org.blockml.bml.documentation.ConstraintsModel,
    org.blockml.bml.core.Constraint, and org.blockml.bml.definition.ConstrainableDefinition. Body
    content is authored in a04 from those sources.
  </documentation>
  <references>
    <see type="doc:ConstraintsModel" relation="Requires">
      Primary content source — branch-to-context binding, validation severity, and standard constraints.
    </see>
    <see type="core:Constraint" relation="Requires">
      The semantic validation rule branch this page introduces.
    </see>
    <see type="def:ConstrainableDefinition" relation="Requires">
      The shared constraints container on Blocks and members.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Constraints</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="Reusable validation rules">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Constraints are reusable validation rules attached to a Block or member through a single constraints container; there is no separate target property, because the embedding context binds the constraint automatically." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Branches bind to their context">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Each constraint branch binds to the context that embeds it: a value constraint on a Property binds to that Property's effective ValueType, while other branches bind to their corresponding member or Block definition. Placing a constraint on the wrong branch for its embedding context is a checked error, not just a modeling convention." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Enforcement is optional">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A constraint's optional validation property controls whether and how strictly it is enforced; when the property is omitted, the constraint is not checked and remains part of the model as metadata only." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Attaching a constraint">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Every definition that supports constraints — whether a Block or one of its members — carries the same constraints container, so the same attachment mechanism applies wherever a constraint is allowed." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Readers should now be able to attach the right constraint branch to a member and know when it takes effect." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with suggestions">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Suggestions" summary="Learn the non-enforced counterpart to constraints.">
                  <target>docs:Suggestions</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Constraints>
