<!--BlockML Documentation — a guide to declarative validation rules

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Constraints-->
<docs:Constraints xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to declarative validation rules
  </is>
  <documentation>
    Scope: declarative validation rules, the constraints container, constraint branches, and when
    a constraint is evaluated, grounded in org.blockml.bml.documentation.ConstraintsModel,
    org.blockml.bml.core.Constraint, and org.blockml.bml.definition.ConstrainableDefinition. Body
    content is rendered in a04 from those sources.
  </documentation>
  <references>
    <see type="doc:ConstraintsModel" relation="Requires">
      Primary content source — branch-to-context binding, validation severity, and standard constraints.
    </see>
    <see type="core:Constraint" relation="Requires">
      The semantic validation rule branch this page introduces.
    </see>
    <see type="def:ConstrainableDefinition" relation="Requires">
      The shared constraints container on Blocks and members.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Constraints</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="One container, automatic binding">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Constraints are reusable validation rules attached through a single constraints container on Blocks and members — there is no target property, because the embedding context binds the constraint automatically." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Branch-to-context mapping-->
        <dpage:Section heading="Which branch fits which context">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A constraint's branch must match the definition it is attached to — a value constraint binds to a Property's effective ValueType, while structural constraint branches bind to the Aggregation, Association, Capability, or Block definition that embeds them, and a mismatch is a checked error." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. When a constraint is enforced-->
        <dpage:Section heading="When a constraint is enforced">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A constraint's optional validation property decides how a violation is reported — omitted, the constraint remains metadata for renderers and editors rather than a rule the BlockML validator enforces." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="Constraining a Property's value">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Property can attach a value constraint whose generic type parameter binds automatically from the Property's own type — no target or type argument is authored explicitly." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- Min's generic parameter T binds to Integer purely from context -->
<acme:Basket xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:validation="org.blockml.bml.validation">

  <baseType>
    core:Block
  </baseType>
  <properties>
    <count type="type:Integer">
      <value>3</value>
      <constraints>
        <constraint:Min value="0" validation="validation:Error" />
      </constraints>
    </count>
  </properties>
</acme:Basket>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="constraint:Min's generic parameter T binds to count's own type, Integer, purely from context — no target or type argument is written on Min itself. Its validation attribute, validation:Error, is what turns it from metadata into a rule the validator actually enforces, rejecting any count below 0." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should be able to attach the right constraint branch to a member and know when it is enforced, before Suggestions contrasts non-enforced guidance with what this page just covered." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with suggestions">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Suggestions" summary="Learn non-mandatory modeling guidance.">
                  <target>docs:Suggestions</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Constraints>
