<!--BlockML Documentation — a guide to declarative validation rules

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Constraints-->
<docs:Constraints xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to declarative validation rules
  </is>
  <documentation>
    Scope: declarative validation rules, the constraints container, constraint branches, and when
    a constraint is evaluated, grounded in org.blockml.bml.documentation.ConstraintsModel,
    org.blockml.bml.core.Constraint, and org.blockml.bml.definition.ConstrainableDefinition. Body
    content is authored in a04 from those sources.
  </documentation>
  <references>
    <see type="doc:ConstraintsModel" relation="Requires">
      Primary content source — branch-to-context binding, validation severity, and standard constraints.
    </see>
    <see type="core:Constraint" relation="Requires">
      The semantic validation rule branch this page introduces.
    </see>
    <see type="def:ConstrainableDefinition" relation="Requires">
      The shared constraints container on Blocks and members.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Constraints</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="One container, automatic binding">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Constraints are reusable validation rules attached through a single constraints container that Blocks and their members all share." />
                <dpage:Text text="A constraint carries no target property of its own — the embedding context it sits inside binds it automatically, whether that context is a Block, a Property, or another member kind." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Branch-to-context mapping-->
        <dpage:Section heading="Which branch fits which context">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Every constraint branch must match the kind of definition it is attached to." />
                <dpage:Text text="A value constraint binds to a Property's effective ValueType, while a structural constraint branch binds instead to the Aggregation, Association, Capability, or Block definition that embeds it." />
                <dpage:Text text="Attaching a constraint to a branch that does not fit its embedding context is a checked error, not a style mismatch the validator lets pass." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. When a constraint is enforced-->
        <dpage:Section heading="When a constraint is enforced">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Every constraint carries an optional validation property that decides how the BlockML validator treats a violation." />
                <dpage:Text text="Left unset, the constraint still exists in the compiled model as descriptive metadata for renderers and editors, without becoming a rule the validator enforces." />
                <dpage:Text text="Setting validation is what turns that same constraint into an actual validation rule, checked at compile time." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="Constraining a Property's value">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="The example below attaches one value constraint directly to a Property's constraints container." />
                <dpage:Text text="The constraint's generic type parameter binds automatically to the Property's own value type, so no target or explicit type argument needs to be written." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- The constraints container holds one Min value constraint; validation="Error" makes it enforced -->
<acme:Panel xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:core="org.blockml.bml.core"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Block
  </baseType>
  <is>
    A panel with a bounded width
  </is>
  <documentation>
    Demonstrates a Property carrying one enforced value constraint.
  </documentation>
  <properties>
    <width type="type:Integer">
      <constraints>
        <constraint:Min value="1" validation="Error" />
      </constraints>
    </width>
  </properties>
</acme:Panel>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="In the example, Min's generic parameter binds to width's Integer type purely from the property it sits inside — nothing about that binding is written explicitly." />
                <dpage:Text text="Because validation is set to Error, the validator treats a width below one as a compile-time violation rather than leaving the bound as descriptive metadata only." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should be able to attach the right constraint branch to a member and know when the BlockML validator actually enforces it." />
                <dpage:Text text="Suggestions, next, contrasts this enforced behavior with guidance that the validator never enforces at all." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with suggestions">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Suggestions" summary="Learn non-mandatory modeling guidance.">
                  <target>docs:Suggestions</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Constraints>
