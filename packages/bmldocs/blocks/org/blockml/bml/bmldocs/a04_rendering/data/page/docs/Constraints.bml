<!--BlockML Documentation — a guide to declarative validation rules

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Constraints-->
<docs:Constraints xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:type="org.blockml.bml.type"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to declarative validation rules
  </is>
  <documentation>
    Scope: declarative validation rules, the constraints container, constraint branches, and when
    a constraint is evaluated, grounded in org.blockml.bml.documentation.ConstraintsModel,
    org.blockml.bml.core.Constraint, and org.blockml.bml.definition.ConstrainableDefinition. Body
    content is authored in a03 from those sources.
  </documentation>
  <references>
    <see type="doc:ConstraintsModel" relation="Requires">
      Primary content source — branch-to-context binding, validation severity, and standard constraints.
    </see>
    <see type="core:Constraint" relation="Requires">
      The semantic validation rule branch this page introduces.
    </see>
    <see type="def:ConstrainableDefinition" relation="Requires">
      The shared constraints container on Blocks and members.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Constraints</value>
    </title>
    <purpose override="true">
      <value>Teach the constraints container and its branch-to-member-kind mapping, so readers can attach the right constraint branch to a member and know when it is enforced.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <workflow:AuthorativeSourceSet>
          <includedTypes>
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.ConstraintsModel" />
            <type:TypeSelectorEntity value="org.blockml.bml.core.Constraint" />
            <type:TypeSelectorEntity value="org.blockml.bml.definition.ConstrainableDefinition" />
          </includedTypes>
        </workflow:AuthorativeSourceSet>
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>Teach the constraints container and its branch-to-member-kind mapping.</summary>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>The reader can attach the right constraint branch to a member.</summary>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>Declarative validation rules, the constraints container, constraint branches, and when a constraint is evaluated.</summary>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>Suggestions depth beyond the enforced-versus-non-enforced contrast.</summary>
          <reason>Suggestions get their own page.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <supportingPoints override="true">
      <composition>
        <sem:SupportingPoint>
          <summary>Placing a constraint on the wrong branch for its embedding context is a checked error, not just a convention.</summary>
        </sem:SupportingPoint>
      </composition>
    </supportingPoints>
    <content override="true">
      <composition>
        <!--1. What a constraint is-->
        <dpage:Section heading="Constraints as declarative rules" purpose="Introduce constraints as declarative conditions rather than ad hoc checks">
          <content>
            <dpage:Paragraph purpose="State what a constraint is and why it exists">
              <role>org.blockml.bml.docgen.role.Lead</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A constraint is a declarative rule that states a condition a Block or member
must satisfy, so BlockML can check it consistently instead of relying on ad hoc
validation code.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>A constraint instance is itself checked by BlockML regardless of whether the rule it describes is enforced.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.core.Constraint" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
            <dpage:Paragraph purpose="Explain that placement determines what a constraint checks">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Where a constraint is attached determines what it checks: authors never
declare a separate target, because the surrounding definition supplies that context
automatically.</message>
              <authoritativeSources>
                <doc:ConstraintsModel />
                <def:ConstrainableDefinition />
              </authoritativeSources>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. The shared container-->
        <dpage:Section heading="One shared container on Blocks and members" purpose="Explain the constraints container that Blocks and members share">
          <content>
            <dpage:Paragraph purpose="Explain the shared constraints container">
              <role>org.blockml.bml.docgen.role.Definition</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Every Block definition and every member definition that can carry a
constraint exposes the same kind of container, so constraints work the same way no
matter where they are attached.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>The container itself does not distinguish what kind of definition it is attached to; the embedding position does.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.definition.ConstrainableDefinition" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Branches-->
        <dpage:Section heading="Matching a constraint to its member kind" purpose="Explain that constraints fall into branches tied to what they can be attached to">
          <content>
            <dpage:Paragraph purpose="Introduce the idea of constraint branches">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Constraints are organized into branches, and each branch is compatible with
only certain kinds of definitions: one branch checks a property's value, while other
branches check the shape of a Block or of another member.</message>
              <authoritativeSources>
                <doc:ConstraintsModel />
              </authoritativeSources>
            </dpage:Paragraph>
            <dpage:List purpose="Summarize the constraint branch categories">
              <role>org.blockml.bml.docgen.role.Summary</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>These branch categories set the boundary for where a given constraint may
be attached.</message>
              <items>
                <dpage:ListItem text="Property value rules" purpose="Describe the branch that checks a property's value">
                  <message>A rule that checks the value assigned to a single property.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Block shape rules" purpose="Describe the branch that checks a Block's own structure">
                  <message>A rule that checks the structure of a Block definition itself.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Member shape rules" purpose="Describe the branch that checks another member's structure">
                  <message>A rule that checks the structure of an aggregation, association, or capability defined on a Block.</message>
                </dpage:ListItem>
              </items>
            </dpage:List>
            <dpage:Paragraph purpose="State that a branch mismatch is a checked error">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Placing a constraint on the wrong branch for its embedding context is a
checked error, not just a naming convention that BlockML leaves to the author's
discipline.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>Placing a constraint on the wrong branch for its embedding context is a checked error, not just a convention.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.core.Constraint" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Enforcement-->
        <dpage:Section heading="Whether a constraint is enforced" purpose="Explain that enforcement is a separate, optional setting">
          <content>
            <dpage:Paragraph purpose="Explain the optional enforcement setting">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A constraint always describes its condition, but only an explicit
enforcement setting tells BlockML to reject a model that violates it; without that
setting the constraint stays descriptive.</message>
              <authoritativeSources>
                <core:Constraint />
              </authoritativeSources>
            </dpage:Paragraph>
            <dpage:Paragraph purpose="Contrast enforced constraints with always-non-enforced suggestions">
              <role>org.blockml.bml.docgen.role.Comparison</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>This optional enforcement is different from a suggestion, which never
participates in validation at all regardless of any setting.</message>
              <authoritativeSources>
                <doc:ConstraintsModel />
              </authoritativeSources>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. Recap-->
        <dpage:Section heading="Attaching a constraint" purpose="Give the reader a compact checklist for attaching a constraint correctly">
          <content>
            <dpage:List purpose="Summarize the steps for attaching a constraint correctly">
              <role>org.blockml.bml.docgen.role.Summary</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>These checks together determine whether a constraint is well placed and
what it will do.</message>
              <items>
                <dpage:ListItem text="Find the definition" purpose="Recap identifying the target definition">
                  <message>Identify the Block or member definition the rule should apply to.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Match the branch" purpose="Recap choosing the compatible branch">
                  <message>Choose the constraint branch compatible with that kind of definition.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Decide on enforcement" purpose="Recap the optional enforcement setting">
                  <message>Add an enforcement setting only if the rule should fail validation, otherwise leave it as descriptive metadata.</message>
                </dpage:ListItem>
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with non-mandatory guidance" purpose="Direct the reader to the next page">
          <content>
            <dpage:Navigation purpose="Continue from constraints into non-mandatory suggestions">
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Suggestions" summary="Learn how non-mandatory guidance for editors and renderers differs from a constraint.">
                  <target>docs:Suggestions</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Constraints>
