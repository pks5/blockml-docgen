<!--BlockML Documentation — a guide to the Block documentation model

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.DocumentingBlocks-->
<docs:DocumentingBlocks xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to the Block documentation model
  </is>
  <documentation>
    Scope: the Block documentation model — is, documentation, and references fields, grounded in
    org.blockml.bml.documentation.DocumentationModel and
    org.blockml.bml.definition.StructuralDefinition. Body content is authored in a03 from those
    sources.
  </documentation>
  <references>
    <see type="doc:DocumentationModel" relation="Requires">
      Primary content source — is, summary, documentation, and references authoring rules.
    </see>
    <see type="def:StructuralDefinition" relation="Requires">
      Shared documentation model — Documentation, Change, Example, and Reference sub-blocks.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Documenting Blocks</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Documentation lives at the definition site">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>Every Block definition carries its own documentation model — is,
documentation, and references — directly in the BML file, as the single
source of truth for that Block.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. is-->
        <dpage:Section heading="is: naming the idea">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>is is a required noun phrase naming what a Block semantically represents — its
Idea — and comes right after a Block's name, type, and baseType identity. is
stays a short noun phrase, not the full purpose or a technical description of
the Block.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. documentation-->
        <dpage:Section heading="documentation: the technical description">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>documentation is a required technical description of the Block, written as
Markdown in English by default, and should use headings, paragraphs, and
lists once the prose grows beyond a short paragraph.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. references-->
        <dpage:Section heading="references: where cross-links live">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>references holds every documentation cross-link from a Block to other types,
instances, or external material, each carrying an explicit relationship, so
documentation prose does not need to repeat those links inline.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. Recap-->
        <dpage:Section heading="Filling the documentation model">
          <content>
            <dpage:List>
              <items>
                <dpage:ListItem text="is names the Block's Idea in a short noun phrase, right after its identity." />
                <dpage:ListItem text="documentation gives the required technical description of the Block, as Markdown prose." />
                <dpage:ListItem text="references carries every documentation cross-link, each with its own relationship." />
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with BML, the authoring format">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="BML" summary="Move from the documentation model into BML as the authoring format itself.">
                  <target>docs:Bml</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:DocumentingBlocks>
