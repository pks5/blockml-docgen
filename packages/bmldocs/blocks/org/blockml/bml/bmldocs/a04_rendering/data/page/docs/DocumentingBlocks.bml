<!--BlockML Documentation — a guide to the Block documentation model

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.DocumentingBlocks-->
<docs:DocumentingBlocks xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to the Block documentation model
  </is>
  <documentation>
    Scope: the Block documentation model — is, documentation, and references fields, grounded in
    org.blockml.bml.documentation.DocumentationModel and
    org.blockml.bml.definition.StructuralDefinition. Body content is authored in a04 from those
    sources.
  </documentation>
  <references>
    <see type="doc:DocumentationModel" relation="Requires">
      Primary content source — is, summary, documentation, and references authoring rules.
    </see>
    <see type="def:StructuralDefinition" relation="Requires">
      Shared documentation model — Documentation, Change, Example, and Reference sub-blocks.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Documenting Blocks</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="Documentation at the definition site">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Every root Block carries a documentation model at the definition site — the single source of truth inside the BML file itself." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="is and documentation">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="is names what a Block semantically represents in a short noun phrase, while documentation is the required technical description, written as Markdown(English) by default." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="isNot">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="isNot is required when confusion risk exists, disambiguating a Block from an easily confused nearby concept." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="references carries the cross-links">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="references carries every documentation cross-link, so prose in documentation should not repeat those links." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="With this model in place, a Block's is, documentation, and references fields can now be filled in correctly." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with BML">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="BML: The Authoring Format" summary="See how BML relates to the canonical BOM.">
                  <target>docs:Bml</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:DocumentingBlocks>
