<!--BlockML Documentation — a guide to the Block documentation model

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.DocumentingBlocks-->
<docs:DocumentingBlocks xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to the Block documentation model
  </is>
  <documentation>
    Scope: the Block documentation model — is, documentation, and references fields, grounded in
    org.blockml.bml.documentation.DocumentationModel and
    org.blockml.bml.definition.StructuralDefinition. Body content is rendered in a04 from those
    sources.
  </documentation>
  <references>
    <see type="doc:DocumentationModel" relation="Requires">
      Primary content source — is, summary, documentation, and references authoring rules.
    </see>
    <see type="def:StructuralDefinition" relation="Requires">
      Shared documentation model — Documentation, Change, Example, and Reference sub-blocks.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Documenting Blocks</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="The definition site is the single source of truth">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Every Block definition carries its documentation at the definition site — is, documentation, and references are the single source of truth inside the BML file itself, not scattered across external documents." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. is names the Idea, documentation explains it-->
        <dpage:Section heading="is names the idea; documentation explains it">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="is is a required, ultra-short noun phrase naming what a Block semantically represents — not a purpose statement and not full technical detail, both of which belong in documentation instead." />
              </content>
            </dpage:Paragraph>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="documentation is always required and defaults to Markdown in English — longer prose should use headings, paragraphs, and lists, since human-friendly formatting is part of BlockML, not decoration." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. references carries every cross-link-->
        <dpage:Section heading="references carries every cross-link">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="references is the single place every documentation cross-link lives — each with an explicit relationship note — so documentation prose should describe concepts rather than repeat links that references already carries." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="Filling is, documentation, and references">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Block fills is with a short noun phrase, documentation with fuller Markdown prose, and references with one cross-link carrying its own relationship note." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- is, documentation, and references, filled at the definition site -->
<acme:Widget xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    core:Block
  </baseType>
  <is>
    A generic composable part
  </is>
  <documentation>
    Widget is the handbook's running example of a minimal domain Block. It carries
    no members of its own and exists purely to illustrate identity and structure.
  </documentation>
  <references>
    <see type="core:Block" relation="Extends">
      Root type every Widget instance ultimately specializes.
    </see>
  </references>
</acme:Widget>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Widget's is stays a short noun phrase, its documentation expands on that in Markdown prose, and the core:Block cross-link sits in references with its own relation, Extends, attached — precisely so the documentation prose above it can stay focused on describing the Block, not on repeating that same link inline." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should be able to fill a Block's is, documentation, and references fields correctly, closing out this handbook's concept pages before the BML authoring format itself is described directly." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with BML, the authoring format">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="BML: The Authoring Format" summary="Learn BML as BlockML's human-authored format.">
                  <target>docs:Bml</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:DocumentingBlocks>
