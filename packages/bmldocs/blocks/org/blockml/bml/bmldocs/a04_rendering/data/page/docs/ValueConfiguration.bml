<!--BlockML Documentation — a guide to configuring ValueType instances

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.ValueConfiguration-->
<docs:ValueConfiguration xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:mapping="org.blockml.bml.mapping"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to configuring ValueType instances
  </is>
  <documentation>
    Scope: configuring values and Block instances in BML through curly-brace ValueType
    configuration, grounded in org.blockml.bml.documentation.ValueTypeConfiguration. Body content
    is authored in a04 from that source.
  </documentation>
  <references>
    <see type="doc:ValueTypeConfiguration" relation="Requires">
      Primary content source — named and positional configuration syntax and its rules.
    </see>
    <see type="mapping:FunctionMapping" relation="SeeAlso">
      Shared declaration-order rule for positional configuration.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Value Configuration</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Curly braces configure an owned type instance">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Curly braces configure the type instance a Property owns — a mechanism orthogonal to the generic parenthesis binding covered earlier." />
                <dpage:Text text="The configuration applies to that owned instance alone, never to the ValueType definition block itself." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Named versus positional-->
        <dpage:Section heading="Named and positional configuration">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Named configuration writes JSON-like key-value pairs inside curly braces, each key naming a configuration property on the ValueType being configured." />
              </content>
            </dpage:Paragraph>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Positional configuration supplies the same values in the ValueType's own property declaration order instead of naming them." />
                <dpage:Text text="Named and positional forms must never be mixed inside the same curly-brace block." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Configuration versus generic binding-->
        <dpage:Section heading="Configuration is not generic binding">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Generic application uses round parentheses to bind a type parameter to a concrete type, while curly braces configure the resulting instance." />
                <dpage:Text text="The two are orthogonal concerns and may appear together on the same type reference." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="Configuring a Text property's length">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Text property can bound its own length using named curly-brace configuration directly on its type, rather than a separate Constraint." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- Named curly-brace configuration bounds the type instance this property owns -->
<acme:Comment xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Block
  </baseType>
  <is>
    A comment with a bounded body length
  </is>
  <documentation>
    Demonstrates named ValueType instance configuration on a Property's type.
  </documentation>
  <properties>
    <body type="type:Text{maxLength: 280}" />
  </properties>
</acme:Comment>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="The maxLength bound in the example belongs entirely to body's own type instance — the Text ValueType definition itself remains unaffected." />
                <dpage:Text text="Other Text properties elsewhere may configure a different bound, or none at all, without any of them interfering with each other." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should be able to write curly-brace configuration on a Property's type reference, closing out the behaviour-and-values group before Composition shows how aggregations get filled with actual children." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with composition">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Composition" summary="Learn how to fill an aggregation through composition.">
                  <target>docs:Composition</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:ValueConfiguration>
