<!--BlockML Documentation — a guide to configuring ValueType instances

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.ValueConfiguration-->
<docs:ValueConfiguration xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:mapping="org.blockml.bml.mapping">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to configuring ValueType instances
  </is>
  <documentation>
    Scope: configuring values and Block instances in BML through curly-brace ValueType
    configuration, grounded in org.blockml.bml.documentation.ValueTypeConfiguration. Body content
    is authored in a04 from that source.
  </documentation>
  <references>
    <see type="doc:ValueTypeConfiguration" relation="Requires">
      Primary content source — named and positional configuration syntax and its rules.
    </see>
    <see type="mapping:FunctionMapping" relation="SeeAlso">
      Shared declaration-order rule for positional configuration.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Value Configuration</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="Configuring a ValueType instance">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Curly braces configure the ValueType instance owned by a Property, a mechanism orthogonal to generic binding written with parentheses." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Named and positional forms">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Configuration may be written as named key-value pairs, such as Text{maxLength: 100}, or positionally by declaration order, such as Decimal{10, 2} — the two forms must not be mixed within a single block." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Where configuration applies">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Configuration always applies to the type instance associated with a particular Property, never to the ValueType definition block itself." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Configuration before multiplicity">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Multiplicity brackets apply after configuration, as in Text{maxLength: 50}[0..n]." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Readers should now be able to write curly-brace configuration on a Property's type reference." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with composition">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Composition" summary="Learn how aggregations are filled with concrete child instances.">
                  <target>docs:Composition</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:ValueConfiguration>
