<!--BlockML Documentation — a guide to configuring ValueType instances

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.ValueConfiguration-->
<docs:ValueConfiguration xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:mapping="org.blockml.bml.mapping">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to configuring ValueType instances
  </is>
  <documentation>
    Scope: configuring values and Block instances in BML through curly-brace ValueType
    configuration, grounded in org.blockml.bml.documentation.ValueTypeConfiguration. Body content
    is authored in a03 from that source.
  </documentation>
  <references>
    <see type="doc:ValueTypeConfiguration" relation="Requires">
      Primary content source — named and positional configuration syntax and its rules.
    </see>
    <see type="mapping:FunctionMapping" relation="SeeAlso">
      Shared declaration-order rule for positional configuration.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Value Configuration</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Configuring a property's type instance">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>Curly-brace syntax lets a property configure the specific instance of
its own type, such as a maximum text length or a decimal's precision and
scale, without changing the type's own definition. This configuration always
belongs to the property's owned type instance — never to the ValueType
definition block itself.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. vs generic binding-->
        <dpage:Section heading="Distinct from generic binding">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>Curly-brace configuration is independent of the parentheses used to
bind a generic type parameter, and a single type reference may use both
together for different purposes.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Named vs positional-->
        <dpage:Section heading="Named and positional configuration">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>A configuration block can name each setting explicitly, or supply the
same settings positionally in the order the type declares them, but a single
block must pick one style rather than mixing the two. Positional configuration
follows the same declaration-order principle used for positional arguments in
a function-like call elsewhere in BlockML.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="A minimal configuration example">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>A configured type reference pairs the type's name with a short
curly-brace block that sets one or more of that type's own configuration
settings.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<properties>
  <displayName type="type:Text{maxLength: 100}">
    <documentation>The item's display name, limited to 100 characters.</documentation>
  </displayName>
</properties>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>In the example, the configuration setting belongs to that one
property's type instance and would need to be repeated on any other property
that reuses the same type.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. Ordering and recap-->
        <dpage:Section heading="Where configuration fits among type syntax">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>Curly-brace configuration is written on the type reference before any
multiplicity brackets that follow it, so the configuration applies first and
the collection shape is layered on afterward.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
            <dpage:List>
              <items>
                <dpage:ListItem text="Configuration always belongs to the property's own type instance." />
                <dpage:ListItem text="Configuration and generic binding serve different purposes and can be combined." />
                <dpage:ListItem text="A configuration block is either fully named or fully positional, never both." />
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with composition">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Composition" summary="Learn how aggregations are filled through composition.">
                  <target>docs:Composition</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:ValueConfiguration>
