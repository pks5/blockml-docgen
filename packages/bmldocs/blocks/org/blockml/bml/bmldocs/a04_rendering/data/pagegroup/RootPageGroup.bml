<!--BlockML Documentation — top-level root page group

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.pagegroup.RootPageGroup-->
<a04pgroup:RootPageGroup xmlns="http://blockml.org/bml"
  xmlns:a04pgroup="org.blockml.bml.bmldocs.a04_rendering.data.pagegroup"
  xmlns:dcore="org.blockml.bml.docgen.core">

  <baseType>
    dcore:PageGroup
  </baseType>
  <is>
    The top-level container for all A04 page groups
  </is>
  <documentation>
    Outermost A04 page group, from BmlDocSetPlan.rootPageGroupPlan (RootPageGroup). Has no
    direct pages and no parentGroup. DocsPageGroup nests under this group via parentGroup.
  </documentation>
  <references>
    <see type="dcore:PageGroup" relation="Extends">
      Docgen page group base.
    </see>
    <see type="a04pgroup:DocsPageGroup" relation="Requires">
      Documentation subtree nested under this root.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Root</value>
    </title>
  </properties>
</a04pgroup:RootPageGroup>
