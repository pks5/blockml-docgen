<!--BlockML Documentation — a guide to XML namespace usage in BML

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.BmlNamespaces-->
<docs:BmlNamespaces xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to XML namespace usage in BML
  </is>
  <documentation>
    Scope: XML namespace usage in BML, xmlns declarations and prefixes, and the bml package
    placement rule, grounded in org.blockml.bml.documentation.BmlNamespace. Body content is
    rendered in a04 from that source.
  </documentation>
  <references>
    <see type="doc:BmlNamespace" relation="Requires">
      Primary content source — mandatory domain.bml namespace and xmlns prefix conventions.
    </see>
    <see type="doc:LibrarySystem" relation="SeeAlso">
      Libraries, packages, and namespace membership.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>BML Namespaces</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Prefixes that resolve to packages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="An xmlns declaration binds a short authoring prefix to a full package — the mechanism behind every qualified reference this handbook's examples have used, from core:Block onward." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. The bml-namespace placement rule-->
        <dpage:Section heading="Every definition lives under a bml package">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Every BML definition must reside below its owning domain's bml package, in the general form domain.bml.* — the same rule this handbook's Namespaces and FQNs page introduced, now tied directly to the xmlns prefixes that address it." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Bare prefix versus domain-mirrored prefix-->
        <dpage:Section heading="A bare prefix means BlockML core">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A bare short prefix such as core or type conventionally names BlockML itself, while a domain mirroring the same segment adds its own token in front — mb for MachineBlocks core, for example — so authors never steal a framework alias for domain use." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="Declaring a prefix for a new package">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A new Block document declares an xmlns prefix for its own domain package, placed under that domain's bml namespace, alongside a core prefix for anything it extends from BlockML itself." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- "acme" names this document's own domain package; "core" names BlockML core -->
<acme:Widget xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    core:Block
  </baseType>
</acme:Widget>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="acme resolves to com.acme.example, the domain package this document's own definitions live under, while core resolves to org.blockml.bml.core and is used only for baseType. Both prefixes in the example are pure authoring convenience over the two package FQNs they name — exactly the mechanism this handbook's examples have relied on from the very first page." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What this handbook has covered-->
        <dpage:Section heading="What this handbook has covered">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Readers can now declare an xmlns prefix and place a new definition under the correct package — the last piece of a path that began with BlockML's basic purpose and moved through Blocks, the type system, the member model, and behaviour and values, to this handbook's own authoring format." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Back to the handbook contents">
          <content>
            <dpage:Navigation>
              <title>Back to contents</title>
              <items>
                <dpage:NavigationItem label="Documentation" summary="Return to the handbook's full table of contents.">
                  <target>docs:TableOfContents</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:BmlNamespaces>
