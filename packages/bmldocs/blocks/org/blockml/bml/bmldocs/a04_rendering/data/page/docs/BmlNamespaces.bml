<!--BlockML Documentation — a guide to XML namespace usage in BML

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.BmlNamespaces-->
<docs:BmlNamespaces xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to XML namespace usage in BML
  </is>
  <documentation>
    Scope: XML namespace usage in BML, xmlns declarations and prefixes, and the bml package
    placement rule, grounded in org.blockml.bml.documentation.BmlNamespace. Body content is
    authored in a04 from that source.
  </documentation>
  <references>
    <see type="doc:BmlNamespace" relation="Requires">
      Primary content source — mandatory domain.bml namespace and xmlns prefix conventions.
    </see>
    <see type="doc:LibrarySystem" relation="SeeAlso">
      Libraries, packages, and namespace membership.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>BML Namespaces</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="xmlns prefixes address packages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="An xmlns prefix is BML-semantic only when it targets a Package, for type addressing, or an Annotation, for directives — other URI bindings carry no BML meaning." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Declaring a prefix">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A prefix declaration such as xmlns:core=&quot;org.blockml.bml.core&quot; binds a short prefix to a package, so the prefix can qualify type names throughout the document." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="The bml-namespace placement rule">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Every BML definition — Blocks, Libraries, Types, and every other BlockML definition — must reside under its owning domain's bml package; no definition may exist outside that namespace." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="A naming convention for prefixes">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A bare short prefix such as core or type conventionally refers to BlockML's own packages, while a domain mirror adds a domain token in front, such as mb for MachineBlocks." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry forward">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Readers should now be able to declare an xmlns prefix and place a new definition under the correct package." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Return to the documentation menu">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Documentation" summary="Return to the handbook's table of contents.">
                  <target>docs:TableOfContents</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:BmlNamespaces>
