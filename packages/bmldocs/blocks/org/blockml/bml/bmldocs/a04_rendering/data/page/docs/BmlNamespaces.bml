<!--BlockML Documentation — a guide to XML namespace usage in BML

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.BmlNamespaces-->
<docs:BmlNamespaces xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to XML namespace usage in BML
  </is>
  <documentation>
    Scope: XML namespace usage in BML, xmlns declarations and prefixes, and the bml package
    placement rule, grounded in org.blockml.bml.documentation.BmlNamespace. Body content is
    authored in a03 from that source.
  </documentation>
  <references>
    <see type="doc:BmlNamespace" relation="Requires">
      Primary content source — mandatory domain.bml namespace and xmlns prefix conventions.
    </see>
    <see type="doc:LibrarySystem" relation="SeeAlso">
      Libraries, packages, and namespace membership.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>BML Namespaces</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="What an xmlns declaration does">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>An xmlns declaration on a BML root element binds a short prefix to a package
identifier, so type references throughout that document can use the prefix
instead of repeating the full package name. A prefix is BML-semantic only
when it targets a Package or an Annotation.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="The bare-prefix convention">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>By convention a bare short prefix such as core or type always names a
BlockML core package; a domain mirroring the same segment adds its own token
in front, such as mb for MachineBlocks, instead of reusing the bare prefix.
Reusing a bare BlockML prefix for a domain's own package is a naming
collision to avoid, not a shortcut.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Every definition lives under a bml package">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>Every BML definition must reside beneath its owning domain's bml package, so a
new Block, Type, or other definition always has one correct place to belong.
No BML definition may exist outside its domain's bml namespace.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Source layout mirrors the namespace">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>A definition's file path mirrors its fully qualified package, so placing a
new definition under the correct package also determines where its source
file lives. Physical source layout mirrors the fully qualified package,
segment by segment.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Recognizing correct placement">
          <content>
            <dpage:List>
              <items>
                <dpage:ListItem text="Prefix declared: every package or Annotation used by a qualified tag has a matching xmlns declaration." />
                <dpage:ListItem text="Convention followed: a bare prefix names a BlockML core package; a domain mirror adds that domain's own token." />
                <dpage:ListItem text="Correct package: the new definition's file sits beneath its domain's bml package, matching its fully qualified name." />
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <dpage:Section heading="Back to the menu">
          <content>
            <dpage:Navigation>
              <title>Back to the menu</title>
              <items>
                <dpage:NavigationItem label="Documentation" summary="Return to the handbook menu.">
                  <target>docs:TableOfContents</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:BmlNamespaces>
