<!--BlockML Documentation — a guide to composite named-field ValueTypes

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.StructTypes-->
<docs:StructTypes xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to composite named-field ValueTypes
  </is>
  <documentation>
    Scope: composite named-field ValueTypes, struct fields, and configuration and use, grounded
    in org.blockml.bml.type.StructType, org.blockml.bml.type.EmptyStruct, and the StructType
    section of org.blockml.bml.documentation.TypeSystemOverview. Body content is authored in a04
    from those sources.
  </documentation>
  <references>
    <see type="type:StructType" relation="Requires">
      The composite named-field ValueType branch this page introduces.
    </see>
    <see type="type:EmptyStruct" relation="Requires">
      Named instantiable StructType with no fields — the counterpart of an empty anonymous struct.
    </see>
    <see type="doc:TypeSystemOverview" relation="Requires">
      Primary content source — StructType examples and branch role in the type system.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Struct Types</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Shape described by ordinary properties">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="StructType is the abstract branch for composite value objects — its declared properties define the value's data layout, with no special struct syntax beyond ordinary Property declarations." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Named field access and order-->
        <dpage:Section heading="Named access and significant field order">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A struct field is read exclusively by name, such as size.x — numeric index access on a StructType is not valid, because a StructType is a typed object with named properties only." />
              </content>
            </dpage:Paragraph>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Field declaration order remains significant for capability call mapping and for compatibility across versions — existing field order must not change, and new fields may only be appended at the end." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. EmptyStruct-->
        <dpage:Section heading="EmptyStruct — the named counterpart of {}">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="type:EmptyStruct is a named, reusable StructType with no fields — usable anywhere a StructType is required and no fields are needed, and it is not itself abstract." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="Declaring and configuring a struct value">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A StructType Block declares its fields as ordinary properties, and a Property of that type is later configured with a matching named object literal." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- Point declares x and y as ordinary properties, in that order -->
<acme:Point xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    type:StructType
  </baseType>
  <is>
    A two-dimensional point
  </is>
  <documentation>
    A point with x and y coordinates.
  </documentation>
  <properties>
    <x type="type:Integer" />
    <y type="type:Integer" />
  </properties>
</acme:Point>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Point declares x then y, in that order; a Property typed acme:Point would supply both fields at once with a matching named object literal such as { x: 4, y: 2 }, reading each field by name regardless of order, even though that same x-then-y order is what a positional configuration would rely on." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should be able to define a StructType and configure a struct value, before contrasting it with the closed-set EnumType branch next." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with enum types">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Enum Types" summary="Learn closed sets of named values.">
                  <target>docs:EnumTypes</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:StructTypes>
