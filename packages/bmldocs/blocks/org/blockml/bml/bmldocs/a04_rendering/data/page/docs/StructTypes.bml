<!--BlockML Documentation — a guide to composite named-field ValueTypes

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.StructTypes-->
<docs:StructTypes xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to composite named-field ValueTypes
  </is>
  <documentation>
    Scope: composite named-field ValueTypes, struct fields, and configuration and use, grounded
    in org.blockml.bml.type.StructType, org.blockml.bml.type.EmptyStruct, and the StructType
    section of org.blockml.bml.documentation.TypeSystemOverview. Body content is authored in a04
    from those sources.
  </documentation>
  <references>
    <see type="type:StructType" relation="Requires">
      The composite named-field ValueType branch this page introduces.
    </see>
    <see type="type:EmptyStruct" relation="Requires">
      Named instantiable StructType with no fields — the counterpart of an empty anonymous struct.
    </see>
    <see type="doc:TypeSystemOverview" relation="Requires">
      Primary content source — StructType examples and branch role in the type system.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Struct Types</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="Composite named-field values">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="StructType is the abstract ValueType branch for composite value objects — complex values described by ordinary Properties." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Declaring a StructType">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A concrete StructType declares properties whose members become struct fields, with no special struct syntax; field declaration order remains significant." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="EmptyStruct">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="EmptyStruct is an instantiable StructType with no fields — the named, reusable counterpart of an anonymous empty struct." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="A sibling, not a supertype">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="StructType is a sibling branch of EnumType under ValueType, not a supertype of it." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Readers should now be able to define a StructType and configure a struct value." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with enum types">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Enum Types" summary="Learn the closed-set-of-named-values ValueType kind.">
                  <target>docs:EnumTypes</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:StructTypes>
