<!--BlockML Documentation — a guide to composite named-field ValueTypes

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.StructTypes-->
<docs:StructTypes xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to composite named-field ValueTypes
  </is>
  <documentation>
    Scope: composite named-field ValueTypes, struct fields, and configuration and use, grounded
    in org.blockml.bml.type.StructType, org.blockml.bml.type.EmptyStruct, and the StructType
    section of org.blockml.bml.documentation.TypeSystemOverview. Body content is authored in a03
    from those sources.
  </documentation>
  <references>
    <see type="type:StructType" relation="Requires">
      The composite named-field ValueType branch this page introduces.
    </see>
    <see type="type:EmptyStruct" relation="Requires">
      Named instantiable StructType with no fields — the counterpart of an empty anonymous struct.
    </see>
    <see type="doc:TypeSystemOverview" relation="Requires">
      Primary content source — StructType examples and branch role in the type system.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Struct Types</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="What a StructType is">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>A StructType names a composite value made of named fields, each an
ordinary Property, so a single Property can carry a structured object instead
of one scalar. StructType is a sibling branch of EnumType under ValueType, not
a supertype of it.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Declaring a StructType's fields">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>A concrete StructType declares its fields as ordinary Properties — there
is no special struct syntax; each Property becomes one named field of the
struct. Field declaration order stays significant once declared, so new
fields are only ever added at the end.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Configuring a struct value">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>A struct value is always a named-field map — its fields are always
accessed and configured by name, never by position. An array of values is
never treated as a struct value by declaration order alone.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<property name="size" type="Size3d">
  <value>
    <Size3d x="4" y="2" z="3" />
  </value>
</property>]]></code>
            </dpage:CodeBlock>
          </content>
        </dpage:Section>
        <dpage:Section heading="EmptyStruct: a struct with no fields">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>EmptyStruct is the named, instantiable StructType with no fields at all,
so its only compatible value is an empty struct. It is a concrete,
ready-to-use StructType wherever a StructType is required and no fields are
needed.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with Enum Types">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Enum Types" summary="Learn the closed named-value kind, the next sibling under ValueType.">
                  <target>docs:EnumTypes</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:StructTypes>
