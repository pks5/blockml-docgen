<!--BlockML Documentation — a guide to composite named-field ValueTypes

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.StructTypes-->
<docs:StructTypes xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to composite named-field ValueTypes
  </is>
  <documentation>
    Scope: composite named-field ValueTypes, struct fields, and configuration and use, grounded
    in org.blockml.bml.type.StructType, org.blockml.bml.type.EmptyStruct, and the StructType
    section of org.blockml.bml.documentation.TypeSystemOverview. Body content is authored in a04
    from those sources.
  </documentation>
  <references>
    <see type="type:StructType" relation="Requires">
      The composite named-field ValueType branch this page introduces.
    </see>
    <see type="type:EmptyStruct" relation="Requires">
      Named instantiable StructType with no fields — the counterpart of an empty anonymous struct.
    </see>
    <see type="doc:TypeSystemOverview" relation="Requires">
      Primary content source — StructType examples and branch role in the type system.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Struct Types</value>
    </title>
    <purpose override="true">
      <value>Teach StructType as the composite named-field branch of the type system, so readers can define a StructType and configure a struct value.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <workflow:AuthorativeSourceSet>
          <includedTypes>
            <type:TypeSelectorEntity value="org.blockml.bml.type.StructType" />
            <type:TypeSelectorEntity value="org.blockml.bml.type.EmptyStruct" />
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.TypeSystemOverview" />
          </includedTypes>
        </workflow:AuthorativeSourceSet>
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>Teach StructType as the composite named-field branch of the type system.</summary>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>The reader can define a StructType and configure a struct value.</summary>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>Composite named-field ValueTypes, declaring struct fields, and configuring a struct value.</summary>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>EnumType or ConstantType depth.</summary>
          <reason>Those are separate sibling branches with their own pages.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <supportingPoints override="true">
      <composition>
        <sem:SupportingPoint>
          <summary>StructType is a sibling branch of EnumType under ValueType, not a supertype of it.</summary>
        </sem:SupportingPoint>
      </composition>
    </supportingPoints>
    <content override="true">
      <composition>
        <dpage:Section heading="Composite named-field values" purpose="State what a StructType is">
          <content>
            <dpage:Paragraph purpose="Introduce StructType">
              <role>org.blockml.bml.docgen.role.Lead</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>StructType is the abstract ValueType branch for composite value objects — complex values described by ordinary Properties.</message>
              <authoritativeSources>
                <workflow:AuthorativeSourceSet>
                  <includedTypes>
                    <type:TypeSelectorEntity value="org.blockml.bml.type.StructType" />
                  </includedTypes>
                </workflow:AuthorativeSourceSet>
              </authoritativeSources>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Declaring a StructType" purpose="Explain how a concrete StructType is declared">
          <content>
            <dpage:Paragraph purpose="Explain that struct fields are ordinary properties">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A concrete StructType declares properties whose members become struct fields, with no special struct syntax; field declaration order remains significant.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="EmptyStruct" purpose="Introduce the named counterpart of an empty struct">
          <content>
            <dpage:Paragraph purpose="Introduce EmptyStruct">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>EmptyStruct is an instantiable StructType with no fields — the named, reusable counterpart of an anonymous empty struct.</message>
              <authoritativeSources>
                <workflow:AuthorativeSourceSet>
                  <includedTypes>
                    <type:TypeSelectorEntity value="org.blockml.bml.type.EmptyStruct" />
                  </includedTypes>
                </workflow:AuthorativeSourceSet>
              </authoritativeSources>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="A sibling, not a supertype" purpose="Prevent confusing StructType with a supertype of EnumType">
          <content>
            <dpage:Paragraph purpose="State the sibling relationship with EnumType">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>StructType is a sibling branch of EnumType under ValueType, not a supertype of it.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages" purpose="Anchor the reader outcome before enum types are introduced">
          <content>
            <dpage:Paragraph purpose="State the retained outcome">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Readers should now be able to define a StructType and configure a struct value.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with enum types" purpose="Direct the reader to the next kind">
          <content>
            <dpage:Navigation purpose="Continue into the Type System section">
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Enum Types" summary="Learn the closed-set-of-named-values ValueType kind.">
                  <target>docs:EnumTypes</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:StructTypes>
