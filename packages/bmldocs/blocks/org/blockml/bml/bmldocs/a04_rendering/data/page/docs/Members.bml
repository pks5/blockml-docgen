<!--BlockML Documentation — a guide to the Block member model

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Members-->
<docs:Members xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to the Block member model
  </is>
  <documentation>
    Scope: Block member model overview and how Properties, Aggregations, Associations, and
    Capabilities relate, grounded in org.blockml.bml.definition.MemberDefinition and
    org.blockml.bml.documentation.DefinitionModel. Body content is authored in a04 from those
    sources.
  </documentation>
  <references>
    <see type="def:MemberDefinition" relation="Requires">
      Abstract base for all four declared member kinds.
    </see>
    <see type="doc:DefinitionModel" relation="Requires">
      Primary content source — Definition branch hierarchy including all member kinds.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Members</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Overview</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Guide</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="Four kinds of members">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Block declares its members as one of four kinds: Properties, Aggregations, Associations, and Capabilities." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What each kind is for">
          <content>
            <dpage:List>
              <items>
                <dpage:ListItem text="Property — a Block member that carries a scalar or structured value." />
                <dpage:ListItem text="Aggregation — a Block member that owns a collection of child Block instances." />
                <dpage:ListItem text="Association — a Block member that links to other instances without owning them." />
                <dpage:ListItem text="Capability — a Block member that declares how the Block communicates or behaves." />
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <dpage:Section heading="One shared authoring pattern">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="All four member kinds share the same declaration pattern: each is authored as a named child element inside its matching member container on a Block definition." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="With the four kinds in view, you should now be able to name each one — Property, Aggregation, Association, and Capability — and pick the right one for a given need." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with Properties">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Properties" summary="Learn how a typed value member is declared.">
                  <target>docs:Properties</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Members>
