<!--BlockML Documentation — a guide to the Block member model

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Members-->
<docs:Members xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to the Block member model
  </is>
  <documentation>
    Scope: Block member model overview and how Properties, Aggregations, Associations, and
    Capabilities relate, grounded in org.blockml.bml.definition.MemberDefinition and
    org.blockml.bml.documentation.DefinitionModel. Body content is rendered in a04 from those
    sources.
  </documentation>
  <references>
    <see type="def:MemberDefinition" relation="Requires">
      Abstract base for all four declared member kinds.
    </see>
    <see type="doc:DefinitionModel" relation="Requires">
      Primary content source — Definition branch hierarchy including all member kinds.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Members</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Overview</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Guide</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Four kinds of declared members">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Block declares its members as Properties, Aggregations, Associations, and Capabilities — four kinds that together describe everything a Block holds and does." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. The four kinds-->
        <dpage:Section heading="The four kinds at a glance">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Every member a Block declares classifies into exactly one of these four kinds:" />
              </content>
            </dpage:Paragraph>
            <dpage:List>
              <items>
                <dpage:ListItem text="Property">
                  <content>
                    <dpage:Paragraph>
                      <content>
                        <dpage:Text text="A scalar or structured value member." />
                      </content>
                    </dpage:Paragraph>
                  </content>
                </dpage:ListItem>
                <dpage:ListItem text="Aggregation">
                  <content>
                    <dpage:Paragraph>
                      <content>
                        <dpage:Text text="An owned collection filled by composition." />
                      </content>
                    </dpage:Paragraph>
                  </content>
                </dpage:ListItem>
                <dpage:ListItem text="Association">
                  <content>
                    <dpage:Paragraph>
                      <content>
                        <dpage:Text text="A non-owning instance-to-instance link." />
                      </content>
                    </dpage:Paragraph>
                  </content>
                </dpage:ListItem>
                <dpage:ListItem text="Capability">
                  <content>
                    <dpage:Paragraph>
                      <content>
                        <dpage:Text text="Behaviour, with an optional language-tagged implementation body." />
                      </content>
                    </dpage:Paragraph>
                  </content>
                </dpage:ListItem>
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <!--3. Shared authoring pattern-->
        <dpage:Section heading="One shared declaration pattern">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="All four member kinds extend the same MemberDefinition base, so abstract, final, override, and visibility work identically regardless of which kind is being declared." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="One Block, three member kinds">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A single Block can declare several member kinds side by side, each inside its own member container." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- One Property, one Aggregation, and one Capability, each in its own container -->
<acme:Widget xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type"
  xmlns:lang="org.blockml.bml.language">

  <baseType>
    core:Block
  </baseType>
  <properties>
    <count type="type:Integer" />
  </properties>
  <aggregations>
    <keywords type="type:TextEntity">
      <documentation>Search keywords for this Widget.</documentation>
    </keywords>
  </aggregations>
  <capabilities>
    <describe type="type:Text">
      <implementation language="lang:PseudoCode">
        return "Widget #" + #this.count
      </implementation>
    </describe>
  </capabilities>
</acme:Widget>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="count sits inside properties, keywords sits inside aggregations, and describe sits inside capabilities — each container in the example names its kind directly, so classifying any member here is just reading which container it sits in." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should be able to name the four member kinds and pick the right one for a given need, before Properties get their own page next." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with properties">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Properties" summary="Learn typed value members.">
                  <target>docs:Properties</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Members>
