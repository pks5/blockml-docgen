<!--BlockML Documentation — a guide to the Block member model

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Members-->
<docs:Members xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to the Block member model
  </is>
  <documentation>
    Scope: Block member model overview and how Properties, Aggregations, Associations, and
    Capabilities relate, grounded in org.blockml.bml.definition.MemberDefinition and
    org.blockml.bml.documentation.DefinitionModel. Body content is authored in a04 from those
    sources.
  </documentation>
  <references>
    <see type="def:MemberDefinition" relation="Requires">
      Abstract base for all four declared member kinds.
    </see>
    <see type="doc:DefinitionModel" relation="Requires">
      Primary content source — Definition branch hierarchy including all member kinds.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Members</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Overview</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Guide</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Four kinds of declared members">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Block declares its own members as one of four kinds — Property, Aggregation, Association, or Capability — and together these four kinds describe everything a Block holds and does." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. The four kinds-->
        <dpage:Section heading="The four kinds at a glance">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Every member a Block declares classifies into exactly one of these four kinds, and the list below is the map to keep in mind while each kind gets its own page next." />
              </content>
            </dpage:Paragraph>
            <dpage:List>
              <items>
                <dpage:ListItem text="Property — a scalar or structured value member." />
                <dpage:ListItem text="Aggregation — an owned collection filled by composition." />
                <dpage:ListItem text="Association — a non-owning instance-to-instance link." />
                <dpage:ListItem text="Capability — behaviour, with an optional language-tagged implementation body." />
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <!--3. Shared authoring pattern-->
        <dpage:Section heading="One shared declaration pattern">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="All four member kinds extend the same abstract MemberDefinition base, so declaration properties such as abstract, final, override, and visibility work identically no matter which kind is being declared." />
                <dpage:Text text="abstract marks a declaration as incomplete and creates an implementation obligation for descendants, final seals it against redeclaration, override confirms a deliberate redefinition of an inherited member, and visibility is read from the member's own name unless stated otherwise." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="One Block, three member kinds">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A single Block can declare several member kinds side by side, each inside its own member container — the following example declares one property, one aggregation, and one capability." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- Three sibling member containers: properties, aggregations, and capabilities -->
<acme:AssemblyStation xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Block
  </baseType>
  <properties>
    <label type="type:Text">
      <value>Assembly Station 1</value>
    </label>
  </properties>
  <aggregations>
    <tools type="acme:Tool[]">
      <composition>
        <acme:Tool bml:id="wrench" />
      </composition>
    </tools>
  </aggregations>
  <capabilities>
    <activate type="org.blockml.bml.capability.Action" />
  </capabilities>
</acme:AssemblyStation>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Each container in the example names its kind directly — label sits inside properties, tools inside aggregations, and activate inside capabilities — so classifying any member here is just reading which container it sits in." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should be able to name the four member kinds and pick the right one for a given need, before Properties introduces the first of them in depth." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with properties">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Properties" summary="Learn typed value members.">
                  <target>docs:Properties</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Members>
