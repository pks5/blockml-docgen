<!--BlockML Documentation — a guide to contracts as composable member fragments

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Contracts-->
<docs:Contracts xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to contracts as composable member fragments
  </is>
  <documentation>
    Scope: contracts as composable, reusable partial definitions, contracts versus inheritance,
    and root-level declaration, grounded in org.blockml.bml.documentation.ContractsModel. Body
    content is authored in a03 from that source.
  </documentation>
  <references>
    <see type="doc:ContractsModel" relation="Requires">
      Primary content source — contract merge order, partial members, and satisfiesTypeBound.
    </see>
    <see type="doc:ModelingGuidelines" relation="SeeAlso">
      When to prefer baseType versus contracts.
    </see>
    <see type="doc:PartialMemberOverrides" relation="SeeAlso">
      Shared override rule for completing partial contract members.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Contracts</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="A contract shares behavior across unrelated Blocks">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>A contract is a reusable, composable fragment of a Block definition.
Several unrelated Blocks can pull in the same contract to share behavior, without
needing to sit on the same inheritance line.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What a contract provides">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>A contract declares a fragment of a Block definition — a handful of
members and their default behavior — that a concrete Block pulls in alongside
whatever it already inherits from its baseType. Declared once, a contract can be
reused by any Block that needs that same fragment, instead of duplicating the
members on each one individually.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Contracts versus baseType">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>Where baseType links Blocks that already share a common ancestor, a
contract lets Blocks with no such ancestor still share a member fragment. A
single Block may draw on more than one contract at once, composing fragments
from several sources rather than being limited to one inherited lineage.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Completing a partial contract member">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>When a contract leaves a member only partially declared, the concrete
Block that pulls in the contract completes it the same way it would complete a
member inherited from its baseType. This keeps one consistent rule for finishing
an incomplete member, whether that member came from a baseType or from a
contract.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Choosing between baseType and a contract">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>Reach for baseType when the Blocks involved already form one natural
family, sharing an ancestor and everything that comes with it. Reach for a
contract instead when the shared fragment cuts across Blocks that otherwise
have nothing else in common.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with namespaces and fully qualified names">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Namespaces and Fully Qualified Names" summary="Learn how packages, Libraries, and fully qualified names relate.">
                  <target>docs:NamespacesAndFullyQualifiedNames</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Contracts>
