<!--BlockML Documentation — a guide to contracts as composable member fragments

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Contracts-->
<docs:Contracts xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to contracts as composable member fragments
  </is>
  <documentation>
    Scope: contracts as composable, reusable partial definitions, contracts versus inheritance,
    and root-level declaration, grounded in org.blockml.bml.documentation.ContractsModel. Body
    content is authored in a04 from that source.
  </documentation>
  <references>
    <see type="doc:ContractsModel" relation="Requires">
      Primary content source — contract merge order, partial members, and satisfiesTypeBound.
    </see>
    <see type="doc:ModelingGuidelines" relation="SeeAlso">
      When to prefer baseType versus contracts.
    </see>
    <see type="doc:PartialMemberOverrides" relation="SeeAlso">
      Shared override rule for completing partial contract members.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Contracts</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="Reusable partial definitions">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Block may declare contracts at root level to compose one or more contract Blocks — reusable partial definitions whose member fragments merge into the effective Block definition. Contracts are declared only on the document root, not on nested Sub-Blocks, and each child element is a direct reference to the contract Block being composed." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="baseType versus contracts">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="baseType provides framework taxonomy and branch detection through single inheritance, and is the right tool when Blocks share a common ancestor. Contracts instead provide domain cross-cutting member mixins for Blocks that need to share a member fragment without sharing a common baseType ancestor." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Merge order">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Effective Block members merge in a fixed order: the baseType chain is applied first, then contracts in the order they are declared, then the Block's own local declarations. Where two layers declare the same member, the later layer wins — a later contract overrides an earlier one, and the Block's own declarations override every contract." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Partial members on a contract">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A contract may declare a member only partially, leaving it for the concrete Block to complete. The Block completes such a member with an explicit override, following the same rule used to refine an inherited baseType member." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="With this distinction in place, readers can choose baseType or a contract whenever they need to reuse behaviour across otherwise unrelated Blocks." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with namespaces">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Namespaces and Fully Qualified Names" summary="Learn how packages, Libraries, and FQNs relate.">
                  <target>docs:NamespacesAndFullyQualifiedNames</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Contracts>
