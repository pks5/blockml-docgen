<!--BlockML Documentation — a guide to contracts as composable member fragments

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Contracts-->
<docs:Contracts xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to contracts as composable member fragments
  </is>
  <documentation>
    Scope: contracts as composable, reusable partial definitions, contracts versus inheritance,
    and root-level declaration, grounded in org.blockml.bml.documentation.ContractsModel. Body
    content is rendered in a04 from that source.
  </documentation>
  <references>
    <see type="doc:ContractsModel" relation="Requires">
      Primary content source — contract merge order, partial members, and satisfiesTypeBound.
    </see>
    <see type="doc:ModelingGuidelines" relation="SeeAlso">
      When to prefer baseType versus contracts.
    </see>
    <see type="doc:PartialMemberOverrides" relation="SeeAlso">
      Shared override rule for completing partial contract members.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Contracts</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Reusable member fragments">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Block may declare contracts at root level to compose one or more contract Blocks — reusable partial definitions whose member fragments merge into the Block's effective definition alongside its baseType chain." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Contracts versus baseType-->
        <dpage:Section heading="Contracts versus baseType">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="baseType establishes framework taxonomy and branch membership through single inheritance, while contracts mix in member fragments across Blocks that share no common baseType ancestor. Contracts are declared only on the document root, never on nested Sub-Blocks." />
              </content>
            </dpage:Paragraph>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="The effective definition merges the baseType chain first, then contracts in declaration order, then local Block declarations — later contracts override earlier ones, and the Block itself overrides every contract." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Completing a partial contract member-->
        <dpage:Section heading="Completing a partial contract member">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A contract may declare an incomplete member — for example an identifier property without a type — and the concrete Block completes it with override=&quot;true&quot;, the same rule used to refine an inherited baseType member." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="Mixing in a contract">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Block can declare both a baseType and a contracts list, mixing in a member fragment that its baseType chain does not otherwise provide." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- A contract: an abstract Block with one partial, untyped member -->
<acme:Identifiable xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    core:Block
  </baseType>
  <abstract>
    true
  </abstract>
  <properties>
    <sku />
  </properties>
</acme:Identifiable>

<!-- Basket mixes in the contract and completes "sku" with a concrete type -->
<acme:Basket xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Block
  </baseType>
  <contracts>
    <acme:Identifiable />
  </contracts>
  <properties>
    <sku override="true" type="type:Text" />
  </properties>
</acme:Basket>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Basket's contracts list names Identifiable as a direct Block reference, and its properties complete sku with override=&quot;true&quot; and a concrete type, exactly as PartialMemberOverrides requires. That entry contributes its member fragment to Basket's effective definition after the baseType chain — Basket gains the sku fragment without needing a common ancestor with Identifiable." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should be able to choose baseType or a contract when they need to reuse a member fragment, before moving on to how Blocks are named and located." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with namespaces and FQNs">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Namespaces and Fully Qualified Names" summary="Learn how packages, Libraries, and FQNs relate.">
                  <target>docs:NamespacesAndFullyQualifiedNames</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Contracts>
