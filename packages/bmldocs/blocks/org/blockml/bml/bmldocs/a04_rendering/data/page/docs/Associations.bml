<!--BlockML Documentation — a guide to non-owning instance links

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Associations-->
<docs:Associations xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition"
  xmlns:type="org.blockml.bml.type"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to non-owning instance links
  </is>
  <documentation>
    Scope: non-owning instance-to-instance links, associations versus aggregation, and
    associations versus documentation references, grounded in
    org.blockml.bml.definition.AssociationDefinition, org.blockml.bml.type.InstanceReference, and
    the AssociationDefinition role in org.blockml.bml.documentation.DefinitionModel. Body content
    is rendered in a04 from those sources.
  </documentation>
  <references>
    <see type="def:AssociationDefinition" relation="Requires">
      The non-owning instance-to-instance link member this page introduces.
    </see>
    <see type="type:InstanceReference" relation="Requires">
      The required Association member type — a pointer, not an owned instance.
    </see>
    <see type="doc:DefinitionModel" relation="Requires">
      Primary content source — Associations as model links distinct from documentation References.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Associations</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="A non-owning link between instances">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="An Association connects concrete Block instances to one another without any lifecycle ownership — a non-owning model link, distinct from the ownership an Aggregation carries." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. InstanceReference is required-->
        <dpage:Section heading="Association type must be InstanceReference">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="An Association's type must be InstanceReference(T) or InstanceReference(T)[] with T extending core:Block — a bare Block FQN such as core:Block is invalid there, unlike on an Aggregation." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Associations versus documentation references-->
        <dpage:Section heading="Associations versus documentation references">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Associations form the instance graph between concrete Block instances; documentation References connect types to types or types to instances for narrative purposes only and never form that instance graph themselves." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="Linking one instance to another">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="An Association declaration wraps its target Block in InstanceReference, and an instance sets it to the id of an existing composition child." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- Definition: "primaryItem" is an Association typed InstanceReference(acme:Widget) -->
<acme:Basket xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Block
  </baseType>
  <associations>
    <primaryItem type="type:InstanceReference(acme:Widget)" />
  </associations>
</acme:Basket>

<!-- Instance: primaryItem points at the bml:id of an existing composition child -->
<acme:Basket bml:id="myBasket" primaryItem="firstWidget">
  <items>
    <acme:Widget bml:id="firstWidget" />
  </items>
</acme:Basket>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="myBasket's primaryItem does not create firstWidget — it merely points at the id of the Widget already owned by items. firstWidget continues to exist independently of primaryItem, unlike the ownership items itself carries; if items were ever emptied, primaryItem would simply be left pointing at nothing." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should be able to add a non-owning link without confusing it with aggregation ownership, before Capabilities introduce behaviour as the fourth member kind." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with capabilities">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Capabilities" summary="Learn Block behaviour expressed as members.">
                  <target>docs:Capabilities</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Associations>
