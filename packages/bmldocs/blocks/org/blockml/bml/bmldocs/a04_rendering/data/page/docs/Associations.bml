<!--BlockML Documentation — a guide to non-owning instance links

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Associations-->
<docs:Associations xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition"
  xmlns:type="org.blockml.bml.type"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to non-owning instance links
  </is>
  <documentation>
    Scope: non-owning instance-to-instance links, associations versus aggregation, and
    associations versus documentation references, grounded in
    org.blockml.bml.definition.AssociationDefinition, org.blockml.bml.type.InstanceReference, and
    the AssociationDefinition role in org.blockml.bml.documentation.DefinitionModel. Body content
    is authored in a04 from those sources.
  </documentation>
  <references>
    <see type="def:AssociationDefinition" relation="Requires">
      The non-owning instance-to-instance link member this page introduces.
    </see>
    <see type="type:InstanceReference" relation="Requires">
      The required Association member type — a pointer, not an owned instance.
    </see>
    <see type="doc:DefinitionModel" relation="Requires">
      Primary content source — Associations as model links distinct from documentation References.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Associations</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="A non-owning link between instances">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="An Association connects concrete Block instances to one another without any lifecycle ownership — a non-owning model link, distinct from the ownership an Aggregation carries." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. InstanceReference is required-->
        <dpage:Section heading="Association type must be InstanceReference">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="An Association's type must be InstanceReference(T) or InstanceReference(T)[] with T extending core:Block — a bare Block FQN such as core:Block, which is valid on an Aggregation, is invalid here." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Associations versus documentation references-->
        <dpage:Section heading="Associations versus documentation references">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Associations form the instance graph between concrete Block instances, while documentation references connect types to types or types to instances purely for narrative purposes and never form that instance graph themselves." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="Linking one instance to another">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="An Association declaration wraps its target Block in InstanceReference; an instance of the declaring Block then sets it to the id of an existing composition child." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- pairedWith is typed InstanceReference(bml:Self), a non-owning pointer to another Tool instance -->
<acme:Tool xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Block
  </baseType>
  <associations>
    <pairedWith type="type:InstanceReference(bml:Self)" />
  </associations>
</acme:Tool>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="An instance of Tool would set pairedWith to the bml:id of another Tool instance already present in the same composition, such as pairedWith=&quot;wrench&quot; — that referenced instance continues to exist independently of this association, unlike an aggregation child that this Block would own outright." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should be able to add a non-owning link without confusing it with aggregation ownership, before Capabilities introduces behaviour as the fourth member kind." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with capabilities">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Capabilities" summary="Learn Block behaviour expressed as members.">
                  <target>docs:Capabilities</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Associations>
