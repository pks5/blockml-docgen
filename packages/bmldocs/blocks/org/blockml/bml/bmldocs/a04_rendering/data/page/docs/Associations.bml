<!--BlockML Documentation — a guide to non-owning instance links

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Associations-->
<docs:Associations xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to non-owning instance links
  </is>
  <documentation>
    Scope: non-owning instance-to-instance links, associations versus aggregation, and
    associations versus documentation references, grounded in
    org.blockml.bml.definition.AssociationDefinition, org.blockml.bml.type.InstanceReference, and
    the AssociationDefinition role in org.blockml.bml.documentation.DefinitionModel. Body content
    is authored in a03 from those sources.
  </documentation>
  <references>
    <see type="def:AssociationDefinition" relation="Requires">
      The non-owning instance-to-instance link member this page introduces.
    </see>
    <see type="type:InstanceReference" relation="Requires">
      The required Association member type — a pointer, not an owned instance.
    </see>
    <see type="doc:DefinitionModel" relation="Requires">
      Primary content source — Associations as model links distinct from documentation References.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Associations</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="What an Association is">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>An Association is a Block member that connects one Block instance to
another without owning it. It is a non-owning link, distinct from a member that holds a value
or a member that owns children.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Declaring an Association typed via InstanceReference">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>An Association's type must be InstanceReference(T) for a single link, or
InstanceReference(T)[] for a collection of links. A bare Block type name is not a valid
Association type.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<associations>
  <related>
    <type>type:InstanceReference(core:Block)</type>
  </related>
</associations>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>In the example, the InstanceReference application names which kind of Block
instance the Association may point to, without granting the Association any ownership over
it.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Association versus Aggregation ownership">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>An Association only points to an instance elsewhere; it never takes on the
ownership that an Aggregation has over the child instances it holds.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Association versus documentation references">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>An Association is a model-level link between concrete instances, while a
documentation reference connects types to types or types to instances for documentation
purposes only.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Adding an Association without confusing it with ownership">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>Reach for Association when a member needs to point to an existing instance
without taking responsibility for its lifecycle.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with Capabilities">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Capabilities" summary="Learn Capability as ordinary behaviour with a language-tagged implementation body.">
                  <target>docs:Capabilities</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Associations>
