<!--BlockML Documentation — a guide to non-owning instance links

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Associations-->
<docs:Associations xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to non-owning instance links
  </is>
  <documentation>
    Scope: non-owning instance-to-instance links, associations versus aggregation, and
    associations versus documentation references, grounded in
    org.blockml.bml.definition.AssociationDefinition, org.blockml.bml.type.InstanceReference, and
    the AssociationDefinition role in org.blockml.bml.documentation.DefinitionModel. Body content
    is authored in a04 from those sources.
  </documentation>
  <references>
    <see type="def:AssociationDefinition" relation="Requires">
      The non-owning instance-to-instance link member this page introduces.
    </see>
    <see type="type:InstanceReference" relation="Requires">
      The required Association member type — a pointer, not an owned instance.
    </see>
    <see type="doc:DefinitionModel" relation="Requires">
      Primary content source — Associations as model links distinct from documentation References.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Associations</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="A non-owning link">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="An Association is a Block member that connects instances to instances — a non-owning model link that carries no lifecycle ownership." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="The required type shape">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="An Association's type must be written as InstanceReference(T) or InstanceReference(T)[]; a bare Block type name is not a valid Association type." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Association versus aggregation">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Unlike an Aggregation, an Association does not own composition children — it only points to instances that already exist elsewhere." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Association versus documentation reference">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Associations form the graph of instances; documentation references are a separate mechanism that connects types to types or types to instances purely for documentation, and are never a substitute for an Association." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="With this, you can add a non-owning Association link without mistaking it for aggregation ownership." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with Capabilities">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Capabilities" summary="Learn how Block behaviour is declared.">
                  <target>docs:Capabilities</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Associations>
