<!--BlockML Documentation — a guide to non-mandatory modeling guidance

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Suggestions-->
<docs:Suggestions xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to non-mandatory modeling guidance
  </is>
  <documentation>
    Scope: non-mandatory modeling guidance for editors and renderers, and suggestions versus
    constraints, grounded in the Suggestions section of
    org.blockml.bml.documentation.ConstraintsModel. Body content is rendered in a04 from that
    source.
  </documentation>
  <references>
    <see type="doc:ConstraintsModel" relation="Requires">
      Primary content source — Suggestions as Property-only, non-validation editor metadata.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Suggestions</value>
    </title>
    <purpose override="true">
      <value>Teach suggestions as non-enforced editor and renderer guidance distinct from constraints, so readers do not mistake a suggestion for a validation rule.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <workflow:AuthorativeSourceSet>
          <includedTypes>
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.ConstraintsModel" />
          </includedTypes>
        </workflow:AuthorativeSourceSet>
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>Teach suggestions as non-enforced guidance, distinct from constraints.</summary>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>The reader knows suggestions are hints for tooling, never validation.</summary>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>Non-mandatory modeling guidance for editors and renderers, and how suggestions differ from constraints.</summary>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>Repeat of constraint mechanics.</summary>
          <reason>Constraint mechanics are covered on the Constraints page.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <supportingPoints override="true">
      <composition>
        <sem:SupportingPoint>
          <summary>A suggested value must still be type-compatible with the property, and suggestions are forbidden on EnumType properties.</summary>
        </sem:SupportingPoint>
      </composition>
    </supportingPoints>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Hints for editors, never validation" purpose="Introduce suggestions as non-enforced guidance">
          <content>
            <dpage:Paragraph purpose="State that suggestions are Property-only, non-enforced editor guidance">
              <role>org.blockml.bml.docgen.role.Lead</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Suggestions are Property-only metadata — Block instances compatible with
the property's type, offered to editors and renderers as guidance, never enforced
as validation.</message>
              <authoritativeSources>
                <workflow:AuthorativeSourceSet>
                  <includedTypes>
                    <type:TypeSelectorEntity value="org.blockml.bml.documentation.ConstraintsModel" />
                  </includedTypes>
                </workflow:AuthorativeSourceSet>
              </authoritativeSources>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Suggestions versus constraints-->
        <dpage:Section heading="Suggestions versus constraints" purpose="Contrast non-enforced guidance with enforced validation">
          <content>
            <dpage:Paragraph purpose="Contrast suggestions as non-enforced with constraints as potentially enforced">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A constraint may fail validation when its validation property is set;
a suggestion never does — authors may enter any value compatible with the
property's type regardless of what the suggestions list offers.</message>
              <authoritativeSources>
                <workflow:AuthorativeSourceSet>
                  <includedTypes>
                    <type:TypeSelectorEntity value="org.blockml.bml.documentation.ConstraintsModel" />
                  </includedTypes>
                </workflow:AuthorativeSourceSet>
              </authoritativeSources>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Forbidden on EnumType-->
        <dpage:Section heading="Forbidden on EnumType properties" purpose="Explain why suggestions never apply where a closed set already exists">
          <content>
            <dpage:Paragraph purpose="Explain that EnumType properties must not carry suggestions since values already supplies the closed set">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Suggestions are forbidden on properties typed with an EnumType, because valid
values already come exclusively from that EnumType's own values catalogue.</message>
              <authoritativeSources>
                <workflow:AuthorativeSourceSet>
                  <includedTypes>
                    <type:TypeSelectorEntity value="org.blockml.bml.documentation.ConstraintsModel" />
                  </includedTypes>
                </workflow:AuthorativeSourceSet>
              </authoritativeSources>
              <exclusions>
                <sem:Exclusion>
                  <summary>Suggestion-type-mismatch diagnostics in depth.</summary>
                  <reason>Diagnostic detail belongs to reference-level material.</reason>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="Suggesting a few compatible values" purpose="Ground the non-enforced guidance model in one small example">
          <content>
            <dpage:Paragraph purpose="Set up a Property with a suggestions list of compatible sample values">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>A Property can offer a short list of compatible sample instances as
suggestions, letting an editor present them without restricting authors to only
those values.</message>
              <exclusions>
                <sem:Exclusion>
                  <summary>An EnumType-typed property.</summary>
                  <reason>The example demonstrates the allowed case, not the forbidden combination.</reason>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>
            <dpage:CodeBlock purpose="Show a Text property with two suggested TextEntity values">
              <role>org.blockml.bml.docgen.role.Example</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>The property declares suggestions holding two compatible TextEntity instances.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>Show a Text property with a suggestions container holding two TextEntity sample values.</summary>
                </sem:SupportingPoint>
              </supportingPoints>
              <exclusions>
                <sem:Exclusion>
                  <summary>An instance authored with a value outside the suggested list.</summary>
                </sem:Exclusion>
              </exclusions>
            </dpage:CodeBlock>
            <dpage:Paragraph purpose="Interpret the suggestions as guidance, not a restriction">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>The two suggested values in the example are offered as convenient starting
points for an editor — an author remains free to write any other Text value on
this property.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages" purpose="Anchor the outcome this page should leave behind">
          <content>
            <dpage:Paragraph purpose="State the outcome this page should leave behind">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>After this page, readers should know suggestions are hints for tooling,
never validation, before Expressions introduces dynamic member values.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with expressions" purpose="Direct the reader to the next page">
          <content>
            <dpage:Navigation purpose="Continue the behaviour-and-values learning sequence">
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Expressions" summary="Learn the BlockML expression language.">
                  <target>docs:Expressions</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Suggestions>
