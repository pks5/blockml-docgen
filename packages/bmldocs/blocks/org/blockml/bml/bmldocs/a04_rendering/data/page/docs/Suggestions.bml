<!--BlockML Documentation — a guide to non-mandatory modeling guidance

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Suggestions-->
<docs:Suggestions xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to non-mandatory modeling guidance
  </is>
  <documentation>
    Scope: non-mandatory modeling guidance for editors and renderers, and suggestions versus
    constraints, grounded in the Suggestions section of
    org.blockml.bml.documentation.ConstraintsModel. Body content is authored in a03 from that
    source.
  </documentation>
  <references>
    <see type="doc:ConstraintsModel" relation="Requires">
      Primary content source — Suggestions as Property-only, non-validation editor metadata.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Suggestions</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Suggestions as optional guidance">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>A suggestion is a hint attached to a property that points editors and
renderers toward Block instances that fit well, without ever governing whether
the model is valid. A suggested instance only needs to be compatible with the
property's own type; BlockML never checks a suggestion as a pass-or-fail
validation rule.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. vs constraints-->
        <dpage:Section heading="Suggestions compared to constraints">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>Unlike a constraint, a suggestion is never validated as a pass-or-fail
rule; it exists purely to help a person or tool choose among values that already
fit the property's type.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Where it lives-->
        <dpage:Section heading="Where a suggestion lives">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>A suggestion is attached only at the property level, offering Block
instances that already fit that property's type, rather than expressing a rule
that applies broadly across a Block.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Type compatibility-->
        <dpage:Section heading="Suggestions still respect the property's type">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text>
                  <text>A suggested instance must still be compatible with the property's own
type, and a property whose type already restricts values to a fixed set of
options does not offer suggestions at all. Suggestions are forbidden entirely on
a property whose type is a closed enumeration, since every valid value for that
property is already fixed by the enumeration itself.</text>
                </dpage:Text>
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. Recap-->
        <dpage:Section heading="Recognizing a suggestion">
          <content>
            <dpage:List>
              <items>
                <dpage:ListItem text="A suggestion never causes a model to fail validation." />
                <dpage:ListItem text="A suggestion offers compatible instances for one property, not a rule spanning a whole Block." />
                <dpage:ListItem text="A suggested instance must still match the property's own type." />
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with the expression language">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Expressions" summary="Learn the expression language used for dynamic member values.">
                  <target>docs:Expressions</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Suggestions>
