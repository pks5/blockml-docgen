<!--BlockML Documentation — a guide to non-mandatory modeling guidance

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Suggestions-->
<docs:Suggestions xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to non-mandatory modeling guidance
  </is>
  <documentation>
    Scope: non-mandatory modeling guidance for editors and renderers, and suggestions versus
    constraints, grounded in the Suggestions section of
    org.blockml.bml.documentation.ConstraintsModel. Body content is authored in a04 from that
    source.
  </documentation>
  <references>
    <see type="doc:ConstraintsModel" relation="Requires">
      Primary content source — Suggestions as Property-only, non-validation editor metadata.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Suggestions</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Hints for editors, never validation">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Suggestions are Property-only metadata — a short list of Block instances compatible with the property's type, offered to editors and renderers as guidance." />
                <dpage:Text text="Unlike a constraint, a suggestion is never enforced as validation." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Suggestions versus constraints-->
        <dpage:Section heading="Suggestions versus constraints">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A constraint may fail validation once its validation property is set, but a suggestion never does." />
                <dpage:Text text="Authors remain free to enter any value compatible with the property's type, regardless of what the suggestions list offers them." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Forbidden on EnumType-->
        <dpage:Section heading="Forbidden on EnumType properties">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Suggestions are forbidden on properties typed with an EnumType." />
                <dpage:Text text="An EnumType property already draws its valid values exclusively from that EnumType's own values catalogue, so a separate suggestions list would only duplicate or contradict the closed set that already governs it." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="Suggesting a few compatible values">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A Property can offer a short list of compatible sample instances as suggestions, letting an editor present them to an author without restricting authoring to only those values." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- The suggestions container offers two compatible sample values for editors to present -->
<acme:Card xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Block
  </baseType>
  <is>
    A card with a suggested label
  </is>
  <documentation>
    Demonstrates a Property carrying non-enforced suggested values.
  </documentation>
  <properties>
    <label type="type:Text">
      <suggestions>
        <type:TextEntity value="Featured" />
        <type:TextEntity value="New" />
      </suggestions>
    </label>
  </properties>
</acme:Card>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="The two suggested values in the example, Featured and New, are offered only as convenient starting points for an editor." />
                <dpage:Text text="An author remains free to write any other Text value on label — nothing here restricts the property the way a constraint would." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should know suggestions are hints for tooling, never validation, before Expressions introduces dynamic member values." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with expressions">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Expressions" summary="Learn the BlockML expression language.">
                  <target>docs:Expressions</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Suggestions>
