<!--BlockML Documentation — a guide to non-mandatory modeling guidance

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Suggestions-->
<docs:Suggestions xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to non-mandatory modeling guidance
  </is>
  <documentation>
    Scope: non-mandatory modeling guidance for editors and renderers, and suggestions versus
    constraints, grounded in the Suggestions section of
    org.blockml.bml.documentation.ConstraintsModel. Body content is authored in a04 from that
    source.
  </documentation>
  <references>
    <see type="doc:ConstraintsModel" relation="Requires">
      Primary content source — Suggestions as Property-only, non-validation editor metadata.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Suggestions</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="Guidance, not validation">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Suggestions are Property-only metadata: compatible Block instances offered to editors and renderers as guidance, not validation rules. A suggested value must still be type-compatible with the property it decorates." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Suggestions versus constraints">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Unlike a constraint, a suggestion is never enforced — authors remain free to enter any type-compatible value even when a suggestion is present." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Forbidden on enums">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Suggestions are forbidden on EnumType properties, because valid values on an enum come exclusively from the type's own declared members." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Readers should now know that a suggestion is a hint for tooling, never a validation rule." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with expressions">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Expressions" summary="Learn how member values can be dynamic.">
                  <target>docs:Expressions</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Suggestions>
