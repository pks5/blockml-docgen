<!--BlockML Documentation — a guide to the type-versus-value distinction

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.TypesAndValues-->
<docs:TypesAndValues xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:core="org.blockml.bml.core"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to the type-versus-value distinction
  </is>
  <documentation>
    Scope: a type describing possible values versus an instance holding an actual value,
    grounded in org.blockml.bml.core.ValueType and
    org.blockml.bml.documentation.EverythingIsABlock. Body content is rendered in a04 from those
    sources.
  </documentation>
  <references>
    <see type="core:ValueType" relation="Requires">
      The typed value domain this page's distinction is built on.
    </see>
    <see type="doc:EverythingIsABlock" relation="Requires">
      Primary content source — ValueTypes never store data; Properties own all concrete values.
    </see>
    <see type="doc:ValueTypeConfiguration" relation="SeeAlso">
      How a Property's owned type instance, not the ValueType definition, carries configuration.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Types and Values</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="What a type describes versus what a value holds">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A ValueType describes the nature of possible values; a Property holds one actual value of that nature — the type never stores data, and every concrete value lives exclusively on the Property." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. ValueType at the top of the hierarchy-->
        <dpage:Section heading="ValueType at the top of the value hierarchy">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="ValueType sits at the top of the value assignability hierarchy — every PrimitiveType, StructType, EnumType, and ConstantType is assignable to it, which is why only ValueTypes may appear as a Property type or a Capability input or output type." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Optional, never null-->
        <dpage:Section heading="Every Property is Optional">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Every Property behaves as Optional — it has a value or it has none — because the ValueType only describes what a value could be, and there is no null state for a type that never itself stores anything." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="One ValueType, two Properties">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Two properties of the same ValueType can hold entirely different states — one with a value present, one with none — because the type itself carries nothing." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- Both properties share the type Integer; only "count" carries a value -->
<acme:Basket xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Block
  </baseType>
  <properties>
    <count type="type:Integer">
      <value>3</value>
    </count>
    <reorderThreshold type="type:Integer" />
  </properties>
</acme:Basket>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="count and reorderThreshold are both typed Integer, yet count carries a value, 3, while reorderThreshold carries none. reorderThreshold is simply absent — Integer, the type, never held anything either way, so there is nothing to represent as null." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should keep type and value apart when reading any member declaration, before generic type parameters extend that same type vocabulary on the next page." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with generic types">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Generic Types" summary="Learn generic type parameters, binding, and forwarding.">
                  <target>docs:GenericTypes</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:TypesAndValues>
