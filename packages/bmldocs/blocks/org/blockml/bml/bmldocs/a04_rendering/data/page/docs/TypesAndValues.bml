<!--BlockML Documentation — a guide to the type-versus-value distinction

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.TypesAndValues-->
<docs:TypesAndValues xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to the type-versus-value distinction
  </is>
  <documentation>
    Scope: a type describing possible values versus an instance holding an actual value,
    grounded in org.blockml.bml.core.ValueType and
    org.blockml.bml.documentation.EverythingIsABlock. Body content is authored in a04 from those
    sources.
  </documentation>
  <references>
    <see type="core:ValueType" relation="Requires">
      The typed value domain this page's distinction is built on.
    </see>
    <see type="doc:EverythingIsABlock" relation="Requires">
      Primary content source — ValueTypes never store data; Properties own all concrete values.
    </see>
    <see type="doc:ValueTypeConfiguration" relation="SeeAlso">
      How a Property's owned type instance, not the ValueType definition, carries configuration.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Types and Values</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="Type describes, instance holds">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="A ValueType describes the nature of the values a member may hold, while a Property holds the actual value — a distinction that underlies every member kind." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="ValueTypes never store data">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="ValueTypes never store data: a Property owns every concrete value, and each Property is Optional — it holds either a value or none, never null." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Configuration lives on the Property, not the type">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Instance configuration applies to a Property's owned ValueType instance — never to the ValueType definition block itself." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Readers leaving this page keep type and value apart when reading any member declaration: the type states what is possible, and the Property holds what is actual." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with generic types">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Generic Types" summary="Learn how a Block declares and binds generic type parameters.">
                  <target>docs:GenericTypes</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:TypesAndValues>
