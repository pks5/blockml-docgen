<!--BlockML Documentation — a first orientation to BlockML for handbook readers

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Introduction-->
<docs:Introduction xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A first orientation to BlockML for handbook readers
  </is>
  <documentation>
    Scope: what BlockML is, the BML-versus-BOM distinction, and how this handbook is organized
    for a first read, grounded in org.blockml.bml.documentation.Introduction. Body content is
    rendered in a04 from that source.
  </documentation>
  <references>
    <see type="doc:Introduction" relation="Requires">
      Primary content source — BlockML's goals, the BML/BOM split, and the domain-agnostic compiler.
    </see>
    <see type="doc:CoreUseCases" relation="ReadNext">
      Next reading step, once BML and BOM are distinguished.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Introduction to BlockML</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Introduction</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="A universal language for describing Blocks">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="BlockML is a universal declarative language for describing parametric, composable semantic units called Blocks, independently of how any particular domain later manifests them. Authors write Blocks in BML, the human- and editor-friendly authoring format, and the compiler turns that BML into the BOM, its canonical, immutable, and lossless representation. That compiler is domain-agnostic — it makes no domain-specific decisions itself, because all domain knowledge lives exclusively in the render targets that later manifest a Block into something concrete." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. BML vs BOM-->
        <dpage:Section heading="BML and BOM">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="BML, the Block Markup Language, is what authors write and edit directly; every BML file uses the .bml extension, and XML is currently its sole serialization. Parsing a BML file produces the BOM, the Block Object Model — the canonical, immutable model the parser builds from that document. Because the parser makes no semantic decisions of its own, a BML document can be converted to its BOM and back again without losing or reinterpreting anything, so the two forms remain losslessly convertible into one another." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. How to read this handbook-->
        <dpage:Section heading="How to read this handbook">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="This handbook moves from a first orientation, through BlockML's foundational Block concepts, into the type and member model, and finally into the BML authoring format itself, with each page building on the mental model the previous one established." />
              </content>
            </dpage:Paragraph>
            <dpage:List>
              <items>
                <dpage:ListItem text="Getting Started">
                  <content>
                    <dpage:Paragraph>
                      <content>
                        <dpage:Text text="What BlockML is and why it exists." />
                      </content>
                    </dpage:Paragraph>
                  </content>
                </dpage:ListItem>
                <dpage:ListItem text="Foundations">
                  <content>
                    <dpage:Paragraph>
                      <content>
                        <dpage:Text text="Blocks, definitions and instances, inheritance, and identity." />
                      </content>
                    </dpage:Paragraph>
                  </content>
                </dpage:ListItem>
                <dpage:ListItem text="The Type System and Members">
                  <content>
                    <dpage:Paragraph>
                      <content>
                        <dpage:Text text="The four ValueType kinds and the Property, Aggregation, Association, and Capability member model." />
                      </content>
                    </dpage:Paragraph>
                  </content>
                </dpage:ListItem>
                <dpage:ListItem text="BML: The Authoring Format">
                  <content>
                    <dpage:Paragraph>
                      <content>
                        <dpage:Text text="The authoring format itself, once every concept it expresses is known." />
                      </content>
                    </dpage:Paragraph>
                  </content>
                </dpage:ListItem>
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="A first look at BML">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Every BML document opens with a root Block element that states its own name, its type identity, and the type it extends, before anything else follows. This identity — name, type, and baseType — always comes first, ahead of the is and documentation fields that describe what the Block means." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- Root Block: name, type identity, and the type it extends -->
<acme:Widget xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    core:Block
  </baseType>
</acme:Widget>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="The element tag acme:Widget names the Block and its type in one step, and baseType states that Widget extends core:Block — nothing else is declared. Reading the example, the document's identity is fully stated before anything else is added; this is the pattern every later page in the handbook builds on." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should be able to say what BlockML is for and keep BML, the authoring format, distinct from BOM, its canonical representation." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with the core use cases">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Core Use Cases" summary="Learn the three problems BlockML is designed to solve.">
                  <target>docs:CoreUseCases</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Introduction>
