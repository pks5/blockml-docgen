<!--BlockML Documentation — a first orientation to BlockML for handbook readers

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Introduction-->
<docs:Introduction xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A first orientation to BlockML for handbook readers
  </is>
  <documentation>
    Scope: what BlockML is, the BML-versus-BOM distinction, and how this handbook is organized
    for a first read, grounded in org.blockml.bml.documentation.Introduction. Body content is
    authored in a04 from that source.
  </documentation>
  <references>
    <see type="doc:Introduction" relation="Requires">
      Primary content source — BlockML's goals, the BML/BOM split, and the domain-agnostic compiler.
    </see>
    <see type="doc:CoreUseCases" relation="ReadNext">
      Next reading step, once BML and BOM are distinguished.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Introduction to BlockML</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Introduction</value>
    </pageType>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="A universal language for describing Blocks">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="BlockML is a universal declarative language for describing parametric, composable semantic units called Blocks, independently of how a domain later manifests them." />
                <dpage:Text text="BML, the Block Markup Language, is the human- and editor-friendly format authors write; the BOM, the Block Object Model, is its canonical, immutable, lossless representation." />
                <dpage:Text text="The compiler that turns BML into a BOM is domain-agnostic — all domain-specific knowledge lives in render targets, never in the compiler itself." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. BML vs BOM-->
        <dpage:Section heading="BML and BOM">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="BML is what authors write and edit — XML is currently its sole serialization, saved with a .bml file extension." />
                <dpage:Text text="The parser that reads BML makes no semantic decisions of its own, which is what keeps a document losslessly convertible between its BML form and its BOM form." />
                <dpage:Text text="Because that round trip is lossless, the BOM the parser produces is treated as the canonical representation, while the BML text stays the editable source authors actually work with." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. How to read this handbook-->
        <dpage:Section heading="How to read this handbook">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="The handbook moves from a first orientation, through the foundational Block concepts, to the type and member model, and finally to the BML authoring format itself — each page building on the mental model the previous one established." />
              </content>
            </dpage:Paragraph>
            <dpage:List>
              <items>
                <dpage:ListItem text="Getting Started — what BlockML is and why it exists." />
                <dpage:ListItem text="Foundations — Blocks, definitions and instances, inheritance, and identity." />
                <dpage:ListItem text="The Type System and Members — the four ValueType kinds and the Property, Aggregation, Association, and Capability member model." />
                <dpage:ListItem text="BML: The Authoring Format — the authoring format itself, once every concept it expresses is known." />
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="A first look at BML">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Every BML document opens with a root Block that states its own name, its type identity, and the type it extends, before any documentation or members follow." />
              </content>
            </dpage:Paragraph>
            <dpage:CodeBlock>
              <code><![CDATA[<!-- Identity comes first: the element tag states name and type; baseType states what it extends -->
<acme:Widget xmlns="http://blockml.org/bml"
  xmlns:acme="com.acme.example"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    core:Block
  </baseType>
</acme:Widget>]]></code>
            </dpage:CodeBlock>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="Reading the example, Widget's identity — its name, its type acme:Widget, and the core:Block type it extends — is fully stated before anything else is added; this is the pattern every later page in the handbook builds on." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this page, readers should be able to say what BlockML is for and keep BML, the authoring format, distinct from BOM, its canonical representation." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with the core use cases">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Core Use Cases" summary="Learn the three problems BlockML is designed to solve.">
                  <target>docs:CoreUseCases</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Introduction>
