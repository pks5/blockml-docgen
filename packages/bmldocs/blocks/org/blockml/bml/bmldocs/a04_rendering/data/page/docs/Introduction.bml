<!--BlockML Documentation — a first orientation to BlockML for handbook readers

  FQN: org.blockml.bml.bmldocs.a04_rendering.data.page.docs.Introduction-->
<docs:Introduction xmlns="http://blockml.org/bml"
  xmlns:docs="org.blockml.bml.bmldocs.a04_rendering.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A first orientation to BlockML for handbook readers
  </is>
  <documentation>
    Scope: what BlockML is, the BML-versus-BOM distinction, and how this handbook is organized
    for a first read, grounded in org.blockml.bml.documentation.Introduction. Body content is
    authored in a04 from that source.
  </documentation>
  <references>
    <see type="doc:Introduction" relation="Requires">
      Primary content source — BlockML's goals, the BML/BOM split, and the domain-agnostic compiler.
    </see>
    <see type="doc:CoreUseCases" relation="ReadNext">
      Next reading step, once BML and BOM are distinguished.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Introduction to BlockML</value>
    </title>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Introduction</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Section heading="A universal language for semantic Blocks">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="BlockML is a universal declarative language for describing parametric, composable semantic units called Blocks." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="BML and BOM">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="BML (Block Markup Language) is the human- and editor-friendly authoring format; the BOM (Block Object Model) is its canonical, immutable, lossless representation." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="A domain-agnostic compiler">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="The compiler is domain-agnostic — domain-specific knowledge lives only in Render Targets, never in the compiler itself. MachineBlocks (SCAD) is the reference render target implementation, not the only possible target." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What BlockML is designed to achieve">
          <content>
            <dpage:List>
              <items>
                <dpage:ListItem text="One grammar — types, domain Blocks, languages, services, and documentation all use the same grammar." />
                <dpage:ListItem text="Semantics in BML — behaviour is expressed as Capabilities, not as special cases hard-coded in the compiler." />
                <dpage:ListItem text="Lossless BML to BOM — the parser makes no semantic decisions, so BML and BOM remain losslessly convertible." />
                <dpage:ListItem text="Renderer freedom — each render target decides how to manifest Blocks in its own output." />
                <dpage:ListItem text="Self-hosting bootstrap — the compiler loads framework BML before it processes any user content." />
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages">
          <content>
            <dpage:Paragraph>
              <content>
                <dpage:Text text="After this introduction, readers should know what BlockML is for and be able to distinguish BML, the authoring format, from BOM, its canonical representation." />
              </content>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with the core use cases">
          <content>
            <dpage:Navigation>
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Core Use Cases" summary="See the three problems BlockML is designed to solve.">
                  <target>docs:CoreUseCases</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Introduction>
