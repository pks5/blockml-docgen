<!--BlockML Documentation — a guide to defining, naming, and referencing a Block

  FQN: org.blockml.bml.bmldocs.a03_authoring.data.page.docs.Blocks-->
<docs:Blocks xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:docs="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:core="org.blockml.bml.core"
  xmlns:workflow="org.blockml.bml.transformer.workflow"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to defining, naming, and referencing a Block
  </is>
  <documentation>
    Scope: what a Block is, defining a Block, identifying a Block, referencing a Block, and the
    difference between defining and using a Block, grounded in org.blockml.bml.core.Block,
    org.blockml.bml.documentation.BlockNameConvention, and
    org.blockml.bml.documentation.DocumentFormat. Body content is authored in a03 from those
    sources.
  </documentation>
  <references>
    <see type="core:Block" relation="Requires">
      The Block root type this page introduces.
    </see>
    <see type="doc:BlockNameConvention" relation="Requires">
      Block name formatting and its relationship to type identity.
    </see>
    <see type="doc:DocumentFormat" relation="Requires">
      Element-tag authoring for defining a Block document.
    </see>
    <see type="doc:TypeIdentityDerivation" relation="SeeAlso">
      Full type-reference and identity derivation rules.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Blocks</value>
    </title>
    <purpose override="true">
      <value>Introduce the Block as BlockML's basic unit and separate defining a Block from referencing one, so readers can locate a Block's FQN and its definition before deeper member or inheritance detail follows.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <workflow:AuthorativeSourceSet>
          <includedTypes>
            <type:TypeSelectorEntity value="org.blockml.bml.core.Block" />
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.BlockNameConvention" />
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.DocumentFormat" />
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.TypeIdentityDerivation" />
          </includedTypes>
        </workflow:AuthorativeSourceSet>
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>Introduce the Block as the basic unit of BlockML and separate defining a Block from using one.</summary>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>The reader can point to a Block's FQN, its definition file, and a use of it.</summary>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>What a Block is, how to define one, how its name and identity are formed, and the difference between defining a Block and referencing it.</summary>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>Definition-versus-instance depth and inheritance mechanics.</summary>
          <reason>Those are the subjects of the next two pages.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <supportingPoints override="true">
      <composition>
        <sem:SupportingPoint>
          <summary>A Block's name is a PascalCase class name, and its canonical type identity comes from the element tag or an explicit type field.</summary>
        </sem:SupportingPoint>
      </composition>
    </supportingPoints>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="The Block: BlockML's basic unit" purpose="Give an immediate orientation to the Block as a unit">
          <content>
            <dpage:Paragraph purpose="Introduce the Block as the basic authoring unit">
              <role>org.blockml.bml.docgen.role.Lead</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A Block is the basic unit BlockML is built from: a named, identifiable
description of a concept, with its own place among the language's other
concepts.</message>
              <authoritativeSources>
                <core:Block />
              </authoritativeSources>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Defining-->
        <dpage:Section heading="Defining a Block" purpose="Explain what it means to define a Block">
          <content>
            <dpage:Paragraph purpose="Explain that a Block definition is its own document with an explicit identity">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Defining a Block means writing a document that gives it a name, states its
own type identity, and declares what kind of concept it specializes.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>Identity comes first in a Block document, before any prose describing what the Block means.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.core.Block" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Naming and identity-->
        <dpage:Section heading="Naming a Block" purpose="Explain the name convention and how canonical identity is formed">
          <content>
            <dpage:Paragraph purpose="State the PascalCase naming convention and where canonical identity comes from">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A Block's name is a PascalCase word, and its canonical type identity comes
either from the tag that opens its document or from an explicit type field
inside it.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>A Block's name is a PascalCase class name, and its canonical type identity comes from the element tag or an explicit type field.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.BlockNameConvention" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
            <dpage:CodeBlock purpose="Illustrate a Block document opened by its own qualified identity tag">
              <role>org.blockml.bml.docgen.role.Example</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>A Block document is opened by a tag naming its own type, with a short prose
name for what the Block represents immediately inside.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>Highlight the opening tag as the Block's canonical identity, followed by a short statement of what the Block represents.</summary>
                </sem:SupportingPoint>
              </supportingPoints>
              <authoritativeSources>
                <doc:DocumentFormat />
              </authoritativeSources>
            </dpage:CodeBlock>
          </content>
        </dpage:Section>
        <!--4. Referencing-->
        <dpage:Section heading="Locating and referencing a Block" purpose="Explain how a Block already defined elsewhere gets referenced">
          <content>
            <dpage:Paragraph purpose="Explain that a reference names an existing Block rather than repeating it">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Referencing a Block elsewhere in a model means pointing at the name of its
own defining document, so a reader can always find the single place that Block
is actually defined.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. Defining versus using-->
        <dpage:Section heading="Defining a Block versus using one" purpose="Sharpen the distinction between a Block's definition and a place it is used">
          <content>
            <dpage:Paragraph purpose="Contrast defining a Block with pointing at an existing one">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Defining a Block creates its one canonical description; using a Block only
ever points back to that description, so the same Block can be pointed at from
many places without ever being redefined.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with definitions and instances" purpose="Direct the reader to the next page">
          <content>
            <dpage:Navigation purpose="Continue from a single Block into the definition-versus-instance distinction">
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Block Definitions and Instances" summary="Learn the difference between a Block definition and a Block instance.">
                  <target>docs:BlockDefinitionsAndInstances</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Blocks>
