<!--BlockML Documentation — How-to page group

  FQN: org.blockml.bml.bmldocs.a03_authoring.data.pagegroup.HowToPageGroup-->
<pgroup:HowToPageGroup xmlns="http://blockml.org/bml"
  xmlns:pgroup="org.blockml.bml.bmldocs.a03_authoring.data.pagegroup"
  xmlns:page="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:dcore="org.blockml.bml.docgen.core">

  <baseType>
    dcore:PageGroup
  </baseType>
  <is>
    The How-to page group for the a03 documentation set
  </is>
  <documentation>
    Section page group; this group is the A03 counterpart of a02_structuring's HowToPageGroup.
    pages / landingPage / parentGroup name only A03 Blocks. Direct pages: AuthorNewBlockGuide.
    parentGroup is DocsPageGroup.
  </documentation>
  <references>
    <see type="dcore:PageGroup" relation="Extends">
      Docgen page group base.
    </see>
    <see type="pgroup:DocsPageGroup" relation="Requires">
      Parent Documentation root page group.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>How-to</value>
    </title>
    <parentGroup override="true">
      <value>pgroup:DocsPageGroup</value>
    </parentGroup>
  </properties>
  <aggregations>
    <pages override="true">
      <composition>
        <page:AuthorNewBlockGuide />
      </composition>
    </pages>
  </aggregations>
</pgroup:HowToPageGroup>
