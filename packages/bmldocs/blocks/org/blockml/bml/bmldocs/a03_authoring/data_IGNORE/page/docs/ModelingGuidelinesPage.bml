<!--BlockML Documentation — Modeling guidelines

  FQN: org.blockml.bml.bmldocs.a03_authoring.data.page.docs.ModelingGuidelinesPage-->
<page:ModelingGuidelinesPage xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:page="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:workflow="org.blockml.bml.transformer.workflow"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A website page of practical modeling guidelines
  </is>
  <documentation>
    Marker page: recommended patterns for baseType, contracts, capabilities, and constraints —
    practical checklist style for website readers.
    
    content is a structural scaffold only; generate prose and examples from referenced core
    documentation (doc:ModelingGuidelines, doc:ContractsModel).
  </documentation>
  <references>
    <see type="doc:ModelingGuidelines" relation="Requires">
      Primary content — recommended modeling patterns.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Modeling guidelines</value>
    </title>
    <purpose override="true">
      <value>Collect practical, non-normative modeling patterns so authors have guidance without turning the page into a second language specification.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Practical</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Guide</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <workflow:AuthorativeSourceSet>
          <includedTypes>
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.ModelingGuidelines" />
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.ContractsModel" />
            <type:TypeSelectorEntity value="org.blockml.bml.core.Block" />
          </includedTypes>
        </workflow:AuthorativeSourceSet>
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>Apply a small set of practical modeling patterns for baseType, reuse, and contracts without treating the page as a second language specification.</summary>
          <authoritativeSources>
            <workflow:AuthorativeSourceSet>
              <includedTypes>
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.ModelingGuidelines" />
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.ContractsModel" />
                <type:TypeSelectorEntity value="org.blockml.bml.core.Block" />
              </includedTypes>
            </workflow:AuthorativeSourceSet>
          </authoritativeSources>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>The reader can choose a baseType that expresses clear branch membership.</summary>
          <authoritativeSources>
            <workflow:AuthorativeSourceSet>
              <includedTypes>
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.ModelingGuidelines" />
                <type:TypeSelectorEntity value="org.blockml.bml.core.Block" />
              </includedTypes>
            </workflow:AuthorativeSourceSet>
          </authoritativeSources>
        </sem:ReaderOutcome>
        <sem:ReaderOutcome>
          <summary>The reader can separate inheritance reuse from contract composition concerns.</summary>
          <authoritativeSources>
            <workflow:AuthorativeSourceSet>
              <includedTypes>
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.ModelingGuidelines" />
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.ContractsModel" />
              </includedTypes>
            </workflow:AuthorativeSourceSet>
          </authoritativeSources>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>Present practical guidelines for baseType choice, branch membership, reuse, contracts, and Capabilities as the public behavioural surface — as authoring advice rather than normative language law.</summary>
          <authoritativeSources>
            <workflow:AuthorativeSourceSet>
              <includedTypes>
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.ModelingGuidelines" />
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.ContractsModel" />
                <type:TypeSelectorEntity value="org.blockml.bml.core.Block" />
              </includedTypes>
            </workflow:AuthorativeSourceSet>
          </authoritativeSources>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>Exhaustive anti-pattern catalogue.</summary>
          <reason>A short guide should teach preferred patterns, not enumerate every mistake.</reason>
        </sem:Exclusion>
        <sem:Exclusion>
          <summary>Validator codes.</summary>
          <reason>Diagnostic identifiers belong on reference and troubleshooting pages.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Practical patterns, not a second specification" purpose="Position the page as authoring guidance rather than language law">
          <content>
            <dpage:Paragraph purpose="Introduce modeling guidelines as practical advice">
              <role>org.blockml.bml.docgen.role.Lead</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>These guidelines help authors choose clear baseTypes and reuse patterns without
restating the whole language specification.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>Prefer a small checklist of durable habits over exhaustive rules.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.ModelingGuidelines" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>Guidance here complements contracts and override pages rather than replacing them.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.ModelingGuidelines" />
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.ContractsModel" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>Clear branch membership and intentional reuse matter more than deep inheritance trees.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.ModelingGuidelines" />
                        <type:TypeSelectorEntity value="org.blockml.bml.core.Block" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Single inheritance-->
        <dpage:Section heading="Single inheritance via baseType" purpose="Explain the principal baseType guideline">
          <content>
            <dpage:Paragraph purpose="Explain single inheritance via baseType">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Practical</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A Block declares exactly one baseType except the Block root, and that choice
should express branch membership and shared members together.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>Clear branch membership beats deep accidental inheritance trees.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.ModelingGuidelines" />
                        <type:TypeSelectorEntity value="org.blockml.bml.core.Block" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>baseType is the primary reuse path for shared members on a single branch.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.ModelingGuidelines" />
                        <type:TypeSelectorEntity value="org.blockml.bml.core.Block" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
            <dpage:Paragraph purpose="Separate inheritance reuse from contract composition concerns">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Practical</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Prefer inheritance when a Block is a specialized member of a branch; prefer
contracts when reusable fragments should merge without forcing that branch.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>Contracts and baseType solve different reuse problems and should not be treated as interchangeable.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.ModelingGuidelines" />
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.ContractsModel" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Guideline checklist-->
        <dpage:Section heading="Guideline checklist" purpose="Summarize the practical patterns readers should retain">
          <content>
            <dpage:Paragraph purpose="Prepare the reader for the modeling checklist">
              <role>org.blockml.bml.docgen.role.Transition</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>A short checklist keeps branch membership, reuse, and contracts distinct while
authoring.</message>
            </dpage:Paragraph>
            <dpage:List purpose="Present modeling patterns as a concise summary">
              <role>org.blockml.bml.docgen.role.Summary</role>
              <detailLevel>org.blockml.bml.docgen.level.Practical</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>These habits keep models readable and reusable.</message>
              <items>
                <dpage:ListItem text="Branch membership" purpose="Prefer clear branch membership over deep accidental trees">
                  <message>Prefer clear branch membership over deep accidental trees.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Reuse" purpose="Explain shared fragments via inheritance or contracts">
                  <message>Share fragments through inheritance or contracts where each mechanism fits.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Contracts note" purpose="Keep contracts and composition concerns separated">
                  <message>Keep contract composition concerns separate from ordinary structural nesting.</message>
                </dpage:ListItem>
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <!--4. Capabilities as public surface-->
        <dpage:Section heading="Capabilities as the public surface" purpose="Guide authors to express behaviour as Capabilities rather than Properties">
          <content>
            <dpage:Paragraph purpose="Explain Capabilities as the public behavioural surface of a Block">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Practical</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Model behaviour as Capabilities — the public surface of a Block — and keep
Properties as internal configuration rather than as the behavioural API.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>Init, get/set, render, and domain operations belong on Capabilities, not on ad-hoc Properties that only look like behaviour.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.ModelingGuidelines" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>Capability kinds such as Inbound, Outbound, and Transformation describe intent without inventing special compiler constructs.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.ModelingGuidelines" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>Prefer PseudoCode or natural-language Capability implementations when the goal is a clear semantic description.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.ModelingGuidelines" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
            <dpage:Paragraph purpose="Prepare the reader for the Capability-versus-Property checklist">
              <role>org.blockml.bml.docgen.role.Transition</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>A short split keeps the public surface and internal configuration distinct while
authoring.</message>
            </dpage:Paragraph>
            <dpage:List purpose="Present Capability versus Property roles as a concise summary">
              <role>org.blockml.bml.docgen.role.Summary</role>
              <detailLevel>org.blockml.bml.docgen.level.Practical</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>These roles keep behaviour public and configuration internal.</message>
              <items>
                <dpage:ListItem text="Capabilities" purpose="Name Capabilities as the public behavioural surface">
                  <message>Capabilities expose the operations and intents callers rely on.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Properties" purpose="Keep Properties as internal configuration">
                  <message>Properties hold internal configuration rather than standing in for behaviour.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Constraints note" purpose="Keep validation on Properties where rules attach">
                  <message>Attach reusable validation on Properties when rules are needed; do not
confuse constraints with Capability behaviour.</message>
                </dpage:ListItem>
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <!--5. Minimal example-->
        <dpage:Section heading="A good baseType choice" purpose="Connect the guideline to a small baseType sketch">
          <content>
            <dpage:Paragraph purpose="Introduce a baseType choice that states branch membership">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Practical</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>A small domain Block should pick a framework or domain base that states its
branch clearly in the definition header.</message>
              <exclusions>
                <sem:Exclusion>
                  <summary>Exhaustive anti-pattern examples and validator codes.</summary>
                  <reason>The example teaches a preferred pattern, not an anti-pattern catalogue.</reason>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>
            <dpage:CodeBlock purpose="Illustrate baseType choice for branch membership">
              <role>org.blockml.bml.docgen.role.Example</role>
              <detailLevel>org.blockml.bml.docgen.level.Practical</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>A small domain Block picks a framework or domain base that states its branch.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>Highlight name, type, and baseType as the identity header that states branch membership.</summary>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>Keep members minimal so the baseType choice remains the teaching focus.</summary>
                </sem:SupportingPoint>
              </supportingPoints>
              <exclusions>
                <sem:Exclusion>
                  <summary>Exhaustive anti-pattern examples and validator codes.</summary>
                </sem:Exclusion>
              </exclusions>
            </dpage:CodeBlock>
            <dpage:Paragraph purpose="Interpret the baseType choice in the example">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Practical</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>In the example, baseType names the parent branch the new Block joins, while
type remains the Block's own identity on that branch.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>Readers should see one clear parent rather than a deep accidental chain invented for reuse alone.</summary>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>Shared fragments that do not belong on that branch would use contracts instead of forcing another baseType.</summary>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with related modeling topics" purpose="Direct the reader to Visibility, Overrides, and Contracts">
          <content>
            <dpage:Navigation purpose="Continue the learning sequence">
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Visibility" summary="Learn how member and Sub-Block visibility encode access control.">
                  <target>page:VisibilityBasics</target>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Overrides" summary="See how partial member overrides refine inherited members.">
                  <target>page:OverridesBasics</target>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Contracts" summary="Use contracts for reusable partial definitions that merge member fragments.">
                  <target>page:ContractsIntro</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</page:ModelingGuidelinesPage>
