<!--BlockML Documentation — Sub-Blocks intro

  FQN: org.blockml.bml.bmldocs.a03_authoring.data.page.docs.SubBlocksIntro-->
<page:SubBlocksIntro xmlns="http://blockml.org/bml"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:page="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:lpage="org.blockml.bml.bmldocs.lib.page"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:dlevel="org.blockml.bml.docgen.level"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:role="org.blockml.bml.docgen.role"
  xmlns:weight="org.blockml.bml.docgen.weight"
  xmlns:core="org.blockml.bml.core"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    lpage:BmlDocPage
  </baseType>
  <is>
    A website intro to Sub-Blocks
  </is>
  <documentation>
    Marker page: nested types under a root Block, FQN derivation, and how they differ from
    embedded Blocks — one nesting example plus a pointer to identity rules.
    
    content is a structural scaffold only; generate prose and examples from referenced core
    documentation (doc:SubBlockModel, doc:TypeIdentityDerivation, doc:MemberVisibility).
  </documentation>
  <references>
    <see type="doc:SubBlockModel" relation="Requires">
      Primary content — Sub-Blocks, visibility, and embedded Blocks.
    </see>
    <see type="doc:TypeIdentityDerivation" relation="Requires">
      Primary content — root vs Sub-Block FQN derivation.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Sub-Blocks</value>
    </title>
    <purpose override="true">
      <value>Introduce Sub-Blocks as nested types under a parent Block.</value>
    </purpose>
    <detailLevel override="true">
      <value>dlevel:Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>ptype:Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <doc:SubBlockModel />
        <doc:TypeIdentityDerivation />
        <doc:MemberVisibility />
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <authoritativeSources>
            <doc:SubBlockModel />
            <doc:TypeIdentityDerivation />
            <doc:MemberVisibility />
          </authoritativeSources>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <authoritativeSources>
            <doc:SubBlockModel />
          </authoritativeSources>
        </sem:ReaderOutcome>
        <sem:ReaderOutcome>
          <authoritativeSources>
            <doc:SubBlockModel />
            <doc:TypeIdentityDerivation />
          </authoritativeSources>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <authoritativeSources>
            <doc:SubBlockModel />
            <doc:TypeIdentityDerivation />
            <doc:MemberVisibility />
          </authoritativeSources>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <reason>Introductory pages need usable reference forms, not the complete algorithm.</reason>
        </sem:Exclusion>
        <sem:Exclusion>
          <reason>Diagnostic identifiers belong on reference and troubleshooting pages.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Nested types under a parent Block" purpose="Orient readers with a nested-type analogy">
          <content>
            <dpage:Paragraph purpose="Introduce Sub-Blocks as nested-type analogues under a parent Block">
              <role>role:Lead</role>
              <detailLevel>dlevel:Overview</detailLevel>
              <weight>weight:Primary</weight>
              <message>Sub-Blocks are nested types under a parent Block, comparable to static nested
classes that still belong to one enclosing identity.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:SubBlockModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:TypeIdentityDerivation />
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:MemberVisibility />
                    <doc:SubBlockModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Nesting and contrast-->
        <dpage:Section heading="Declared under subBlocks" purpose="Explain nesting under the parent and contrast embedded Blocks">
          <content>
            <dpage:Paragraph purpose="Explain subBlocks nesting">
              <role>role:Explanation</role>
              <detailLevel>dlevel:Introductory</detailLevel>
              <weight>weight:Primary</weight>
              <message>Sub-Blocks are declared in subBlocks, may nest to arbitrary depth, and do not
inherit outer generic scope from the parent.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:SubBlockModel />
                    <doc:MemberVisibility />
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:SubBlockModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
            <dpage:Paragraph purpose="Contrast Sub-Blocks with embedded Blocks">
              <role>role:Explanation</role>
              <detailLevel>dlevel:Introductory</detailLevel>
              <weight>weight:Primary</weight>
              <message>Embedded Blocks under embeddedBlocks serve a different nesting role and must
not be confused with Sub-Block nested types.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:SubBlockModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:SubBlockModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. FQN and references-->
        <dpage:Section heading="FQN and reference forms" purpose="Summarize identity and how nested types are referenced">
          <content>
            <dpage:Paragraph purpose="Introduce root versus Sub-Block identity at a conceptual level">
              <role>role:Explanation</role>
              <detailLevel>dlevel:Introductory</detailLevel>
              <weight>weight:Supporting</weight>
              <message>A Sub-Block identity builds from the parent FQN prefix rather than standing as
an independent document root.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:TypeIdentityDerivation />
                    <doc:SubBlockModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
              <exclusions>
                <sem:Exclusion />
              </exclusions>
            </dpage:Paragraph>
            <dpage:Paragraph purpose="Prepare the reader for common Sub-Block reference forms">
              <role>role:Transition</role>
              <detailLevel>dlevel:Overview</detailLevel>
              <weight>weight:Supporting</weight>
              <message>Authors usually choose among fully qualified, prefixed, and innermost-first
unqualified references.</message>
            </dpage:Paragraph>
            <dpage:List purpose="Present reference forms as a concise summary">
              <role>role:Summary</role>
              <detailLevel>dlevel:Overview</detailLevel>
              <weight>weight:Primary</weight>
              <message>These forms cover qualified and nested unqualified references.</message>
              <items>
                <dpage:ListItem text="FQN" purpose="Name the fully qualified name form">
                  <message>A fully qualified name identifies the nested type unambiguously.</message>
                </dpage:ListItem>
                <dpage:ListItem text="QName" purpose="Name the QName with xmlns prefix form">
                  <message>A QName with an xmlns prefix can refer to the nested type compactly.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Nested unqualified" purpose="Name innermost-first unqualified resolution">
                  <message>Unqualified nested resolution prefers the innermost enclosing scope first.</message>
                </dpage:ListItem>
                <dpage:ListItem text="External refs" purpose="Explain that outside the parent document refs must qualify">
                  <message>References from outside the parent document must qualify the nested type.</message>
                </dpage:ListItem>
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <!--4. Sub-Block identity-->
        <dpage:Section heading="Sub-Block identity differs from root identity" purpose="Explain the name-required, type-derived convention for nested types">
          <content>
            <dpage:Paragraph purpose="Contrast Sub-Block identity with root Block identity conventions">
              <role>role:Explanation</role>
              <detailLevel>dlevel:Introductory</detailLevel>
              <weight>weight:Primary</weight>
              <message>Sub-Block identity uses the opposite convention from a root Block: name is
required, and type is normally omitted because it derives from the parent FQN
plus that name.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:TypeIdentityDerivation />
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:TypeIdentityDerivation />
                    <doc:SubBlockModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:SubBlockModel />
                    <doc:TypeIdentityDerivation />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
              <exclusions>
                <sem:Exclusion />
              </exclusions>
            </dpage:Paragraph>
            <dpage:Paragraph purpose="Prepare the reader for the identity-convention summary">
              <role>role:Transition</role>
              <detailLevel>dlevel:Overview</detailLevel>
              <weight>weight:Supporting</weight>
              <message>A short contrast keeps root and nested identity rules distinct while authoring.</message>
            </dpage:Paragraph>
            <dpage:List purpose="Present root versus Sub-Block identity conventions">
              <role>role:Summary</role>
              <detailLevel>dlevel:Overview</detailLevel>
              <weight>weight:Primary</weight>
              <message>These conventions distinguish document roots from nested types.</message>
              <items>
                <dpage:ListItem text="Root" purpose="Summarize root identity: type required, name optional">
                  <message>Roots require type; name is optional when it matches the type's last
segment.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Sub-Block" purpose="Summarize Sub-Block identity: name required, type derived">
                  <message>Sub-Blocks require name; type is normally omitted and derived from the
parent path.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Embedded contrast" purpose="Keep embedded Blocks out of the nested-type identity rule">
                  <message>Embedded Blocks remain separate full documents with their own required
type, not nested-type identity under the parent FQN.</message>
                </dpage:ListItem>
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <!--5. Minimal example-->
        <dpage:Section heading="A parent with one nested Sub-Block" purpose="Connect the concept to a small nesting sketch">
          <content>
            <dpage:Paragraph purpose="Introduce a parent Sub-Block declaration and qualified reference">
              <role>role:Explanation</role>
              <detailLevel>dlevel:Introductory</detailLevel>
              <weight>weight:Supporting</weight>
              <message>A root can declare one Sub-Block under subBlocks and refer to that nested type
with a qualified name from a composition or similar member.</message>
              <exclusions>
                <sem:Exclusion>
                  <reason>The example teaches nesting and reference shape, not the full algorithm.</reason>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>
            <dpage:CodeBlock purpose="Illustrate a subBlocks entry and a qualified nested reference">
              <role>role:Example</role>
              <detailLevel>dlevel:Overview</detailLevel>
              <weight>weight:Supporting</weight>
              <message>A root declares one Sub-Block and a composition can refer to that nested type
with a qualified name.</message>
              <supportingPoints>
                <sem:SupportingPoint />
                <sem:SupportingPoint />
              </supportingPoints>
              <exclusions>
                <sem:Exclusion />
              </exclusions>
            </dpage:CodeBlock>
            <dpage:Paragraph purpose="Interpret the subBlocks declaration and qualified reference">
              <role>role:Explanation</role>
              <detailLevel>dlevel:Introductory</detailLevel>
              <weight>weight:Supporting</weight>
              <message>In the example, the Sub-Block is a nested type under the parent, and the
qualified reference resolves that nested identity rather than an independent
root document.</message>
              <supportingPoints>
                <sem:SupportingPoint />
                <sem:SupportingPoint />
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with visibility and contracts" purpose="Direct the reader to related conceptual pages">
          <content>
            <dpage:Navigation purpose="Continue the learning sequence">
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Visibility" summary="Learn how naming prefixes control access to members and Sub-Blocks.">
                  <target>page:VisibilityBasics</target>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Contracts" summary="See how contracts differ from nested Sub-Block types.">
                  <target>page:ContractsIntro</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</page:SubBlocksIntro>
