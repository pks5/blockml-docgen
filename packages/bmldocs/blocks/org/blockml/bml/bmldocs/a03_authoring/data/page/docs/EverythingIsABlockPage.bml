<!--BlockML Documentation — a guide to BlockML's unifying Everything-is-a-Block principle

  FQN: org.blockml.bml.bmldocs.a03_authoring.data.page.docs.EverythingIsABlockPage-->
<docs:EverythingIsABlockPage xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:docs="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:core="org.blockml.bml.core"
  xmlns:workflow="org.blockml.bml.transformer.workflow"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to BlockML's unifying Everything-is-a-Block principle
  </is>
  <documentation>
    Scope: the Everything-is-a-Block model, single inheritance root, and why one grammar covers
    domain and framework types, grounded in org.blockml.bml.documentation.EverythingIsABlock and
    org.blockml.bml.core.Block. Body content is authored in a03 from those sources.
  </documentation>
  <references>
    <see type="doc:EverythingIsABlock" relation="Requires">
      Primary content source — one root, one parser, one TypeRegistry bootstrap path.
    </see>
    <see type="core:Block" relation="Requires">
      Sole inheritance root every BlockML concept ultimately extends.
    </see>
    <see type="doc:CoreUseCases" relation="SeeAlso">
      What the principle is used for.
    </see>
    <see type="doc:BlockAndInstance" relation="ReadNext">
      Next reading step — definition versus instance.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Everything Is a Block</value>
    </title>
    <purpose override="true">
      <value>Teach Everything-is-a-Block as BlockML's unifying principle, so readers see domain types, ValueTypes, Languages, and even documentation as the same kind of thing before any member-level detail follows.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <workflow:AuthorativeSourceSet>
          <includedTypes>
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.EverythingIsABlock" />
            <type:TypeSelectorEntity value="org.blockml.bml.core.Block" />
          </includedTypes>
        </workflow:AuthorativeSourceSet>
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>Teach Everything-is-a-Block as the language's unifying principle, distinguishing the authoring ontology from free compiler internals.</summary>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>The reader can explain why domain types, ValueTypes, Languages, and documentation blocks are all Blocks.</summary>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>The Everything-is-a-Block model: one inheritance root, one parser, and one TypeRegistry bootstrap path for domain types, ValueTypes, Languages, and Definitions alike.</summary>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>The full member model and inheritance mechanics.</summary>
          <reason>Those get dedicated pages; this page only establishes the unifying principle.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <supportingPoints override="true">
      <composition>
        <sem:SupportingPoint>
          <summary>A concrete domain example grounds the abstraction: composable domain types, ValueTypes such as Integer, and Languages such as TypeScript are all Blocks under the same root.</summary>
        </sem:SupportingPoint>
      </composition>
    </supportingPoints>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="One idea underlies everything" purpose="Give an immediate orientation to the unifying principle">
          <content>
            <dpage:Paragraph purpose="State the Everything-is-a-Block principle in one sentence">
              <role>org.blockml.bml.docgen.role.Lead</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Every concept BlockML's grammar can express — a domain type, a value type, a
language, or a piece of documentation — is a Block, described the same way and
traced back to the same root.</message>
              <authoritativeSources>
                <doc:EverythingIsABlock />
              </authoritativeSources>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Single root-->
        <dpage:Section heading="A single root, one parser, one TypeRegistry" purpose="Establish the shared bootstrap path every Block goes through">
          <content>
            <dpage:Paragraph purpose="Explain the single-root, single-parser, single-registry model">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Every Block ultimately extends the same sole inheritance root, is read by the
same parser, and is registered through the same bootstrap path, so branch-specific
behavior comes from that root's chain of specialization rather than from separate
parallel systems.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>One root, one parser, one TypeRegistry bootstrap path applies uniformly, whatever kind of Block is being described.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.EverythingIsABlock" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Same grammar, many kinds-->
        <dpage:Section heading="The same grammar covers domain and framework concepts" purpose="Ground the abstraction in concrete kinds of Block">
          <content>
            <dpage:Paragraph purpose="Introduce the list of concrete Block kinds">
              <role>org.blockml.bml.docgen.role.Transition</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>Several very different-looking things in BlockML all turn out to be Blocks
under this one principle.</message>
            </dpage:Paragraph>
            <dpage:List purpose="Enumerate concrete kinds of Block that share the one grammar">
              <role>org.blockml.bml.docgen.role.Summary</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Domain types, value types, languages, and the definitions that describe Block
structure itself are all just Blocks.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>A concrete domain example grounds the abstraction: composable domain types, value types such as Integer, and languages such as TypeScript are all Blocks under the same root.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.EverythingIsABlock" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
              <items>
                <dpage:ListItem text="Domain types" purpose="Name composable domain types as Blocks">
                  <message>A composable domain type describing something in a modeled world is a Block.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Value types" purpose="Name value types as Blocks">
                  <message>A value type that describes the nature of a value, such as an integer or a size, is a Block.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Languages" purpose="Name implementation languages as Blocks">
                  <message>An implementation language binding used to express behavior is a Block.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Definitions" purpose="Name the definition meta-model as Blocks">
                  <message>The definitions that describe a Block's own structure are themselves Blocks.</message>
                </dpage:ListItem>
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <!--4. Authoring ontology vs compiler internals-->
        <dpage:Section heading="Authoring ontology versus compiler internals" purpose="Distinguish the semantic model authors see from free internal representation">
          <content>
            <dpage:Paragraph purpose="Explain that the Block ontology is an authoring-level distinction, not a runtime mandate">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Treating everything as a named, identifiable Block with its own place in a
chain of specialization is a property of the authoring model, not a requirement on
how the compiler must represent things internally.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>The authoring ontology gives every Block a fully qualified name and a chain of specialization; compiler internals remain free to use whatever representation is convenient.</summary>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. Looking ahead-->
        <dpage:Section heading="What this principle sets up" purpose="Prepare the reader for the next page's closer look at a Block">
          <content>
            <dpage:Paragraph purpose="Transition toward examining a single Block closely">
              <role>org.blockml.bml.docgen.role.Transition</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>Because every concept is a Block, learning how one Block is defined, named,
and referenced is enough to start reading any part of a BlockML model.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with a single Block" purpose="Direct the reader to the next page">
          <content>
            <dpage:Navigation purpose="Continue from the unifying principle into a single Block">
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Blocks" summary="Learn how a single Block is defined, named, and referenced.">
                  <target>docs:Blocks</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:EverythingIsABlockPage>
