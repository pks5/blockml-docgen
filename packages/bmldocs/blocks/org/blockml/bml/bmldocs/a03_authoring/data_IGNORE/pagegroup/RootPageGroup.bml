<!--BlockML Documentation — top-level root page group

  FQN: org.blockml.bml.bmldocs.a03_authoring.data.pagegroup.RootPageGroup-->
<pgroup:RootPageGroup xmlns="http://blockml.org/bml"
  xmlns:pgroup="org.blockml.bml.bmldocs.a03_authoring.data.pagegroup"
  xmlns:dcore="org.blockml.bml.docgen.core">

  <baseType>
    dcore:PageGroup
  </baseType>
  <is>
    The top-level container for all a03 page groups
  </is>
  <documentation>
    Outermost A03 page group; this group is the A03 counterpart of a02_structuring's
    RootPageGroup. pages / landingPage / parentGroup name only A03 Blocks. Has no direct pages
    and no parentGroup. DocsPageGroup nests under this group via parentGroup.
  </documentation>
  <references>
    <see type="dcore:PageGroup" relation="Extends">
      Docgen page group base.
    </see>
    <see type="pgroup:DocsPageGroup" relation="Requires">
      Documentation subtree nested under this root.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Root</value>
    </title>
  </properties>
</pgroup:RootPageGroup>
