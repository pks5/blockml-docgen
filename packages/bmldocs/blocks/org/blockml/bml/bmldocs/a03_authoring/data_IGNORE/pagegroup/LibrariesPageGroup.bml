<!--BlockML Documentation — Libraries page group

  FQN: org.blockml.bml.bmldocs.a03_authoring.data.pagegroup.LibrariesPageGroup-->
<pgroup:LibrariesPageGroup xmlns="http://blockml.org/bml"
  xmlns:pgroup="org.blockml.bml.bmldocs.a03_authoring.data.pagegroup"
  xmlns:page="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:dcore="org.blockml.bml.docgen.core">

  <baseType>
    dcore:PageGroup
  </baseType>
  <is>
    The Libraries page group for the a03 documentation set
  </is>
  <documentation>
    Section page group; this group is the A03 counterpart of a02_structuring's
    LibrariesPageGroup. pages / landingPage / parentGroup name only A03 Blocks. Direct pages:
    LibrariesAndPackages, ReadmeAndBootstrap. parentGroup is DocsPageGroup.
  </documentation>
  <references>
    <see type="dcore:PageGroup" relation="Extends">
      Docgen page group base.
    </see>
    <see type="pgroup:DocsPageGroup" relation="Requires">
      Parent Documentation root page group.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Libraries</value>
    </title>
    <parentGroup override="true">
      <value>pgroup:DocsPageGroup</value>
    </parentGroup>
  </properties>
  <aggregations>
    <pages override="true">
      <composition>
        <page:LibrariesAndPackages />
        <page:ReadmeAndBootstrap />
      </composition>
    </pages>
  </aggregations>
</pgroup:LibrariesPageGroup>
