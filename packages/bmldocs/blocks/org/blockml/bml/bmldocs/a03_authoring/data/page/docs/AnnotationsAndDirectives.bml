<!--BlockML Documentation — Annotations and directives

  FQN: org.blockml.bml.bmldocs.a03_authoring.data.page.docs.AnnotationsAndDirectives-->
<page:AnnotationsAndDirectives xmlns="http://blockml.org/bml"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:page="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:dlevel="org.blockml.bml.docgen.level"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:role="org.blockml.bml.docgen.role"
  xmlns:weight="org.blockml.bml.docgen.weight"
  xmlns:core="org.blockml.bml.core"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A website page for annotations and bml: directives
  </is>
  <documentation>
    Marker page: annotation namespaces vs directives, then a short tour of bml:each, bml:if,
    bml:container, bml:with, and bml:xml — examples over taxonomy tables.
    
    content is a structural scaffold only; generate prose and examples from referenced core
    documentation (doc:AnnotationModel, doc:BmlDirectives).
  </documentation>
  <references>
    <see type="doc:AnnotationModel" relation="Requires">
      Primary content — annotation namespaces and facets.
    </see>
    <see type="doc:BmlDirectives" relation="Requires">
      Primary content — bml:each, bml:if, bml:container, bml:with, bml:xml.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Annotations and directives</value>
    </title>
    <purpose override="true">
      <value>Frame annotations as directive namespaces orthogonal to Definition members.</value>
    </purpose>
    <detailLevel override="true">
      <value>dlevel:Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>ptype:Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <doc:AnnotationModel />
        <doc:BmlDirectives />
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <authoritativeSources>
            <doc:AnnotationModel />
            <doc:BmlDirectives />
          </authoritativeSources>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <authoritativeSources>
            <doc:AnnotationModel />
          </authoritativeSources>
        </sem:ReaderOutcome>
        <sem:ReaderOutcome>
          <authoritativeSources>
            <doc:BmlDirectives />
          </authoritativeSources>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <authoritativeSources>
            <doc:AnnotationModel />
            <doc:BmlDirectives />
          </authoritativeSources>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <reason>This page frames roles; attribute catalogues belong in dedicated references.</reason>
        </sem:Exclusion>
        <sem:Exclusion>
          <reason>Diagnostic identifiers belong on reference and troubleshooting pages.</reason>
        </sem:Exclusion>
        <sem:Exclusion>
          <reason>The conceptual model should stay free of project-status notes.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Annotations sit beside Definition structure" purpose="Frame annotations as directive namespaces orthogonal to Definition">
          <content>
            <dpage:Paragraph purpose="Introduce annotations as directive namespaces">
              <role>role:Lead</role>
              <detailLevel>dlevel:Overview</detailLevel>
              <weight>weight:Primary</weight>
              <message>Annotations provide directive namespaces that sit orthogonal to ordinary
Definition members instead of describing block structure themselves.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:AnnotationModel />
                    <doc:BmlDirectives />
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:AnnotationModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:BmlDirectives />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Annotation vs Definition-->
        <dpage:Section heading="Annotation versus Definition" purpose="Explain the orthogonality of annotation namespaces">
          <content>
            <dpage:Paragraph purpose="Contrast Annotation namespaces with Definition members">
              <role>role:Explanation</role>
              <detailLevel>dlevel:Introductory</detailLevel>
              <weight>weight:Primary</weight>
              <message>Annotations do not describe block structure; naming overlap with Definition
concepts only classifies directive form, not membership in the model tree.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:AnnotationModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:AnnotationModel />
                    <doc:BmlDirectives />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
            <dpage:Paragraph purpose="Explain why xmlns:bml binds the directive namespace">
              <role>role:Explanation</role>
              <detailLevel>dlevel:Introductory</detailLevel>
              <weight>weight:Primary</weight>
              <message>Authors bind xmlns:bml to the annotation namespace so directive attributes and
elements are recognized without polluting Definition membership.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:BmlDirectives />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Common directives-->
        <dpage:Section heading="Common bml: directives" purpose="Summarize principal directive roles without syntax tutorials">
          <content>
            <dpage:Paragraph purpose="Prepare the reader for the common directive roles">
              <role>role:Transition</role>
              <detailLevel>dlevel:Overview</detailLevel>
              <weight>weight:Supporting</weight>
              <message>A small set of bml: directives covers the everyday authoring controls without
requiring a full attribute catalogue here.</message>
            </dpage:Paragraph>
            <dpage:List purpose="Present common directives as conceptual messages">
              <role>role:Summary</role>
              <detailLevel>dlevel:Overview</detailLevel>
              <weight>weight:Primary</weight>
              <message>These directives cover repetition, condition, containment, binding, and
serialization hints.</message>
              <items>
                <dpage:ListItem text="each" purpose="Describe bml:each for repetition">
                  <message>each expresses repetition over a collection in authoring flow.</message>
                </dpage:ListItem>
                <dpage:ListItem text="if" purpose="Describe bml:if for conditional inclusion">
                  <message>if includes or omits content based on a condition.</message>
                </dpage:ListItem>
                <dpage:ListItem text="container" purpose="Describe bml:container as a general virtual container">
                  <message>container provides a general virtual container without becoming a Definition
member.</message>
                </dpage:ListItem>
                <dpage:ListItem text="with" purpose="Describe bml:with for binding context">
                  <message>with binds a temporary context for nested authoring.</message>
                </dpage:ListItem>
                <dpage:ListItem text="xml" purpose="Describe bml:xml for serialization hints">
                  <message>xml carries serialization hints for XML-oriented processing.</message>
                </dpage:ListItem>
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <!--4. Annotation facets-->
        <dpage:Section heading="Value and example Annotation facets" purpose="Explain Annotation facets as orthogonal multipliers beside canonical slots">
          <content>
            <dpage:Paragraph purpose="Explain that Annotation facets multiply values and examples by namespace">
              <role>role:Explanation</role>
              <detailLevel>dlevel:Introductory</detailLevel>
              <weight>weight:Primary</weight>
              <message>Annotation facets multiply property values and examples along an Annotation
namespace axis; they never replace the required canonical value, documentation,
or examples slots.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:AnnotationModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:AnnotationModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:AnnotationModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
              <exclusions>
                <sem:Exclusion />
              </exclusions>
            </dpage:Paragraph>
            <dpage:Paragraph purpose="Prepare the reader for facet versus canonical slot roles">
              <role>role:Transition</role>
              <detailLevel>dlevel:Overview</detailLevel>
              <weight>weight:Supporting</weight>
              <message>Keep canonical Definition slots and Annotation facets conceptually separate.</message>
            </dpage:Paragraph>
            <dpage:List purpose="Present facet versus canonical roles as a concise summary">
              <role>role:Summary</role>
              <detailLevel>dlevel:Overview</detailLevel>
              <weight>weight:Primary</weight>
              <message>These roles keep facets orthogonal to required Definition slots.</message>
              <items>
                <dpage:ListItem text="Canonical slots" purpose="Keep required value and examples on the Definition">
                  <message>Canonical value, documentation, and examples remain required Definition
slots.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Value facets" purpose="Describe Annotation value facets beside a property">
                  <message>Value facets add namespace-specific property values beside the canonical
value.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Example facets" purpose="Describe Annotation example facets beside canonical examples">
                  <message>Example facets pair target-specific examples with canonical ones without
becoming Definition members.</message>
                </dpage:ListItem>
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <!--5. Minimal example-->
        <dpage:Section heading="Binding xmlns:bml and a directive" purpose="Connect the concept to a small directive sketch">
          <content>
            <dpage:Paragraph purpose="Introduce xmlns:bml binding with a flow-control directive">
              <role>role:Explanation</role>
              <detailLevel>dlevel:Introductory</detailLevel>
              <weight>weight:Supporting</weight>
              <message>A short fragment binds xmlns:bml to the annotation namespace and uses a
flow-control directive such as if or each.</message>
              <exclusions>
                <sem:Exclusion>
                  <reason>The example teaches namespace binding and one directive role, not a catalogue.</reason>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>
            <dpage:CodeBlock purpose="Illustrate xmlns:bml with a directive attribute">
              <role>role:Example</role>
              <detailLevel>dlevel:Overview</detailLevel>
              <weight>weight:Supporting</weight>
              <message>A fragment binds xmlns:bml to the annotation namespace and uses a flow-control
directive such as if or each.</message>
              <supportingPoints>
                <sem:SupportingPoint />
                <sem:SupportingPoint />
              </supportingPoints>
              <exclusions>
                <sem:Exclusion />
              </exclusions>
            </dpage:CodeBlock>
            <dpage:Paragraph purpose="Interpret the xmlns:bml binding and directive in the example">
              <role>role:Explanation</role>
              <detailLevel>dlevel:Introductory</detailLevel>
              <weight>weight:Supporting</weight>
              <message>In the example, xmlns:bml opens the annotation namespace, and the if or each
directive controls authoring flow beside ordinary members rather than as one.</message>
              <supportingPoints>
                <sem:SupportingPoint />
                <sem:SupportingPoint />
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with composition" purpose="Direct the reader to Composition for container relationships">
          <content>
            <dpage:Navigation purpose="Continue the learning sequence">
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Composition basics" summary="Relate containers and composition to ordinary Definition structure.">
                  <target>page:CompositionBasics</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</page:AnnotationsAndDirectives>
