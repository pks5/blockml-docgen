<!--BlockML Documentation — Anatomy of a .bml file

  FQN: org.blockml.bml.bmldocs.a03_authoring.data.page.docs.FileAnatomy-->
<page:FileAnatomy xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:page="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:workflow="org.blockml.bml.transformer.workflow"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A .bml file anatomy cheat-sheet
  </is>
  <documentation>
    Marker page: walk through the required identity fields, is/documentation, and naming
    conventions for a root .bml document — short labeled anatomy, not a full style guide.
    content is a structural scaffold only; generate prose and examples from referenced core
    documentation (doc:DocumentationModel, doc:BlockNameConvention).
  </documentation>
  <references>
    <see type="doc:DocumentationModel" relation="Requires">
      Primary content — is, documentation, references, examples.
    </see>
    <see type="doc:BlockNameConvention" relation="Requires">
      Primary content — PascalCase name rules and type identity.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Anatomy of a .bml file</value>
    </title>
    <purpose override="true">
      <value>Give readers a structural cheat-sheet for the ordered fields of a root Block document.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Guide</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <workflow:AuthorativeSourceSet>
          <includedTypes>
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.DocumentationModel" />
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.BlockNameConvention" />
            <type:TypeSelectorEntity value="org.blockml.bml.core.Block" />
          </includedTypes>
        </workflow:AuthorativeSourceSet>
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>Recognize the ordered identity and documentation fields of a root Block document.</summary>
          <authoritativeSources>
            <workflow:AuthorativeSourceSet>
              <includedTypes>
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.DocumentationModel" />
                <type:TypeSelectorEntity value="org.blockml.bml.core.Block" />
              </includedTypes>
            </workflow:AuthorativeSourceSet>
          </authoritativeSources>
        </sem:LearningObjective>
        <sem:LearningObjective>
          <summary>Apply PascalCase Block naming rules at a conceptual level.</summary>
          <authoritativeSources>
            <workflow:AuthorativeSourceSet>
              <includedTypes>
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.BlockNameConvention" />
              </includedTypes>
            </workflow:AuthorativeSourceSet>
          </authoritativeSources>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>The reader can map the main ordered fields of a typical root .bml file.</summary>
          <authoritativeSources>
            <workflow:AuthorativeSourceSet>
              <includedTypes>
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.DocumentationModel" />
                <type:TypeSelectorEntity value="org.blockml.bml.core.Block" />
              </includedTypes>
            </workflow:AuthorativeSourceSet>
          </authoritativeSources>
        </sem:ReaderOutcome>
        <sem:ReaderOutcome>
          <summary>The reader can state valid versus invalid Block name forms without diagnostic codes.</summary>
          <authoritativeSources>
            <workflow:AuthorativeSourceSet>
              <includedTypes>
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.BlockNameConvention" />
              </includedTypes>
            </workflow:AuthorativeSourceSet>
          </authoritativeSources>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>Provide a structural cheat-sheet for the ordered fields of a root Block document.</summary>
          <authoritativeSources>
            <workflow:AuthorativeSourceSet>
              <includedTypes>
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.DocumentationModel" />
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.BlockNameConvention" />
                <type:TypeSelectorEntity value="org.blockml.bml.core.Block" />
              </includedTypes>
            </workflow:AuthorativeSourceSet>
          </authoritativeSources>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>Full style-guide advice beyond file anatomy and naming.</summary>
          <reason>This page is a short labeled map, not a modeling style guide.</reason>
        </sem:Exclusion>
        <sem:Exclusion>
          <summary>Validator diagnostic identifiers and detailed validation behavior.</summary>
          <reason>Diagnostic details belong on reference and troubleshooting pages.</reason>
        </sem:Exclusion>
        <sem:Exclusion>
          <summary>Capabilities, constraints, and versioning noise in the skeleton example.</summary>
          <reason>The annotated skeleton should show identity, documentation, properties, and references.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="A structural map of a Block document" purpose="Introduce the page as a .bml anatomy cheat-sheet">
          <content>
            <dpage:Paragraph purpose="Explain this page as a structural map of a root Block document">
              <role>org.blockml.bml.docgen.role.Lead</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>This page is a short structural map of the ordered fields in a root Block
document, not a full style guide.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>Identity fields come first, then documentation fields, then ordinary members.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.core.Block" />
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.DocumentationModel" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>Naming conventions keep the local Block name readable and valid.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.BlockNameConvention" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>An annotated skeleton ties the ordered fields together in one view.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.core.Block" />
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.DocumentationModel" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Identity before prose-->
        <dpage:Section heading="Identity before prose" purpose="Place identity fields ahead of documentation prose">
          <content>
            <dpage:Paragraph purpose="Cover is, documentation, references, and examples from doc:DocumentationModel">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>After identity, a definition carries is, documentation, references, and
optional examples that explain the Block for humans and tools.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>is states the Block in one short sentence.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.DocumentationModel" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>documentation expands intent for humans and tools beyond that one-liner.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.DocumentationModel" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>references and examples point to related material without replacing the Block's own documentation.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.DocumentationModel" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
            <dpage:Paragraph purpose="Stress identity first: name, type, baseType before prose">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Name, type, and baseType come first so the Block is identifiable before any
prose is read.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>name is the local Block identifier in the file.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.core.Block" />
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.BlockNameConvention" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>type and baseType place the Block in the type system and inheritance chain.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.core.Block" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>Prose fields follow only after that identity trio is present.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.DocumentationModel" />
                        <type:TypeSelectorEntity value="org.blockml.bml.core.Block" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Naming-->
        <dpage:Section heading="Naming the Block" purpose="Summarize PascalCase Block name rules">
          <content>
            <dpage:Paragraph purpose="Summarize PascalCase name rules from doc:BlockNameConvention">
              <role>org.blockml.bml.docgen.role.Transition</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>Block names follow a simple PascalCase convention that keeps type identity readable.</message>
              <exclusions>
                <sem:Exclusion>
                  <summary>Validator diagnostic identifiers for invalid names.</summary>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>
            <dpage:List purpose="Name rules to remember">
              <role>org.blockml.bml.docgen.role.Summary</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Remember the valid format and the forms that fail the naming convention.</message>
              <items>
                <dpage:ListItem text="PascalCase format" purpose="Letters and digits only; start with uppercase">
                  <message>Use letters and digits only, and start the name with an uppercase letter.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Invalid forms" purpose="Invalid: hyphens, underscores, spaces, leading digits">
                  <message>Hyphens, underscores, spaces, and leading digits are invalid Block name forms.</message>
                </dpage:ListItem>
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <!--4. Annotated skeleton-->
        <dpage:Section heading="Annotated skeleton" purpose="Show the ordered fields of a typical root .bml">
          <content>
            <dpage:Paragraph purpose="Walk through the ordered fields of a typical root .bml">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>A typical root .bml orders identity, documentation fields, properties, and
references in a stable skeleton.</message>
              <exclusions>
                <sem:Exclusion>
                  <summary>Capabilities, constraints, and versioning in the skeleton.</summary>
                  <reason>The annotated example should stay focused on the cheat-sheet fields.</reason>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>
            <dpage:CodeBlock purpose="Annotated skeleton showing identity, documentation, properties, references">
              <role>org.blockml.bml.docgen.role.Example</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>Illustrate an annotated root Block skeleton with identity, documentation,
properties, and references.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>Highlight the ordered identity trio name, type, and baseType at the top of the root Block.</summary>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>Highlight is, documentation, and references as the documentation-model fields that follow identity.</summary>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>Highlight a small properties section as the first ordinary member area in the skeleton.</summary>
                </sem:SupportingPoint>
              </supportingPoints>
              <exclusions>
                <sem:Exclusion>
                  <summary>Capabilities, constraints, and versioning noise.</summary>
                </sem:Exclusion>
              </exclusions>
            </dpage:CodeBlock>
            <dpage:Paragraph purpose="Interpret the annotated skeleton's field order and roles">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>Read the skeleton top to bottom: name, type, and baseType identify the Block,
is and documentation explain it, references point outward, and properties
begin the ordinary member area.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>Notice that prose fields never precede identity — the Block is named before it is described.</summary>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>The properties section shows where members live without introducing capabilities or constraints into the cheat-sheet.</summary>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. Field-order checklist implications-->
        <dpage:Section heading="Common field-order mistakes" purpose="Summarize overview-depth mistakes that break the ordered anatomy">
          <content>
            <dpage:Paragraph purpose="Explain why the ordered checklist matters in practice">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>The ordered skeleton is a checklist: when fields appear in the wrong place or
under the wrong name form, the document stops reading as a clear Block anatomy.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>Identity must precede prose so name, type, and baseType identify the Block before is or documentation explain it.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.core.Block" />
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.DocumentationModel" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>PascalCase naming mistakes are anatomy errors, not merely style nits, because the local name is part of type identity.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.BlockNameConvention" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>Stuffing capabilities, constraints, or versioning into a first skeleton hides the cheat-sheet fields this page is meant to teach.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.DocumentationModel" />
                        <type:TypeSelectorEntity value="org.blockml.bml.core.Block" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
              <exclusions>
                <sem:Exclusion>
                  <summary>Validator diagnostic identifiers and full style-guide advice.</summary>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>
            <dpage:List purpose="Checklist of overview-depth mistakes to avoid">
              <role>org.blockml.bml.docgen.role.Summary</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Avoid these field-order and naming mistakes when sketching a root .bml.</message>
              <items>
                <dpage:ListItem text="Prose before identity" purpose="Mistake: is or documentation ahead of name, type, baseType">
                  <message>Do not place is or documentation ahead of name, type, and baseType.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Invalid name forms" purpose="Mistake: hyphens, underscores, spaces, or leading digits">
                  <message>Do not use hyphens, underscores, spaces, or leading digits in the Block name.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Skeleton overload" purpose="Mistake: capabilities and constraints crowding the first map">
                  <message>Do not crowd a first anatomy sketch with capabilities, constraints, or
versioning before the identity and documentation fields are clear.</message>
                </dpage:ListItem>
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <!--6. Navigation-->
        <dpage:Section heading="Continue with practice and guidelines" purpose="Direct the reader to related pages">
          <content>
            <dpage:Navigation purpose="Continue from the file anatomy cheat-sheet">
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Your first Block" summary="Walk through a first Block definition with a tiny example.">
                  <target>page:FirstBlock</target>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Modeling guidelines" summary="Apply broader authoring guidance after the file map.">
                  <target>page:ModelingGuidelinesPage</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</page:FileAnatomy>
