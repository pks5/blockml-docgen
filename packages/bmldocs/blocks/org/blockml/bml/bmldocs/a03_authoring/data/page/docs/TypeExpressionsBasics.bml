<!--BlockML Documentation — Type expressions basics

  FQN: org.blockml.bml.bmldocs.a03_authoring.data.page.docs.TypeExpressionsBasics-->
<page:TypeExpressionsBasics xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:page="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A website cheat-sheet for type expressions
  </is>
  <documentation>
    Marker page: bite-sized type expression patterns — multiplicity, unions, match order — as a
    cheat-sheet with examples, not a complete specification.
    content is a structural scaffold only; generate prose and examples from referenced core
    documentation (doc:TypeExpressions).
  </documentation>
  <references>
    <see type="doc:TypeExpressions" relation="Requires">
      Primary content source — multiplicity, unions, and match order.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Type expressions</value>
    </title>
    <purpose override="true">
      <value>Cheat-sheet for combining named types into type expressions.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Guide</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <doc:TypeExpressions />
        <doc:TypeSystemOverview />
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <authoritativeSources>
            <doc:TypeExpressions />
            <doc:TypeSystemOverview />
          </authoritativeSources>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <authoritativeSources>
            <doc:TypeExpressions />
          </authoritativeSources>
        </sem:ReaderOutcome>
        <sem:ReaderOutcome>
          <authoritativeSources>
            <doc:TypeExpressions />
            <doc:TypeSystemOverview />
          </authoritativeSources>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <authoritativeSources>
            <doc:TypeExpressions />
            <doc:TypeSystemOverview />
          </authoritativeSources>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <reason>Generics deserve a focused page; inheritance details would overwhelm this cheat-sheet.</reason>
        </sem:Exclusion>
        <sem:Exclusion>
          <reason>Diagnostics belong on reference and troubleshooting pages.</reason>
        </sem:Exclusion>
        <sem:Exclusion>
          <reason>This page is a usage map, not a complete specification.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Combining named types" purpose="Position this page as a cheat-sheet for type expressions">
          <content>
            <dpage:Paragraph purpose="Introduce type expressions as usage of named types, not new type classes">
              <role>org.blockml.bml.docgen.role.Lead</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Type expressions combine named types into the forms authors write on
properties and other typed members.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:TypeExpressions />
                    <doc:TypeSystemOverview />
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:TypeExpressions />
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:TypeExpressions />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. ValueType vs TypeExpression-->
        <dpage:Section heading="ValueType versus TypeExpression" purpose="Establish the distinction between named meaning and combination forms">
          <content>
            <dpage:Paragraph purpose="Explain ValueType as named semantic meaning versus TypeExpression as combination">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A ValueType names semantic meaning; a TypeExpression applies multiplicity,
unions, generic application, or configuration to named types at a use site.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:TypeSystemOverview />
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:TypeExpressions />
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:TypeExpressions />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
              <exclusions>
                <sem:Exclusion />
              </exclusions>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Match order-->
        <dpage:Section heading="Union match order" purpose="Explain left-to-right first-hit matching for union alternatives">
          <content>
            <dpage:Paragraph purpose="Explain that union alternatives match left to right, first hit wins">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Union alternatives are matched left to right; the first alternative that
fits wins, with no best-match search.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:TypeExpressions />
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:TypeExpressions />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
              <exclusions>
                <sem:Exclusion />
              </exclusions>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Summary of forms-->
        <dpage:Section heading="Common expression forms" purpose="Summarize the forms readers will see most often">
          <content>
            <dpage:Paragraph purpose="Prepare the reader for the common-forms summary list">
              <role>org.blockml.bml.docgen.role.Transition</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>Most everyday type expressions are built from a small set of combination forms.</message>
            </dpage:Paragraph>
            <dpage:List purpose="Present common type-expression forms as a concise summary">
              <role>org.blockml.bml.docgen.role.Summary</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>These forms are the everyday building blocks of type expressions.</message>
              <items>
                <dpage:ListItem text="Multiplicity" purpose="Explain array and range multiplicity forms">
                  <message>Multiplicity forms such as arrays and ranges describe how many values
of a type are expected.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Unions" purpose="Explain union alternatives and match order">
                  <message>Unions combine alternatives, and match order matters when more than
one alternative could apply.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Generics" purpose="Explain generic application at use sites">
                  <message>Generic application binds type arguments at a use site.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Configuration" purpose="Explain curly-brace configuration on the property type instance">
                  <message>Curly-brace configuration specializes the ValueType instance on a
property without redefining the type itself.</message>
                </dpage:ListItem>
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <!--5. Example-->
        <dpage:Section heading="Multiplicity and union" purpose="Connect the cheat-sheet to a small type-expression example">
          <content>
            <dpage:Paragraph purpose="Introduce multiplicity and a simple union on a property type">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>Two frequent patterns are array multiplicity and a simple union of named types.</message>
              <exclusions>
                <sem:Exclusion />
              </exclusions>
            </dpage:Paragraph>
            <dpage:CodeBlock purpose="Illustrate a complete Block using multiplicity and union type expressions">
              <role>org.blockml.bml.docgen.role.Example</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>Show a complete root Block with property types that use multiplicity brackets
and a simple union of named ValueTypes.</message>
              <supportingPoints>
                <sem:SupportingPoint />
                <sem:SupportingPoint />
              </supportingPoints>
              <exclusions>
                <sem:Exclusion />
              </exclusions>
            </dpage:CodeBlock>
            <dpage:Paragraph purpose="Interpret the multiplicity and union constructs in the example">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>In the example, multiplicity brackets describe how many values a property
expects, while the union lists alternatives that still resolve left to right.</message>
              <supportingPoints>
                <sem:SupportingPoint />
                <sem:SupportingPoint />
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Navigation-->
        <dpage:Section heading="Continue with generics and configuration" purpose="Direct the reader to related type topics">
          <content>
            <dpage:Navigation purpose="Continue the type-expression learning sequence">
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Generics briefly" summary="See how type parameters are declared and bound on Blocks.">
                  <target>page:GenericsBriefly</target>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Configuring ValueTypes" summary="Learn curly-brace configuration of ValueType instances on properties.">
                  <target>page:ConfiguringTypes</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</page:TypeExpressionsBasics>
