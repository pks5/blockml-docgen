<!--BlockML Documentation — Constraints basics

  FQN: org.blockml.bml.bmldocs.a03_authoring.data.page.docs.ConstraintsBasics-->
<page:ConstraintsBasics xmlns="http://blockml.org/bml"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:page="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:lpage="org.blockml.bml.bmldocs.lib.page"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:dlevel="org.blockml.bml.docgen.level"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:role="org.blockml.bml.docgen.role"
  xmlns:weight="org.blockml.bml.docgen.weight"
  xmlns:core="org.blockml.bml.core"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    lpage:BmlDocPage
  </baseType>
  <is>
    A website intro to constraints
  </is>
  <documentation>
    Marker page: attach a simple constraint, understand severity vs suggestions — one MinLength-
    style example is enough for the first pass.
    
    content is a structural scaffold only; generate prose and examples from referenced core
    documentation (doc:ConstraintsModel, doc:ValueTypeConfiguration).
  </documentation>
  <references>
    <see type="doc:ConstraintsModel" relation="Requires">
      Primary content — constraints, suggestions, and Enum rules.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Constraints</value>
    </title>
    <purpose override="true">
      <value>Introduce reusable validation rules on constrainable definition elements.</value>
    </purpose>
    <detailLevel override="true">
      <value>dlevel:Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>ptype:Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <doc:ConstraintsModel />
        <doc:ValueTypeConfiguration />
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <authoritativeSources>
            <doc:ConstraintsModel />
            <doc:ValueTypeConfiguration />
          </authoritativeSources>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <authoritativeSources>
            <doc:ConstraintsModel />
          </authoritativeSources>
        </sem:ReaderOutcome>
        <sem:ReaderOutcome>
          <authoritativeSources>
            <doc:ConstraintsModel />
          </authoritativeSources>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <authoritativeSources>
            <doc:ConstraintsModel />
            <doc:ValueTypeConfiguration />
          </authoritativeSources>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <reason>An introductory page should teach the attachment model, not list every branch.</reason>
        </sem:Exclusion>
        <sem:Exclusion>
          <reason>Diagnostic identifiers belong on reference and troubleshooting pages.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Reusable validation on definition elements" purpose="Give readers an immediate orientation to constraints">
          <content>
            <dpage:Paragraph purpose="Introduce reusable validation rules on ConstrainableDefinition elements">
              <role>role:Lead</role>
              <detailLevel>dlevel:Overview</detailLevel>
              <weight>weight:Primary</weight>
              <message>Constraints are reusable validation rules attached to constrainable definition
elements such as properties and related members.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:ConstraintsModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:ConstraintsModel />
                    <doc:ValueTypeConfiguration />
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:ConstraintsModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Context-bound container-->
        <dpage:Section heading="One constraints container, context-bound" purpose="Explain that embedding context binds the constraint without a target property">
          <content>
            <dpage:Paragraph purpose="Explain the single constraints container and missing target property">
              <role>role:Explanation</role>
              <detailLevel>dlevel:Introductory</detailLevel>
              <weight>weight:Primary</weight>
              <message>A definition uses a single constraints container, and embedding context binds
each constraint automatically without a target= property.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:ConstraintsModel />
                    <doc:ValueTypeConfiguration />
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:ConstraintsModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
              <exclusions>
                <sem:Exclusion />
              </exclusions>
            </dpage:Paragraph>
            <dpage:Paragraph purpose="Relate constraints to ValueType configuration on members">
              <role>role:Explanation</role>
              <detailLevel>dlevel:Introductory</detailLevel>
              <weight>weight:Primary</weight>
              <message>Constraints often appear beside ValueType configuration on the same member,
keeping validation next to the typed value they guard.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:ValueTypeConfiguration />
                    <doc:ConstraintsModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Branches summary-->
        <dpage:Section heading="Branches, suggestions, and Enums" purpose="Summarize the related constraint topics readers should retain">
          <content>
            <dpage:Paragraph purpose="Prepare the reader for related constraint topics">
              <role>role:Transition</role>
              <detailLevel>dlevel:Overview</detailLevel>
              <weight>weight:Supporting</weight>
              <message>Constraint branches, suggestions, and Enum-related patterns frame how rules
and authoring help appear together.</message>
            </dpage:Paragraph>
            <dpage:List purpose="Present constraint topics as a concise summary">
              <role>role:Summary</role>
              <detailLevel>dlevel:Overview</detailLevel>
              <weight>weight:Primary</weight>
              <message>These topics frame how constraints and related help appear in authoring.</message>
              <items>
                <dpage:ListItem text="Branches" purpose="Mention constraint branches and genericTypes">
                  <message>Constraint branches and genericTypes organize reusable rule kinds.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Suggestions" purpose="Mention suggestions as related authoring help">
                  <message>Suggestions provide related authoring help beside validation rules.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Enums" purpose="Mention Enum-related constraint patterns">
                  <message>Enum-related patterns constrain allowed values without a separate language.</message>
                </dpage:ListItem>
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <!--4. Validation severity-->
        <dpage:Section heading="Validation severity and metadata-only rules" purpose="Explain optional validation levels and the preference for inline type config">
          <content>
            <dpage:Paragraph purpose="Explain optional validation severity on constraints">
              <role>role:Explanation</role>
              <detailLevel>dlevel:Introductory</detailLevel>
              <weight>weight:Primary</weight>
              <message>A constraint may declare an optional validation severity — Error, Warning, or
Information — and when validation is omitted the rule remains metadata only.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:ConstraintsModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:ConstraintsModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
              <exclusions>
                <sem:Exclusion />
              </exclusions>
            </dpage:Paragraph>
            <dpage:Paragraph purpose="Prefer ValueType configuration for type-intrinsic thresholds">
              <role>role:Explanation</role>
              <detailLevel>dlevel:Introductory</detailLevel>
              <weight>weight:Primary</weight>
              <message>Prefer ValueType curly-brace configuration for type-intrinsic thresholds, and
keep Constraints for contextual or composable rules beside that type shape.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:ValueTypeConfiguration />
                    <doc:ConstraintsModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:ConstraintsModel />
                    <doc:ValueTypeConfiguration />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. Minimal example-->
        <dpage:Section heading="A Min or Pattern style constraint" purpose="Connect the concept to a small constraints sketch">
          <content>
            <dpage:Paragraph purpose="Introduce a property constraints container with a simple rule">
              <role>role:Explanation</role>
              <detailLevel>dlevel:Introductory</detailLevel>
              <weight>weight:Supporting</weight>
              <message>A property can host a constraints container with a simple MinLength- or
Pattern-style rule bound by that property's context.</message>
              <exclusions>
                <sem:Exclusion>
                  <reason>The example teaches attachment, not every constraint branch.</reason>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>
            <dpage:CodeBlock purpose="Illustrate a constraints container with a Min or Pattern example">
              <role>role:Example</role>
              <detailLevel>dlevel:Overview</detailLevel>
              <weight>weight:Supporting</weight>
              <message>A property constraints container can host a simple Min or Pattern style rule.</message>
              <supportingPoints>
                <sem:SupportingPoint />
                <sem:SupportingPoint />
              </supportingPoints>
              <exclusions>
                <sem:Exclusion />
              </exclusions>
            </dpage:CodeBlock>
            <dpage:Paragraph purpose="Interpret the constraints container and rule in the example">
              <role>role:Explanation</role>
              <detailLevel>dlevel:Introductory</detailLevel>
              <weight>weight:Supporting</weight>
              <message>In the example, the property's constraints container holds the rule, and
placement under that property binds the constraint without a separate target=
property.</message>
              <supportingPoints>
                <sem:SupportingPoint />
                <sem:SupportingPoint />
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with types and modeling guidelines" purpose="Direct the reader to related pages">
          <content>
            <dpage:Navigation purpose="Continue the learning sequence">
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Configuring types" summary="See how ValueType configuration relates to constrained members.">
                  <target>page:ConfiguringTypes</target>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Modeling guidelines" summary="Apply practical patterns for constraints alongside other modeling choices.">
                  <target>page:ModelingGuidelinesPage</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</page:ConstraintsBasics>
