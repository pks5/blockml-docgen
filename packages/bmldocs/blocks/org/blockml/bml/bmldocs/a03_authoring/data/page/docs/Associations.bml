<!--BlockML Documentation — a guide to non-owning instance links

  FQN: org.blockml.bml.bmldocs.a03_authoring.data.page.docs.Associations-->
<docs:Associations xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:docs="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition"
  xmlns:type="org.blockml.bml.type"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to non-owning instance links
  </is>
  <documentation>
    Scope: non-owning instance-to-instance links, associations versus aggregation, and
    associations versus documentation references, grounded in
    org.blockml.bml.definition.AssociationDefinition, org.blockml.bml.type.InstanceReference, and
    the AssociationDefinition role in org.blockml.bml.documentation.DefinitionModel. Body content
    is authored in a03 from those sources.
  </documentation>
  <references>
    <see type="def:AssociationDefinition" relation="Requires">
      The non-owning instance-to-instance link member this page introduces.
    </see>
    <see type="type:InstanceReference" relation="Requires">
      The required Association member type — a pointer, not an owned instance.
    </see>
    <see type="doc:DefinitionModel" relation="Requires">
      Primary content source — Associations as model links distinct from documentation References.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Associations</value>
    </title>
    <purpose override="true">
      <value>Teach Association as a non-owning instance-to-instance link typed via InstanceReference, so readers can add such a link without confusing it with aggregation ownership.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <workflow:AuthorativeSourceSet>
          <includedTypes>
            <type:TypeSelectorEntity value="org.blockml.bml.definition.AssociationDefinition" />
            <type:TypeSelectorEntity value="org.blockml.bml.type.InstanceReference" />
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.DefinitionModel" />
          </includedTypes>
        </workflow:AuthorativeSourceSet>
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>Teach Association as a non-owning instance-to-instance link, typed via InstanceReference.</summary>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>The reader can add a non-owning link without confusing it with ownership.</summary>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>Non-owning instance-to-instance links, associations versus aggregation ownership, and associations versus documentation references.</summary>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>Aggregation ownership mechanics or the full documentation-reference model.</summary>
          <reason>Those are covered on the Aggregations page and the Documenting Blocks page.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <supportingPoints override="true">
      <composition>
        <sem:SupportingPoint>
          <summary>Association member types must be InstanceReference(T) or InstanceReference(T)[] — a bare Block FQN is invalid there.</summary>
        </sem:SupportingPoint>
      </composition>
    </supportingPoints>
    <rules override="true">
      <composition>
        <lrule:CodeExamplePlacementRule />
        <lrule:CodeExplanationRule />
      </composition>
    </rules>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="A non-owning link between instances" purpose="Introduce Association as the member kind for non-owning links">
          <content>
            <dpage:Paragraph purpose="Introduce Association as a non-owning instance-to-instance link">
              <role>org.blockml.bml.docgen.role.Lead</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>An Association connects concrete Block instances to one another without any
lifecycle ownership — a non-owning model link, distinct from the ownership an
Aggregation carries.</message>
              <authoritativeSources>
                <workflow:AuthorativeSourceSet>
                  <includedTypes>
                    <type:TypeSelectorEntity value="org.blockml.bml.definition.AssociationDefinition" />
                  </includedTypes>
                </workflow:AuthorativeSourceSet>
              </authoritativeSources>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. InstanceReference is required-->
        <dpage:Section heading="Association type must be InstanceReference" purpose="State the required type shape for an Association member">
          <content>
            <dpage:Paragraph purpose="State that Association type must be InstanceReference(T) or InstanceReference(T)[]">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>An Association's type must be InstanceReference(T) or
InstanceReference(T)[] with T extending core:Block — a bare Block FQN such as
core:Block is invalid there, unlike on an Aggregation.</message>
              <authoritativeSources>
                <workflow:AuthorativeSourceSet>
                  <includedTypes>
                    <type:TypeSelectorEntity value="org.blockml.bml.type.InstanceReference" />
                  </includedTypes>
                </workflow:AuthorativeSourceSet>
              </authoritativeSources>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Associations versus documentation references-->
        <dpage:Section heading="Associations versus documentation references" purpose="Prevent confusing model links with documentation cross-links">
          <content>
            <dpage:Paragraph purpose="Distinguish Association model links from documentation References">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Associations form the instance graph between concrete Block instances;
documentation References connect types to types or types to instances for
narrative purposes only and never form that instance graph themselves.</message>
              <authoritativeSources>
                <workflow:AuthorativeSourceSet>
                  <includedTypes>
                    <type:TypeSelectorEntity value="org.blockml.bml.documentation.DefinitionModel" />
                  </includedTypes>
                </workflow:AuthorativeSourceSet>
              </authoritativeSources>
              <exclusions>
                <sem:Exclusion>
                  <summary>The full documentation Reference target-attribute catalogue.</summary>
                  <reason>Documentation references get their own treatment on the Documenting Blocks page.</reason>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="Linking one instance to another" purpose="Ground the InstanceReference type shape in one small example">
          <content>
            <dpage:Paragraph purpose="Set up an Association declaration whose type wraps a target Block in InstanceReference">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>An Association declaration wraps its target Block in InstanceReference, and
an instance sets it to the id of an existing composition child.</message>
              <exclusions>
                <sem:Exclusion>
                  <summary>Cross-document qualified instance references.</summary>
                  <reason>The example isolates a single local instance link.</reason>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>
            <dpage:CodeBlock purpose="Show an Association declaration and an instance value pointing at a local bml:id">
              <role>org.blockml.bml.docgen.role.Example</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>The association type is InstanceReference of the target Block; the instance value names an existing bml:id.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>Show an association declaration typed InstanceReference(core:Block) and an instance value referencing a local id.</summary>
                </sem:SupportingPoint>
              </supportingPoints>
              <exclusions>
                <sem:Exclusion>
                  <summary>A qualified cross-document reference form.</summary>
                </sem:Exclusion>
              </exclusions>
            </dpage:CodeBlock>
            <dpage:Paragraph purpose="Interpret the link as non-owning, unlike an aggregation child">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>The referenced instance in the example continues to exist independently of
this Association — the link merely points at it, unlike an aggregation child that
this Block would own.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages" purpose="Anchor the outcome this page should leave behind">
          <content>
            <dpage:Paragraph purpose="State the outcome this page should leave behind">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>After this page, readers should be able to add a non-owning link without
confusing it with aggregation ownership, before Capabilities introduce behaviour
as the fourth member kind.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with capabilities" purpose="Direct the reader to the next page">
          <content>
            <dpage:Navigation purpose="Continue the member-model learning sequence">
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Capabilities" summary="Learn Block behaviour expressed as members.">
                  <target>docs:Capabilities</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Associations>
