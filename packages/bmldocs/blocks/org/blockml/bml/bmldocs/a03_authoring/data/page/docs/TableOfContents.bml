<!--BlockML Documentation — documentation menu and navigation entry point

  FQN: org.blockml.bml.bmldocs.a03_authoring.data.page.docs.TableOfContents-->
<docs:TableOfContents xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:docs="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    The documentation menu and navigation entry point
  </is>
  <documentation>
    Index/menu page for the BlockML Core handbook. Scope is documentation menu, entry points,
    and navigation overview only — no BlockML concept is explained here. This page has no
    domain-content authoritative sources; it links structurally to the handbook's page groups.
    Body content (the link list) is authored in A03 from this DocSet's page and pageGroup structure.
  </documentation>
  <references>
    <see type="dcore:DocSet" relation="SeeAlso">
      DocSet this page belongs to; pageGroups supply the menu structure.
    </see>
    <see type="dcore:PageGroup" relation="SeeAlso">
      Nested navigational groups this menu presents (structural template, not domain content).
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Documentation</value>
    </title>
    <purpose override="true">
      <value>Give readers a single entry point that lists every handbook section and page, so they can find the right topic and start reading without teaching any concept here.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Overview</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Index</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <workflow:AuthorativeSourceSet>
        </workflow:AuthorativeSourceSet>
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>Present the site structure as a navigable menu, not as a lesson on any single concept.</summary>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>The reader can locate the page for any handbook topic and knows where to start reading.</summary>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>The documentation menu, entry points, and navigation overview across all handbook groups.</summary>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>Any BlockML concept explained in depth.</summary>
          <reason>Concept depth lives on the linked pages, not on the navigation menu.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <supportingPoints override="true">
      <composition>
        <sem:SupportingPoint>
          <summary>Groups mirror the learning path from Getting Started through the BML authoring format section.</summary>
        </sem:SupportingPoint>
      </composition>
    </supportingPoints>
    <content override="true">
      <composition>
        <dpage:Section heading="Documentation" purpose="Present the whole handbook as one navigable menu, grouped by learning path">
          <content>
            <dpage:Navigation purpose="List every handbook section and its pages in reading order">
              <title>Handbook contents</title>
              <items>
                <dpage:NavigationItem label="Getting Started" summary="A first orientation to BlockML and the problems it is designed to solve.">
                  <target>docs:Introduction</target>
                  <items>
                    <dpage:NavigationItem label="Introduction to BlockML" summary="What BlockML is and how BML and BOM differ.">
                      <target>docs:Introduction</target>
                    </dpage:NavigationItem>
                    <dpage:NavigationItem label="Core Use Cases" summary="The three problems BlockML is designed to solve.">
                      <target>docs:CoreUseCases</target>
                    </dpage:NavigationItem>
                  </items>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Foundations" summary="Blocks, definitions and instances, inheritance, contracts, and identity.">
                  <target>docs:EverythingIsABlockPage</target>
                  <items>
                    <dpage:NavigationItem label="Everything Is a Block" summary="BlockML's unifying ontological principle.">
                      <target>docs:EverythingIsABlockPage</target>
                    </dpage:NavigationItem>
                    <dpage:NavigationItem label="Blocks" summary="Defining, naming, and referencing a Block.">
                      <target>docs:Blocks</target>
                    </dpage:NavigationItem>
                    <dpage:NavigationItem label="Block Definitions and Instances" summary="The Block-versus-instance distinction.">
                      <target>docs:BlockDefinitionsAndInstances</target>
                    </dpage:NavigationItem>
                    <dpage:NavigationItem label="Inheritance" summary="Specialization via baseType.">
                      <target>docs:Inheritance</target>
                    </dpage:NavigationItem>
                    <dpage:NavigationItem label="Contracts" summary="Composable member fragments distinct from inheritance.">
                      <target>docs:Contracts</target>
                    </dpage:NavigationItem>
                    <dpage:NavigationItem label="Namespaces and Fully Qualified Names" summary="Packages, Libraries, and FQNs.">
                      <target>docs:NamespacesAndFullyQualifiedNames</target>
                    </dpage:NavigationItem>
                    <dpage:NavigationItem label="Identifiers and References" summary="Syntax-only identifiers versus validated references.">
                      <target>docs:IdentifiersAndReferences</target>
                    </dpage:NavigationItem>
                  </items>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="The Type System" summary="The four ValueType kinds and generic type parameters.">
                  <target>docs:TypeSystem</target>
                  <items>
                    <dpage:NavigationItem label="The Type System" summary="An overview of the four ValueType kinds.">
                      <target>docs:TypeSystem</target>
                    </dpage:NavigationItem>
                    <dpage:NavigationItem label="Primitive Types" summary="Atomic scalar ValueTypes.">
                      <target>docs:PrimitiveTypes</target>
                    </dpage:NavigationItem>
                    <dpage:NavigationItem label="Struct Types" summary="Composite named-field ValueTypes.">
                      <target>docs:StructTypes</target>
                    </dpage:NavigationItem>
                    <dpage:NavigationItem label="Enum Types" summary="Closed sets of named values.">
                      <target>docs:EnumTypes</target>
                    </dpage:NavigationItem>
                    <dpage:NavigationItem label="Primitive Entities" summary="Wrapping primitive values as Block instances.">
                      <target>docs:PrimitiveEntities</target>
                    </dpage:NavigationItem>
                    <dpage:NavigationItem label="Types and Values" summary="The general type-versus-value distinction.">
                      <target>docs:TypesAndValues</target>
                    </dpage:NavigationItem>
                    <dpage:NavigationItem label="Generic Types" summary="Generic type parameters, binding, and forwarding.">
                      <target>docs:GenericTypes</target>
                    </dpage:NavigationItem>
                  </items>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Members" summary="Properties, Aggregations, Associations, and Capabilities.">
                  <target>docs:Members</target>
                  <items>
                    <dpage:NavigationItem label="Members" summary="An overview of the Block member model.">
                      <target>docs:Members</target>
                    </dpage:NavigationItem>
                    <dpage:NavigationItem label="Properties" summary="Typed value members.">
                      <target>docs:Properties</target>
                    </dpage:NavigationItem>
                    <dpage:NavigationItem label="Aggregations" summary="Owned collection members.">
                      <target>docs:Aggregations</target>
                    </dpage:NavigationItem>
                    <dpage:NavigationItem label="Associations" summary="Non-owning instance-to-instance links.">
                      <target>docs:Associations</target>
                    </dpage:NavigationItem>
                    <dpage:NavigationItem label="Capabilities" summary="Block behaviour expressed as members.">
                      <target>docs:Capabilities</target>
                    </dpage:NavigationItem>
                    <dpage:NavigationItem label="Member Inheritance and Overrides" summary="Combining inherited members with the override flag.">
                      <target>docs:MemberInheritanceAndOverrides</target>
                    </dpage:NavigationItem>
                    <dpage:NavigationItem label="Visibility" summary="Member and Sub-Block visibility.">
                      <target>docs:Visibility</target>
                    </dpage:NavigationItem>
                    <dpage:NavigationItem label="Multiplicity and Collections" summary="Optional, singular, and multiple values.">
                      <target>docs:MultiplicityAndCollections</target>
                    </dpage:NavigationItem>
                  </items>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Behaviour &amp; Values" summary="Constraints, suggestions, expressions, and value configuration.">
                  <target>docs:Constraints</target>
                  <items>
                    <dpage:NavigationItem label="Constraints" summary="Declarative validation rules.">
                      <target>docs:Constraints</target>
                    </dpage:NavigationItem>
                    <dpage:NavigationItem label="Suggestions" summary="Non-mandatory modeling guidance.">
                      <target>docs:Suggestions</target>
                    </dpage:NavigationItem>
                    <dpage:NavigationItem label="Expressions" summary="The BlockML expression language.">
                      <target>docs:Expressions</target>
                    </dpage:NavigationItem>
                    <dpage:NavigationItem label="Value Configuration" summary="Configuring ValueType instances.">
                      <target>docs:ValueConfiguration</target>
                    </dpage:NavigationItem>
                  </items>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Composition &amp; Structure" summary="Filling aggregations, Sub-Blocks, embedded Blocks, and documentation.">
                  <target>docs:Composition</target>
                  <items>
                    <dpage:NavigationItem label="Composition" summary="Filling aggregations through composition.">
                      <target>docs:Composition</target>
                    </dpage:NavigationItem>
                    <dpage:NavigationItem label="Sub-Blocks" summary="Nested Block definitions.">
                      <target>docs:SubBlocks</target>
                    </dpage:NavigationItem>
                    <dpage:NavigationItem label="Embedded Blocks" summary="Embedded Block definitions and instances.">
                      <target>docs:EmbeddedBlocks</target>
                    </dpage:NavigationItem>
                    <dpage:NavigationItem label="Documenting Blocks" summary="The Block documentation model.">
                      <target>docs:DocumentingBlocks</target>
                    </dpage:NavigationItem>
                  </items>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="BML: The Authoring Format" summary="BML as the human-authored format and its namespace rules.">
                  <target>docs:Bml</target>
                  <items>
                    <dpage:NavigationItem label="BML: The Authoring Format" summary="BML as BlockML's human-authored format.">
                      <target>docs:Bml</target>
                    </dpage:NavigationItem>
                    <dpage:NavigationItem label="BML Namespaces" summary="XML namespace usage in BML.">
                      <target>docs:BmlNamespaces</target>
                    </dpage:NavigationItem>
                  </items>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:TableOfContents>
