<!--BlockML Documentation — documentation table of contents

  FQN: org.blockml.bml.bmldocs.a03_authoring.data.page.docs.TableOfContents-->
<page:TableOfContents xmlns="http://blockml.org/bml"
  xmlns:page="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:dlevel="org.blockml.bml.docgen.level">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    The blockml.org documentation table of contents
  </is>
  <documentation>
    DocPage that presents the site documentation menu as a Navigation tree of NavigationItems.
    Routing keys and paths live on DocSet.pageMapping (BmlDocSet), not on this page.
    Section nodes carry only label and nested items; leaf nodes set target to a page marker.
  </documentation>
  <references>
    <see type="dpage:DocPage" relation="Extends">
      Docgen human-facing documentation page marker.
    </see>
    <see type="dpage:Navigation" relation="Requires">
      In-page navigation block holding the TOC menu tree.
    </see>
    <see type="dpage:NavigationItem" relation="Requires">
      Recursive menu nodes (sections and leaf links).
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Documentation</value>
    </title>
    <purpose override="true">
      <value>Present the structured documentation menu so readers can find entry points without
introducing new conceptual content.</value>
    </purpose>
    <detailLevel override="true">
      <value>dlevel:Overview</value>
    </detailLevel>
    <pageType override="true">
      <value>ptype:Index</value>
    </pageType>
  </properties>
  <aggregations>
    <content override="true">
      <composition>
        <dpage:Navigation purpose="Site documentation menu for blockml.org">
          <title>Contents</title>
          <items>
            <dpage:NavigationItem label="Getting Started">
              <items>
                <dpage:NavigationItem label="What is BlockML" target="page:Intro" />
                <dpage:NavigationItem label="Your first Block" target="page:FirstBlock" />
                <dpage:NavigationItem label="Anatomy of a .bml file" target="page:FileAnatomy" />
              </items>
            </dpage:NavigationItem>
            <dpage:NavigationItem label="Core Ideas">
              <items>
                <dpage:NavigationItem label="Everything is a Block" target="page:EverythingIsABlockPage" />
                <dpage:NavigationItem label="Definition and instance" target="page:DefinitionAndInstance" />
                <dpage:NavigationItem label="Composition" target="page:CompositionBasics" />
              </items>
            </dpage:NavigationItem>
            <dpage:NavigationItem label="Types">
              <items>
                <dpage:NavigationItem label="Types at a glance" target="page:TypesOverview" />
                <dpage:NavigationItem label="Type expressions" target="page:TypeExpressionsBasics" />
                <dpage:NavigationItem label="Generics briefly" target="page:GenericsBriefly" />
                <dpage:NavigationItem label="Configuring ValueTypes" target="page:ConfiguringTypes" />
              </items>
            </dpage:NavigationItem>
            <dpage:NavigationItem label="Behaviour">
              <items>
                <dpage:NavigationItem label="Capabilities" target="page:CapabilitiesIntro" />
                <dpage:NavigationItem label="Expressions" target="page:ExpressionsIntro" />
                <dpage:NavigationItem label="Embedded expressions" target="page:EmbeddedExpressionsIntro" />
              </items>
            </dpage:NavigationItem>
            <dpage:NavigationItem label="Libraries">
              <items>
                <dpage:NavigationItem label="Libraries and packages" target="page:LibrariesAndPackages" />
                <dpage:NavigationItem label="README and Bootstrap" target="page:ReadmeAndBootstrap" />
              </items>
            </dpage:NavigationItem>
            <dpage:NavigationItem label="Authoring">
              <items>
                <dpage:NavigationItem label="Modeling guidelines" target="page:ModelingGuidelinesPage" />
                <dpage:NavigationItem label="Visibility" target="page:VisibilityBasics" />
                <dpage:NavigationItem label="Overrides" target="page:OverridesBasics" />
                <dpage:NavigationItem label="Constraints" target="page:ConstraintsBasics" />
                <dpage:NavigationItem label="Annotations and directives" target="page:AnnotationsAndDirectives" />
              </items>
            </dpage:NavigationItem>
            <dpage:NavigationItem label="Deeper Topics">
              <items>
                <dpage:NavigationItem label="Sub-Blocks" target="page:SubBlocksIntro" />
                <dpage:NavigationItem label="Contracts" target="page:ContractsIntro" />
                <dpage:NavigationItem label="How the compiler works" target="page:CompilerOverview" />
              </items>
            </dpage:NavigationItem>
            <dpage:NavigationItem label="How-to">
              <items>
                <dpage:NavigationItem label="Author a new Block" target="page:AuthorNewBlockGuide" />
              </items>
            </dpage:NavigationItem>
          </items>
        </dpage:Navigation>
      </composition>
    </content>
  </aggregations>
</page:TableOfContents>
