<!--BlockML Documentation — a guide to optional, singular, and multiple values

  FQN: org.blockml.bml.bmldocs.a03_authoring.data.page.docs.MultiplicityAndCollections-->
<docs:MultiplicityAndCollections xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:docs="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to optional, singular, and multiple values
  </is>
  <documentation>
    Scope: optional, singular, and multiple values, multiplicity brackets, and collection
    semantics, grounded in the multiplicity sections of
    org.blockml.bml.documentation.TypeExpressions. Body content is authored in a03 from that
    source.
  </documentation>
  <references>
    <see type="doc:TypeExpressions" relation="Requires">
      Primary content source — multiplicity as a postfix type-expression operation, and nested collections.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Multiplicity and Collections</value>
    </title>
    <purpose override="true">
      <value>Teach multiplicity as one axis of a type expression rather than a separate Array type, so readers can read a multiplicity bracket and place it correctly in a type expression.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <workflow:AuthorativeSourceSet>
          <includedTypes>
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.TypeExpressions" />
          </includedTypes>
        </workflow:AuthorativeSourceSet>
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>Teach multiplicity as one axis of a type expression, not a separate Array type.</summary>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>The reader can read a multiplicity bracket and place it correctly in a type expression.</summary>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>Optional, singular, and multiple values expressed through multiplicity brackets on a type expression.</summary>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>MinItems and MaxItems constraint depth.</summary>
          <reason>Those are contextual Constraints, covered on the Constraints page.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <supportingPoints override="true">
      <composition>
        <sem:SupportingPoint>
          <summary>Multiplicity is a postfix operation on a type expression, so nested collections need explicit grouping — (Integer[])[], never Integer[][].</summary>
        </sem:SupportingPoint>
      </composition>
    </supportingPoints>
    <content override="true">
      <composition>
        <dpage:Section heading="Multiplicity is not a separate type" purpose="Introduce multiplicity as an axis of a type expression rather than an Array type">
          <content>
            <dpage:Paragraph purpose="Introduce multiplicity brackets as a way of expressing how many values a type expression carries">
              <role>org.blockml.bml.docgen.role.Lead</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Whether a value is optional, singular, or multiple is expressed as a bracket on a
type expression, not by choosing a separate Array type.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Reading a multiplicity bracket" purpose="Present the three multiplicity forms readers will encounter">
          <content>
            <dpage:List purpose="List the multiplicity forms and what each one means">
              <role>org.blockml.bml.docgen.role.Summary</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A type expression's bracket, or the absence of one, tells a reader exactly how many
values are expected.</message>
              <items>
                <dpage:ListItem text="No bracket" purpose="Describe a type expression with no multiplicity bracket">
                  <message>A type expression with no bracket at all means exactly one value.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Open bracket" purpose="Describe the open collection bracket">
                  <message>An open bracket such as [] means a collection of any number of values, including none.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Bounded bracket" purpose="Describe a bounded multiplicity bracket">
                  <message>A bounded bracket such as [1..5] means a collection whose size must fall within that range.</message>
                </dpage:ListItem>
              </items>
            </dpage:List>
            <dpage:Paragraph purpose="State the reader outcome directly after the multiplicity forms">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>Recognizing these three bracket forms is enough to read the multiplicity of any type
expression on sight.</message>
              <readerOutcomes>
                <sem:ReaderOutcome>
                  <summary>The reader can read a multiplicity bracket and place it correctly in a type expression.</summary>
                </sem:ReaderOutcome>
              </readerOutcomes>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Grouping nested collections explicitly" purpose="Explain why a collection of collections needs explicit grouping">
          <content>
            <dpage:Paragraph purpose="Explain that nested collections must be grouped with parentheses">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Because multiplicity is a postfix operation on a type expression, a collection of
collections needs explicit grouping — the inner type expression is parenthesized
before the outer bracket is applied, rather than stacking two brackets directly.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>Multiplicity is a postfix operation on a type expression, so nested collections need explicit grouping — (Integer[])[], never Integer[][].</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.TypeExpressions" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Placing multiplicity correctly in a type expression" purpose="Explain that a multiplicity bracket applies to whatever precedes it">
          <content>
            <dpage:Paragraph purpose="Explain that a multiplicity bracket is placed directly after the type expression it applies to">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>A multiplicity bracket always applies to the type expression immediately before
it — a plain type name, or a parenthesized expression that already carries its own
multiplicity.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Where multiplicity is used" purpose="Situate multiplicity brackets among the places they commonly appear">
          <content>
            <dpage:Paragraph purpose="Note where multiplicity brackets commonly appear versus a single value">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>Multiplicity brackets appear commonly on aggregation and association types and on
capability input types, while a plain property is usually exactly one value.</message>
              <exclusions>
                <sem:Exclusion>
                  <summary>MinItems and MaxItems constraint depth.</summary>
                  <reason>Those are contextual Constraints, covered on the Constraints page.</reason>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with Constraints" purpose="Direct the reader to the next topic in the following page group">
          <content>
            <dpage:Navigation purpose="Continue from multiplicity into declarative validation rules">
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Constraints" summary="Learn declarative validation rules, including size bounds on a collection.">
                  <target>docs:Constraints</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:MultiplicityAndCollections>
