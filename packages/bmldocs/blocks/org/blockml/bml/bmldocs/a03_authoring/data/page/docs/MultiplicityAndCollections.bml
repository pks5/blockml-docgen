<!--BlockML Documentation — a guide to optional, singular, and multiple values

  FQN: org.blockml.bml.bmldocs.a03_authoring.data.page.docs.MultiplicityAndCollections-->
<docs:MultiplicityAndCollections xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:docs="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to optional, singular, and multiple values
  </is>
  <documentation>
    Scope: optional, singular, and multiple values, multiplicity brackets, and collection
    semantics, grounded in the multiplicity sections of
    org.blockml.bml.documentation.TypeExpressions. Body content is authored in a03 from that
    source.
  </documentation>
  <references>
    <see type="doc:TypeExpressions" relation="Requires">
      Primary content source — multiplicity as a postfix type-expression operation, and nested collections.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Multiplicity and Collections</value>
    </title>
    <purpose override="true">
      <value>Teach multiplicity as one axis of a type expression rather than a separate Array type, so readers can read a multiplicity bracket and place it correctly in a type expression.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <workflow:AuthorativeSourceSet>
          <includedTypes>
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.TypeExpressions" />
          </includedTypes>
        </workflow:AuthorativeSourceSet>
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>Teach multiplicity as one axis of a type expression, not a separate Array type.</summary>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>The reader can read a multiplicity bracket and place it correctly in a type expression.</summary>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>Optional, singular, and multiple values expressed through multiplicity brackets on a type expression.</summary>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>MinItems and MaxItems constraint depth.</summary>
          <reason>Those are contextual Constraints, covered on the Constraints page.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <supportingPoints override="true">
      <composition>
        <sem:SupportingPoint>
          <summary>Multiplicity is a postfix operation on a type expression, so nested collections need explicit grouping — (Integer[])[], never Integer[][].</summary>
        </sem:SupportingPoint>
      </composition>
    </supportingPoints>
    <content override="true">
      <composition>
        <dpage:Section heading="Multiplicity, not a separate Array type" purpose="State the core reframing of collection types">
          <content>
            <dpage:Paragraph purpose="State that multiplicity is postfix on a type expression">
              <role>org.blockml.bml.docgen.role.Lead</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>BlockML has no separate Array type — multiplicity is a postfix bracket operation on a type expression.</message>
              <authoritativeSources>
                <workflow:AuthorativeSourceSet>
                  <includedTypes>
                    <type:TypeSelectorEntity value="org.blockml.bml.documentation.TypeExpressions" />
                  </includedTypes>
                </workflow:AuthorativeSourceSet>
              </authoritativeSources>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Bracket forms" purpose="Show the range of multiplicity bracket forms">
          <content>
            <dpage:List purpose="List the multiplicity bracket forms">
              <role>org.blockml.bml.docgen.role.Summary</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A multiplicity bracket may express exactly one value, an open collection, a fixed size, or a bounded range.</message>
              <items>
                <dpage:ListItem text="Exactly one" purpose="Show the no-bracket case">
                  <message>Integer names exactly one value.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Open collection" purpose="Show the open-collection bracket">
                  <message>Integer[] is equivalent to Integer[0..n] — zero or more values.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Fixed and bounded" purpose="Show fixed-size and bounded-range brackets">
                  <message>Integer[3] fixes the count; Integer[1..5] bounds it between one and five.</message>
                </dpage:ListItem>
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <dpage:Section heading="Nesting requires explicit grouping" purpose="State the nested-multiplicity grouping rule">
          <content>
            <dpage:Paragraph purpose="State the nested multiplicity grouping rule">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Multiplicity may apply to any type expression, including one that already carries multiplicity, but nested collections need explicit grouping — (Integer[])[], never Integer[][].</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages" purpose="Anchor the reader outcome before constraints are introduced">
          <content>
            <dpage:Paragraph purpose="State the retained outcome">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Readers should now be able to read a multiplicity bracket and place it correctly in a type expression.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with constraints" purpose="Direct the reader to the Behaviour and Values section">
          <content>
            <dpage:Navigation purpose="Continue into the Behaviour and Values section">
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Constraints" summary="Learn how declarative validation rules attach to members.">
                  <target>docs:Constraints</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:MultiplicityAndCollections>
