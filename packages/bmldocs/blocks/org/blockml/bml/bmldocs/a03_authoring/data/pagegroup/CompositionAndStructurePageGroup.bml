<!--BlockML Documentation — Composition & Structure page group

  FQN: org.blockml.bml.bmldocs.a03_authoring.data.pagegroup.CompositionAndStructurePageGroup-->
<a03pgroup:CompositionAndStructurePageGroup xmlns="http://blockml.org/bml"
  xmlns:a03pgroup="org.blockml.bml.bmldocs.a03_authoring.data.pagegroup"
  xmlns:docs="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:dcore="org.blockml.bml.docgen.core">

  <baseType>
    dcore:PageGroup
  </baseType>
  <is>
    The Composition &amp; Structure page group for the A03 documentation set
  </is>
  <documentation>
    Section page group under DocsPageGroup, from BmlDocSetPlan.rootPageGroupPlan
    (CompositionAndStructurePageGroup). Direct pages: Composition, SubBlocks, EmbeddedBlocks,
    DocumentingBlocks.
  </documentation>
  <references>
    <see type="dcore:PageGroup" relation="Extends">
      Docgen page group base.
    </see>
    <see type="a03pgroup:DocsPageGroup" relation="Requires">
      Parent Documentation page group.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Composition &amp; Structure</value>
    </title>
    <parentGroup override="true">
      <value>a03pgroup:DocsPageGroup</value>
    </parentGroup>
  </properties>
  <aggregations>
    <pages override="true">
      <composition>
        <docs:Composition />
        <docs:SubBlocks />
        <docs:EmbeddedBlocks />
        <docs:DocumentingBlocks />
      </composition>
    </pages>
  </aggregations>
</a03pgroup:CompositionAndStructurePageGroup>
