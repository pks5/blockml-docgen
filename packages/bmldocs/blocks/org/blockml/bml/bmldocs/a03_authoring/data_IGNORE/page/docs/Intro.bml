<!--BlockML Documentation — What is BlockML

  FQN: org.blockml.bml.bmldocs.a03_authoring.data.page.docs.Intro-->
<page:Intro xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:page="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:workflow="org.blockml.bml.transformer.workflow"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A short website introduction to BlockML
  </is>
  <documentation>
    Marker page: gentle first contact for humans on blockml.org — goals and overview only.
    content is a structural scaffold only; generate prose and examples from referenced core
    documentation (doc:Introduction).
  </documentation>
  <references>
    <see type="doc:Introduction" relation="Requires">
      Primary content source — BlockML goals and overview.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>What is BlockML?</value>
    </title>
    <purpose override="true">
      <value>Give first-time readers BlockML's core idea and vocabulary, then orient them toward the concept pages that follow; keep it to a short introduction rather than a deep dive.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Introduction</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <workflow:AuthorativeSourceSet>
          <includedTypes>
            <type:TypeSelectorEntity value="org.blockml.bml.core.Block" />
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.Introduction" />
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.EverythingIsABlock" />
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.WOTFoundation" />
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.BmlNamespace" />
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.BmlDirectives" />
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.DocumentationModel" />
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.CompilerArchitecture" />
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.BlockAndInstance" />
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.RendererFreedom" />
          </includedTypes>
        </workflow:AuthorativeSourceSet>
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>Establish the distinction between authored meaning, canonical representation, and target-specific manifestation.</summary>
          <authoritativeSources>
            <workflow:AuthorativeSourceSet>
              <includedTypes>
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.BmlNamespace" />
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.BmlDirectives" />
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.DocumentationModel" />
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.Introduction" />
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.CompilerArchitecture" />
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.BlockAndInstance" />
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.RendererFreedom" />
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.WOTFoundation" />
              </includedTypes>
            </workflow:AuthorativeSourceSet>
          </authoritativeSources>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>The reader can explain the basic purpose of BlockML in one or two sentences.</summary>
          <authoritativeSources>
            <workflow:AuthorativeSourceSet>
              <includedTypes>
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.Introduction" />
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.EverythingIsABlock" />
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.WOTFoundation" />
              </includedTypes>
            </workflow:AuthorativeSourceSet>
          </authoritativeSources>
        </sem:ReaderOutcome>
        <sem:ReaderOutcome>
          <summary>The reader can distinguish BML, BOM, and a Renderer at a conceptual level.</summary>
          <authoritativeSources>
            <workflow:AuthorativeSourceSet>
              <includedTypes>
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.BmlNamespace" />
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.BmlDirectives" />
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.DocumentationModel" />
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.Introduction" />
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.CompilerArchitecture" />
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.BlockAndInstance" />
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.RendererFreedom" />
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.WOTFoundation" />
              </includedTypes>
            </workflow:AuthorativeSourceSet>
          </authoritativeSources>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>Provide a short conceptual introduction to BlockML, its principal representations, and the role of target-specific Renderers.</summary>
          <authoritativeSources>
            <workflow:AuthorativeSourceSet>
              <includedTypes>
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.Introduction" />
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.EverythingIsABlock" />
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.WOTFoundation" />
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.BmlNamespace" />
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.BmlDirectives" />
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.DocumentationModel" />
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.CompilerArchitecture" />
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.BlockAndInstance" />
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.RendererFreedom" />
              </includedTypes>
            </workflow:AuthorativeSourceSet>
          </authoritativeSources>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>Compiler implementation details, package names, pipeline stages, and internal object-model interfaces.</summary>
          <reason>The page establishes the conceptual model before presenting implementation details.</reason>
        </sem:Exclusion>
        <sem:Exclusion>
          <summary>Validator diagnostic identifiers and detailed validation behavior.</summary>
          <reason>Diagnostic details belong on reference and troubleshooting pages.</reason>
        </sem:Exclusion>
        <sem:Exclusion>
          <summary>Version-specific migration notes, implementation status, and legacy behavior.</summary>
          <reason>The introduction should describe the stable mental model rather than project history.</reason>
        </sem:Exclusion>
        <sem:Exclusion>
          <summary>Detailed expression syntax, service binding, directives, and capability invocation.</summary>
          <reason>These concepts require dedicated pages and should not compete with the introductory message.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="A language for describing ideas as Blocks" purpose="Give readers an immediate and accessible orientation">
          <content>
            <dpage:Paragraph purpose="Introduce BlockML in one concise paragraph">
              <role>org.blockml.bml.docgen.role.Lead</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>BlockML is a universal declarative language for describing semantic,
reusable Blocks independently of how they are later manifested.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>The same language can describe Blocks from different technical and non-technical domains.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.Introduction" />
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.EverythingIsABlock" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>Humans and language models can work on the same explicit representation.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.Introduction" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>Concrete output is produced later by target-specific Renderers.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.RendererFreedom" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Core mental model-->
        <dpage:Section heading="BML, BOM, and Renderers" purpose="Establish the three-part conceptual model used throughout the documentation">
          <content>
            <dpage:Paragraph purpose="Explain the relationship between BML and BOM">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>BML and BOM are complementary representations of the same authored model:
BML is optimized for authoring, while BOM preserves the model canonically
and losslessly for processing.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>BML is the human- and editor-friendly authoring representation.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.BmlNamespace" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>BOM is the canonical and immutable representation of authored BML.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.BmlNamespace" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>A lossless BML to BOM to BML round trip must remain possible.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.BmlNamespace" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
              <exclusions>
                <sem:Exclusion>
                  <summary>Parser stages, TypeScript interfaces, and internal BOM data structures.</summary>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>
            <dpage:Paragraph purpose="Explain why target-specific interpretation belongs to Renderers">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>BlockML preserves the meaning of a model without deciding how it must appear
in a particular target; each Renderer supplies that interpretation.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>The BlockML core remains independent of individual domains and output formats.</summary>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>Different Renderers may produce fundamentally different manifestations from the same model.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.RendererFreedom" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
              <exclusions>
                <sem:Exclusion>
                  <summary>Specific renderer pipelines, processor classes, and target-package architecture.</summary>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Goals-->
        <dpage:Section heading="What BlockML is designed to achieve" purpose="Summarize the small set of principles readers should retain">
          <content>
            <dpage:Paragraph purpose="Prepare the reader for the following summary list">
              <role>org.blockml.bml.docgen.role.Transition</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>BlockML combines a common grammar, explicit semantics, lossless representation,
and renderer independence in one model.</message>
            </dpage:Paragraph>
            <dpage:List purpose="Present the principal design goals as a concise summary">
              <role>org.blockml.bml.docgen.role.Summary</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>These principles define the core character of BlockML.</message>
              <items>
                <dpage:ListItem text="One grammar" purpose="Explain that different BlockML domains share the same foundational language">
                  <message>Types, domain Blocks, services, languages, and documentation use the same
foundational grammar.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Explicit semantics" purpose="Explain that behavior and intent remain part of the model">
                  <message>Meaning and behavior are described explicitly through ordinary BlockML
structures such as Properties, relationships, and Capabilities.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Lossless representation" purpose="Explain that authored information is preserved">
                  <message>The canonical BOM preserves the authored BML model without silently
interpreting or discarding information.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Renderer freedom" purpose="Explain that output interpretation remains target-specific">
                  <message>Each Renderer decides how the semantic model is manifested in its own target.</message>
                </dpage:ListItem>
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="A minimal Block" purpose="Connect the conceptual explanation to a small piece of BML">
          <content>
            <dpage:Paragraph purpose="Introduce the minimum visible structure of a BML document">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>A BML document uses a single root block definition with a name, a globally
identifiable type, and an explicit base type.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>The root is the definition document itself, not a nested instance.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.core.Block" />
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.Introduction" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>Identity fields alone are enough to open the mental model before members are introduced.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.core.Block" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
              <exclusions>
                <sem:Exclusion>
                  <summary>Properties, aggregations, associations, capabilities, directives, validation, and versioning.</summary>
                  <reason>The example should show only the smallest useful structural skeleton.</reason>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>
            <dpage:CodeBlock purpose="Illustrate the minimum BML block structure">
              <role>org.blockml.bml.docgen.role.Example</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>Every BML definition is represented by a root block with explicit identity
and inheritance.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>Highlight the root block element with name, type, and baseType as the minimal identity skeleton.</summary>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>Keep the example free of properties, aggregations, and other members so identity stands alone.</summary>
                </sem:SupportingPoint>
              </supportingPoints>
              <exclusions>
                <sem:Exclusion>
                  <summary>All optional metadata and member declarations.</summary>
                </sem:Exclusion>
              </exclusions>
            </dpage:CodeBlock>
            <dpage:Paragraph purpose="Interpret the minimal root Block identity fields in the example">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>In the example, the root block is the definition itself: name is the local
identifier, type is the Block's own type identity, and baseType names the
parent it extends.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>Notice that name, type, and baseType appear before any members, matching the authored-meaning model from the earlier sections.</summary>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>The absence of properties and aggregations shows that identity alone is enough to open a valid definition document.</summary>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. What to carry forward-->
        <dpage:Section heading="What to carry into the next pages" purpose="Anchor the introductory outcomes readers should retain">
          <content>
            <dpage:Paragraph purpose="State the mental-model outcomes this introduction should leave behind">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>After this introduction, readers should be able to explain BlockML as authored
meaning, name BML and BOM as complementary representations, and treat
Renderers as the place where target-specific manifestation begins.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>The same Block idea can describe domains far beyond a single output format.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.Introduction" />
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.EverythingIsABlock" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>Later pages deepen authoring and behaviour on top of this shared model rather than replacing it.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.Introduction" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
            <dpage:List purpose="Summarize the retainable outcomes of the introduction">
              <role>org.blockml.bml.docgen.role.Summary</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>These outcomes are the checkpoint before Everything is a Block and the
getting-started pages that follow.</message>
              <items>
                <dpage:ListItem text="Purpose in one sentence" purpose="Retain the purpose of BlockML">
                  <message>BlockML describes reusable semantic Blocks independently of how a target
later manifests them.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Three-part model" purpose="Retain BML, BOM, and Renderer roles">
                  <message>BML is for authoring, BOM preserves that model canonically, and each
Renderer supplies a target interpretation.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Minimal document shape" purpose="Retain the identity skeleton of a root Block">
                  <message>A root Block needs name, type, and baseType before members are added.</message>
                </dpage:ListItem>
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with the core idea" purpose="Direct the reader to the next conceptual page">
          <content>
            <dpage:Navigation purpose="Continue the introductory learning sequence">
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Everything is a Block" summary="Learn why Block is the universal abstraction at the heart of BlockML.">
                  <target>page:EverythingIsABlockPage</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</page:Intro>
