<!--BlockML Documentation — a guide to BML as BlockML's human-authored format

  FQN: org.blockml.bml.bmldocs.a03_authoring.data.page.docs.Bml-->
<docs:Bml xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:docs="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to BML as BlockML's human-authored format
  </is>
  <documentation>
    Scope: BML as the human-authored representation and its relationship to the canonical BOM,
    grounded in org.blockml.bml.documentation.Introduction and
    org.blockml.bml.documentation.DocumentFormat. Body content is authored in a03 from those
    sources.
  </documentation>
  <references>
    <see type="doc:Introduction" relation="Requires">
      Primary content source — the BML-authoring versus BOM-canonical distinction.
    </see>
    <see type="doc:DocumentFormat" relation="Requires">
      Document root, Sub-Block, and embedded Block authoring format.
    </see>
    <see type="doc:CompilerArchitecture" relation="SeeAlso">
      BML to Parser to BOM pipeline context.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>BML: The Authoring Format</value>
    </title>
    <purpose override="true">
      <value>Teach BML as the authoring format and the BOM as its canonical, lossless form, so readers can identify a Block document's root element and format before namespace and directive detail follows.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <workflow:AuthorativeSourceSet>
          <includedTypes>
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.Introduction" />
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.DocumentFormat" />
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.CompilerArchitecture" />
          </includedTypes>
        </workflow:AuthorativeSourceSet>
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>Teach BML as the authoring format and the BOM as its canonical form.</summary>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>The reader can identify a Block document's root element and authoring format.</summary>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>BML as the human-authored representation of a BlockML model, and its relationship to the canonical BOM.</summary>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>Namespace declaration mechanics or bml: directives depth.</summary>
          <reason>Those get the following BML Namespaces page and the earlier Namespaces page.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <supportingPoints override="true">
      <composition>
        <sem:SupportingPoint>
          <summary>The compiler is domain-agnostic — it understands only BML and the BOM, never domain-specific meaning.</summary>
        </sem:SupportingPoint>
      </composition>
    </supportingPoints>
    <content override="true">
      <composition>
        <dpage:Section heading="BML and the canonical BOM" purpose="Restate the authoring-versus-canonical distinction for the format itself">
          <content>
            <dpage:Paragraph purpose="Introduce BML as the authoring format">
              <role>org.blockml.bml.docgen.role.Lead</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>BML is the human- and editor-friendly authoring format; the BOM is its canonical, immutable, lossless representation.</message>
              <authoritativeSources>
                <workflow:AuthorativeSourceSet>
                  <includedTypes>
                    <type:TypeSelectorEntity value="org.blockml.bml.documentation.Introduction" />
                  </includedTypes>
                </workflow:AuthorativeSourceSet>
              </authoritativeSources>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Identifying the document root" purpose="Explain how a Block document's root element is identified">
          <content>
            <dpage:Paragraph purpose="Explain that the element tag identifies the document root's type">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Every Block definition wrapper — document root, Sub-Block, and embedded Block — is identified by its element tag.</message>
              <authoritativeSources>
                <workflow:AuthorativeSourceSet>
                  <includedTypes>
                    <type:TypeSelectorEntity value="org.blockml.bml.documentation.DocumentFormat" />
                  </includedTypes>
                </workflow:AuthorativeSourceSet>
              </authoritativeSources>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Two authoring formats, one transition" purpose="Explain the preferred and legacy authoring forms">
          <content>
            <dpage:Paragraph purpose="Explain the preferred tag-as-type form versus the legacy wrapper">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>The type-or-name-as-tag form is the intended long-term format; a legacy wrapper form remains valid during a long transition.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="A domain-agnostic pipeline" purpose="Sketch the compiler pipeline at overview level">
          <content>
            <dpage:Paragraph purpose="Sketch the compiler pipeline without implementation depth">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>BML is parsed into the canonical BOM, which then flows through validation and render-target pipelines — the compiler itself remains domain-agnostic throughout.</message>
              <authoritativeSources>
                <workflow:AuthorativeSourceSet>
                  <includedTypes>
                    <type:TypeSelectorEntity value="org.blockml.bml.documentation.CompilerArchitecture" />
                  </includedTypes>
                </workflow:AuthorativeSourceSet>
              </authoritativeSources>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages" purpose="Anchor the reader outcome before namespace declarations are introduced">
          <content>
            <dpage:Paragraph purpose="State the retained outcome">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Readers should now be able to identify a Block document's root element and authoring format.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with BML namespaces" purpose="Direct the reader to the last page">
          <content>
            <dpage:Navigation purpose="Continue the BML authoring format sequence">
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="BML Namespaces" summary="Learn xmlns declarations and the bml-namespace placement rule.">
                  <target>docs:BmlNamespaces</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Bml>
