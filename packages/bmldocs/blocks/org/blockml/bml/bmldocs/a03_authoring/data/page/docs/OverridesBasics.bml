<!--BlockML Documentation — Overrides basics

  FQN: org.blockml.bml.bmldocs.a03_authoring.data.page.docs.OverridesBasics-->
<page:OverridesBasics xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:page="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:workflow="org.blockml.bml.transformer.workflow"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A website intro to partial member overrides
  </is>
  <documentation>
    Marker page: abstract / final / override / readOnly in everyday authoring terms with one
    before/after snippet.
    
    content is a structural scaffold only; generate prose and examples from referenced core
    documentation (doc:PartialMemberOverrides, doc:ContractsModel).
  </documentation>
  <references>
    <see type="doc:PartialMemberOverrides" relation="Requires">
      Primary content — merge semantics and override flags.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Overrides</value>
    </title>
    <purpose override="true">
      <value>Introduce partial member overrides with override="true".</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <workflow:AuthorativeSourceSet>
          <includedTypes>
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.PartialMemberOverrides" />
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.ContractsModel" />
          </includedTypes>
        </workflow:AuthorativeSourceSet>
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>Use override="true" when a local redeclaration merges with inherited or contract members, and understand that the flag is not inherited.</summary>
          <authoritativeSources>
            <workflow:AuthorativeSourceSet>
              <includedTypes>
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.PartialMemberOverrides" />
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.ContractsModel" />
              </includedTypes>
            </workflow:AuthorativeSourceSet>
          </authoritativeSources>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>The reader can decide when a member needs override="true".</summary>
          <authoritativeSources>
            <workflow:AuthorativeSourceSet>
              <includedTypes>
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.PartialMemberOverrides" />
              </includedTypes>
            </workflow:AuthorativeSourceSet>
          </authoritativeSources>
        </sem:ReaderOutcome>
        <sem:ReaderOutcome>
          <summary>The reader can explain that each redeclaration layer must set override again.</summary>
          <authoritativeSources>
            <workflow:AuthorativeSourceSet>
              <includedTypes>
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.PartialMemberOverrides" />
              </includedTypes>
            </workflow:AuthorativeSourceSet>
          </authoritativeSources>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>Introduce partial member overrides, merge with baseType and contracts, local flags such as abstract, final, and readOnly, and the authoring checks for new versus override members.</summary>
          <authoritativeSources>
            <workflow:AuthorativeSourceSet>
              <includedTypes>
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.PartialMemberOverrides" />
                <type:TypeSelectorEntity value="org.blockml.bml.documentation.ContractsModel" />
              </includedTypes>
            </workflow:AuthorativeSourceSet>
          </authoritativeSources>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>Full merge algorithm.</summary>
          <reason>Introductory pages need the authoring rule, not the complete merge procedure.</reason>
        </sem:Exclusion>
        <sem:Exclusion>
          <summary>Diagnostic codes.</summary>
          <reason>Diagnostic identifiers belong on reference and troubleshooting pages.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Partial overrides refine inherited members" purpose="Give readers an immediate orientation to override=&quot;true&quot;">
          <content>
            <dpage:Paragraph purpose="Introduce override=&quot;true&quot; for refining inherited members">
              <role>org.blockml.bml.docgen.role.Lead</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A partial member override uses override=&quot;true&quot; when a local redeclaration
refines a member that already exists through inheritance or contracts.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>The flag marks intentional merge rather than accidental name collision.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.PartialMemberOverrides" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>Overrides refine existing members; they do not invent a second identity for the same name.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.PartialMemberOverrides" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>Contract fragments and baseType members both count as prior members that may need override.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.PartialMemberOverrides" />
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.ContractsModel" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Merge rules-->
        <dpage:Section heading="Merge with baseType and contracts" purpose="Explain when override is required and that it is not inherited">
          <content>
            <dpage:Paragraph purpose="Explain merge with baseType chain and contracts">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>The override flag is required when a local redeclaration merges with a member
from the baseType chain or from contracts.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>Inherited identity and contract fragments both count as prior members.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.PartialMemberOverrides" />
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.ContractsModel" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>Setting override="true" declares that the local member intentionally merges with that prior identity.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.PartialMemberOverrides" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
            <dpage:Paragraph purpose="Explain that override is not inherited">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Override is not inherited; each redeclaration layer must set override=&quot;true&quot;
again when it further refines the member.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>A child that overrides again must restate the flag; it does not inherit the parent's override marker.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.PartialMemberOverrides" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
              <exclusions>
                <sem:Exclusion>
                  <summary>Full merge algorithm details.</summary>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Authoring checks-->
        <dpage:Section heading="New versus override" purpose="Summarize the principal authoring checks">
          <content>
            <dpage:Paragraph purpose="Prepare the reader for new-versus-override checks">
              <role>org.blockml.bml.docgen.role.Transition</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>Authors should distinguish brand-new members from redeclarations that merge with
prior identity.</message>
            </dpage:Paragraph>
            <dpage:List purpose="Present authoring checks as a concise summary">
              <role>org.blockml.bml.docgen.role.Summary</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>These checks keep new members and overrides distinct.</message>
              <items>
                <dpage:ListItem text="New" purpose="Explain that new members must not set override=&quot;true&quot;">
                  <message>New members must not set override=&quot;true&quot;.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Override required" purpose="Explain that inherited identity requires override=&quot;true&quot;">
                  <message>Inherited identity requires override=&quot;true&quot; on the local redeclaration.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Abstract satisfaction" purpose="Explain that a concrete override can satisfy abstract parents">
                  <message>A locally concrete override can satisfy abstract members from parents.</message>
                </dpage:ListItem>
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <!--4. Abstract, final, and readOnly-->
        <dpage:Section heading="Abstract, final, and readOnly" purpose="Introduce local merge flags beyond override=&quot;true&quot;">
          <content>
            <dpage:Paragraph purpose="Explain abstract, final, and override as local declaration flags">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>abstract, final, and override are local declaration flags — they are never
inherited, even when their effects propagate through the merge.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>abstract="true" marks an incomplete declaration that creates an implementation obligation for descendants.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.PartialMemberOverrides" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>final="true" seals a declaration so descendants cannot override it.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.PartialMemberOverrides" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>A concrete child satisfies an abstract parent by restating the member with override="true" and a locally complete declaration.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.PartialMemberOverrides" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
              <exclusions>
                <sem:Exclusion>
                  <summary>Full merge algorithm and diagnostic codes.</summary>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>
            <dpage:Paragraph purpose="Explain that readOnly is orthogonal to abstract, final, and override">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>readOnly is orthogonal to those flags: it blocks instance writes after effective
resolution, while final blocks further definition overrides entirely.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>Definitions may still declare and refine readOnly members; instances must not set a member whose effective definition is readOnly.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.PartialMemberOverrides" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>A public readOnly member remains publicly readable; readOnly is not a visibility substitute.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.PartialMemberOverrides" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. Minimal example-->
        <dpage:Section heading="Overriding a property" purpose="Connect the concept to a small override sketch">
          <content>
            <dpage:Paragraph purpose="Introduce a child member refined with override=&quot;true&quot;">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>A child Block can refine an inherited property by restating it with
override=&quot;true&quot; and a narrowed documentation or value.</message>
              <exclusions>
                <sem:Exclusion>
                  <summary>Full merge algorithm and diagnostic codes.</summary>
                  <reason>The example teaches the authoring flag, not the merge procedure.</reason>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>
            <dpage:CodeBlock purpose="Illustrate a child member with override=&quot;true&quot;">
              <role>org.blockml.bml.docgen.role.Example</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>A child Block refines an inherited property with override=&quot;true&quot; and a
narrowed documentation or value.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>Highlight the child property that repeats an inherited name with override="true".</summary>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>Highlight the refined documentation or value that demonstrates partial merge rather than a brand-new member.</summary>
                </sem:SupportingPoint>
              </supportingPoints>
              <exclusions>
                <sem:Exclusion>
                  <summary>Full merge algorithm and diagnostic codes.</summary>
                </sem:Exclusion>
              </exclusions>
            </dpage:CodeBlock>
            <dpage:Paragraph purpose="Interpret the override=&quot;true&quot; property in the example">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>In the example, the child restates the inherited property name and marks it
with override=&quot;true&quot; so the local changes merge into that prior member.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>Without the flag, the same name would look like an accidental collision rather than an intentional refinement.</summary>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <summary>A further descendant that refines again must set override="true" on its own redeclaration layer.</summary>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with constraints and contracts" purpose="Direct the reader to related conceptual pages">
          <content>
            <dpage:Navigation purpose="Continue the learning sequence">
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Constraints" summary="Attach reusable validation rules to constrainable definition elements.">
                  <target>page:ConstraintsBasics</target>
                </dpage:NavigationItem>
                <dpage:NavigationItem label="Contracts" summary="See how contracts contribute member fragments that may be overridden.">
                  <target>page:ContractsIntro</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</page:OverridesBasics>
