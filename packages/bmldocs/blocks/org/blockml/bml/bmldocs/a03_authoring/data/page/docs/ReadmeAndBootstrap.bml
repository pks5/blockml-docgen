<!--BlockML Documentation — README and Bootstrap

  FQN: org.blockml.bml.bmldocs.a03_authoring.data.page.docs.ReadmeAndBootstrap-->
<page:ReadmeAndBootstrap xmlns="http://blockml.org/bml"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:page="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:lpage="org.blockml.bml.bmldocs.lib.page"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:dlevel="org.blockml.bml.docgen.level"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:role="org.blockml.bml.docgen.role"
  xmlns:weight="org.blockml.bml.docgen.weight"
  xmlns:core="org.blockml.bml.core"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    lpage:BmlDocPage
  </baseType>
  <is>
    A website page for README versus Bootstrap
  </is>
  <documentation>
    Marker page: human/LLM ReadMe entry vs automation Bootstrap SPOE — when to use which and how
    Library.readMe / Library.bootstrap wire them.
    
    content is a structural scaffold only; generate prose and examples from referenced core
    documentation (doc:BootstrapModel, doc:LibrarySystem).
  </documentation>
  <references>
    <see type="doc:BootstrapModel" relation="Requires">
      Primary content — README, Bootstrap SPOE, and interpretation context.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>README and Bootstrap</value>
    </title>
    <purpose override="true">
      <value>Distinguish human-facing README from compiler bootstrap entry points.</value>
    </purpose>
    <detailLevel override="true">
      <value>dlevel:Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>ptype:Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <doc:BootstrapModel />
        <doc:LibrarySystem />
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <authoritativeSources>
            <doc:BootstrapModel />
            <doc:LibrarySystem />
          </authoritativeSources>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <authoritativeSources>
            <doc:BootstrapModel />
          </authoritativeSources>
        </sem:ReaderOutcome>
        <sem:ReaderOutcome>
          <authoritativeSources>
            <doc:BootstrapModel />
          </authoritativeSources>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <authoritativeSources>
            <doc:BootstrapModel />
            <doc:LibrarySystem />
          </authoritativeSources>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <reason>Package names obscure the conceptual bootstrap story for website readers.</reason>
        </sem:Exclusion>
        <sem:Exclusion>
          <reason>Stage mechanics belong to compiler architecture pages, not this distinction.</reason>
        </sem:Exclusion>
        <sem:Exclusion>
          <reason>Migration history distracts from the stable README versus Bootstrap model.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="README for humans, Bootstrap for the compiler" purpose="Give readers an immediate distinction between README and Bootstrap">
          <content>
            <dpage:Paragraph purpose="Clarify human README versus compiler bootstrap entry">
              <role>role:Lead</role>
              <detailLevel>dlevel:Overview</detailLevel>
              <weight>weight:Primary</weight>
              <message>README orients humans and language models, while Bootstrap is the compiler
entry that prepares interpretation context for a Library.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:BootstrapModel />
                    <doc:LibrarySystem />
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:BootstrapModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:BootstrapModel />
                    <doc:LibrarySystem />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Self-hosting bootstrap-->
        <dpage:Section heading="Self-hosting TypeRegistry bootstrap" purpose="Explain that framework BML loads before user content">
          <content>
            <dpage:Paragraph purpose="Explain self-hosting TypeRegistry bootstrap without implementation packages">
              <role>role:Explanation</role>
              <detailLevel>dlevel:Introductory</detailLevel>
              <weight>weight:Primary</weight>
              <message>The compiler loads framework BML to populate the TypeRegistry before it
interprets user content, instead of hard-coding type semantics in code.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:BootstrapModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:BootstrapModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
              <exclusions>
                <sem:Exclusion />
              </exclusions>
            </dpage:Paragraph>
            <dpage:Paragraph purpose="Explain why user content waits for the registry">
              <role>role:Explanation</role>
              <detailLevel>dlevel:Introductory</detailLevel>
              <weight>weight:Primary</weight>
              <message>User content is interpreted only after the TypeRegistry already knows the
framework and package types it depends on.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:BootstrapModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Bootstrap order summary-->
        <dpage:Section heading="Bootstrap order at a glance" purpose="Summarize the high-level load order readers should retain">
          <content>
            <dpage:Paragraph purpose="Prepare the reader for the bootstrap order list">
              <role>role:Transition</role>
              <detailLevel>dlevel:Overview</detailLevel>
              <weight>weight:Supporting</weight>
              <message>Bootstrap proceeds from core branches through packages to user content in a
fixed conceptual order.</message>
            </dpage:Paragraph>
            <dpage:List purpose="Present bootstrap order highlights as a concise summary">
              <role>role:Summary</role>
              <detailLevel>dlevel:Overview</detailLevel>
              <weight>weight:Primary</weight>
              <message>Bootstrap proceeds from core branches through packages to user content.</message>
              <items>
                <dpage:ListItem text="Core branches" purpose="Name the earliest bootstrap layer">
                  <message>Core branches such as Block, ValueType, and Language come first.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Packages" purpose="Name framework and domain package loading">
                  <message>Framework packages and domain packages follow once core branches exist.</message>
                </dpage:ListItem>
                <dpage:ListItem text="User content" purpose="Name when user content is interpreted">
                  <message>User content loads after the TypeRegistry is ready.</message>
                </dpage:ListItem>
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="Bootstrap and Library entry points" purpose="Connect the distinction to a small entry-point sketch">
          <content>
            <dpage:Paragraph purpose="Introduce Library readMe and bootstrap entry-point wiring">
              <role>role:Explanation</role>
              <detailLevel>dlevel:Introductory</detailLevel>
              <weight>weight:Supporting</weight>
              <message>A Library can point to a human README and a Bootstrap entry without mixing
those roles in one document purpose.</message>
              <exclusions>
                <sem:Exclusion>
                  <reason>The sketch teaches entry-point wiring, not compiler internals.</reason>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>
            <dpage:CodeBlock purpose="Sketch Bootstrap and Library entry points readers should recognize">
              <role>role:Example</role>
              <detailLevel>dlevel:Overview</detailLevel>
              <weight>weight:Supporting</weight>
              <message>A Library can point to README for humans and Bootstrap for interpretation
context without mixing those roles.</message>
              <supportingPoints>
                <sem:SupportingPoint />
                <sem:SupportingPoint />
              </supportingPoints>
              <exclusions>
                <sem:Exclusion />
              </exclusions>
            </dpage:CodeBlock>
            <dpage:Paragraph purpose="Interpret the readMe and bootstrap entry constructs in the example">
              <role>role:Explanation</role>
              <detailLevel>dlevel:Introductory</detailLevel>
              <weight>weight:Supporting</weight>
              <message>In the example, readMe names the orientation document for people, while
bootstrap names the Block that establishes interpretation context for the
compiler.</message>
              <supportingPoints>
                <sem:SupportingPoint />
                <sem:SupportingPoint />
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. When to use which-->
        <dpage:Section heading="When to open README versus Bootstrap" purpose="Give readers decision criteria for README versus Bootstrap entry points">
          <content>
            <dpage:Paragraph purpose="State when README is the right entry">
              <role>role:Explanation</role>
              <detailLevel>dlevel:Introductory</detailLevel>
              <weight>weight:Primary</weight>
              <message>Open README when a human or language model needs orientation to the Library's
purpose, audience, and how to approach its content.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:BootstrapModel />
                    <doc:LibrarySystem />
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:LibrarySystem />
                    <doc:BootstrapModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:BootstrapModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
            <dpage:List purpose="Decision cues for choosing Bootstrap instead of README">
              <role>role:Summary</role>
              <detailLevel>dlevel:Overview</detailLevel>
              <weight>weight:Primary</weight>
              <message>Choose Bootstrap when the question is how interpretation context is prepared,
not how to read the Library as a person.</message>
              <items>
                <dpage:ListItem text="Interpretation context" purpose="Bootstrap when TypeRegistry or load order matters">
                  <message>Use Bootstrap when you need the entry that prepares TypeRegistry context
before user content runs.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Load order" purpose="Bootstrap when framework-before-user order is the topic">
                  <message>Use Bootstrap when the topic is self-hosting load order from core branches
through packages to user content.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Keep audiences separate" purpose="Do not mix README prose into Bootstrap purpose">
                  <message>Keep README and Bootstrap as separate Library entry points so orientation
prose and compiler entry logic stay distinct.</message>
                </dpage:ListItem>
              </items>
              <exclusions>
                <sem:Exclusion />
              </exclusions>
            </dpage:List>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with libraries and packages" purpose="Direct the reader to the related conceptual page">
          <content>
            <dpage:Navigation purpose="Continue the learning sequence">
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Libraries and packages" summary="See how Libraries publish Blocks under the domain bml package convention.">
                  <target>page:LibrariesAndPackages</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</page:ReadmeAndBootstrap>
