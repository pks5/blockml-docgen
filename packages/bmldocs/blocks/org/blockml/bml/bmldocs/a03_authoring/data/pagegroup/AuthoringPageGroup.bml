<!--BlockML Documentation — Authoring page group

  FQN: org.blockml.bml.bmldocs.a03_authoring.data.pagegroup.AuthoringPageGroup-->
<pgroup:AuthoringPageGroup xmlns="http://blockml.org/bml"
  xmlns:pgroup="org.blockml.bml.bmldocs.a03_authoring.data.pagegroup"
  xmlns:page="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:dcore="org.blockml.bml.docgen.core">

  <baseType>
    dcore:PageGroup
  </baseType>
  <is>
    A documentation page group for Authoring
  </is>
  <documentation>
    Page group corresponding to the “Authoring” TOC section on blockml.org. pages lists the
    section’s leaf NavigationItem targets as page type references. parentGroup is
    DocsPageGroup.
  </documentation>
  <references>
    <see type="dcore:PageGroup" relation="Extends">
      Docgen page group base.
    </see>
    <see type="pgroup:DocsPageGroup" relation="Requires">
      Parent Documentation root page group.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Authoring</value>
    </title>
    <parentGroup override="true">
      <value>pgroup:DocsPageGroup</value>
    </parentGroup>
  </properties>
  <aggregations>
    <pages override="true">
      <composition>
        <page:ModelingGuidelinesPage />
        <page:VisibilityBasics />
        <page:OverridesBasics />
        <page:ConstraintsBasics />
        <page:AnnotationsAndDirectives />
      </composition>
    </pages>
  </aggregations>
</pgroup:AuthoringPageGroup>
