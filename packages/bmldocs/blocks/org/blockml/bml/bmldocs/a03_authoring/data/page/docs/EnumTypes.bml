<!--BlockML Documentation — a guide to closed sets of named values

  FQN: org.blockml.bml.bmldocs.a03_authoring.data.page.docs.EnumTypes-->
<docs:EnumTypes xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:docs="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to closed sets of named values
  </is>
  <documentation>
    Scope: a closed set of named literal values, the EnumType branch, and its contrast with
    PrimitiveType and StructType, grounded in org.blockml.bml.type.EnumType, the EnumType section
    of org.blockml.bml.documentation.TypeSystemOverview, and the enum-suggestions prohibition in
    org.blockml.bml.documentation.ConstraintsModel. Body content is authored in a03 from those
    sources.
  </documentation>
  <references>
    <see type="type:EnumType" relation="Requires">
      The closed named-value ValueType branch this page introduces.
    </see>
    <see type="doc:TypeSystemOverview" relation="Requires">
      Primary content source — EnumType examples and branch role in the type system.
    </see>
    <see type="doc:ConstraintsModel" relation="SeeAlso">
      Suggestions forbidden on EnumType properties.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Enum Types</value>
    </title>
    <purpose override="true">
      <value>Teach EnumType as a finite, closed set of named values and its own ValueType branch, so readers can define a closed enum and use its literal values.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <workflow:AuthorativeSourceSet>
          <includedTypes>
            <type:TypeSelectorEntity value="org.blockml.bml.type.EnumType" />
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.TypeSystemOverview" />
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.ConstraintsModel" />
          </includedTypes>
        </workflow:AuthorativeSourceSet>
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>Teach EnumType as a finite, closed set of named values and its own ValueType branch.</summary>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>The reader can define a closed enum and use its literal values.</summary>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>A closed set of named literal values, the EnumType branch, and its contrast with PrimitiveType and StructType.</summary>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>Suggestions mechanics, beyond noting the enum prohibition.</summary>
          <reason>Suggestions get their own page; here only the restriction on enum properties matters.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <supportingPoints override="true">
      <composition>
        <sem:SupportingPoint>
          <summary>Suggestions are forbidden on EnumType properties.</summary>
        </sem:SupportingPoint>
      </composition>
    </supportingPoints>
  </aggregations>
</docs:EnumTypes>
