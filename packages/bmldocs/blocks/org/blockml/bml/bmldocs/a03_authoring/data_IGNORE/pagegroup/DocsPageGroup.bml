<!--BlockML Documentation — Documentation page group

  FQN: org.blockml.bml.bmldocs.a03_authoring.data.pagegroup.DocsPageGroup-->
<pgroup:DocsPageGroup xmlns="http://blockml.org/bml"
  xmlns:pgroup="org.blockml.bml.bmldocs.a03_authoring.data.pagegroup"
  xmlns:page="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:dcore="org.blockml.bml.docgen.core">

  <baseType>
    dcore:PageGroup
  </baseType>
  <is>
    The Documentation page group for the a03 documentation set
  </is>
  <documentation>
    Documentation subtree under RootPageGroup; this group is the A03 counterpart of
    a02_structuring's DocsPageGroup. pages / landingPage / parentGroup name only A03 Blocks.
    Direct pages: TableOfContents. Section PageGroups (GettingStarted, CoreIdeas, Types,
    Behaviour, Libraries, Authoring, DeeperTopics, HowTo) nest under this group via parentGroup.
  </documentation>
  <references>
    <see type="dcore:PageGroup" relation="Extends">
      Docgen page group base.
    </see>
    <see type="pgroup:RootPageGroup" relation="Requires">
      Top-level site root page group.
    </see>
    <see type="page:TableOfContents" relation="Requires">
      Direct page of this group.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Documentation</value>
    </title>
    <parentGroup override="true">
      <value>pgroup:RootPageGroup</value>
    </parentGroup>
  </properties>
</pgroup:DocsPageGroup>
