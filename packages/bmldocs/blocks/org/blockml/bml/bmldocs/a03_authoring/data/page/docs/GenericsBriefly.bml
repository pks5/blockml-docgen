<!--BlockML Documentation — Generics briefly

  FQN: org.blockml.bml.bmldocs.a03_authoring.data.page.docs.GenericsBriefly-->
<page:GenericsBriefly xmlns="http://blockml.org/bml"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:page="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:lpage="org.blockml.bml.bmldocs.lib.page"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:dlevel="org.blockml.bml.docgen.level"
  xmlns:ptype="org.blockml.bml.docgen.pagetype"
  xmlns:role="org.blockml.bml.docgen.role"
  xmlns:weight="org.blockml.bml.docgen.weight"
  xmlns:core="org.blockml.bml.core"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    lpage:BmlDocPage
  </baseType>
  <is>
    A short website intro to generics
  </is>
  <documentation>
    Marker page: declare a type parameter, bind it on baseType, and see one inheritance example —
    keep advanced constraints for later reading.
    content is a structural scaffold only; generate prose and examples from referenced core
    documentation (doc:GenericsModel).
  </documentation>
  <references>
    <see type="doc:GenericsModel" relation="Requires">
      Primary content source — generics declarations and binding.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Generics briefly</value>
    </title>
    <purpose override="true">
      <value>Introduce generics as parameters owned by the declaring Block.</value>
    </purpose>
    <detailLevel override="true">
      <value>dlevel:Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>ptype:Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <doc:GenericsModel />
        <doc:TypeExpressions />
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <authoritativeSources>
            <doc:GenericsModel />
            <doc:TypeExpressions />
          </authoritativeSources>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <authoritativeSources>
            <doc:GenericsModel />
          </authoritativeSources>
        </sem:ReaderOutcome>
        <sem:ReaderOutcome>
          <authoritativeSources>
            <doc:GenericsModel />
          </authoritativeSources>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <authoritativeSources>
            <doc:GenericsModel />
            <doc:TypeExpressions />
          </authoritativeSources>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <reason>Variance details belong after the basic ownership and binding model is clear.</reason>
        </sem:Exclusion>
        <sem:Exclusion>
          <reason>This page establishes the author-facing model, not compiler machinery.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Parameters owned by the declaring Block" purpose="Frame generics as Block-owned type parameters">
          <content>
            <dpage:Paragraph purpose="Introduce generics as parameters owned by the declaring Block">
              <role>role:Lead</role>
              <detailLevel>dlevel:Overview</detailLevel>
              <weight>weight:Primary</weight>
              <message>Generics are type parameters owned by the Block that declares them.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:GenericsModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:TypeExpressions />
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:GenericsModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. No implicit inheritance-->
        <dpage:Section heading="No implicit inheritance of parameters" purpose="Make binding or forwarding explicit when using a generic base">
          <content>
            <dpage:Paragraph purpose="Explain that baseType use requires binding or forwarding every base parameter">
              <role>role:Explanation</role>
              <detailLevel>dlevel:Introductory</detailLevel>
              <weight>weight:Primary</weight>
              <message>When a Block uses a generic Block as its base type, every base parameter
must be bound or forwarded; parameters are not inherited implicitly.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:GenericsModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:GenericsModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:GenericsModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
              <exclusions>
                <sem:Exclusion />
              </exclusions>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Application syntax-->
        <dpage:Section heading="Application at use sites" purpose="Explain round-parentheses generic application in type expressions">
          <content>
            <dpage:Paragraph purpose="Explain Type(Args) application syntax and its relationship to ownership">
              <role>role:Explanation</role>
              <detailLevel>dlevel:Introductory</detailLevel>
              <weight>weight:Primary</weight>
              <message>At a use site, round parentheses bind type arguments to the parameters owned
by the named Block, as in Box(Integer).</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:TypeExpressions />
                    <doc:GenericsModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
                <sem:SupportingPoint>
                  <authoritativeSources>
                    <doc:GenericsModel />
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
              <exclusions>
                <sem:Exclusion>
                  <reason>Those mechanisms are orthogonal and belong on neighboring pages.</reason>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Summary of sites-->
        <dpage:Section heading="Where generics appear" purpose="Summarize declaration, application, and inheritance sites">
          <content>
            <dpage:Paragraph purpose="Prepare the reader for the three-site summary list">
              <role>role:Transition</role>
              <detailLevel>dlevel:Overview</detailLevel>
              <weight>weight:Supporting</weight>
              <message>Generics show up in three places: declaration, application, and inheritance.</message>
            </dpage:Paragraph>
            <dpage:List purpose="Present the principal generics sites as a concise summary">
              <role>role:Summary</role>
              <detailLevel>dlevel:Overview</detailLevel>
              <weight>weight:Primary</weight>
              <message>These three sites cover how generics are declared and used.</message>
              <items>
                <dpage:ListItem text="Declaration" purpose="Explain genericTypes on the declaring Block">
                  <message>Declaration introduces type parameters on the Block that owns them.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Application" purpose="Explain Type(Args) at use sites">
                  <message>Application binds type arguments at use sites in type expressions.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Inheritance" purpose="Explain baseType binding or forwarding in derived Blocks">
                  <message>Inheritance requires binding or forwarding every parameter of a
generic base type.</message>
                </dpage:ListItem>
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <!--5. Example-->
        <dpage:Section heading="A generic declaration and binding" purpose="Connect the concept to a small generics example">
          <content>
            <dpage:Paragraph purpose="Introduce a generic declaration and a concrete binding">
              <role>role:Explanation</role>
              <detailLevel>dlevel:Introductory</detailLevel>
              <weight>weight:Supporting</weight>
              <message>A short example shows a Block declaring a type parameter and a use site
binding it to a concrete type.</message>
              <exclusions>
                <sem:Exclusion />
              </exclusions>
            </dpage:Paragraph>
            <dpage:CodeBlock purpose="Illustrate complete Blocks for generic declaration and concrete binding">
              <role>role:Example</role>
              <detailLevel>dlevel:Overview</detailLevel>
              <weight>weight:Supporting</weight>
              <message>Show complete Blocks: one declaring a type parameter under genericTypes, and
one applying or binding that parameter to a concrete type.</message>
              <supportingPoints>
                <sem:SupportingPoint />
                <sem:SupportingPoint />
              </supportingPoints>
              <exclusions>
                <sem:Exclusion />
              </exclusions>
            </dpage:CodeBlock>
            <dpage:Paragraph purpose="Interpret the declaration and binding constructs in the example">
              <role>role:Explanation</role>
              <detailLevel>dlevel:Introductory</detailLevel>
              <weight>weight:Supporting</weight>
              <message>In the example, the declaring Block owns the parameter under genericTypes,
and the use site's parentheses bind that parameter to a concrete type rather
than inheriting it silently.</message>
              <supportingPoints>
                <sem:SupportingPoint />
                <sem:SupportingPoint />
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Navigation-->
        <dpage:Section heading="Return to type expressions" purpose="Direct the reader back to combination forms">
          <content>
            <dpage:Navigation purpose="Continue the type-system learning sequence">
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Type expressions" summary="See how generics fit among multiplicity, unions, and configuration.">
                  <target>page:TypeExpressionsBasics</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</page:GenericsBriefly>
