<!--BlockML Documentation — a guide to owned collection members

  FQN: org.blockml.bml.bmldocs.a03_authoring.data.page.docs.Aggregations-->
<docs:Aggregations xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:docs="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition"
  xmlns:type="org.blockml.bml.type"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to owned collection members
  </is>
  <documentation>
    Scope: owned collection members, ownership, composition fill, and aggregations versus
    associations, grounded in org.blockml.bml.definition.AggregationDefinition and
    org.blockml.bml.documentation.CompositionModel. Body content is authored in a03 from those
    sources.
  </documentation>
  <references>
    <see type="def:AggregationDefinition" relation="Requires">
      The owned collection member this page introduces.
    </see>
    <see type="doc:CompositionModel" relation="Requires">
      Primary content source — composition fill rules and instance-side aggregation opening.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Aggregations</value>
    </title>
    <purpose override="true">
      <value>Teach Aggregation as an owned collection filled by Composition, so readers can declare and fill an owned collection member and open it correctly on an instance.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <workflow:AuthorativeSourceSet>
          <includedTypes>
            <type:TypeSelectorEntity value="org.blockml.bml.definition.AggregationDefinition" />
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.CompositionModel" />
          </includedTypes>
        </workflow:AuthorativeSourceSet>
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>Teach Aggregation as an owned collection filled by Composition.</summary>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>The reader can declare and fill an owned collection member.</summary>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>Owned collection members, ownership, filling an aggregation with composition, and the contrast between aggregations and associations.</summary>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>Association depth beyond the ownership contrast.</summary>
          <reason>Associations get their own following page.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <supportingPoints override="true">
      <composition>
        <sem:SupportingPoint>
          <summary>On a Block instance, aggregation children sit directly inside the named aggregation element — there is no composition wrapper or default aggregation on instances.</summary>
        </sem:SupportingPoint>
      </composition>
    </supportingPoints>
    <content override="true">
      <composition>
        <dpage:Section heading="What an Aggregation is" purpose="Introduce Aggregation as an owned collection member">
          <content>
            <dpage:Paragraph purpose="Introduce Aggregation as a member that owns a collection of child Block instances">
              <role>org.blockml.bml.docgen.role.Lead</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>An Aggregation is a Block member representing an owned collection: its children are
Block instances whose lifecycle belongs to the owning Block.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Declaring an owned collection member" purpose="Explain what an Aggregation declaration names">
          <content>
            <dpage:Paragraph purpose="Explain that declaring an Aggregation means naming the kind of Block it owns">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Declaring an Aggregation means naming the kind of Block its children must be, so the
collection knows what it may own.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Filling an Aggregation with composition" purpose="Show how a Block definition supplies an Aggregation's initial children">
          <content>
            <dpage:Paragraph purpose="Explain that composition supplies an Aggregation's children on the definition">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>On a Block definition, a composition nested inside the Aggregation member supplies
the concrete child Block instances that fill it.</message>
            </dpage:Paragraph>
            <dpage:CodeBlock purpose="Illustrate an Aggregation declaration filled with composition">
              <role>org.blockml.bml.docgen.role.Example</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>An Aggregation declaration names its child type and nests a composition holding the
initial child Block instances.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>Show the Aggregation's type together with one nested composition child.</summary>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:CodeBlock>
            <dpage:Paragraph purpose="Interpret the composition shown in the example">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>In the example, the composition is nested inside the Aggregation member itself — it
is a declaration-only field, never a wrapper used when a domain instance is authored.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Opening an Aggregation on an instance" purpose="Explain how a Block instance actually supplies Aggregation children">
          <content>
            <dpage:Paragraph purpose="State that instance children sit directly inside the named Aggregation element">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>On a Block instance, aggregation children sit directly inside the named aggregation
element — there is no composition wrapper and no default aggregation, so the
aggregation must always be opened by its member name.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>On a Block instance, aggregation children sit directly inside the named aggregation element — there is no composition wrapper or default aggregation on instances.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.CompositionModel" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
              <readerOutcomes>
                <sem:ReaderOutcome>
                  <summary>The reader can open and fill an owned collection member correctly on an instance.</summary>
                </sem:ReaderOutcome>
              </readerOutcomes>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Aggregation versus Association: who owns what" purpose="Contrast owning collections with non-owning links, without going into Association mechanics">
          <content>
            <dpage:Paragraph purpose="Contrast Aggregation ownership with the non-owning nature of Association">
              <role>org.blockml.bml.docgen.role.Comparison</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>An Aggregation owns the Block instances it holds, while an Association only points to
an instance elsewhere without taking ownership of it.</message>
              <exclusions>
                <sem:Exclusion>
                  <summary>Association depth beyond the ownership contrast.</summary>
                  <reason>Associations get their own following page.</reason>
                </sem:Exclusion>
              </exclusions>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with Associations" purpose="Direct the reader to the next member kind">
          <content>
            <dpage:Navigation purpose="Continue from owned collections into non-owning instance links">
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Associations" summary="Learn Association as a non-owning instance-to-instance link.">
                  <target>docs:Associations</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Aggregations>
