<!--BlockML Documentation — a guide to typed value members

  FQN: org.blockml.bml.bmldocs.a03_authoring.data.page.docs.Properties-->
<docs:Properties xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:docs="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition"
  xmlns:type="org.blockml.bml.type"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to typed value members
  </is>
  <documentation>
    Scope: typed value members, their definition, configuration, and inheritance and override,
    grounded in org.blockml.bml.definition.PropertyDefinition and the Property authoring rules in
    org.blockml.bml.documentation.MemberAuthoring. Body content is authored in a03 from those
    sources.
  </documentation>
  <references>
    <see type="def:PropertyDefinition" relation="Requires">
      The typed value member this page introduces.
    </see>
    <see type="doc:MemberAuthoring" relation="Requires">
      Primary content source — definition-field value versus instance-side payload syntax.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Properties</value>
    </title>
    <purpose override="true">
      <value>Teach Property as a scalar or structured value member, so readers can declare a typed Property with a default value and tell the definition-side value field from the instance-side payload.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <workflow:AuthorativeSourceSet>
          <includedTypes>
            <type:TypeSelectorEntity value="org.blockml.bml.definition.PropertyDefinition" />
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.MemberAuthoring" />
          </includedTypes>
        </workflow:AuthorativeSourceSet>
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>Teach Property as a scalar or structured value member.</summary>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>The reader can declare a typed Property with a default value.</summary>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>Typed value members: declaring a Property, configuring its default value, and how Properties are inherited and overridden.</summary>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>Suggestions or constraints depth.</summary>
          <reason>Those are separate member-behaviour topics with their own pages.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <supportingPoints override="true">
      <composition>
        <sem:SupportingPoint>
          <summary>A Property's default value lives in the value field of its declaration — never as an instance-side wrapper.</summary>
        </sem:SupportingPoint>
      </composition>
    </supportingPoints>
    <content override="true">
      <composition>
        <dpage:Section heading="What a Property is" purpose="Introduce Property as the member that carries a single value">
          <content>
            <dpage:Paragraph purpose="Introduce Property as a scalar or structured value member">
              <role>org.blockml.bml.docgen.role.Lead</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A Property is a Block member that carries a single scalar or structured value — the
piece of data a Block holds, as opposed to owned children or behaviour.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Declaring a typed Property with a default value" purpose="Explain the concept of a Property declaration, then show a minimal example">
          <content>
            <dpage:Paragraph purpose="Explain that declaring a Property means naming its type and optionally a default">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Declaring a Property means naming the kind of value it holds and, optionally, giving
it a default so that instances need not always supply one.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>A Property's default value lives in the value field of its declaration — never as an instance-side wrapper.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.definition.PropertyDefinition" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
            <dpage:CodeBlock purpose="Illustrate a minimal typed Property declaration with a default value">
              <role>org.blockml.bml.docgen.role.Example</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>A Property declaration names its type and may supply a default value directly on
that same declaration.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>Show the type and the default value together on one Property declaration.</summary>
                </sem:SupportingPoint>
              </supportingPoints>
              <exclusions>
                <sem:Exclusion>
                  <summary>Suggestions, constraints, and other optional declaration fields.</summary>
                  <reason>Those are separate member-behaviour topics with their own pages.</reason>
                </sem:Exclusion>
              </exclusions>
            </dpage:CodeBlock>
            <dpage:Paragraph purpose="Interpret the declared type and default value shown in the example">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>In the example, the declared type names the kind of value the Property holds, and the
default value is what an instance receives when it sets nothing itself.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Definition value versus instance payload" purpose="Distinguish the declaration's default value field from how an instance actually carries a Property">
          <content>
            <dpage:Paragraph purpose="Explain that a Property declaration's default and an instance's payload are two different things">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>The default value on a Property declaration and the value an instance carries are two
different things: the declaration's default lives in its own value field, while an
instance supplies the Property directly, as an attribute or as the member element's
own content.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>An instance never wraps its Property payload in a value element — that wrapper belongs to the declaration only.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.MemberAuthoring" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
              <readerOutcomes>
                <sem:ReaderOutcome>
                  <summary>The reader can tell the definition-side default value field apart from the instance-side Property payload.</summary>
                </sem:ReaderOutcome>
              </readerOutcomes>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Every Property is optional" purpose="Explain that a Property either has a value or has none, with no separate null state">
          <content>
            <dpage:Paragraph purpose="State that a Property always behaves as optional">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>A Property always behaves as optional: it either holds a value or holds none at
all — there is no separate null state to consider.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Inherited Properties and refining a default" purpose="Give a first, light look at refining an inherited Property's default value">
          <content>
            <dpage:Paragraph purpose="Explain that an inherited Property's default can be refined in a child Block">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>A Property inherited from a base Block can be refined in a child Block by
redeclaring it and supplying a new default value.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with Aggregations" purpose="Direct the reader to the next member kind">
          <content>
            <dpage:Navigation purpose="Continue from Property into the owned-collection member kind">
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Aggregations" summary="Learn Aggregation as an owned collection filled by composition.">
                  <target>docs:Aggregations</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Properties>
