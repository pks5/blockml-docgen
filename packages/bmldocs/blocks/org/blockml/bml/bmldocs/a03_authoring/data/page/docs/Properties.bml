<!--BlockML Documentation — a guide to typed value members

  FQN: org.blockml.bml.bmldocs.a03_authoring.data.page.docs.Properties-->
<docs:Properties xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:docs="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition"
  xmlns:type="org.blockml.bml.type"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to typed value members
  </is>
  <documentation>
    Scope: typed value members, their definition, configuration, and inheritance and override,
    grounded in org.blockml.bml.definition.PropertyDefinition and the Property authoring rules in
    org.blockml.bml.documentation.MemberAuthoring. Body content is authored in a03 from those
    sources.
  </documentation>
  <references>
    <see type="def:PropertyDefinition" relation="Requires">
      The typed value member this page introduces.
    </see>
    <see type="doc:MemberAuthoring" relation="Requires">
      Primary content source — definition-field value versus instance-side payload syntax.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Properties</value>
    </title>
    <purpose override="true">
      <value>Teach Property as a scalar or structured value member, so readers can declare a typed Property with a default value and tell the definition-side value field from the instance-side payload.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <workflow:AuthorativeSourceSet>
          <includedTypes>
            <type:TypeSelectorEntity value="org.blockml.bml.definition.PropertyDefinition" />
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.MemberAuthoring" />
          </includedTypes>
        </workflow:AuthorativeSourceSet>
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>Teach Property as a scalar or structured value member.</summary>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>The reader can declare a typed Property with a default value.</summary>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>Typed value members: declaring a Property, configuring its default value, and how Properties are inherited and overridden.</summary>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>Suggestions or constraints depth.</summary>
          <reason>Those are separate member-behaviour topics with their own pages.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <supportingPoints override="true">
      <composition>
        <sem:SupportingPoint>
          <summary>A Property's default value lives in the value field of its declaration — never as an instance-side wrapper.</summary>
        </sem:SupportingPoint>
      </composition>
    </supportingPoints>
  </aggregations>
</docs:Properties>
