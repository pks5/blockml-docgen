<!--BlockML Documentation — a guide to member and Sub-Block visibility

  FQN: org.blockml.bml.bmldocs.a03_authoring.data.page.docs.Visibility-->
<docs:Visibility xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:docs="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition"
  xmlns:type="org.blockml.bml.type"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to member and Sub-Block visibility
  </is>
  <documentation>
    Scope: member and Sub-Block visibility and the public/protected/private naming convention,
    grounded in org.blockml.bml.documentation.MemberVisibility and
    org.blockml.bml.definition.SubBlockDefinition. Body content is authored in a03 from those
    sources.
  </documentation>
  <references>
    <see type="doc:MemberVisibility" relation="Requires">
      Primary content source — naming convention, formal access, and visibility diagnostics.
    </see>
    <see type="def:SubBlockDefinition" relation="Requires">
      Sub-Blocks share the same naming-convention visibility rules as members.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Visibility</value>
    </title>
    <purpose override="true">
      <value>Teach the naming-convention visibility model, so readers can tell a member's visibility from its name and understand what public, protected, and private actually restrict.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <workflow:AuthorativeSourceSet>
          <includedTypes>
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.MemberVisibility" />
            <type:TypeSelectorEntity value="org.blockml.bml.definition.SubBlockDefinition" />
          </includedTypes>
        </workflow:AuthorativeSourceSet>
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>Teach the naming-convention visibility model.</summary>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>The reader can tell a member's visibility from its name.</summary>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>Member and Sub-Block visibility, and the public, protected, and private naming convention.</summary>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>Renderer implementation detail.</summary>
          <reason>Visibility restricts authoring access only; it is not a renderer concern.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <supportingPoints override="true">
      <composition>
        <sem:SupportingPoint>
          <summary>Visibility restricts authoring access only — renderers always see the entire Canonical BOM regardless of visibility.</summary>
        </sem:SupportingPoint>
      </composition>
    </supportingPoints>
    <content override="true">
      <composition>
        <dpage:Section heading="Visibility by naming convention" purpose="State the primary visibility signal">
          <content>
            <dpage:Paragraph purpose="State the naming convention">
              <role>org.blockml.bml.docgen.role.Lead</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A member's name signals its visibility: myVar is public, _myVar is protected, and __myVar is private.</message>
              <authoritativeSources>
                <workflow:AuthorativeSourceSet>
                  <includedTypes>
                    <type:TypeSelectorEntity value="org.blockml.bml.documentation.MemberVisibility" />
                  </includedTypes>
                </workflow:AuthorativeSourceSet>
              </authoritativeSources>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What visibility restricts" purpose="State that visibility is an authoring-access control, not a renderer control">
          <content>
            <dpage:Paragraph purpose="State that visibility controls authoring access only">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Visibility controls which definitions may reference, read, or set a member — it restricts authoring access only, and renderers always see the entire Canonical BOM.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Widening on override" purpose="State the override-time visibility rule">
          <content>
            <dpage:Paragraph purpose="State that visibility may widen but not narrow on override">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A child may redeclare a member with wider visibility, such as protected to public, but never narrower.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Sub-Blocks share the same rule" purpose="Extend the naming convention to Sub-Blocks">
          <content>
            <dpage:Paragraph purpose="State that Sub-Blocks share the member visibility convention">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>Sub-Blocks use the same naming-convention visibility rules as members.</message>
              <authoritativeSources>
                <workflow:AuthorativeSourceSet>
                  <includedTypes>
                    <type:TypeSelectorEntity value="org.blockml.bml.definition.SubBlockDefinition" />
                  </includedTypes>
                </workflow:AuthorativeSourceSet>
              </authoritativeSources>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages" purpose="Anchor the reader outcome before multiplicity is introduced">
          <content>
            <dpage:Paragraph purpose="State the retained outcome">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Readers should now be able to tell a member's visibility from its name.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with multiplicity and collections" purpose="Direct the reader to the next page">
          <content>
            <dpage:Navigation purpose="Continue the Members sequence">
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Multiplicity and Collections" summary="Learn how optional, singular, and multiple values are expressed.">
                  <target>docs:MultiplicityAndCollections</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Visibility>
