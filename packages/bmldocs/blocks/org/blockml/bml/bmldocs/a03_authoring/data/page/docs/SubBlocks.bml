<!--BlockML Documentation — a guide to nested Block definitions

  FQN: org.blockml.bml.bmldocs.a03_authoring.data.page.docs.SubBlocks-->
<docs:SubBlocks xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:docs="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition"
  xmlns:type="org.blockml.bml.type"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to nested Block definitions
  </is>
  <documentation>
    Scope: nested Block definitions, Sub-Block identity and scope, and nesting depth, grounded in
    the Sub-Block sections of org.blockml.bml.documentation.SubBlockModel and
    org.blockml.bml.definition.SubBlockDefinition. Body content is authored in a03 from those
    sources.
  </documentation>
  <references>
    <see type="doc:SubBlockModel" relation="Requires">
      Primary content source — Sub-Block nesting, identity derivation, and generic scope.
    </see>
    <see type="def:SubBlockDefinition" relation="Requires">
      The nested Sub-Block definition shape this page introduces.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Sub-Blocks</value>
    </title>
    <purpose override="true">
      <value>Teach Sub-Blocks as nested Block definitions sharing the parent's FQN prefix, so readers can nest a definition inside a parent Block and know how deep nesting resolves.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <workflow:AuthorativeSourceSet>
          <includedTypes>
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.SubBlockModel" />
            <type:TypeSelectorEntity value="org.blockml.bml.definition.SubBlockDefinition" />
          </includedTypes>
        </workflow:AuthorativeSourceSet>
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>Teach Sub-Blocks as nested definitions that share the parent's FQN prefix.</summary>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>The reader can nest a Block definition inside a parent Block.</summary>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>Nested Block definitions, Sub-Block identity and scope, and nesting depth.</summary>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>Embedded Blocks depth beyond the nesting note.</summary>
          <reason>Embedded Blocks get their own contrasting page next.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <supportingPoints override="true">
      <composition>
        <sem:SupportingPoint>
          <summary>Sub-Blocks do not see the enclosing Block's generic type parameters — outer parameters must be forwarded explicitly.</summary>
        </sem:SupportingPoint>
      </composition>
    </supportingPoints>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="A Block definition nested inside another" purpose="Introduce Sub-Blocks with the static-nested-class analogy">
          <content>
            <dpage:Paragraph purpose="State what a Sub-Block is in one sentence">
              <role>org.blockml.bml.docgen.role.Lead</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A Sub-Block is a Block definition nested inside a parent Block, comparable to a
static nested class: it shares the parent's identity prefix without opening a
document or library of its own.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>A Sub-Block is declared inside the parent Block rather than as its own document.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.SubBlockModel" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. Identity-->
        <dpage:Section heading="How a Sub-Block gets its identity" purpose="Explain name and type derivation for a nested definition">
          <content>
            <dpage:Paragraph purpose="Explain that a Sub-Block's identity is derived from its parent">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A Sub-Block's local name is required, while its full identity is normally
derived by extending the immediately enclosing Block's identity with that
local name, so nesting can continue to any depth.</message>
              <authoritativeSources>
                <def:SubBlockDefinition />
              </authoritativeSources>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>A parent Block may itself be a Sub-Block, so nesting composes to any depth.</summary>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Declaring one-->
        <dpage:Section heading="Declaring a Sub-Block" purpose="Explain where a Sub-Block is written and what it must state">
          <content>
            <dpage:Paragraph purpose="Explain the preferred authoring shape for a Sub-Block">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A Sub-Block is declared inside its parent Block, and a Sub-Block must always
state its own baseType even though its other fields follow the same shape as
a root Block.</message>
              <authoritativeSources>
                <doc:SubBlockModel />
              </authoritativeSources>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Generic scope-->
        <dpage:Section heading="Sub-Blocks and generic type parameters" purpose="Explain the generic-scope boundary between a Sub-Block and its parent">
          <content>
            <dpage:Paragraph purpose="Explain that a Sub-Block cannot see the enclosing Block's generic parameters">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A Sub-Block may declare its own generic type parameters, but it does not see
the generic type parameters of its enclosing Block — a parameter the parent
needs inside the Sub-Block must be forwarded explicitly.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>Sub-Blocks do not see the enclosing Block's generic type parameters — outer parameters must be forwarded explicitly.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.SubBlockModel" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. Recap-->
        <dpage:Section heading="What to remember about Sub-Blocks" purpose="Anchor the outcome before contrasting Sub-Blocks with embedded Blocks">
          <content>
            <dpage:Paragraph purpose="State the outcome readers should retain about nesting a definition">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A Sub-Block lets a Block definition nest inside a parent while sharing its
identity prefix, with deeper nesting simply extending that prefix one more
step; a different kind of nested document, the embedded Block, follows next.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with embedded Blocks" purpose="Direct the reader to the contrasting Embedded Blocks page">
          <content>
            <dpage:Navigation purpose="Continue from nested Sub-Blocks into the contrasting embedded Block form">
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Embedded Blocks" summary="See how an embedded Block differs from a Sub-Block by keeping its own independent identity.">
                  <target>docs:EmbeddedBlocks</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:SubBlocks>
