<!--BlockML Documentation — a guide to nested Block definitions

  FQN: org.blockml.bml.bmldocs.a03_authoring.data.page.docs.SubBlocks-->
<docs:SubBlocks xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:docs="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition"
  xmlns:type="org.blockml.bml.type"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to nested Block definitions
  </is>
  <documentation>
    Scope: nested Block definitions, Sub-Block identity and scope, and nesting depth, grounded in
    the Sub-Block sections of org.blockml.bml.documentation.SubBlockModel and
    org.blockml.bml.definition.SubBlockDefinition. Body content is authored in a03 from those
    sources.
  </documentation>
  <references>
    <see type="doc:SubBlockModel" relation="Requires">
      Primary content source — Sub-Block nesting, identity derivation, and generic scope.
    </see>
    <see type="def:SubBlockDefinition" relation="Requires">
      The nested Sub-Block definition shape this page introduces.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Sub-Blocks</value>
    </title>
    <purpose override="true">
      <value>Teach Sub-Blocks as nested Block definitions sharing the parent's FQN prefix, so readers can nest a definition inside a parent Block and know how deep nesting resolves.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <workflow:AuthorativeSourceSet>
          <includedTypes>
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.SubBlockModel" />
            <type:TypeSelectorEntity value="org.blockml.bml.definition.SubBlockDefinition" />
          </includedTypes>
        </workflow:AuthorativeSourceSet>
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>Teach Sub-Blocks as nested definitions that share the parent's FQN prefix.</summary>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>The reader can nest a Block definition inside a parent Block.</summary>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>Nested Block definitions, Sub-Block identity and scope, and nesting depth.</summary>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>Embedded Blocks depth beyond the nesting note.</summary>
          <reason>Embedded Blocks get their own contrasting page next.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <supportingPoints override="true">
      <composition>
        <sem:SupportingPoint>
          <summary>Sub-Blocks do not see the enclosing Block's generic type parameters — outer parameters must be forwarded explicitly.</summary>
        </sem:SupportingPoint>
      </composition>
    </supportingPoints>
    <content override="true">
      <composition>
        <dpage:Section heading="A nested definition" purpose="State what a Sub-Block is">
          <content>
            <dpage:Paragraph purpose="Introduce Sub-Blocks">
              <role>org.blockml.bml.docgen.role.Lead</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A Sub-Block is a Block definition nested inside a parent Block, sharing the parent's FQN prefix — much like a Java static nested class.</message>
              <authoritativeSources>
                <workflow:AuthorativeSourceSet>
                  <includedTypes>
                    <type:TypeSelectorEntity value="org.blockml.bml.documentation.SubBlockModel" />
                  </includedTypes>
                </workflow:AuthorativeSourceSet>
              </authoritativeSources>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Deriving a Sub-Block's identity" purpose="Explain how a Sub-Block's name and type are derived">
          <content>
            <dpage:Paragraph purpose="Explain Sub-Block identity derivation">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A Sub-Block's name is its required local identity, supplied by the element tag, while its type is normally omitted and derived as the parent's type plus the name.</message>
              <authoritativeSources>
                <workflow:AuthorativeSourceSet>
                  <includedTypes>
                    <type:TypeSelectorEntity value="org.blockml.bml.definition.SubBlockDefinition" />
                  </includedTypes>
                </workflow:AuthorativeSourceSet>
              </authoritativeSources>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="No enclosing generic scope" purpose="State the generic-forwarding rule for Sub-Blocks">
          <content>
            <dpage:Paragraph purpose="State that Sub-Blocks must forward outer generics explicitly">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Sub-Blocks do not see the enclosing Block's generic type parameters — outer parameters must be forwarded explicitly.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Naming distinctly from the parent" purpose="State the naming-clarity guideline">
          <content>
            <dpage:Paragraph purpose="State the guideline for choosing distinctive Sub-Block names">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>Prefer a Sub-Block name that differs from the enclosing root Block's name, to avoid ambiguous short reference tags.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages" purpose="Anchor the reader outcome before embedded Blocks are contrasted">
          <content>
            <dpage:Paragraph purpose="State the retained outcome">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Readers should now be able to nest a definition inside a parent Block.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with embedded Blocks" purpose="Direct the reader to the contrasting nesting mechanism">
          <content>
            <dpage:Navigation purpose="Continue the Composition and Structure sequence">
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Embedded Blocks" summary="Learn the full-document alternative to Sub-Block nesting.">
                  <target>docs:EmbeddedBlocks</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:SubBlocks>
