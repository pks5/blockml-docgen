<!--BlockML Documentation — author semantic structure on imported A03 pages
  FQN: org.blockml.bml.bmldocs.a03_authoring.task.A03_02_AuthorPages-->
<task:A03_02_AuthorPages xmlns="http://blockml.org/bml"
  xmlns:task="org.blockml.bml.bmldocs.a03_authoring.task"
  xmlns:ltask="org.blockml.bml.bmldocs.lib.task"
  xmlns:source="org.blockml.bml.bmldocs.lib.source"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule"
  xmlns:lcrit="org.blockml.bml.bmldocs.lib.criterion"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    ltask:RuleAwareInstructionTask
  </baseType>
  <is>
    A task that authors the semantic structure of imported A03 pages
  </is>
  <documentation>
    A03 authoring task: enrich every page imported by A03_01_CopyData with
    a content scaffold that A04 will render. This task does not copy
    or delete A03 data.

    - **Import** — A03_01_CopyData already wiped A03 data and imported the
      full A02 data tree with packages and names remapped
    - **Identity** — title, purpose, detailLevel, pageType, is stay on
      the imported A03 page
    - **Page semantics** — keep the page-level authoritativeSources,
      scopes, readerOutcomes, learningObjectives, exclusions, and
      supportingPoints from A02_02_UpdatePageSkeletons; refine them only
      when the bound sources justify a tighter wording
    - **Content** — author DocPage.content as Sections and ContentElements
      that refine page semantics at element level
    - **Rules** — AuthoringRules (inspect each subRule); do not paraphrase
      them in instructions
    - **Sources** — authorativeSources is BlockMLSourceSet
  </documentation>
  <properties>
    <instructions type="type:Text" override="true">
      <value>
        <![CDATA[
          Author the content scaffold that specifies what each imported
          A03 page must show. Sector 3 writes specification, not the
          finished site. Sector 4 renders prose and listings from that
          specification.

          A03_01_CopyData has already wiped live A03 data and imported the
          full A02 data tree with packages and names remapped. This task
          does not copy, delete, or recreate DocSet, Pages, or PageGroups.
          Do not invent pages that are not in BmlDocSet_A03.pages. Do not
          edit A02. Do not write Pages outside a03.

          Keep the imported page identity (is, isNot, title, purpose,
          detailLevel, pageType, lib see-links) and the page-level
          semantic scaffold from A02_02_UpdatePageSkeletons. Refine a
          page-level instance only when the bound sources justify tighter
          wording.

          Discard only DocPage.content. Keep the FQN / file path.

          1. Read org.blockml.bml.bmldocs.a03_authoring.data.BmlDocSet_A03.
          Walk BmlDocSet_A03.pages in listed order. Inspect each page's
          identity and page-level semantics. Element-level sources must be
          subsets of that page's AuthorativeSourceSet.

          2. Resolve this task's authorativeSources (inspect
          BlockMLSourceSet.includedTypes, then scan / inspect matching
          Blocks). Domain claims and links may name only A03 Blocks, that
          source set, or org.blockml.bml.bmldocs.lib.**. Never link a Block
          from another sector. Docgen types may appear as structural
          see-links.

          3. Author DocPage.content as Sections and ContentElements.
          Inspect DocPage, Section, ContentElement, and
          org.blockml.bml.docgen.semantic.* for member shape. Distribute
          kept page semantics onto the content tree as refinements, not
          copies. Set purpose, message, role, detailLevel, and weight on
          each ContentElement.

          Index pages: Navigation tree of A03 pages only; no conceptual
          body.

          4. Export each authored A03 page from
          org.blockml.bml.bmldocs.Library if it is not already in the
          catalog. Do not remove catalog entries of other sectors. Do not
          remove PageExample_A03 if it is catalogued.
        ]]>
      </value>
    </instructions>
  </properties>
  <aggregations>
    <rules override="true">
      <composition>
        <lrule:AuthoringRules />
      </composition>
    </rules>
    <successCriteria override="true">
      <composition>
        <lcrit:HasCodeExampleWhereApplicable />
        <lcrit:CodeBlockFollowedByExplanation />
        <lcrit:CodeBlockOmitsLiteralCode />
      </composition>
    </successCriteria>
    <authorativeSources override="true">
      <composition>
        <source:BlockMLSourceSet />
      </composition>
    </authorativeSources>
  </aggregations>
</task:A03_02_AuthorPages>
