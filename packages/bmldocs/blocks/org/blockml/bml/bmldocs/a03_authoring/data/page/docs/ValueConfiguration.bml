<!--BlockML Documentation — a guide to configuring ValueType instances

  FQN: org.blockml.bml.bmldocs.a03_authoring.data.page.docs.ValueConfiguration-->
<docs:ValueConfiguration xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:docs="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:mapping="org.blockml.bml.mapping"
  xmlns:type="org.blockml.bml.type"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to configuring ValueType instances
  </is>
  <documentation>
    Scope: configuring values and Block instances in BML through curly-brace ValueType
    configuration, grounded in org.blockml.bml.documentation.ValueTypeConfiguration. Body content
    is authored in a03 from that source.
  </documentation>
  <references>
    <see type="doc:ValueTypeConfiguration" relation="Requires">
      Primary content source — named and positional configuration syntax and its rules.
    </see>
    <see type="mapping:FunctionMapping" relation="SeeAlso">
      Shared declaration-order rule for positional configuration.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Value Configuration</value>
    </title>
    <purpose override="true">
      <value>Teach ValueType instance configuration as distinct from generic binding, so readers can write curly-brace configuration on a Property's type reference.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <workflow:AuthorativeSourceSet>
          <includedTypes>
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.ValueTypeConfiguration" />
            <type:TypeSelectorEntity value="org.blockml.bml.mapping.FunctionMapping" />
          </includedTypes>
        </workflow:AuthorativeSourceSet>
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>Teach ValueType configuration as distinct from generic (...) binding.</summary>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>The reader can write curly-brace configuration on a Property's type reference.</summary>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>Configuring values and Block instances in BML: curly-brace ValueType instance configuration.</summary>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>Multiplicity depth beyond noting the ordering.</summary>
          <reason>Multiplicity has its own page; here only that configuration precedes multiplicity matters.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <supportingPoints override="true">
      <composition>
        <sem:SupportingPoint>
          <summary>Configuration is per-property on the owned type instance, never on the ValueType definition block itself.</summary>
        </sem:SupportingPoint>
      </composition>
    </supportingPoints>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Configuring a property's type instance" purpose="Introduce curly-brace configuration on a property's type reference">
          <content>
            <dpage:Paragraph purpose="State what curly-brace configuration does">
              <role>org.blockml.bml.docgen.role.Lead</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Curly-brace syntax lets a property configure the specific instance of its
own type, such as a maximum length or a numeric precision, without changing the
type's definition.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>Configuration is per-property on the owned type instance, never on the ValueType definition block itself.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.ValueTypeConfiguration" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. vs generic binding-->
        <dpage:Section heading="Distinct from generic binding" purpose="Distinguish curly-brace configuration from generic type binding">
          <content>
            <dpage:Paragraph purpose="Contrast configuration with generic type binding">
              <role>org.blockml.bml.docgen.role.Comparison</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Curly-brace configuration is independent of the parentheses used to bind a
generic type parameter, and a single type reference may use both together for
different purposes.</message>
              <authoritativeSources>
                <doc:ValueTypeConfiguration />
              </authoritativeSources>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Named vs positional-->
        <dpage:Section heading="Named and positional configuration" purpose="Explain the two ways to supply configuration values">
          <content>
            <dpage:Paragraph purpose="Explain named versus positional configuration">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A configuration block can name each setting explicitly, or supply the
same settings positionally in the order the type declares them, but a single block
must pick one style rather than mixing the two.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>Positional configuration follows the same declaration-order principle used for positional arguments in a function-like call elsewhere in BlockML.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.mapping.FunctionMapping" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Minimal example-->
        <dpage:Section heading="A minimal configuration example" purpose="Connect the conceptual explanation to a small configured type reference">
          <content>
            <dpage:Paragraph purpose="Introduce the minimal shape of a configured type reference">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>A configured type reference pairs the type's name with a short
curly-brace block that sets one or more of that type's own configuration settings.</message>
            </dpage:Paragraph>
            <dpage:CodeBlock purpose="Illustrate a single named configuration setting on a property's type reference">
              <role>org.blockml.bml.docgen.role.Example</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>Show one property whose type reference carries a single named
configuration setting, with no generic binding or multiplicity present.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>Keep the example to one configuration setting so the curly-brace shape stands out on its own.</summary>
                </sem:SupportingPoint>
              </supportingPoints>
              <exclusions>
                <sem:Exclusion>
                  <summary>Generic binding, multiplicity brackets, and multiple configuration settings in one block.</summary>
                  <reason>The example should isolate the configuration syntax alone.</reason>
                </sem:Exclusion>
              </exclusions>
            </dpage:CodeBlock>
            <dpage:Paragraph purpose="Interpret the configuration example">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>In the example, the configuration setting belongs to that one property's
type instance and would need to be repeated on any other property that reuses the
same type.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. Ordering and recap-->
        <dpage:Section heading="Where configuration fits among type syntax" purpose="Note the ordering between configuration and multiplicity without going into multiplicity depth">
          <content>
            <dpage:Paragraph purpose="Note that configuration precedes multiplicity">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Curly-brace configuration is written on the type reference before any
multiplicity brackets that follow it, so the configuration applies first and the
collection shape is layered on afterward.</message>
              <authoritativeSources>
                <doc:ValueTypeConfiguration />
              </authoritativeSources>
            </dpage:Paragraph>
            <dpage:List purpose="Summarize how configuration behaves wherever it appears">
              <role>org.blockml.bml.docgen.role.Summary</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>These points summarize how configuration behaves wherever it appears.</message>
              <items>
                <dpage:ListItem text="Applies to the instance" purpose="Recap that configuration belongs to the property's type instance">
                  <message>Configuration always belongs to the property's own type instance.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Independent of generics" purpose="Recap independence from generic binding">
                  <message>Configuration and generic binding serve different purposes and can be combined.</message>
                </dpage:ListItem>
                <dpage:ListItem text="One style at a time" purpose="Recap that named and positional styles are never mixed">
                  <message>A configuration block is either fully named or fully positional, never both.</message>
                </dpage:ListItem>
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with composition" purpose="Direct the reader to the next page group">
          <content>
            <dpage:Navigation purpose="Continue from value configuration into filling aggregations through composition">
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Composition" summary="Learn how aggregations are filled through composition.">
                  <target>docs:Composition</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:ValueConfiguration>
