<!--BlockML Documentation — a guide to non-mandatory modeling guidance

  FQN: org.blockml.bml.bmldocs.a03_authoring.data.page.docs.Suggestions-->
<docs:Suggestions xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:docs="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to non-mandatory modeling guidance
  </is>
  <documentation>
    Scope: non-mandatory modeling guidance for editors and renderers, and suggestions versus
    constraints, grounded in the Suggestions section of
    org.blockml.bml.documentation.ConstraintsModel. Body content is authored in a03 from that
    source.
  </documentation>
  <references>
    <see type="doc:ConstraintsModel" relation="Requires">
      Primary content source — Suggestions as Property-only, non-validation editor metadata.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Suggestions</value>
    </title>
    <purpose override="true">
      <value>Teach suggestions as non-enforced editor and renderer guidance distinct from constraints, so readers do not mistake a suggestion for a validation rule.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <workflow:AuthorativeSourceSet>
          <includedTypes>
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.ConstraintsModel" />
          </includedTypes>
        </workflow:AuthorativeSourceSet>
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>Teach suggestions as non-enforced guidance, distinct from constraints.</summary>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>The reader knows suggestions are hints for tooling, never validation.</summary>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>Non-mandatory modeling guidance for editors and renderers, and how suggestions differ from constraints.</summary>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>Repeat of constraint mechanics.</summary>
          <reason>Constraint mechanics are covered on the Constraints page.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <supportingPoints override="true">
      <composition>
        <sem:SupportingPoint>
          <summary>A suggested value must still be type-compatible with the property, and suggestions are forbidden on EnumType properties.</summary>
        </sem:SupportingPoint>
      </composition>
    </supportingPoints>
    <content override="true">
      <composition>
        <dpage:Section heading="Guidance, not validation" purpose="State what a suggestion is">
          <content>
            <dpage:Paragraph purpose="Introduce suggestions as Property-only metadata">
              <role>org.blockml.bml.docgen.role.Lead</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Suggestions are Property-only metadata — compatible Block instances offered to editors and renderers, not validation.</message>
              <authoritativeSources>
                <workflow:AuthorativeSourceSet>
                  <includedTypes>
                    <type:TypeSelectorEntity value="org.blockml.bml.documentation.ConstraintsModel" />
                  </includedTypes>
                </workflow:AuthorativeSourceSet>
              </authoritativeSources>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Suggestions versus constraints" purpose="Contrast suggestions with constraints">
          <content>
            <dpage:Paragraph purpose="Contrast non-enforced suggestions with enforced constraints">
              <role>org.blockml.bml.docgen.role.Comparison</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Suggestions are never enforced — authors may still enter any type-compatible value, unlike a constraint that may fail validation.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Forbidden on enums" purpose="State the EnumType restriction">
          <content>
            <dpage:Paragraph purpose="State that suggestions are forbidden on EnumType properties">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Suggestions are forbidden on EnumType properties, since valid values there come exclusively from the type's declared members.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="What to carry into the next pages" purpose="Anchor the reader outcome before expressions are introduced">
          <content>
            <dpage:Paragraph purpose="State the retained outcome">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Readers should now know that suggestions are hints for tooling, never validation.</message>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <dpage:Section heading="Continue with expressions" purpose="Direct the reader to the next page">
          <content>
            <dpage:Navigation purpose="Continue the Behaviour and Values sequence">
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Expressions" summary="Learn how member values can be dynamic.">
                  <target>docs:Expressions</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Suggestions>
