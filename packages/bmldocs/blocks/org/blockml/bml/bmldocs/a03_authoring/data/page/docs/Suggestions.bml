<!--BlockML Documentation — a guide to non-mandatory modeling guidance

  FQN: org.blockml.bml.bmldocs.a03_authoring.data.page.docs.Suggestions-->
<docs:Suggestions xmlns="http://blockml.org/bml"
  xmlns:sem="org.blockml.bml.docgen.semantic"
  xmlns:docs="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:dpage="org.blockml.bml.docgen.page"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <baseType>
    dpage:DocPage
  </baseType>
  <is>
    A guide to non-mandatory modeling guidance
  </is>
  <documentation>
    Scope: non-mandatory modeling guidance for editors and renderers, and suggestions versus
    constraints, grounded in the Suggestions section of
    org.blockml.bml.documentation.ConstraintsModel. Body content is authored in a03 from that
    source.
  </documentation>
  <references>
    <see type="doc:ConstraintsModel" relation="Requires">
      Primary content source — Suggestions as Property-only, non-validation editor metadata.
    </see>
  </references>
  <properties>
    <title override="true">
      <value>Suggestions</value>
    </title>
    <purpose override="true">
      <value>Teach suggestions as non-enforced editor and renderer guidance distinct from constraints, so readers do not mistake a suggestion for a validation rule.</value>
    </purpose>
    <detailLevel override="true">
      <value>org.blockml.bml.docgen.level.Introductory</value>
    </detailLevel>
    <pageType override="true">
      <value>org.blockml.bml.docgen.pagetype.Concept</value>
    </pageType>
  </properties>
  <aggregations>
    <authoritativeSources override="true">
      <composition>
        <workflow:AuthorativeSourceSet>
          <includedTypes>
            <type:TypeSelectorEntity value="org.blockml.bml.documentation.ConstraintsModel" />
          </includedTypes>
        </workflow:AuthorativeSourceSet>
      </composition>
    </authoritativeSources>
    <learningObjectives override="true">
      <composition>
        <sem:LearningObjective>
          <summary>Teach suggestions as non-enforced guidance, distinct from constraints.</summary>
        </sem:LearningObjective>
      </composition>
    </learningObjectives>
    <readerOutcomes override="true">
      <composition>
        <sem:ReaderOutcome>
          <summary>The reader knows suggestions are hints for tooling, never validation.</summary>
        </sem:ReaderOutcome>
      </composition>
    </readerOutcomes>
    <scopes override="true">
      <composition>
        <sem:Scope>
          <summary>Non-mandatory modeling guidance for editors and renderers, and how suggestions differ from constraints.</summary>
        </sem:Scope>
      </composition>
    </scopes>
    <exclusions override="true">
      <composition>
        <sem:Exclusion>
          <summary>Repeat of constraint mechanics.</summary>
          <reason>Constraint mechanics are covered on the Constraints page.</reason>
        </sem:Exclusion>
      </composition>
    </exclusions>
    <supportingPoints override="true">
      <composition>
        <sem:SupportingPoint>
          <summary>A suggested value must still be type-compatible with the property, and suggestions are forbidden on EnumType properties.</summary>
        </sem:SupportingPoint>
      </composition>
    </supportingPoints>
    <content override="true">
      <composition>
        <!--1. Lead-->
        <dpage:Section heading="Suggestions as optional guidance" purpose="Introduce suggestions as non-mandatory guidance for editors and renderers">
          <content>
            <dpage:Paragraph purpose="Introduce a suggestion as a non-mandatory hint">
              <role>org.blockml.bml.docgen.role.Lead</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A suggestion is a hint attached to a property that points editors and
renderers toward values or instances that fit well, without ever governing whether
the model is valid.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>A suggestion only needs to be type-compatible with its property; it is never checked as a pass-or-fail validation rule.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.ConstraintsModel" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--2. vs constraints-->
        <dpage:Section heading="Suggestions compared to constraints" purpose="Distinguish suggestions from constraints without repeating constraint mechanics">
          <content>
            <dpage:Paragraph purpose="Contrast a suggestion with a validation rule">
              <role>org.blockml.bml.docgen.role.Comparison</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>Unlike a constraint, a suggestion is never validated as a pass-or-fail
rule; it exists purely to help a person or tool choose among values that already fit
the property's type.</message>
              <authoritativeSources>
                <doc:ConstraintsModel />
              </authoritativeSources>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--3. Where it lives-->
        <dpage:Section heading="Where a suggestion lives" purpose="Explain that suggestions are property-level guidance about compatible instances">
          <content>
            <dpage:Paragraph purpose="Explain that a suggestion is property-level metadata">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A suggestion is attached only at the property level, offering Block
instances that already fit that property's type, rather than expressing a rule that
applies broadly across a Block.</message>
              <authoritativeSources>
                <doc:ConstraintsModel />
              </authoritativeSources>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--4. Type compatibility-->
        <dpage:Section heading="Suggestions still respect the property's type" purpose="Explain the type-compatibility boundary on suggestions">
          <content>
            <dpage:Paragraph purpose="Explain that a suggestion must remain type-compatible">
              <role>org.blockml.bml.docgen.role.Explanation</role>
              <detailLevel>org.blockml.bml.docgen.level.Introductory</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Primary</weight>
              <message>A suggested instance must still be compatible with the property's own
type, and a property whose type already restricts values to a fixed set of options
does not offer suggestions at all.</message>
              <supportingPoints>
                <sem:SupportingPoint>
                  <summary>Suggestions are forbidden entirely on a property whose type is a closed enumeration, since every valid value is already fixed.</summary>
                  <authoritativeSources>
                    <workflow:AuthorativeSourceSet>
                      <includedTypes>
                        <type:TypeSelectorEntity value="org.blockml.bml.documentation.ConstraintsModel" />
                      </includedTypes>
                    </workflow:AuthorativeSourceSet>
                  </authoritativeSources>
                </sem:SupportingPoint>
              </supportingPoints>
            </dpage:Paragraph>
          </content>
        </dpage:Section>
        <!--5. Recap-->
        <dpage:Section heading="Recognizing a suggestion" purpose="Summarize how to recognize a suggestion versus a validation rule">
          <content>
            <dpage:List purpose="Summarize the traits that identify a suggestion">
              <role>org.blockml.bml.docgen.role.Summary</role>
              <detailLevel>org.blockml.bml.docgen.level.Overview</detailLevel>
              <weight>org.blockml.bml.docgen.weight.Supporting</weight>
              <message>These checks distinguish a suggestion from a validation rule at a glance.</message>
              <items>
                <dpage:ListItem text="Hint, not rule" purpose="Recap that a suggestion never fails validation">
                  <message>A suggestion never causes a model to fail validation.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Property-level only" purpose="Recap the property-level scope of a suggestion">
                  <message>A suggestion offers compatible instances for one property, not a rule spanning a whole Block.</message>
                </dpage:ListItem>
                <dpage:ListItem text="Still type-compatible" purpose="Recap the type-compatibility boundary">
                  <message>A suggested instance must still match the property's own type.</message>
                </dpage:ListItem>
              </items>
            </dpage:List>
          </content>
        </dpage:Section>
        <!--6. Continuation-->
        <dpage:Section heading="Continue with the expression language" purpose="Direct the reader to the next page">
          <content>
            <dpage:Navigation purpose="Continue from suggestions into the expression language">
              <title>Next</title>
              <items>
                <dpage:NavigationItem label="Expressions" summary="Learn the expression language used for dynamic member values.">
                  <target>docs:Expressions</target>
                </dpage:NavigationItem>
              </items>
            </dpage:Navigation>
          </content>
        </dpage:Section>
      </composition>
    </content>
  </aggregations>
</docs:Suggestions>
