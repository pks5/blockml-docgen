<!--BlockML Documentation Sector Model Descriptor

  Name: Library
  Filename: Library.bml
  FQN: org.blockml.bml.bmldocs.Library

  Sector model for stepwise documentation development (a01, a02, …).
  Block .bml sources live under blocks/org/blockml/bml/bmldocs/.-->
<bmldocs:Library xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bmldocs="org.blockml.bml.bmldocs"
  xmlns:a01_planning="org.blockml.bml.bmldocs.a01_planning"
  xmlns:pdata="org.blockml.bml.bmldocs.a01_planning.data"
  xmlns:a01task="org.blockml.bml.bmldocs.a01_planning.task"
  xmlns:a02_structuring="org.blockml.bml.bmldocs.a02_structuring"
  xmlns:a02data="org.blockml.bml.bmldocs.a02_structuring.data"
  xmlns:docs="org.blockml.bml.bmldocs.a02_structuring.data.page.docs"
  xmlns:a02pgroup="org.blockml.bml.bmldocs.a02_structuring.data.pagegroup"
  xmlns:task="org.blockml.bml.bmldocs.a02_structuring.task"
  xmlns:a03_authoring="org.blockml.bml.bmldocs.a03_authoring"
  xmlns:adata="org.blockml.bml.bmldocs.a03_authoring.data"
  xmlns:page="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:pgroup="org.blockml.bml.bmldocs.a03_authoring.data.pagegroup"
  xmlns:a03task="org.blockml.bml.bmldocs.a03_authoring.task"
  xmlns:a04_rendering="org.blockml.bml.bmldocs.a04_rendering"
  xmlns:a04task="org.blockml.bml.bmldocs.a04_rendering.task"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule"
  xmlns:source="org.blockml.bml.bmldocs.lib.source"
  xmlns:program="org.blockml.bml.bmldocs.program"
  xmlns:core="org.blockml.bml.core"
  xmlns:docgen="org.blockml.bml.docgen"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:BlockLibrary
  </baseType>
  <is>
    A sector-model catalog for stepwise documentation development
  </is>
  <isnot>
    A classical cohesive Block library for one published documentation site
  </isnot>
  <version>
    0.1.0
  </version>
  <documentation>
    Sector model (org.blockml.bml.bmldocs) for developing documentation in successive steps.
    The model is partitioned into numbered sectors (a01, a02, …). Each sector holds an
    autonomous sub-model that may be derived from earlier sectors. Sector models are not
    classical cohesive libraries.
    
    docgen supplies only the content-structure types that sector models specialize
    (DocSet, DocSetPlan, Page, PageGroup, and related types). It is the foundation for
    models inside sectors, not a site catalogue and not the owner of sector content.
    
    Membership of this descriptor is defined exclusively by this file's blocks list — not
    by directory layout. Version 0.1.0 applies to all exported blocks (framework convention:
    version only on Library.bml).
  </documentation>
  <references>
    <see type="bmldocs:README" relation="ReadFirst">
      Human/LLM reading entry for this library.
    </see>
  </references>
  <language>
    <blockml:language.English />
  </language>
  <properties>
    <description override="true">
      <value>BlockML documentation sector model — autonomous sector sub-models, not a classical library</value>
    </description>
  </properties>
  <aggregations>
    <readMe override="true">
      <composition>
        <bmldocs:README />
      </composition>
    </readMe>
    <dependencies override="true">
      <composition>
        <blockml:Library />
        <docgen:Library />
      </composition>
    </dependencies>
    <blocks override="true">
      <composition>
        <bmldocs:README />
        <adata:BmlDocSet_A03 />
