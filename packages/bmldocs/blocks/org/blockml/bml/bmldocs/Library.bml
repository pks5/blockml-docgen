<!--BlockML Documentation Sector Model Descriptor

  Name: Library
  Filename: Library.bml
  FQN: org.blockml.bml.bmldocs.Library

  Sector model for stepwise documentation development (a01, a02, …).
  Block .bml sources live under blocks/org/blockml/bml/bmldocs/.-->
<bmldocs:Library xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bmldocs="org.blockml.bml.bmldocs"
  xmlns:pdata="org.blockml.bml.bmldocs.a01_planning.data"
  xmlns:task="org.blockml.bml.bmldocs.a02_structuring.task"
  xmlns:adata="org.blockml.bml.bmldocs.a03_authoring.data"
  xmlns:pgroup="org.blockml.bml.bmldocs.a03_authoring.data.page"
  xmlns:page="org.blockml.bml.bmldocs.a03_authoring.data.page.docs"
  xmlns:lrule="org.blockml.bml.bmldocs.lib.rule"
  xmlns:core="org.blockml.bml.core"
  xmlns:docgen="org.blockml.bml.docgen"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:BlockLibrary
  </baseType>
  <is>
    A sector-model catalog for stepwise documentation development
  </is>
  <isNot>
    A classical cohesive Block library for one published documentation site
  </isNot>
  <version>
    0.1.0
  </version>
  <documentation>
    Sector model (org.blockml.bml.bmldocs) for developing documentation in successive steps.
    The model is partitioned into numbered sectors (a01, a02, …). Each sector holds an
    autonomous sub-model that may be derived from earlier sectors. Sector models are not
    classical cohesive libraries.
    
    docgen supplies only the content-structure types that sector models specialize
    (DocSet, DocSetPlan, Page, PageGroup, and related types). It is the foundation for
    models inside sectors, not a site catalogue and not the owner of sector content.
    
    Membership of this descriptor is defined exclusively by this file's blocks list — not
    by directory layout. Version 0.1.0 applies to all exported blocks (framework convention:
    version only on Library.bml).
  </documentation>
  <references>
    <see type="bmldocs:README" relation="ReadFirst">
      Human/LLM reading entry for this library.
    </see>
  </references>
  <language>
    <blockml:language.English />
  </language>
  <properties>
    <description override="true">
      <value>BlockML documentation sector model — autonomous sector sub-models, not a classical library</value>
    </description>
  </properties>
  <aggregations>
    <readMe override="true">
      <composition>
        <bmldocs:README />
      </composition>
    </readMe>
    <dependencies override="true">
      <composition>
        <blockml:Library />
        <docgen:Library />
      </composition>
    </dependencies>
    <blocks override="true">
      <composition>
        <bmldocs:README />
        <adata:BmlDocSet_A03 />
        <pdata:BmlDocSetPlan />
        <lrule:CodeStyleRule />
        <lrule:CompleteSentenceRule />
        <lrule:OnePrimaryMessageRule />
        <lrule:RespectScopeRule />
        <lrule:RespectExclusionsRule />
        <lrule:NoSourceDumpRule />
        <lrule:NoUnrequestedDiagnosticsRule />
        <lrule:MatchDetailLevelRule />
        <lrule:ConceptBeforeImplementationRule />
        <lrule:NoFragmentedEnumerationRule />
        <lrule:AudienceVocabularyRule />
        <page:TableOfContents />
        <page:Intro />
        <page:FirstBlock />
        <page:FileAnatomy />
        <page:EverythingIsABlockPage />
        <page:DefinitionAndInstance />
        <page:CompositionBasics />
        <page:TypesOverview />
        <page:TypeExpressionsBasics />
        <page:GenericsBriefly />
        <page:ConfiguringTypes />
        <page:CapabilitiesIntro />
        <page:ExpressionsIntro />
        <page:EmbeddedExpressionsIntro />
        <page:LibrariesAndPackages />
        <page:ReadmeAndBootstrap />
        <page:ModelingGuidelinesPage />
        <page:VisibilityBasics />
        <page:OverridesBasics />
        <page:ConstraintsBasics />
        <page:AnnotationsAndDirectives />
        <page:SubBlocksIntro />
        <page:ContractsIntro />
        <page:CompilerOverview />
        <page:AuthorNewBlockGuide />
        <pgroup:RootPageGroup />
        <pgroup:DocsPageGroup />
        <pgroup:GettingStartedPageGroup />
        <pgroup:CoreIdeasPageGroup />
        <pgroup:TypesPageGroup />
        <pgroup:BehaviourPageGroup />
        <pgroup:LibrariesPageGroup />
        <pgroup:AuthoringPageGroup />
        <pgroup:DeeperTopicsPageGroup />
        <pgroup:HowToPageGroup />
        <task:A02_UpdatePageSkeletons />
      </composition>
    </blocks>
  </aggregations>
</bmldocs:Library>