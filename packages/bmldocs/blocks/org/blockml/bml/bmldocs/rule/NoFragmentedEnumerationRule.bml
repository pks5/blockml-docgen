<!--BlockML Documentation — no fragmented enumeration structure rule

  FQN: org.blockml.bml.bmldocs.rule.NoFragmentedEnumerationRule-->
<brule:NoFragmentedEnumerationRule xmlns="http://blockml.org/bml"
  xmlns:brule="org.blockml.bml.bmldocs.rule"
  xmlns:rule="org.blockml.bml.docgen.rule">

  <baseType>
    rule:StructureRule
  </baseType>
  <is>
    A structure rule requiring explicit List or Table for unstructured enumerations
  </is>
  <documentation>
    Requires that unstructured enumerations of three or more parallel facts, rules, categories, or
    diagnostics use an explicit List or Table PageElement. Implicit lists must not be encoded as
    consecutive sentence fragments inside a Paragraph.
  </documentation>
  <references>
    <see type="rule:StructureRule" relation="Extends">
      Documentation structure-rule branch.
    </see>
  </references>
  <properties>
    <name override="true">
      <value>No fragmented enumeration</value>
    </name>
    <summary override="true">
      <value>Unstructured enumerations must be represented by an explicit List or Table.</value>
    </summary>
    <instructions override="true">
      <value>When three or more parallel facts, rules, categories, or diagnostics are presented,
use a List or Table PageElement. Do not encode an implicit list as consecutive sentence
fragments inside a Paragraph.</value>
    </instructions>
  </properties>
</brule:NoFragmentedEnumerationRule>
