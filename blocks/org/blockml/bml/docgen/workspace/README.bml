<!--BlockML Docgen Workspace — README
  FQN: org.blockml.bml.docgen.workspace.README-->
<workspace:README xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:docgen="org.blockml.bml.docgen"
  xmlns:workspace="org.blockml.bml.docgen.workspace"
  xmlns:wsdocumentation="org.blockml.bml.docgen.workspace.documentation">

  <baseType>
    core:ReadMe
  </baseType>
  <is>
    Reading entry for the BlockML Docgen workspace library
  </is>
  <documentation>
    This monorepo authors two publishable BML libraries.
    
    @blockml/docgen is the base library for structuring documentation. It defines
    DocSet, Page, PageGroup, Plans, manifestation stages, page and content types,
    roles, rules, and semantic annotations — orthogonal to any one website or
    documentation programme.
    
    @blockml/bmldocs is a sector model on top of that foundation. Numbered sectors
    (a01, a02, …) each hold an autonomous sub-model; later sectors can be produced
    from earlier ones. The sector model uses docgen only for content structure and
    generates the BlockML documentation in successive steps. It is not a classical
    cohesive library.
    
    This library (org.blockml.bml.docgen.workspace.*) is the monorepo documentation hub
    and SSOT entry. It depends on the base package library; packages never depend back
    here. Start at org.blockml.bml.docgen.workspace.documentation.Introduction.
  </documentation>
  <references>
    <see type="wsdocumentation:Introduction" relation="ReadFirst" />
    <see type="wsdocumentation:PackageMap" relation="SeeAlso" />
    <see type="wsdocumentation:ArchitectureOverview" relation="SeeAlso" />
    <see type="wsdocumentation:ReadingOrder" relation="SeeAlso" />
    <see type="wsdocumentation:LinkingRules" relation="SeeAlso" />
    <see type="docgen:README" relation="SeeAlso" />
  </references>
</workspace:README>
