<!--
  BlockML Docgen Workspace — README
  FQN: org.blockml.bml.docgen.workspace.README
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:type="org.blockml.bml.type"
  xmlns:docgen="org.blockml.bml.docgen"
  xmlns:bmldocs="org.blockml.bml.bmldocs"
  xmlns:workspace="org.blockml.bml.docgen.workspace"
  xmlns:wsdocumentation="org.blockml.bml.docgen.workspace.documentation">

  <name>README</name>
  <type>workspace:README</type>
  <baseType>core:ReadMe</baseType>
  <is>Reading entry for the BlockML Docgen workspace library</is>

  <documentation>
    This monorepo hosts @blockml/docgen and @blockml/bmldocs — BML libraries for
    generating structured documents from other BlockML libraries, and for producing
    the documentation published on blockml.org.

    This library (org.blockml.bml.docgen.workspace.*) is the monorepo documentation hub
    and SSOT entry. It depends on each package BML library; packages never depend
    back here.

    Start reading at org.blockml.bml.docgen.workspace.documentation.Introduction
    (ReadNext chain). Package detail lives in the linked libraries under
    packages/*/blocks/.
  </documentation>

  <references>
    <see type="wsdocumentation:Introduction" relation="ReadFirst" />
    <see type="wsdocumentation:PackageMap" relation="SeeAlso" />
    <see type="wsdocumentation:ArchitectureOverview" relation="SeeAlso" />
    <see type="wsdocumentation:LinkingRules" relation="SeeAlso" />
    <see type="docgen:README" relation="SeeAlso" />
    <see type="bmldocs:README" relation="SeeAlso" />
  </references>

</block>
