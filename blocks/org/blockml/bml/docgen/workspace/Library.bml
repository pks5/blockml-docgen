<!--BlockML Docgen Workspace Library
  FQN: org.blockml.bml.docgen.workspace.Library-->
<workspace:Library xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:docgen="org.blockml.bml.docgen"
  xmlns:workspace="org.blockml.bml.docgen.workspace"
  xmlns:wsdocumentation="org.blockml.bml.docgen.workspace.documentation">

  <baseType>
    core:BlockLibrary
  </baseType>
  <is>
    The BlockML Docgen monorepo workspace library catalog
  </is>
  <version>
    0.1.0
  </version>
  <documentation>
    Documentation and SSOT hub for the BlockML Docgen monorepo.
    
    This workspace orients two publishable packages:
    
    - @blockml/docgen — base library for structuring documentation
    - @blockml/bmldocs — sector model that generates BlockML documentation on top of docgen
    
    @blockml/core supplies language and narrative SSOT that both packages consume.
    
    Direction is workspace → packages only. Membership is defined exclusively by
    this blocks list. This hub does not re-export package blocks; package libraries
    must not depend back on this library.
  </documentation>
  <references>
    <see type="workspace:README" relation="ReadFirst">
      Human/LLM reading entry for this library.
    </see>
  </references>
  <language>
    <blockml:language.English />
  </language>
  <properties>
    <description override="true">
      <value>BlockML Docgen workspace monorepo library</value>
    </description>
  </properties>
  <aggregations>
    <readMe override="true">
      <composition>
        <workspace:README />
      </composition>
    </readMe>
    <dependencies override="true">
      <composition>
        <blockml:Library />
        <docgen:Library />
      </composition>
    </dependencies>
    <blocks override="true">
      <composition>
        <workspace:WorkspaceType />
        <wsdocumentation:Introduction />
        <wsdocumentation:PackageMap />
        <wsdocumentation:ArchitectureOverview />
        <wsdocumentation:ReadingOrder />
        <wsdocumentation:LinkingRules />
      </composition>
    </blocks>
  </aggregations>
</workspace:Library>
