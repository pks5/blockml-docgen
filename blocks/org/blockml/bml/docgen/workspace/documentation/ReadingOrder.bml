<!--Workspace Documentation — ReadingOrder
  FQN: org.blockml.bml.docgen.workspace.documentation.ReadingOrder-->
<wsdocumentation:ReadingOrder xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:docgen="org.blockml.bml.docgen"
  xmlns:dcore="org.blockml.bml.docgen.core"
  xmlns:wsdocumentation="org.blockml.bml.docgen.workspace.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Recommended reading path across package libraries
  </is>
  <documentation>
    Suggested order for onboarding:
    
    1. This hub — Introduction → PackageMap → ArchitectureOverview → LinkingRules.
    2. The docgen base library — start at its README, then dcore:DocElement,
       dcore:DocSet, dcore:Page (DocPage), dcore:PageGroup, dcore:Plan, and
       dcore:ManifestationStage. Stay there for reusable structuring types and the
       four-stage pipeline.
    3. The bmldocs sector model — read it as numbered autonomous sectors (a01, a02,
       …), not as one classical catalogue. Stay there for the stepwise generation of
       BlockML documentation on top of docgen.
    
    Dive into a package library only for that package's contracts; return here for
    monorepo orientation. Narrative language SSOT remains in org.blockml.bml
    (documentation.* and task.*).
  </documentation>
  <references>
    <see type="wsdocumentation:LinkingRules" relation="ReadNext" />
    <see type="docgen:README" relation="SeeAlso" />
    <see type="dcore:DocElement" relation="SeeAlso" />
    <see type="dcore:DocSet" relation="SeeAlso" />
    <see type="docgen:Library" relation="SeeAlso" />
  </references>
</wsdocumentation:ReadingOrder>
