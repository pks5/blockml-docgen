<!--
  Workspace Documentation — ReadingOrder
  FQN: org.blockml.bml.docgen.workspace.documentation.ReadingOrder
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:type="org.blockml.bml.type"
  xmlns:docgen="org.blockml.bml.docgen"
  xmlns:bmldocs="org.blockml.bml.bmldocs"
  xmlns:workspace="org.blockml.bml.docgen.workspace"
  xmlns:wsdocumentation="org.blockml.bml.docgen.workspace.documentation"
  xmlns:doc="org.blockml.bml.documentation">

  <name>ReadingOrder</name>
  <type>wsdocumentation:ReadingOrder</type>
  <baseType>core:Documentation</baseType>
  <is>Recommended reading path across package libraries</is>

  <documentation>Suggested order for onboarding (each library README → Introduction chain):

    1. This hub — workspace Introduction → PackageMap → ArchitectureOverview
    2. org.blockml.bml.docgen — generic document-generation tools (@blockml/docgen)
    3. org.blockml.bml.bmldocs — blockml.org documentation library (@blockml/bmldocs)

    Dive into a package library only for that package's contracts; return here for
    monorepo orientation.</documentation>

  <references>
    <see type="wsdocumentation:LinkingRules" relation="ReadNext" />
    <see type="docgen:Library" relation="SeeAlso" />
    <see type="bmldocs:Library" relation="SeeAlso" />
  </references>

</block>
