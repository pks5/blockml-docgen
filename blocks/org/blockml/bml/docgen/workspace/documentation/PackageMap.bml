<!--Workspace Documentation — PackageMap
  FQN: org.blockml.bml.docgen.workspace.documentation.PackageMap-->
<wsdocumentation:PackageMap xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:docgen="org.blockml.bml.docgen"
  xmlns:wsdocumentation="org.blockml.bml.docgen.workspace.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    npm package to BML library map for this monorepo
  </is>
  <documentation>
    Linked libraries (npm → BML FQN → blocks path):
    
    • @blockml/core (external) → org.blockml.bml.Library
      → node_modules/@blockml/core/blocks/org/blockml/bml/Library.bml
      Language, narrative documentation, and task guides that both packages consume.
    
    • @blockml/docgen → org.blockml.bml.docgen.Library
      → packages/docgen/blocks/org/blockml/bml/docgen/Library.bml
      Base library for structuring documentation: DocElement branch (DocSet, Page,
      PageGroup, PageElement, Plan, Rule, ManifestationStage, DetailLevel, Weight,
      Audience, PageType, ContentRole, SemanticAnnotation), plan types, four
      manifestation stages, page content types, page-type and role specializations,
      rule families, and semantic annotations.
    
    • @blockml/bmldocs
      → packages/bmldocs/blocks/org/blockml/bml/bmldocs/
      Sector model that generates BlockML documentation on top of docgen. Numbered
      sectors (a01, a02, …) are autonomous sub-models, not one classical cohesive
      library. Uses docgen only for content structure inside sectors.
    
    This hub → org.blockml.bml.docgen.workspace.Library
      → blocks/org/blockml/bml/docgen/workspace/Library.bml
      Monorepo orientation only. Not an npm publishable product library.
  </documentation>
  <references>
    <see type="wsdocumentation:ArchitectureOverview" relation="ReadNext" />
    <see type="wsdocumentation:ReadingOrder" relation="SeeAlso" />
    <see type="docgen:Library" relation="SeeAlso" />
    <see type="docgen:README" relation="SeeAlso" />
  </references>
</wsdocumentation:PackageMap>
