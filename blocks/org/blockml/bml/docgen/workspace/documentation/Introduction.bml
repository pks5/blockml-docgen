<!--
  Workspace Documentation — Introduction
  FQN: org.blockml.bml.docgen.workspace.documentation.Introduction
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:type="org.blockml.bml.type"
  xmlns:workspace="org.blockml.bml.docgen.workspace"
  xmlns:wsdocumentation="org.blockml.bml.docgen.workspace.documentation"
  xmlns:doc="org.blockml.bml.documentation">

  <name>Introduction</name>
  <type>wsdocumentation:Introduction</type>
  <baseType>core:Documentation</baseType>
  <is>Purpose and scope of the BlockML Docgen workspace library</is>

  <documentation>This repository is the BlockML Docgen monorepo. It authors two @blockml/*
    packages: @blockml/docgen (generic tools that turn other BML libraries into
    structured documents) and @blockml/bmldocs (the library that generates the
    documentation published on blockml.org).

    This workspace library (org.blockml.bml.docgen.workspace.*) is the monorepo
    documentation hub and SSOT entry for humans and LLMs. It links each package
    BML library via Library.dependencies (workspace → packages only). Per-package
    contracts remain in those libraries; this hub does not re-export their blocks.

    Root README.md points here.</documentation>

  <references>
    <see type="wsdocumentation:PackageMap" relation="ReadNext" />
    <see type="wsdocumentation:ArchitectureOverview" relation="SeeAlso" />
    <see type="wsdocumentation:LinkingRules" relation="SeeAlso" />
  </references>

</block>
