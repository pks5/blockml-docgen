    <see type="stage:PageAuthoringStage" relation="SeeAlso" />
    <see type="stage:PageRenderingStage" relation="SeeAlso" />
    <see type="docset:BmlDocSet" relation="SeeAlso" />
    <see type="docgen:Library" relation="SeeAlso" />
    <see type="bmldocs:Library" relation="SeeAlso" />
  </references>

</block>
